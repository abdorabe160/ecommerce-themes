{# ===== ANAQA Cart Drawer (Mini Cart) — Editorial ===== #}

<style>
  .anaqa-drawer-checkout {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    width: 100%; height: 52px;
    font-size: 12px; font-weight: 500;
    letter-spacing: 0.16em; text-transform: uppercase;
    background: var(--color-text-primary);
    color: var(--color-bg-primary);
    text-decoration: none;
    transition: opacity 0.3s ease;
  }
  html[dir="rtl"] .anaqa-drawer-checkout { letter-spacing: 0; text-transform: none; font-size: 14px; }
  .anaqa-drawer-checkout:hover { opacity: 0.88; }
</style>

<div x-data="cartInteraction({
  items: [{% for item in cart.items %}{id:'{{ item._id }}',qty:{{ item.quantity }},productId:'{{ item.productId }}',variantId:'{{ item.variantId or '' }}',slug:{{ (item.productData.slug or item.productData.handle or '') | dump }}}{% if not loop.last %},{% endif %}{% endfor %}]
})" x-cloak>

  {# Overlay #}
  <div x-show="$store.modal.current === 'cart'"
       @click="$store.modal.close()"
       class="overlay"
       x-transition:enter="transition ease-out duration-400"
       x-transition:enter-start="opacity-0"
       x-transition:enter-end="opacity-100"
       x-transition:leave="transition ease-in duration-300"
       x-transition:leave-start="opacity-100"
       x-transition:leave-end="opacity-0">
  </div>

  {# Drawer #}
  <div class="drawer drawer-end flex flex-col"
       :class="{ 'open': $store.modal.current === 'cart' }"
       style="background: var(--color-bg-primary);">

    {# ===== Header ===== #}
    <div class="flex-shrink-0 px-5 pt-6 pb-4">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-heading-ar" style="color: var(--color-text-primary); font-weight: 500;">{{t('pages.cart.title')}}</h2>
        <button @click="$store.modal.close()"
                class="w-9 h-9 flex items-center justify-center transition-colors"
                style="color: var(--color-text-secondary);"
                onmouseenter="this.style.color='var(--color-text-primary)'"
                onmouseleave="this.style.color='var(--color-text-secondary)'"
                aria-label="{{t('common.close') | default('إغلاق')}}">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      {# Items count bar #}
      <div class="flex items-center justify-between text-[12px] font-body-ar pb-4" data-cart-count-bar
           style="border-bottom: 1px solid var(--color-border); {% if not cart.items | length %}display:none{% endif %}">
        <span style="color: var(--color-text-tertiary);"><span data-cart-count-text>{% ui "count.njk", n=(cart.totalQuantity or 0), kind='product' %}</span></span>
        <a href="/cart" @click="$store.modal.close()" class="editorial-link" style="color: var(--color-text-secondary);">{{t('common.view_all')}}</a>
      </div>
    </div>

    {# ===== Cart Items ===== #}
    <div class="flex-1 overflow-y-auto custom-scrollbar px-5" data-cart-container
         style="{% if not cart.items | length %}display:none{% endif %}">
      <div>
        {% for item in cart.items %}
          <div class="transition-all duration-300 py-5"
               data-cart-item="{{ item._id }}"
               style="{% if not loop.last %}border-bottom: 1px solid var(--color-border);{% endif %}"
               x-show="activeItems.includes('{{ item._id }}')"
               x-transition:leave="transition ease-in duration-200"
               x-transition:leave-start="opacity-100"
               x-transition:leave-end="opacity-0"
               :class="{ 'opacity-20 pointer-events-none': removingId === '{{ item._id }}' }">

            {# Product Card #}
            <div class="flex gap-4">
              {# Image #}
              <a href="/products/{{ item.productData.slug }}" @click="$store.modal.close()" class="shrink-0">
                {% if item.productData.image and item.productData.image.fileUrl %}
                  <div class="w-[72px] overflow-hidden" style="aspect-ratio: 3 / 4; background: var(--color-bg-secondary);">
                    <img src="{{ item.productData.image.fileUrl }}"
                         alt="{{ item.productData.title }}"
                         class="w-full h-full object-cover"
                         style="filter: saturate(1.03) contrast(1.02);"
                         loading="lazy">
                  </div>
                {% else %}
                  <div class="w-[72px] flex items-center justify-center" style="aspect-ratio: 3 / 4; background: var(--color-bg-secondary);">
                    <svg class="w-7 h-7" fill="none" stroke="var(--color-text-tertiary)" viewBox="0 0 24 24" style="opacity: 0.25;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  </div>
                {% endif %}
              </a>

              {# Details #}
              <div class="flex-1 min-w-0 flex flex-col gap-1.5">
                {# Title + Remove #}
                <div class="flex items-start justify-between gap-2">
                  <a href="/products/{{ item.productData.slug }}"
                     @click="$store.modal.close()"
                     class="text-[14px] font-heading-ar line-clamp-2 leading-snug transition-colors"
                     style="color: var(--color-text-primary);"
                     onmouseenter="this.style.color='var(--color-accent)'"
                     onmouseleave="this.style.color='var(--color-text-primary)'">
                    {{ item.productData.title }}
                  </a>
                  <button @click="removeItem('{{ item._id }}')"
                          class="shrink-0 -mt-2.5 -me-2.5 w-10 h-10 flex items-center justify-center transition-colors"
                          style="color: var(--color-text-tertiary);"
                          onmouseenter="this.style.color='var(--color-error)'"
                          onmouseleave="this.style.color='var(--color-text-tertiary)'"
                          aria-label="{{t('pages.cart.remove')}}">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 18L18 6M6 6l12 12"/></svg>
                  </button>
                </div>

                {# Variant Options #}
                {% if item.variantData and item.variantData.options | length > 0 %}
                  <div class="flex flex-wrap items-center gap-x-2.5 gap-y-0.5">
                    {% for opt in item.variantData.options %}
                      <span class="text-[11px] flex items-center gap-1 font-body-ar" style="color: var(--color-text-tertiary);">
                        {{ opt.option.name }}:
                        {% if opt.option.type == 'color' %}
                          <span class="inline-block w-3 h-3 rounded-full align-middle" style="background-color: {% ui "color-value.njk", value=(opt.value or ''), label=(opt.label or '') %}; border: 1px solid var(--color-border);"></span>
                        {% endif %}
                        <span style="color: var(--color-text-secondary);">{{ opt.label }}</span>
                      </span>
                    {% endfor %}
                  </div>
                {% endif %}
                <p x-show="isOverStock('{{ item._id }}')" x-cloak x-text="stockNote('{{ item._id }}')" class="attar-citem-note"></p>

                {# Price + Qty Row #}
                <div class="flex items-center justify-between mt-2">
                  {# Quantity #}
                  <div class="inline-flex items-center" style="border: 1px solid var(--color-border);">
                    <button @click="decrement('{{ item._id }}')"
                            class="w-8 h-8 flex items-center justify-center transition-colors"
                            style="color: var(--color-text-secondary);"
                            onmouseenter="this.style.color='var(--color-text-primary)'"
                            onmouseleave="this.style.color='var(--color-text-secondary)'"
                            aria-label="{{t('pages.cart.quantity') | default('الكمية')}}">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M20 12H4"/></svg>
                    </button>
                    <span class="w-9 h-8 flex items-center justify-center text-[13px] font-medium" style="color: var(--color-text-primary); border-inline: 1px solid var(--color-border);">
                      <span x-show="updating !== '{{ item._id }}'"
                            x-text="quantities['{{ item._id }}']">{{ item.quantity }}</span>
                      <svg x-show="updating === '{{ item._id }}'" x-cloak class="w-3.5 h-3.5 animate-spin mx-auto" fill="none" viewBox="0 0 24 24" style="color: var(--color-accent);"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                    </span>
                    <button @click="increment('{{ item._id }}')" :class="{ 'opacity-30 cursor-not-allowed': quantities['{{ item._id }}'] >= maxFor('{{ item._id }}') }"
                            class="w-8 h-8 flex items-center justify-center transition-colors"
                            style="color: var(--color-text-secondary);"
                            onmouseenter="this.style.color='var(--color-text-primary)'"
                            onmouseleave="this.style.color='var(--color-text-secondary)'"
                            aria-label="{{t('pages.cart.quantity') | default('الكمية')}}">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 4v16m8-8H4"/></svg>
                    </button>
                  </div>

                  {# Price #}
                  <div class="text-end">
                    <span class="text-[14px] font-body-ar" style="color: var(--color-text-primary);"
                          data-item-total="{{ item._id }}"
                          :class="{ 'opacity-40': updating === '{{ item._id }}' }">
                      {{ item.totalPrice | money }}
                    </span>
                    {% if item.compareAtPrice and item.compareAtPrice > item.price %}
                      <span class="block text-[10px] font-light line-through font-body-ar" style="color: var(--color-text-tertiary);" data-item-compare="{{ item._id }}">{{ item.totalCompareAtPrice | money }}</span>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>

          </div>
        {% endfor %}
      </div>
    </div>

    {# ===== Footer ===== #}
    <div class="flex-shrink-0" data-cart-footer
         style="{% if not cart.items | length %}display:none{% endif %}">

      {# Summary #}
      <div class="px-5 py-5" style="border-top: 1px solid var(--color-border);">
        {% ui "free-shipping.njk" %}
        <div class="flex items-center justify-between text-[12px] mb-3 font-body-ar" data-cart-savings-row
             style="{% if not cart.totalSavings or cart.totalSavings <= 0 %}display:none{% endif %}">
          <span style="color: var(--color-sale-text, var(--color-accent));">{{t('pages.cart.savings')}}</span>
          <span style="color: var(--color-sale-text, var(--color-accent));" data-cart-savings>-{{ cart.totalSavings | money }}</span>
        </div>
        <div class="flex items-baseline justify-between">
          <span class="text-[13px] font-body-ar" style="color: var(--color-text-secondary);">{{t('pages.cart.total')}}</span>
          <span class="text-xl font-heading-ar" style="color: var(--color-text-primary); font-weight: 500;" data-cart-total>{{ cart.totalPrice | money }}</span>
        </div>
      </div>

      {# Actions #}
      <div class="px-5 pb-5 flex flex-col gap-3">
        <p x-show="checkoutBlocked" x-cloak class="attar-citem-note text-center" role="alert">{{t('pages.cart.stock_blocked')}}</p>
        <a href="/checkout"
           @click="goCheckout($event)"
           :aria-disabled="checkoutBlocked ? 'true' : 'false'"
           :class="{ 'opacity-50 cursor-not-allowed': checkoutBlocked }"
           class="anaqa-drawer-checkout font-body-ar">
          {{t('pages.cart.checkout')}}
          <svg class="w-4 h-4 {% if localization.language != 'en' %}rotate-180{% endif %}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href="/cart"
           @click="$store.modal.close()"
           class="anaqa-btn w-full font-body-ar" style="padding-top: 14px; padding-bottom: 14px;">
          {{t('pages.cart.view_cart') | default('عرض السلة')}}
        </a>
      </div>
    </div>

    {# ===== Empty State ===== #}
    <div class="flex-1 flex flex-col items-center justify-center px-8 text-center" data-cart-empty
         style="{% if cart.items | length %}display:none{% endif %}">
      <div class="w-16 h-16 mb-6 flex items-center justify-center" style="background: var(--color-bg-secondary);">
        <svg class="w-8 h-8" fill="none" stroke="var(--color-text-tertiary)" viewBox="0 0 24 24" style="opacity: 0.5;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
      </div>
      <h3 class="text-[16px] font-heading-ar mb-2" style="color: var(--color-text-primary); font-weight: 500;">{{t('cart.empty')}}</h3>
      <p class="text-[13px] leading-relaxed max-w-[220px] mb-8 font-body-ar" style="color: var(--color-text-secondary);">{{t('cart.empty_message')}}</p>
      <a href="/" @click="$store.modal.close()" class="anaqa-btn font-body-ar">
        {{t('cart.continue_shopping')}}
      </a>
    </div>
  </div>
</div>

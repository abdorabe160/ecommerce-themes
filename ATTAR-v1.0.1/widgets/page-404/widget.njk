{# ===== ATTAR 404 Page — Fragrance house ===== #}
{% set title = widget.data.title | default(t('pages.404.title'), true) %}
{% set message = widget.data.message | default(t('pages.404.message'), true) %}

<style>
  .anaqa-404-wrap {
    padding: 120px 0 140px;
    background: var(--color-bg-primary);
  }
  @media (max-width: 639px) {
    .anaqa-404-wrap { padding: 80px 0 96px; }
  }
  .anaqa-404-number {
    font-family: var(--font-heading-en);
    font-size: clamp(96px, 20vw, 220px);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--color-accent);
    user-select: none;
  }
</style>

<section id="{{ widget.id }}" class="anaqa-404-wrap">
  <div class="container mx-auto px-6 max-sm:px-4">
    <div class="max-w-xl mx-auto text-center">

      {# ── Editorial label ── #}
      <span class="editorial-label block mb-8">{{ t('pages.404.eyebrow') | default('Error 404') }}</span>

      {# ── Big serif number ── #}
      <div class="mb-10" aria-hidden="true">
        <span class="anaqa-404-number">404</span>
      </div>

      {# ── Hairline divider ── #}
      <span class="block w-14 mx-auto mb-10" style="height:1px; background: var(--color-border);"></span>

      {# ── Title ── #}
      <h1 class="font-heading-ar mb-5" style="color: var(--color-text-primary); font-weight: 500; font-size: clamp(1.75rem, 4vw, 2.5rem); line-height: 1.2;">
        {{ title | safe }}
      </h1>

      {# ── Message ── #}
      <p class="font-body-ar leading-[1.9] mb-12 mx-auto" style="max-width: 44ch; color: var(--color-text-secondary); font-size: 15px;">
        {{ message | safe }}
      </p>

      {# ── Actions ── #}
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="{{ widget.data.home_url | default('/') }}" class="anaqa-btn font-body-ar">
          {{ t('pages.404.back_home') | default('العودة للرئيسية') }}
        </a>
        <a href="/shop" class="editorial-link font-body-ar inline-flex items-center min-h-[44px]" style="font-size: 14px; color: var(--color-text-secondary);">
          {{ t('pages.404.browse_shop') | default('تصفح المتجر') }}
        </a>
      </div>

    </div>
  </div>
</section>

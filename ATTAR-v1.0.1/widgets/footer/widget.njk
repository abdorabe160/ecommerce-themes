{# ===== ATTAR FOOTER — Fragrance house · gold accents ===== #}
{% set cText = 'var(--color-footer-text)' %}
{% set cHeading = 'var(--color-footer-heading)' %}
{% set cMuted = 'var(--color-footer-text-muted)' %}
{% set cBorder = 'var(--color-footer-border)' %}

{% set logo = widget.data.footer_logo %}
{% set description = widget.data.footer_description %}
{% set menu1Title = widget.data.footer_menu_1_title %}
{% set menu1 = widget.data.footer_menu_1 %}
{% set menu2Title = widget.data.footer_menu_2_title %}
{% set menu2 = widget.data.footer_menu_2 %}
{# Two columns bound to the same menu would repeat every link — show it once #}
{% if menu1 and menu2 and (menu1 | dump) == (menu2 | dump) %}{% set menu2 = null %}{% endif %}
{# an empty menu hides its column, heading included #}
{% if menu1 and not (menu1 | length) %}{% set menu1 = null %}{% endif %}
{% if menu2 and not (menu2 | length) %}{% set menu2 = null %}{% endif %}
{# a link to a page the store may not have is a 500: shown only when the merchant sets it #}
{% set privacyUrl = widget.data.privacy_url %}
{% set termsUrl = widget.data.terms_url %}
{% set socialX = widget.data.footer_social_x %}
{% set socialInstagram = widget.data.footer_social_instagram %}
{% set socialTiktok = widget.data.footer_social_tiktok %}
{% set socialSnapchat = widget.data.footer_social_snapchat %}
{% set socialFacebook = widget.data.footer_social_facebook %}
{% set socialYoutube = widget.data.footer_social_youtube %}
{% set socialWhatsapp = widget.data.footer_social_whatsapp %}
{% set hasSocial = socialX or socialInstagram or socialTiktok or socialSnapchat or socialFacebook or socialYoutube or socialWhatsapp %}

<style>
  .anaqa-footer { background: var(--color-footer); border-top: 1px solid color-mix(in srgb, var(--color-accent) 20%, transparent); }

  .anaqa-foot-logo {
    font-family: var(--font-heading-en);
    font-weight: 600;
    font-size: 1.9rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-accent);
    line-height: 1;
    padding-inline-start: 0.28em;
  }
  html[dir="rtl"] .anaqa-foot-logo { font-family: var(--font-heading-ar); letter-spacing: 0; text-transform: none; padding-inline-start: 0; }

  .anaqa-foot-heading {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-footer-heading);
  }
  html[dir="rtl"] .anaqa-foot-heading { letter-spacing: 0.02em; text-transform: none; font-size: 13px; }

  .anaqa-foot-link { transition: color 0.25s ease; text-decoration: none; }

  .anaqa-foot-social {
    width: 44px; height: 44px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    border: 1px solid var(--color-footer-border);
    color: var(--color-footer-text);
    transition: color 0.3s ease, border-color 0.3s ease;
  }
  .anaqa-foot-social:hover { color: var(--color-accent); border-color: var(--color-accent); }

  @media (max-width: 639px) { .anaqa-foot-logo { font-size: 1.5rem; } .anaqa-foot-social { width: 44px; height: 44px; } }
</style>

<footer class="anaqa-footer">
  <div class="container mx-auto px-6 max-sm:px-4">

    {# ——— Main ——— #}
    <div class="pt-20 pb-14 max-sm:pt-14 max-sm:pb-10">
      <div class="flex flex-col lg:flex-row gap-16 max-sm:gap-10 lg:justify-between">

        {# Brand Column #}
        <div class="flex flex-col gap-6 max-w-sm">
          {% if logo and logo.fileUrl %}
            <a href="/" class="inline-block w-fit">
              <img src="{{ logo.fileUrl }}" alt="{{ store.name }}" class="h-10 w-auto object-contain"/>
            </a>
          {% else %}
            <a href="/" class="anaqa-foot-logo inline-block w-fit" title="{{ store.name | default('ATTAR') }}">{% ui "store-name.njk" %}</a>
          {% endif %}

          {% if description %}
            <p class="text-[14px] leading-[1.9] font-body-ar" style="color: {{ cText }}; max-width: 42ch;">{{ description | safe }}</p>
          {% endif %}

          {% if hasSocial %}
            <div class="flex flex-wrap items-center gap-2.5 mt-2">
              {% if socialInstagram %}<a href="{{ socialInstagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="anaqa-foot-social"><svg class="w-[17px] h-[17px]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" stroke-linecap="round"/><circle cx="12" cy="12" r="5" stroke-linecap="round"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>{% endif %}
              {% if socialX %}<a href="{{ socialX }}" target="_blank" rel="noopener noreferrer" aria-label="X" class="anaqa-foot-social"><svg class="w-[15px] h-[15px]" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>{% endif %}
              {% if socialTiktok %}<a href="{{ socialTiktok }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="anaqa-foot-social"><svg class="w-[15px] h-[15px]" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.34-6.34V8.87a8.16 8.16 0 004.76 1.52v-3.4a4.85 4.85 0 01-1-.3z"/></svg></a>{% endif %}
              {% if socialSnapchat %}<a href="{{ socialSnapchat }}" target="_blank" rel="noopener noreferrer" aria-label="Snapchat" class="anaqa-foot-social"><svg class="w-[15px] h-[15px]" viewBox="0 0 24 24" fill="currentColor"><path d="M12.206.793c.99 0 4.347.276 5.93 3.821.529 1.193.403 3.219.299 4.847l-.003.06c-.012.18-.022.345-.03.51.075.045.203.09.401.09.3-.016.659-.12.922-.214.14-.05.273-.096.395-.13a.93.93 0 01.268-.04c.326 0 .598.164.724.439.167.366-.024.75-.192.99-.06.088-.227.28-.439.413-.232.143-.588.283-1.073.283-.2 0-.42-.026-.65-.079a1.42 1.42 0 00-.268-.03c-.078 0-.147.01-.205.03-.138.047-.257.164-.377.403-.188.37-.36.755-.637 1.064-.372.416-.84.73-1.412.948-.21.08-.437.152-.674.215.012.047.044.103.103.173.128.148.35.283.475.355.064.04.135.084.19.12.315.2.587.43.657.715.038.148.023.297-.04.438-.108.237-.32.406-.535.504-.36.164-.79.235-1.28.235-.33 0-.654-.04-.913-.082a3.98 3.98 0 00-.634-.06c-.078 0-.173.01-.27.03-.2.04-.41.157-.627.302-.42.282-.888.622-1.619.622s-1.2-.34-1.619-.622a2.89 2.89 0 00-.627-.302c-.098-.02-.19-.03-.27-.03-.21 0-.44.02-.635.06-.258.04-.582.082-.913.082-.49 0-.92-.07-1.28-.235a1.04 1.04 0 01-.534-.504.65.65 0 01-.04-.438c.07-.284.342-.515.657-.715.055-.036.126-.08.19-.12.125-.072.347-.207.475-.355.06-.07.09-.126.103-.173a6.04 6.04 0 01-.674-.215c-.572-.218-1.04-.532-1.412-.948-.277-.309-.449-.694-.637-1.064-.12-.24-.24-.356-.377-.403a.575.575 0 00-.205-.03 1.42 1.42 0 00-.268.03c-.23.053-.45.079-.65.079-.485 0-.84-.14-1.073-.283a1.87 1.87 0 01-.44-.414c-.166-.24-.358-.623-.191-.989.127-.275.4-.44.724-.44a.93.93 0 01.268.04c.122.035.255.08.395.131.263.094.622.23.922.214.199 0 .326-.045.401-.09a6.37 6.37 0 01-.03-.51l-.003-.06c-.104-1.628-.23-3.654.3-4.847C7.859 1.069 11.216.793 12.206.793z"/></svg></a>{% endif %}
              {% if socialFacebook %}<a href="{{ socialFacebook }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="anaqa-foot-social"><svg class="w-[15px] h-[15px]" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></a>{% endif %}
              {% if socialYoutube %}<a href="{{ socialYoutube }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="anaqa-foot-social"><svg class="w-[15px] h-[15px]" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg></a>{% endif %}
              {% if socialWhatsapp %}<a href="{{ socialWhatsapp }}" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="anaqa-foot-social"><svg class="w-[15px] h-[15px]" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/></svg></a>{% endif %}
            </div>
          {% endif %}
        </div>

        {# Navigation Menus #}
        {% if menu1 or menu2 %}
          <div class="flex gap-20 max-lg:gap-14 max-sm:gap-10 max-sm:flex-col flex-shrink-0">
            {% if menu1 %}
              <nav class="flex flex-col min-w-[140px]">
                <h4 class="anaqa-foot-heading font-body-ar mb-5">{{ menu1Title | safe }}</h4>
                <ul class="flex flex-col gap-3.5 max-lg:gap-0">
                  {% for item in menu1 %}
                    <li><a href="{{ item.url | default('#') }}" class="anaqa-foot-link text-[14px] font-body-ar" style="color: {{ cText }};" onmouseenter="this.style.color='var(--color-footer-heading)'" onmouseleave="this.style.color='{{ cText }}'">{{ item.title | safe }}</a></li>
                    {# sub-items arrive under `item.menu` (measured), not `children` #}
                    {% for s in (item.menu or item.children or []) %}
                      <li><a href="{{ s.url | default('#') }}" class="anaqa-foot-link attar-foot-sublink text-[13px] font-body-ar" style="color: {{ cText }};">{{ s.title | safe }}</a></li>
                    {% endfor %}
                  {% endfor %}
                </ul>
              </nav>
            {% endif %}
            {% if menu2 %}
              <nav class="flex flex-col min-w-[140px]">
                <h4 class="anaqa-foot-heading font-body-ar mb-5">{{ menu2Title | safe }}</h4>
                <ul class="flex flex-col gap-3.5 max-lg:gap-0">
                  {% for item in menu2 %}
                    <li><a href="{{ item.url | default('#') }}" class="anaqa-foot-link text-[14px] font-body-ar" style="color: {{ cText }};" onmouseenter="this.style.color='var(--color-footer-heading)'" onmouseleave="this.style.color='{{ cText }}'">{{ item.title | safe }}</a></li>
                    {# sub-items arrive under `item.menu` (measured), not `children` #}
                    {% for s in (item.menu or item.children or []) %}
                      <li><a href="{{ s.url | default('#') }}" class="anaqa-foot-link attar-foot-sublink text-[13px] font-body-ar" style="color: {{ cText }};">{{ s.title | safe }}</a></li>
                    {% endfor %}
                  {% endfor %}
                </ul>
              </nav>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>

    {# ——— Bottom Bar ——— #}
    <div class="py-7 max-sm:py-5 flex items-center justify-between max-sm:flex-col max-sm:gap-4" style="border-top: 1px solid {{ cBorder }};">
      <p class="text-[12px] tracking-wide font-body-ar" style="color: {{ cMuted }};">
        &copy; <span id="anaqa-foot-year">2026</span> {% ui "store-name.njk" %}. {{ t('footer.rights') | default('جميع الحقوق محفوظة') }}
      </p>
      <div class="flex items-center gap-8 max-sm:gap-6 flex-wrap justify-center">
        {% if privacyUrl %}<a href="{{ privacyUrl }}" class="anaqa-foot-link text-[12px] font-body-ar" style="color: {{ cMuted }};" onmouseenter="this.style.color='var(--color-footer-heading)'" onmouseleave="this.style.color='{{ cMuted }}'">{{ t('footer.privacy') | default('سياسة الخصوصية') }}</a>{% endif %}
        {% if termsUrl %}<a href="{{ termsUrl }}" class="anaqa-foot-link text-[12px] font-body-ar" style="color: {{ cMuted }};" onmouseenter="this.style.color='var(--color-footer-heading)'" onmouseleave="this.style.color='{{ cMuted }}'">{{ t('footer.terms') | default('الشروط والأحكام') }}</a>{% endif %}
      </div>
    </div>

  </div>
  <script>(function(){var y=document.getElementById('anaqa-foot-year');if(y)y.textContent=new Date().getFullYear();})();</script>
</footer>

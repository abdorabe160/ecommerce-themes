{# ===== ATTAR Single Blog Widget ===== #}
{% set article = widget.data.articles %}

{% if article %}
  <section id="{{ widget.id }}" class="py-12 md:py-16" style="background: var(--color-bg-primary);">
    <div class="max-w-md mx-auto px-4 sm:px-6">
      <a href="/articles/{{ article.slug or article.handle }}" class="group flex flex-col font-body-ar" style="text-decoration: none;">

        {# ——— Media ——— #}
        <div class="relative aspect-[4/3] w-full overflow-hidden" style="background: var(--color-bg-secondary);">
          {% if article.image and article.image.fileUrl %}
            <img src="{{ article.image.fileUrl }}"
                 alt="{{ article.title }}"
                 class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1100ms] ease-out group-hover:scale-[1.04]"
                 style="filter: saturate(1.03) contrast(1.02);"
                 loading="lazy">
          {% else %}
            <div class="attar-mark" aria-hidden="true"></div>
          {% endif %}
        </div>

        {# ——— Caption ——— #}
        <div class="flex flex-col mt-5">
          {% if article.createdAt %}
            <span class="text-[11px] tabular-nums mb-3" style="color: var(--color-text-tertiary);">{{ article.createdAt | date('yyyy-MM-dd') }}</span>
          {% endif %}

          <h3 class="font-heading-ar text-[19px] leading-snug line-clamp-2 transition-colors duration-300 [color:var(--color-text-primary)] group-hover:[color:var(--color-accent)]"
              style="font-weight: 600;">
            {{ article.title }}
          </h3>

          <span class="mt-4 inline-flex items-center gap-1.5 self-start pb-[3px] text-[12px] font-medium border-b border-solid transition-colors duration-300 [color:var(--color-text-primary)] [border-color:var(--color-border)] group-hover:[color:var(--color-accent)] group-hover:[border-color:var(--color-accent)]">
            {{ t('pages.blog.read_more') | default('اقرئي المزيد') }}
            <svg class="w-3.5 h-3.5 rtl:rotate-180 transition-transform duration-300 group-hover:translate-x-1 rtl:group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </span>
        </div>
      </a>
    </div>
  </section>
{% else %}
  <div class="text-center py-12">
    <p class="text-sm font-body-ar" style="color: var(--color-text-tertiary);">{{ t('pages.blog.no_articles') | default('لا توجد مقالات') }}</p>
  </div>
{% endif %}

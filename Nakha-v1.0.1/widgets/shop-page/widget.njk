{# ============================================================================
   NAKHA SHOP PAGE — the browsing shell for /shop, /shop/:handle and /shop?q=
   ----------------------------------------------------------------------------
   ⚠️  This widget is only the CHROME. The product grid itself is rendered by
   the `shop-products` widget, which Qumra injects into
   #products-grid-wrapper[data-qumra-section="shop-products"].

   ⚠️  CONTRACT with collectionFilter() in assets/main.js — do not rename:
     · x-data="collectionFilter({ section: 'shop-products', … })"
     · #products-grid-wrapper  → where the section is mounted
     · #products-count         → filled from #products-count-data after a run
     · state used here: loading · filtersOpen · sortOpen · currentSort
                        priceMin/priceMax · activeCount · collectionId
                        sortBy() · clearFilters() · setCollection() · goToPage()
   Translations are NOT dumped here any more — main.js falls back to the shared
   strings in __QUMRA_CONFIG__.card.
   ========================================================================= #}

{% set id = widget.id %}
{% set d = widget.data %}

{% set collections = context.collections | default([]) %}
{# live stores put the current collection in context.shop.collection #}
{% set curColl = context.shop.collection if context.shop and context.shop.collection else context.collection %}
{% set filters = context.shop.filters.available if context.shop and context.shop.filters else context.filters | default([]) %}
{% set lang = localization.language | default('ar') %}

{# ---------------------------------------------------------------------------
   filterLabels — a handle → value → label map handed to collectionFilter() so
   the removable chips above the grid can read "أزرق" instead of "#1B6BFF".
   Built by a macro rather than inline in the x-data attribute: the label may be
   a plain string OR a lang-keyed object, and resolving that with a ternary
   inside an HTML attribute is exactly where operator precedence bites.
   Values go through `| dump` so a label containing a quote can't break the JS.
   --------------------------------------------------------------------------- #}
{% macro buildFilterLabels(filters, lang) %}
  {%- for filter in filters -%}
    {%- if filter.inputType != 'range' -%}
      {%- set items = filter.items | default(filter.values) | default([]) -%}
      {#- a filter without a key would print `: {…}` and kill the whole x-data object -#}
      {%- set fkey = filter.handle or filter.key -%}
      {%- if fkey and (items | length) > 0 -%}
        {{ (fkey or '') | dump | safe }}: {
        {%- for item in items -%}
          {%- if item.label is string -%}
            {%- set lab = item.label -%}
          {%- else -%}
            {%- set lab = item.label[lang] | default(item.label.ar) | default(item.label.en) | default(item.value) -%}
          {%- endif -%}
          {{ (item.value or '') | dump | safe }}: {{ (lab or '') | dump | safe }},
        {%- endfor -%}
        },
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{% endmacro %}
{% set filterLabelsJs = buildFilterLabels(filters, lang) %}

{% set showBreadcrumb = d.show_breadcrumb | default(true) %}
{% set showRail = d.show_collection_rail | default(true) %}
{% set sidebarCollections = d.show_sidebar_collections | default(false) %}
{% set showSort = d.show_sort | default(true) %}
{% set showFilters = (d.show_filters | default(true)) and (filters | length) > 0 %}

{% set colsD = d.columns_desktop | default('4', true) %}
{% set colsM = d.columns_mobile | default('2', true) %}
{% set ratio = d.card_image_ratio | default('1x1', true) %}

{# the collection page reuses this widget — its title wins over the setting #}
{% set pageTitle = curColl.title if curColl and curColl.title else (d.title | default(t('pages.shop.all_products'), true)) %}
{% set pageDesc = curColl.description if curColl and curColl.description else (d.description | default('')) %}

{# Range filter handles drive priceMin/priceMax in the Alpine component. They are
   emitted as a JS array inline in the x-data below (see `rangeHandles`).
   The previous version captured a single handle in a loop, which picked the LAST
   range filter; the component now takes the FIRST, so the topmost slider in the
   panel — the one a shopper reads as "price" — is the one actually applied.
   ⚠️  Known gap: ui/filter-panel.njk renders a slider per range filter but they
   all bind to the same priceMin/priceMax pair, so a second range filter moves
   with the first. Needs per-handle state in collectionFilter() to fix properly. #}

{# tablet sits one step below desktop, floored at 3 #}
{% set colsInt = colsD | int %}
{% set colsTablet = 3 if colsInt > 3 else colsInt %}


<style>
  .nakha-shop-{{ id }}-title {
    margin: 0;
    font-family: var(--font-display-ar);
    font-size: clamp(1.625rem, 3.4vw, 2.375rem);
    font-weight: 700;
    line-height: 1.24;
    letter-spacing: normal;
    color: var(--color-text-primary);
    text-transform: var(--display-case);
  }
  html[dir="ltr"] .nakha-shop-{{ id }}-title {
    font-family: var(--font-display-en);
    font-weight: 400;
    letter-spacing: 0.01em;
  }
  html[dir="rtl"] .nakha-shop-{{ id }}-title { line-height: 1.34; letter-spacing: normal; }

  /* sort dropdown
     Border AND shadow. On the cream ground the warm shadow does read (unlike
     the dark theme this started as, where only the border did), but a floating
     panel over a cream page still needs an edge or it blends into the section
     behind it — the two together are what separate it. */
  .nakha-shop-{{ id }}-sortmenu {
    min-width: 220px;
    padding: 6px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
  }
  .nakha-shop-{{ id }}-sortmenu button {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 14px;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text-secondary);
    font-family: inherit;
    font-size: 0.875rem;
    text-align: start;
    cursor: pointer;
    transition: background var(--t-fast) var(--ease-soft), color var(--t-fast) var(--ease-soft);
  }
  .nakha-shop-{{ id }}-sortmenu button:hover { background: var(--color-surface-alt); color: var(--color-text-primary); }
  /* Plain --color-appetite, not the -dark variant: the panel background is
     --color-bg-secondary (white), where the brand red already clears AA. */
  .nakha-shop-{{ id }}-sortmenu button.is-active { color: var(--color-appetite); font-weight: 700; }

  /* the grid fades while a filter request is in flight */
  .nakha-shop-{{ id }}-results { transition: opacity var(--t-base) var(--ease-soft); }
  .nakha-shop-{{ id }}-results.is-loading { opacity: 0.4; pointer-events: none; }
</style>


{# ============================================================================
   The collectionFilter config lives in a <script>, NOT inline in x-data.
   ----------------------------------------------------------------------------
   ⚠️  Anything merchant-authored — a collection title, a filter label — can
   contain a quote. Inside x-data="…" the first double quote CLOSES the HTML
   attribute: Alpine then never parses the component, collectionFilter never
   runs, qumra.filters.section() is never called, and the shop page renders a
   working sidebar beside a permanently empty grid with no console error that
   points at the cause. `| dump` emits double quotes, so it is only ever safe
   inside a script block. Keep this config here.
   ========================================================================= #}
<script>
  window.__nakhaShopCfg_ = {
    collectionId: {{ (curColl._id if curColl and curColl._id else '') | dump | safe }},
    section: 'shop-products',
    rangeHandles: [
      {%- for filter in filters -%}
        {%- if filter.inputType == 'range' -%}{{ (filter.handle or '') | dump | safe }},{%- endif -%}
      {%- endfor -%}
    ],
    collections: [
      {%- for col in collections -%}
        { id: {{ (col._id or '') | dump | safe }}, slug: {{ (col.slug or col.handle or '') | dump | safe }}, title: {{ (col.title or '') | dump | safe }} },
      {%- endfor -%}
    ],
    cardSettings: {
      cols: { desktop: {{ colsInt | default(4, true) }}, tablet: {{ colsTablet | default(3, true) }}, mobile: {{ colsM | int }} },
      imageRatio: {{ ratio | dump | safe }}
    },
    filterLabels: { {{ filterLabelsJs }} }
  };
</script>

<section id="nakha-shop-{{ id }}" class="nakha-section"
         x-data="collectionFilter(window.__nakhaShopCfg_)">

  <div class="nakha-container">

    {# ═════════════════ breadcrumb ═════════════════ #}
    {% if showBreadcrumb %}
      <nav class="flex items-center gap-2 flex-wrap mb-6 nakha-caption" aria-label="breadcrumb">
        <a href="/" class="hover:text-flame transition-colors">{{ t('common.home') }}</a>
        <svg class="nakha-flip shrink-0" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="opacity:.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/>
        </svg>
        {% if curColl and curColl.title %}
          <a href="/shop" class="hover:text-flame transition-colors">{{ t('pages.shop.title') }}</a>
          <svg class="nakha-flip shrink-0" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="opacity:.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/>
          </svg>
          <span style="color: var(--color-text-secondary);">{{ curColl.title }}</span>
        {% else %}
          <span style="color: var(--color-text-secondary);">{{ t('pages.shop.title') }}</span>
        {% endif %}
      </nav>
    {% endif %}

    {# ═════════════════ header ═════════════════ #}
    <div class="flex flex-col gap-4 mb-8">
      <h1 class="nakha-shop-{{ id }}-title">
        <span x-show="!searchQuery">{{ pageTitle }}</span>
        <span x-show="searchQuery" x-cloak>
          {{ t('pages.search.results_for') }}
          <span style="color: var(--color-appetite);" x-text="'“' + searchQuery + '”'"></span>
        </span>
      </h1>

      {% if pageDesc %}
        <p class="nakha-lead m-0" style="max-width: 62ch;">{{ pageDesc | safe }}</p>
      {% endif %}

      {# No search field here. The header already carries search on every page —
         a second one on the shop page is the same control twice on one screen,
         and the shopper who wants to search has already learned where it lives.
         `searchQuery` still drives the heading above, so arriving from the
         header's search with ?q=… reads correctly. #}
    </div>

    {# ═════════════════ collection rail ═════════════════ #}
    {% if showRail and (collections | length) > 0 %}
      <div class="nakha-rail mb-7">
        <button type="button" class="nakha-chip" :class="!collectionId && 'is-active'"
                @click="setCollection('', '')">
          {{ t('pages.shop.all_products') }}
        </button>
        {% for col in collections %}
          {% if col.title and not col.deleted and not (col.salesChannels and col.salesChannels.onlineStore == false) %}
          <button type="button" class="nakha-chip"
                  :class="collectionId === '{{ col._id }}' && 'is-active'"
                  @click="setCollection('{{ col._id }}', '{{ col.slug or col.handle or '' }}')">
            {{ col.title }}
          </button>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {# ═════════════════ body ═════════════════ #}
    <div class="flex items-start gap-9">

      {% if showFilters %}
        {% ui "filter-panel.njk", variant='sidebar', filters=filters, collections=collections, show_collections=sidebarCollections %}
      {% endif %}

      {# `view` is deliberately LOCAL to this column, not part of collectionFilter:
         it changes nothing about the query, so it must not survive into a filter
         request or force a refetch. The class lands on a wrapper ABOVE the
         results div, so it keeps applying to markup main.js re-renders. #}
      <div class="flex-1 min-w-0"
           x-data="{ view: 'grid' }"
           x-init="view = (localStorage.getItem('nakha-shop-view') === 'list') ? 'list' : 'grid'">

        {# ---------- toolbar ---------- #}
        <div class="flex items-center justify-between gap-3 flex-wrap mb-4">

          <div class="flex items-center gap-2.5 min-w-0">
            {% if showFilters %}
              <button type="button" @click="filtersOpen = true"
                      class="nakha-btn nakha-btn--outline nakha-btn--sm nakha-only-lg">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
                     stroke-linecap="round">
                  <path d="M3.5 6.5h17M6.5 12h11M10 17.5h4"/>
                </svg>
                {{ t('pages.collection.filter') }}
                <span class="nakha-badge nakha-badge--appetite" x-show="activeCount > 0" x-cloak
                      x-text="activeCount"></span>
              </button>
            {% endif %}

            {# results count — the sidebar copy only exists when filters are on,
               so this one carries it whatever the configuration #}
            <span class="nakha-caption" x-show="!loading" id="products-count-toolbar"></span>

            <span class="nakha-caption inline-flex items-center gap-2" x-show="loading" x-cloak>
              <span class="nakha-spinner" style="width: 14px; height: 14px; border-width: 1.5px;"></span>
              {{ t('common.loading') }}
            </span>
          </div>

          <div class="flex items-center gap-2 shrink-0">

          {% if showSort %}
            <div class="relative" @click.outside="sortOpen = false">
              <button type="button" @click="sortOpen = !sortOpen"
                      class="nakha-btn nakha-btn--outline nakha-btn--sm"
                      :aria-expanded="sortOpen">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
                     stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 4v16m0 0-3-3m3 3 3-3M17 20V4m0 0-3 3m3-3 3 3"/>
                </svg>
                {{ t('search.sort_by') }}
              </button>

              <div x-show="sortOpen" x-cloak
                   x-transition:enter="transition ease-out duration-200"
                   x-transition:enter-start="opacity-0 -translate-y-1"
                   x-transition:enter-end="opacity-100 translate-y-0"
                   class="absolute top-full mt-2 end-0 z-50 nakha-shop-{{ id }}-sortmenu">
                {# written out flat on purpose — an array of object literals in
                   {% set %} is another construct with no precedent in this theme #}
                {% macro sortItem(value, label) %}
                  <button type="button"
                          :class="currentSort === '{{ value }}' && 'is-active'"
                          @click="sortBy('{{ value }}')">
                    <span>{{ label }}</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
                         x-show="currentSort === '{{ value }}'">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4 12.5 9.5 18 20 6.5"/>
                    </svg>
                  </button>
                {% endmacro %}
                {{ sortItem('newest',        t('search.newest')) }}
                {{ sortItem('price_asc',     t('search.price_low_high')) }}
                {{ sortItem('price_desc',    t('search.price_high_low')) }}
                {{ sortItem('highest_rated', t('search.highest_rated')) }}
              </div>
            </div>
          {% endif %}

          {# ---------- grid / list switch ---------- #}
          <div class="nakha-btn-group nakha-hide-sm" role="group" aria-label="{{ t('pages.shop.view_mode') }}">
            <button type="button"
                    :aria-pressed="view === 'grid'"
                    :class="view === 'grid' && 'is-active'"
                    @click="view = 'grid'; localStorage.setItem('nakha-shop-view', 'grid')"
                    aria-label="{{ t('pages.shop.view_grid') }}">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
                <rect x="3.5" y="3.5" width="7" height="7" rx="1.4"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.4"/>
                <rect x="3.5" y="13.5" width="7" height="7" rx="1.4"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.4"/>
              </svg>
            </button>
            <button type="button"
                    :aria-pressed="view === 'list'"
                    :class="view === 'list' && 'is-active'"
                    @click="view = 'list'; localStorage.setItem('nakha-shop-view', 'list')"
                    aria-label="{{ t('pages.shop.view_list') }}">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
                <rect x="3.5" y="4.5" width="17" height="5.5" rx="1.4"/><rect x="3.5" y="14" width="17" height="5.5" rx="1.4"/>
              </svg>
            </button>
          </div>

          </div>
        </div>

        {# ---------- active filter chips ----------
             `activeChips` is a getter on collectionFilter; the labels come from
             the filterLabels map built at the top of this file. #}
        <div class="flex items-center gap-2 flex-wrap mb-4"
             x-show="activeChips.length > 0" x-cloak>
          <template x-for="chip in activeChips" :key="chip.handle + ':' + chip.value">
            <span class="nakha-fchip">
              <span x-text="chip.label"></span>
              <button type="button"
                      @click="toggleFilter(chip.handle, chip.value)"
                      :aria-label="chip.label">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
              </button>
            </span>
          </template>

          <button type="button" @click="clearFilters()" class="nakha-btn nakha-btn--ghost nakha-btn--xs">
            {{ t('pages.collection.clear_filters') }}
          </button>
        </div>

        {# ---------- results ----------
             Qumra mounts the `shop-products` widget inside #products-grid-wrapper.
             Do not put anything else in THAT div — a re-render replaces its
             contents. The view class sits on the wrapper above it, so switching
             to list mode survives every AJAX repaint. #}
        <div class="nakha-shop-{{ id }}-results"
             :class="[loading && 'is-loading', view === 'list' && 'nakha-list-view']">
          <div id="products-grid-wrapper" data-qumra-section="shop-products"></div>
        </div>

      </div>
    </div>
  </div>

  {# ═════════════════ mobile filter drawer ═════════════════ #}
  {% if showFilters %}
    {% ui "filter-panel.njk", variant='drawer', filters=filters, collections=collections, show_collections=sidebarCollections %}
  {% endif %}
</section>

{# Per-section palette. Emits nothing at all unless `colors_enabled` is on, so
   the switch IS the revert. Must stay after the widget's own <style> — see the
   partial's header for why. #}
{% ui "section-colors.njk", scope='#nakha-shop-' ~ id, c=d %}

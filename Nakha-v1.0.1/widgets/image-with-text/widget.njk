{# ============================================================================
   NAKHA IMAGE WITH TEXT — the "why us" block
   ----------------------------------------------------------------------------
   Three layouts:
     split    image beside the text, both inside the container (default)
     overlap  a second image tucked over the corner of the first
     wide     the image runs off the container to the screen edge

   `point` blocks render either as a row of numbers (stats) or as a checklist.
   Stats use the shared .nakha-stat primitive, the same one the hero's strip is
   built from — so if BOTH are on a page they will look like one device repeated.
   That is why the home page sets this one to `checks`: the hero already owns the
   scoreboard, and a second row of big numbers halfway down reads as a template
   the merchant forgot to fill in differently.
   ========================================================================= #}

{% set id = widget.id %}
{% set d = widget.data %}
{% set points = widget.blocks | default([]) %}
{% set pointCount = points | length %}

{% set layout = d.layout | default('split', true) %}
{% set isOverlap = layout == 'overlap' %}
{% set isWide = layout == 'wide' %}

{% set imgPos = d.image_position | default('start', true) %}
{% set imgFirst = imgPos == 'start' %}

{% set img = d.image.fileUrl if d.image and d.image.fileUrl else '' %}
{% set img2 = d.image_2.fileUrl if d.image_2 and d.image_2.fileUrl else '' %}
{# Out of the box: a bundled demo photo until the merchant picks one (docs/demo-images.md) #}
{% if not img %}{% set img = 'demo-story-1.jpg' | assets %}{% endif %}
{% if not img2 %}{% set img2 = 'demo-story-2.jpg' | assets %}{% endif %}

{% set fit = d.image_fit | default('cover', true) %}
{% set ratio = d.image_ratio | default('4x5', true) %}
{% if ratio == '3x2' %}{% set ratioCls = 'nakha-ratio-3x2' %}
{% elif ratio == '1x1' %}{% set ratioCls = 'nakha-ratio-1x1' %}
{% elif ratio == '4x3' %}{% set ratioCls = 'nakha-ratio-4x3' %}
{% elif ratio == '3x4' %}{% set ratioCls = 'nakha-ratio-3x4' %}
{% else %}{% set ratioCls = 'nakha-ratio-4x5' %}{% endif %}

{% set eyebrow = d.eyebrow | default('') %}
{% set title = d.title | default('') %}
{% set text = d.text | default('') %}
{% set signature = d.signature | default('') %}

{% set btnText = d.button_text | default(t('defaults.about_us'), true) %}
{% set btnUrl = d.button_url | default('', true) %}
{% set btn2Text = d.button2_text | default(t('common.faq'), true) %}
{% set btn2Url = d.button2_url | default('', true) %}

{% set blocksStyle = d.blocks_style | default('stats', true) %}
{% set showPoints = blocksStyle != 'none' and pointCount > 0 %}
{% set isStats = blocksStyle == 'stats' %}

{% set bg = d.background | default('canvas', true) %}
{# `void` and `dark` are the same answer — a charcoal band. Both MUST set
   isDark, because that is what adds .nakha-invert; a charcoal ground without
   it is dark text on a dark panel. #}
{% set isDark = bg == 'dark' or bg == 'void' %}
{% if bg == 'surface' %}{% set bgVal = 'var(--color-surface)' %}
{% elif bg == 'well' %}{% set bgVal = 'var(--color-bg-tertiary)' %}
{% elif bg == 'alt' %}{% set bgVal = 'var(--color-section-b)' %}
{% elif bg == 'void' %}{% set bgVal = 'var(--color-char)' %}
{% elif isDark %}{% set bgVal = 'var(--color-char)' %}
{% else %}{% set bgVal = 'var(--color-bg-primary)' %}{% endif %}


<style>
  #nakha-iwt-{{ id }} { background: {{ bgVal }}; }

  /* ================= row ================= */
  .nakha-iwt-{{ id }}-row {
    display: grid;
    align-items: center;
    gap: 40px;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }
  @media (min-width: 1024px) {
    .nakha-iwt-{{ id }}-row { gap: 60px; }
  }
  @media (max-width: 1023px) {
    .nakha-iwt-{{ id }}-row { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    /* on one column the image always leads, whatever `image_position` says —
       a text block with no visual above it reads as a wall */
    .nakha-iwt-{{ id }}-media { order: -1; }
  }

  {% if not imgFirst %}
  @media (min-width: 1024px) {
    .nakha-iwt-{{ id }}-media { order: 2; }
    .nakha-iwt-{{ id }}-text { order: 1; }
  }
  {% endif %}

  {% if isWide %}
  /* the media column escapes the container on its own side only */
  @media (min-width: 1024px) {
    .nakha-iwt-{{ id }}-media {
      {% if imgFirst %}
      margin-inline-start: calc((100vw - min(100vw, var(--container-max))) / -2 - var(--container-px));
      {% else %}
      margin-inline-end: calc((100vw - min(100vw, var(--container-max))) / -2 - var(--container-px));
      {% endif %}
    }
  }
  {% endif %}

  /* ================= media ================= */
  .nakha-iwt-{{ id }}-media { position: relative; min-width: 0; }

  .nakha-iwt-{{ id }}-frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-media);
  }
  .nakha-iwt-{{ id }}-frame img {
    width: 100%;
    height: 100%;
    object-fit: {{ fit }};
    {% if fit == 'contain' %}padding: 8%;{% endif %}
  }

  {% if isOverlap and img2 %}
  /* the second image sits over the first's outer corner, with a ring in the
     section colour so the two never visually merge */
  .nakha-iwt-{{ id }}-frame2 {
    position: absolute;
    z-index: 2;
    width: 46%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius-card);
    border: 6px solid {{ bgVal }};
    background: var(--color-media);
    inset-block-end: -28px;
    inset-inline-end: -20px;
    box-shadow: var(--shadow-lg);
  }
  .nakha-iwt-{{ id }}-frame2 img { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 639px) {
    .nakha-iwt-{{ id }}-frame2 { width: 42%; inset-block-end: -18px; inset-inline-end: -10px; border-width: 4px; }
  }
  /* the overlap hangs below the frame — reserve the room so the next row
     never collides with it */
  .nakha-iwt-{{ id }}-media { padding-block-end: 34px; }
  {% endif %}

  .nakha-iwt-{{ id }}-noimg {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-border-strong);
  }

  /* ================= text ================= */
  .nakha-iwt-{{ id }}-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    min-width: 0;
  }

  .nakha-iwt-{{ id }}-body {
    margin: 0;
    max-width: 54ch;
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
  }
  .nakha-iwt-{{ id }}-body p { margin: 0 0 0.85em; }
  .nakha-iwt-{{ id }}-body p:last-child { margin-bottom: 0; }

  .nakha-iwt-{{ id }}-sig {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-text-tertiary);
  }

  /* ================= points ================= */
  .nakha-iwt-{{ id }}-stats {
    display: grid;
    grid-template-columns: repeat({{ 3 if pointCount > 3 else (pointCount if pointCount > 0 else 1) }}, minmax(0, 1fr));
    gap: 18px;
    width: 100%;
    padding-block-start: 4px;
  }
  @media (max-width: 480px) {
    .nakha-iwt-{{ id }}-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  /* a 1px rule between the numbers — the same device the features bar uses */
  .nakha-iwt-{{ id }}-stats > * + * {
    border-inline-start: 1px solid var(--color-border);
    padding-inline-start: 18px;
  }
  /* The shared stat primitive runs at hero scale; step it down here so a
     supporting block never outshouts the headline it sits under. */
  .nakha-iwt-{{ id }}-stats .nakha-stat-num { font-size: clamp(1.5rem, 2.4vw, 2rem); }

  .nakha-iwt-{{ id }}-check {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
  .nakha-iwt-{{ id }}-check svg {
    flex: none;
    margin-top: 3px;
    color: var(--color-basil);
  }
</style>


<section id="nakha-iwt-{{ id }}" class="nakha-section {{ 'nakha-invert' if isDark }}">
  <div class="nakha-container">
    <div class="nakha-iwt-{{ id }}-row">

      {# ═══════════════ media ═══════════════ #}
      <div class="nakha-iwt-{{ id }}-media">
        <div class="nakha-iwt-{{ id }}-frame {{ ratioCls }}">
          {% if img %}
            <img src="{{ img }}" alt="{{ title | default('', true) | replace('<br>', ' ') | striptags }}" loading="lazy"/>
          {% else %}
            <span class="nakha-iwt-{{ id }}-noimg">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
                <rect x="3" y="3" width="18" height="18" rx="3"/>
                <circle cx="8.75" cy="9" r="1.6"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="m4 17 5-4.5 4.5 4 3-2.5L21 18"/>
              </svg>
            </span>
          {% endif %}
        </div>

        {% if isOverlap and img2 %}
          <div class="nakha-iwt-{{ id }}-frame2">
            <img src="{{ img2 }}" alt="" loading="lazy"/>
          </div>
        {% endif %}
      </div>

      {# ═══════════════ text ═══════════════ #}
      <div class="nakha-iwt-{{ id }}-text">
        {% if eyebrow %}
          <span class="nakha-eyebrow">{{ eyebrow }}</span>
        {% endif %}

        {% if title %}
          <div class="nakha-h2">{{ title | safe }}</div>
        {% endif %}

        {% if text %}
          <div class="nakha-iwt-{{ id }}-body">{{ text | safe }}</div>
        {% endif %}

        {% if signature %}
          <span class="nakha-iwt-{{ id }}-sig">{{ signature }}</span>
        {% endif %}

        {# ---- points ---- #}
        {% if showPoints %}
          {% if isStats %}
            <div class="nakha-iwt-{{ id }}-stats">
              {% for block in points %}
                {% set pt = block.data %}
                {% if pt.number or pt.label %}
                  <div class="nakha-stat">
                    {% if pt.number %}<span class="nakha-stat-num">{{ pt.number }}</span>{% endif %}
                    {% if pt.label %}<span class="nakha-stat-label">{{ pt.label }}</span>{% endif %}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% else %}
            <div class="flex flex-col gap-3 w-full pt-1">
              {% for block in points %}
                {% set pt = block.data %}
                {% if pt.label %}
                  <span class="nakha-iwt-{{ id }}-check">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4 12.5 9.5 18 20 6.5"/>
                    </svg>
                    {{ pt.label }}
                  </span>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        {% endif %}

        {# ---- buttons ---- #}
        {% if (btnText and btnUrl) or (btn2Text and btn2Url) %}
          <div class="flex items-center gap-3 flex-wrap pt-1">
            {% if btnText and btnUrl %}
              <a href="{{ btnUrl }}" class="nakha-btn nakha-btn--primary">
                {{ btnText }}
                <svg class="nakha-flip" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/>
                </svg>
              </a>
            {% endif %}
            {% if btn2Text and btn2Url %}
              <a href="{{ btn2Url }}" class="nakha-btn nakha-btn--outline">{{ btn2Text }}</a>
            {% endif %}
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</section>

{# Per-section palette. Emits nothing unless `colors_enabled` is on — see the
   partial's header for why it has to sit after the widget's own <style>. #}
{% ui "section-colors.njk", scope='#nakha-iwt-' ~ id, c=d %}

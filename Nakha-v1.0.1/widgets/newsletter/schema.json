{
  "name": "النشرة البريدية",
  "settings": {
    "action_url": {
      "type": "string",
      "label": {
        "ar": "رابط استقبال البيانات (Mailchimp / Klaviyo / Google Forms) — بدونه لا يظهر النموذج",
        "en": "Form action URL (Mailchimp / Klaviyo / Google Forms) — without it the form is not rendered"
      },
      "default": ""
    },
    "email_field_name": {
      "type": "string",
      "label": {
        "ar": "اسم حقل البريد عند مزوّد الخدمة",
        "en": "Email field name at your provider"
      },
      "default": "EMAIL"
    },
    "open_in_new_tab": {
      "type": "boolean",
      "label": {
        "ar": "فتح الإرسال في تبويب جديد (يبقي الزائر في المتجر)",
        "en": "Submit in a new tab (keeps the visitor on the store)"
      },
      "default": true
    },
    "layout": {
      "type": "select",
      "label": {
        "ar": "التقسيم",
        "en": "Layout"
      },
      "default": "card",
      "options": [
        {
          "value": "card",
          "label": {
            "ar": "بطاقة داخل الصفحة",
            "en": "Inset card"
          }
        },
        {
          "value": "full",
          "label": {
            "ar": "شريط ممتد بعرض الشاشة",
            "en": "Full-width strip"
          }
        },
        {
          "value": "split",
          "label": {
            "ar": "صورة + نموذج",
            "en": "Image + form"
          }
        }
      ]
    },
    "background": {
      "type": "select",
      "label": {
        "ar": "الخلفية",
        "en": "Background"
      },
      "default": "void",
      "options": [
        {
          "value": "void",
          "label": {
            "ar": "فحمي",
            "en": "Charcoal"
          }
        },
        {
          "value": "appetite",
          "label": {
            "ar": "أحمر شهي",
            "en": "Appetite red"
          }
        },
        {
          "value": "canvas",
          "label": {
            "ar": "خلفية الموقع",
            "en": "Page background"
          }
        },
        {
          "value": "alt",
          "label": {
            "ar": "خلفية متبادلة",
            "en": "Alternating"
          }
        },
        {
          "value": "surface",
          "label": {
            "ar": "لون البطاقات",
            "en": "Card surface"
          }
        },
        {
          "value": "dark",
          "label": {
            "ar": "فحمي داكن — يقلب ألوان القسم",
            "en": "Charcoal — inverts the section"
          }
        }
      ]
    },
    "show_speed_motif": {
      "type": "boolean",
      "label": {
        "ar": "إظهار اللمسة الدافئة فوق الصورة",
        "en": "Show the Warm Glaze Over the Photo"
      },
      "default": true
    },
    "image": {
      "type": "media",
      "label": {
        "ar": "الصورة (لتقسيم «صورة + نموذج»)",
        "en": "Image (split layout)"
      }
    },
    "eyebrow": {
      "type": "string",
      "label": {
        "ar": "نص تمهيدي (فوق العنوان)",
        "en": "Eyebrow (above title)"
      },
      "default": ""
    },
    "title": {
      "type": "text",
      "label": {
        "ar": "العنوان — ضع <em>كلمة</em> لتلوينها",
        "en": "Title — wrap a word in <em> to tint it"
      },
      "default": ""
    },
    "subtitle": {
      "type": "text",
      "label": {
        "ar": "النص التوضيحي",
        "en": "Subtitle"
      },
      "default": ""
    },
    "placeholder": {
      "type": "string",
      "label": {
        "ar": "نص حقل البريد",
        "en": "Email Placeholder"
      },
      "default": ""
    },
    "button_text": {
      "type": "string",
      "label": {
        "ar": "نص الزر",
        "en": "Button Text"
      },
      "default": ""
    },
    "success_message": {
      "type": "string",
      "label": {
        "ar": "رسالة النجاح",
        "en": "Success Message"
      },
      "default": ""
    },
    "show_consent": {
      "type": "boolean",
      "label": {
        "ar": "إظهار مربّع الموافقة",
        "en": "Show Consent Checkbox"
      },
      "default": false
    },
    "show_note": {
      "type": "boolean",
      "label": {
        "ar": "إظهار ملاحظة الخصوصية",
        "en": "Show Privacy Note"
      },
      "default": false
    },
    "note_text": {
      "type": "string",
      "label": {
        "ar": "نص الملاحظة",
        "en": "Note Text"
      },
      "default": ""
    },
    "text_alignment": {
      "type": "select",
      "label": {
        "ar": "محاذاة النص",
        "en": "Text Alignment"
      },
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": {
            "ar": "وسط",
            "en": "Center"
          }
        },
        {
          "value": "start",
          "label": {
            "ar": "بداية السطر",
            "en": "Start"
          }
        }
      ]
    },
    "colors_enabled": {
      "type": "boolean",
      "label": {
        "ar": "ألوان مخصّصة لهذا القسم — أطفئه للرجوع لألوان الثيم",
        "en": "Custom colours for this section — switch off to restore the theme palette"
      },
      "default": false
    },
    "color_bg": {
      "type": "color",
      "label": {
        "ar": "لون الخلفية",
        "en": "Background colour"
      },
      "default": ""
    },
    "color_title": {
      "type": "color",
      "label": {
        "ar": "لون العنوان",
        "en": "Title colour"
      },
      "default": ""
    },
    "color_text": {
      "type": "color",
      "label": {
        "ar": "لون النص والوصف",
        "en": "Body & description colour"
      },
      "default": ""
    },
    "color_accent": {
      "type": "color",
      "label": {
        "ar": "لون التمييز — الكلمة الملوّنة والأيقونات والروابط",
        "en": "Accent — highlighted word, icons, links"
      },
      "default": ""
    },
    "color_border": {
      "type": "color",
      "label": {
        "ar": "لون الحدود والفواصل",
        "en": "Borders & dividers"
      },
      "default": ""
    },
    "color_card": {
      "type": "color",
      "label": {
        "ar": "لون خلفية البطاقات",
        "en": "Card background"
      },
      "default": ""
    },
    "color_btn_bg": {
      "type": "color",
      "label": {
        "ar": "لون خلفية الزر",
        "en": "Button background"
      },
      "default": ""
    },
    "color_btn_text": {
      "type": "color",
      "label": {
        "ar": "لون نص الزر",
        "en": "Button text"
      },
      "default": ""
    }
  },
  "presets": [
    {
      "category": "الصفحة الرئيسية",
      "name": "النشرة البريدية"
    }
  ]
}

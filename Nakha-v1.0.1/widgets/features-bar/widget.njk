{# ============================================================================
   NAKHA FEATURES BAR — the service strip
   ----------------------------------------------------------------------------
   Three styles:
     trust    icon box + title + description   (shipping / exchange / support…)
     compact  icon + short label on one line   (dense strip under the hero)
     marquee  infinite scrolling ticker

   The icon set is the kitchen's promise, not decoration: fast delivery, baked
   this morning, halal, cash on delivery, pickup in ten minutes.

   ── The `dark` background — and why it is no longer called `light` ────────
   Picking it adds `.nakha-invert`, which flips the whole token set for this
   section only (style.css §01). Nothing inside needs a variant: the icons,
   text, borders and dividers all read from tokens, so they re-colour
   themselves.

   ⚠️  The option was `light` in RIYADA and means the OPPOSITE here. `invert`
   is defined against the theme's ground: RIYADA was dark-first so inverting
   gave paper-on-white; NAKHA is light-first so inverting gives cream-on-char.
   Same class, opposite result — the option had to be renamed with it, or a
   merchant asking for a light band would have got a black one.
   ========================================================================= #}

{% set id = widget.id %}
{% set d = widget.data %}
{% set items = widget.blocks | default([]) %}
{% set count = items | length %}

{% set style = d.style | default('trust', true) %}
{% set isCompact = style == 'compact' %}
{% set isMarquee = style == 'marquee' %}

{% set bg = d.background | default('canvas', true) %}
{% set tone = d.icon_tone | default('appetite', true) %}
{% set shape = d.icon_shape | default('square', true) %}
{% set cols = d.columns | default('4', true) %}
{% set align = d.align | default('start', true) %}
{% set isCenter = align == 'center' %}
{% set dividers = d.show_dividers | default(true) %}
{% set boxed = d.boxed | default(false) %}
{% set borderTop = d.border_top | default(false) %}
{% set borderBottom = d.border_bottom | default(true) %}
{% set tight = d.compact | default(false) %}
{% set mqSpeed = d.marquee_speed | default(26, true) %}

{# ---- background ----
   `light` and `flame` are the two that change what "readable" means inside the
   section, so each carries its own token overrides further down. #}
{# `void` and `dark` are the same answer — a charcoal band. Both MUST set
   isDark, because that is what adds .nakha-invert; a charcoal ground without
   it is dark text on a dark panel. #}
{% set isDark = bg == 'dark' or bg == 'void' %}
{% set isFlame = bg == 'appetite' %}
{% if bg == 'surface' %}{% set bgVal = 'var(--color-surface)' %}
{% elif bg == 'well' %}{% set bgVal = 'var(--color-bg-tertiary)' %}
{% elif bg == 'alt' %}{% set bgVal = 'var(--color-section-b)' %}
{% elif bg == 'void' %}{% set bgVal = 'var(--color-char)' %}
{% elif isFlame %}{% set bgVal = 'var(--color-appetite-solid)' %}
{% elif isDark %}{% set bgVal = 'var(--color-char)' %}
{% elif bg == 'none' %}{% set bgVal = 'transparent' %}
{% else %}{% set bgVal = 'var(--color-bg-primary)' %}{% endif %}

{# ---- icon colours ---- #}
{% if tone == 'light' %}
  {% set iconFg = 'var(--color-text-primary)' %}{% set iconBg = 'var(--color-surface-alt)' %}
{% elif tone == 'success' or tone == 'basil' %}
  {% set iconFg = 'var(--color-basil)' %}{% set iconBg = 'var(--color-basil-wash)' %}
{% else %}
  {% set iconFg = 'var(--color-appetite)' %}{% set iconBg = 'var(--color-appetite-wash)' %}
{% endif %}

{# On the flame band every tinted chip disappears — swap to translucent white. #}
{% if isFlame %}
  {% set iconFg = 'var(--color-cream)' %}{% set iconBg = 'rgba(255,247,239,0.18)' %}
{% endif %}

{# ---- responsive column count for the mid breakpoint ---- #}
{% set colsInt = cols | int %}
{% set colsMid = 3 if colsInt > 3 else colsInt %}
{# No lone item on the last row: count the items that actually render and
   step the column count down (or up) when exactly one would be left over.
   Phones (2 columns) let an odd last item take the whole row instead. #}
{% set _shown = [] %}
{% for _blk in items %}{% if _blk.data and _blk.data.title %}{% set _x = _shown.push(1) %}{% endif %}{% endfor %}
{% set nItems = _shown | length %}
{% if nItems > colsMid and nItems % colsMid == 1 %}
  {% set colsMid = (colsMid - 1) if (colsMid > 2 and nItems % (colsMid - 1) != 1) else (colsMid + 1) %}
{% endif %}
{% if nItems > colsInt and nItems % colsInt == 1 %}
  {% set colsInt = (colsInt - 1) if (colsInt > 2 and nItems % (colsInt - 1) != 1) else (colsInt + 1) %}
{% endif %}


{# ============================ ICON LIBRARY ============================
   Line icons on a 24×24 grid, 1.7 stroke — matches the rest of the theme.
   `refresh` is kept as an alias so older page JSON keeps working.
   ==================================================================== #}
{% macro icon(name, size) %}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none"
     stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true">
  {% if name == 'shipping' or name == 'delivery' %}
    {# scooter — the delivery promise #}
    <circle cx="6" cy="17.5" r="2.6"/><circle cx="18" cy="17.5" r="2.6"/>
    <path d="M8.6 17.5h6.8M6 14.9V9.6h4.2l3.4 5.3M13.6 9.6h3.2l1.2 5.3"/><path d="M15.4 6.2h2.4"/>
  {% elif name == 'returns' or name == 'refresh' or name == 'exchange' %}
    <path d="M3 12a9 9 0 1 0 9-9 9.7 9.7 0 0 0-6.7 2.7L3 8"/><path d="M3 3v5h5"/>
  {% elif name == 'oven' or name == 'fresh' %}
    {# baked this morning #}
    <rect x="2.8" y="4" width="18.4" height="16" rx="2.4"/><path d="M2.8 9.4h18.4"/>
    <path d="M6.4 6.7h.01M9.4 6.7h.01"/><rect x="6.6" y="12.4" width="10.8" height="4.6" rx="1.4"/>
  {% elif name == 'chef' %}
    <path d="M7.4 20.4h9.2v-6.2h-9.2z"/>
    <path d="M7.4 14.2a3.6 3.6 0 1 1 1.2-6.9 3.7 3.7 0 0 1 6.8 0 3.6 3.6 0 1 1 1.2 6.9"/>
  {% elif name == 'leaf' or name == 'veg' %}
    <path d="M20.4 3.6c0 9.2-4.6 13.8-11.4 13.8a5.4 5.4 0 0 1-5.4-5.4C3.6 8.2 8.2 3.6 20.4 3.6Z"/>
    <path d="M4.4 20.4c3-6.4 7-9.6 12-11.4"/>
  {% elif name == 'spicy' or name == 'fire' %}
    <path d="M12 21.4c3.6 0 6.4-2.6 6.4-6 0-4.4-4.2-6.6-4.2-10.4-2 .8-3 2.6-3 4.4-1.2-.6-1.8-1.8-1.8-3-1.8 1.6-3.8 4.2-3.8 9 0 3.4 2.8 6 6.4 6Z"/>
  {% elif name == 'coffee' or name == 'drink' %}
    <path d="M3.6 8.4h13v6.2a4.4 4.4 0 0 1-4.4 4.4H8a4.4 4.4 0 0 1-4.4-4.4z"/>
    <path d="M16.6 10h1.8a2.6 2.6 0 0 1 0 5.2h-1.8"/><path d="M7 2.8v2.4M11 2.8v2.4"/>
  {% elif name == 'bag' or name == 'pickup' %}
    <path d="M5 8h14l-1.2 11.2a1.9 1.9 0 0 1-1.9 1.7H8.1a1.9 1.9 0 0 1-1.9-1.7z"/>
    <path d="M9 8V6.4a3 3 0 0 1 6 0V8"/>
  {% elif name == 'halal' or name == 'medal' %}
    <circle cx="12" cy="9.4" r="6.2"/><path d="m8.4 15 -1.6 6 5.2-2.6 5.2 2.6-1.6-6"/>
  {% elif name == 'cash' %}
    <rect x="2.5" y="6" width="19" height="12" rx="2.2"/><circle cx="12" cy="12" r="2.6"/>
    <path d="M6 10v4M18 10v4"/>
  {% elif name == 'warranty' or name == 'authentic' %}
    <path d="M12 3l7.5 3v5.6c0 4.5-3.1 7.3-7.5 8.9-4.4-1.6-7.5-4.4-7.5-8.9V6z"/>
    <path d="M9 12.2l2.2 2.2 4.3-4.4"/>
  {% elif name == 'shield' %}
    <path d="M12 3l7.5 3v5.6c0 4.5-3.1 7.3-7.5 8.9-4.4-1.6-7.5-4.4-7.5-8.9V6z"/>
    <rect x="9.4" y="11.2" width="5.2" height="4.2" rx="1"/>
    <path d="M10.7 11.2V10a1.3 1.3 0 0 1 2.6 0v1.2"/>
  {% elif name == 'card' %}
    <rect x="2.5" y="5.5" width="19" height="13" rx="2.5"/><path d="M2.5 10h19"/>
    <path d="M6 14.5h3.5"/>
  {% elif name == 'installment' %}
    <rect x="3" y="4.5" width="18" height="15.5" rx="2.5"/><path d="M3 9.5h18"/>
    <path d="M7.5 3v3M16.5 3v3"/><path d="M7.5 13.5h2M14.5 13.5h2M7.5 16.8h2M14.5 16.8h2"/>
  {% elif name == 'support' %}
    <path d="M4 13.5v-1.5a8 8 0 0 1 16 0v1.5"/>
    <rect x="2.5" y="12.5" width="4" height="6" rx="1.8"/>
    <rect x="17.5" y="12.5" width="4" height="6" rx="1.8"/>
    <path d="M20 18.5v.6a2.4 2.4 0 0 1-2.4 2.4H13"/>
  {% elif name == 'clock' %}
    <circle cx="12" cy="12" r="8.75"/><path d="M12 7.2V12l3.4 2"/>
  {% elif name == 'badge' %}
    <path d="M12 2.8l2.2 1.6 2.7-.3 1 2.5 2.3 1.4-.7 2.6.7 2.6-2.3 1.4-1 2.5-2.7-.3L12 19.4l-2.2-1.6-2.7.3-1-2.5-2.3-1.4.7-2.6-.7-2.6 2.3-1.4 1-2.5 2.7.3z"/>
    <path d="M9.2 11.9l2 2 3.6-3.7"/>
  {% elif name == 'box' %}
    <path d="M3 7.6 12 3l9 4.6v8.8L12 21l-9-4.6z"/>
    <path d="M3 7.6 12 12l9-4.4"/><path d="M12 12v9"/>
  {% elif name == 'star' %}
    <path d="m12 3.1 2.7 5.5 6 .9-4.3 4.3 1 6-5.4-2.9-5.4 2.9 1-6L3.3 9.5l6-.9z"/>
  {% elif name == 'bolt' %}
    <path d="M13.2 2.6 5.3 14.4h5.1l-.6 7 7.9-11.8h-5.1z"/>
  {% else %}
    <circle cx="12" cy="12" r="8.75"/><path d="m8.2 12.3 2.6 2.6 5-5.2"/>
  {% endif %}
</svg>
{% endmacro %}

{# One pass of the ticker. Called six times — .nakha-offer-track translates by
   exactly -50%, so the count must stay even or the loop jumps, and short copy
   must still fill a wide screen. #}
{% macro mqRun(list, hidden) %}
  <div class="flex items-center" style="gap: var(--marquee-gap, 32px);"
       {% if hidden %}aria-hidden="true"{% endif %}>
    {% for block in list %}
      {% set f = block.data %}
      {% if f.title %}
        <span class="nakha-fb-{{ id }}-mq-item">
          {{ icon(f.icon | default('check'), 16) }}{{ f.title }}
        </span>
      {% endif %}
    {% endfor %}
  </div>
{% endmacro %}


<style>
  /* ================= shell ================= */
  #nakha-fb-{{ id }} {
    background: {{ bgVal }};
    {% if borderTop %}border-top: 1px solid var(--color-border);{% endif %}
    {% if borderBottom %}border-bottom: 1px solid var(--color-border);{% endif %}
    {% if isMarquee %}
    padding-block: {{ '12px' if tight else '18px' }};
    {% else %}
    padding-block: {{ '22px' if tight else '36px' }};
    {% endif %}
  }
  @media (max-width: 767px) {
    #nakha-fb-{{ id }} { padding-block: {{ '12px' if tight or isMarquee else '24px' }}; }
  }

  {% if isFlame %}
  /* On the flame band the neutral tokens would be unreadable, so they are
     redefined for the whole subtree rather than overridden per element. */
  #nakha-fb-{{ id }} {
    --color-text-primary: var(--color-cream);
    --color-text-secondary: rgba(255, 247, 239, 0.86);
    --color-text-tertiary: rgba(255, 247, 239, 0.74);
    --color-border: rgba(255, 247, 239, 0.26);
    --color-surface: transparent;
  }
  {% endif %}

  {% if boxed %}
  /* the whole strip becomes one bordered card floating on the section bg */
  .nakha-fb-{{ id }}-box {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: {{ 'transparent' if isFlame else 'var(--color-surface)' }};
    padding: {{ '16px' if tight else '22px' }};
  }
  {% endif %}

  /* ================= grid ================= */
  .nakha-fb-{{ id }}-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: {{ '16px 12px' if isCompact else '22px 16px' }};
  }
  {% if nItems % 2 == 1 and nItems > 2 %}
  @media (max-width: 767px) {
    .nakha-fb-{{ id }}-grid > .nakha-fb-{{ id }}-item:last-child { grid-column: 1 / -1; }
  }
  {% endif %}
  @media (min-width: 768px) {
    .nakha-fb-{{ id }}-grid { grid-template-columns: repeat({{ colsMid }}, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .nakha-fb-{{ id }}-grid { grid-template-columns: repeat({{ colsInt }}, minmax(0, 1fr)); gap: 0; }
  }

  {% if dividers %}
  /* 1px rules between cells — this theme leans on lines, not shadows.
     Only from the breakpoint where every cell sits on ONE row; below that the
     rule lands mid-wrap and reads as a random stripe. */
  @media (min-width: 1024px) {
    .nakha-fb-{{ id }}-item + .nakha-fb-{{ id }}-item {
      border-inline-start: 1px solid var(--color-border);
    }
    .nakha-fb-{{ id }}-item { padding-inline: 22px; }
  }
  {% endif %}

  /* ================= item ================= */
  .nakha-fb-{{ id }}-item {
    display: flex;
    align-items: center;
    gap: {{ '9px' if isCompact else '13px' }};
    min-width: 0;
    {% if isCenter %}
    justify-content: center;
    text-align: center;
    {% if not isCompact %}flex-direction: column;{% endif %}
    {% endif %}
  }

  .nakha-fb-{{ id }}-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    color: {{ iconFg }};
    {% if shape != 'bare' %}
    background: {{ iconBg }};
    width: {{ '34px' if isCompact else '44px' }};
    height: {{ '34px' if isCompact else '44px' }};
    border-radius: {{ '50%' if shape == 'circle' else 'var(--radius-sm)' }};
    {% endif %}
  }

  .nakha-fb-{{ id }}-title {
    font-size: {{ '0.8125rem' if isCompact else '0.9375rem' }};
    font-weight: 800;
    line-height: 1.35;
    color: var(--color-text-primary);
  }
  .nakha-fb-{{ id }}-desc {
    margin-top: 3px;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-text-tertiary);
  }

  /* ================= marquee ================= */
  .nakha-fb-{{ id }}-mq {
    --marquee-dur: {{ mqSpeed * 3 }}s;
    --marquee-gap: 32px;
  }
  .nakha-fb-{{ id }}-mq-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: none;
    font-size: 0.8125rem;
    font-weight: 700;
    white-space: nowrap;
    color: var(--color-text-primary);
    text-transform: var(--display-case);
  }
  html[dir="ltr"] .nakha-fb-{{ id }}-mq-item { letter-spacing: 0.08em; }
  .nakha-fb-{{ id }}-mq-item svg { color: {{ iconFg }}; flex: none; }
</style>


<section id="nakha-fb-{{ id }}"{% if count == 0 %} data-nakha-demo{% endif %} class="{{ 'nakha-invert' if isDark }}">
  {% if isMarquee %}

    {# ---------------- marquee ----------------
       The list is printed twice so the loop has no seam; the second copy is
       aria-hidden so a screen reader never announces the same promise twice. #}
    <div class="nakha-offer nakha-fb-{{ id }}-mq">
      <div class="nakha-offer-track">
        {{ mqRun(items, false) }}
        {% for _r in [1, 2, 3, 4, 5] %}{{ mqRun(items, true) }}{% endfor %}
      </div>
    </div>

  {% else %}

    {# ---------------- grid ---------------- #}
    <div class="nakha-container">
      <div class="{{ 'nakha-fb-' ~ id ~ '-box' if boxed }}">
        <div class="nakha-fb-{{ id }}-grid">
          {% for block in items %}
            {% set f = block.data %}
            {% if f.title %}
              <div class="nakha-fb-{{ id }}-item">
                <span class="nakha-fb-{{ id }}-icon">
                  {{ icon(f.icon | default('check'), 20 if isCompact else 22) }}
                </span>
                <div class="min-w-0">
                  <div class="nakha-fb-{{ id }}-title">{{ f.title }}</div>
                  {% if f.description and not isCompact %}
                    <div class="nakha-fb-{{ id }}-desc">{{ f.description }}</div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}

          {# editor-only: a bar with no blocks would otherwise render as a bare strip #}
          {% if count == 0 %}
            <div class="nakha-fb-{{ id }}-item" style="grid-column: 1 / -1;">
              <span class="nakha-caption">{{ t('pages.features.empty') }}</span>
            </div>
          {% endif %}
        </div>
      </div>
    </div>

  {% endif %}
</section>

{# Per-section palette. Emits nothing at all unless `colors_enabled` is on, so
   the switch IS the revert. Must stay after the widget's own <style> — see the
   partial's header for why. #}
{% ui "section-colors.njk", scope='#nakha-fb-' ~ id, c=d %}

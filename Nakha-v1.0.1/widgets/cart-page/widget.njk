{# ============================================================================
   NAKHA CART PAGE
   ----------------------------------------------------------------------------
   Rows come from ui/cart.njk in 'list' mode — the same macro the header drawer
   uses, so the two views of the cart can never disagree.

   ⚠️  data-* hooks read by CartManager._updateUI() / _refreshDrawer():
       data-cart-count · data-cart-total · data-cart-savings-row · data-cart-savings
       (plus data-cart-item / data-item-total / data-item-compare inside each row)

   ⚠️  NO coupon input. Qumra exposes cart.couponApplied / couponDiscount as
   READ-ONLY values and documents no coupon endpoint — an input here could not
   submit anywhere. The applied discount is displayed; entering one happens at
   checkout.
   ========================================================================= #}

{% set id = widget.id %}
{% set d = widget.data %}

{% set title = d.title | default(t('pages.cart.title'), true) %}
{% set showBreadcrumb = d.show_breadcrumb | default(true) %}
{% set showSavings = d.show_savings | default(true) %}
{% set showDiscount = d.show_discount_row | default(true) %}
{% set freeThreshold = d.free_shipping_threshold | default(0) %}
{% set confirmRemove = d.confirm_remove | default(true) %}
{% set checkoutUrl = d.checkout_url | default('/checkout', true) %}
{% set shopUrl = d.continue_shopping_url | default('/shop', true) %}
{% set noteText = d.note_text | default('') %}

{% set showTrust = d.show_trust_row | default(true) %}
{% set trust1 = d.trust1_text | default('') %}
{% set trust2 = d.trust2_text | default('') %}
{% set trust3 = d.trust3_text | default('') %}
{% set hasTrust = showTrust and (trust1 or trust2 or trust3) %}

{% set itemCount = cart.items | length %}
{# Both states are in the page and Alpine swaps them, so only the one the server shows is the H1 #}
{% set fullTag = 'h1' if itemCount > 0 else 'h2' %}
{% set emptyTag = 'h2' if itemCount > 0 else 'h1' %}


{# ---------------- one reassurance line ---------------- #}
{% macro trustLine(text, icon) %}
  {% if text %}
    <li class="nakha-cp-trust-item">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        {% if icon == 'lock' %}
          <rect x="4.5" y="10.5" width="15" height="10" rx="2.4"/>
          <path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/>
        {% elif icon == 'warranty' %}
          <path d="M12 3l7.5 3v5.6c0 4.5-3.1 7.3-7.5 8.9-4.4-1.6-7.5-4.4-7.5-8.9V6z"/>
          <path d="M9 12.2l2.2 2.2 4.3-4.4"/>
        {% else %}
          <path d="M3 12a9 9 0 1 0 9-9 9.7 9.7 0 0 0-6.7 2.7L3 8"/><path d="M3 3v5h5"/>
        {% endif %}
      </svg>
      <span>{{ text }}</span>
    </li>
  {% endif %}
{% endmacro %}


<style>
  .nakha-cp-{{ id }}-title {
    margin: 0;
    font-family: var(--font-display-ar);
    font-size: clamp(1.375rem, 2.8vw, 1.875rem);
    font-weight: 700;
    line-height: 1.22;
    letter-spacing: normal;
    color: var(--color-text-primary);
    text-transform: var(--display-case);
  }
  html[dir="ltr"] .nakha-cp-{{ id }}-title { font-family: var(--font-display-en); font-weight: 400; letter-spacing: 0.02em; }
  html[dir="rtl"] .nakha-cp-{{ id }}-title { line-height: 1.32; letter-spacing: normal; }

  .nakha-cp-{{ id }}-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .nakha-cp-{{ id }}-row { grid-template-columns: minmax(0, 1fr) 360px; gap: 24px; }
    /* the summary follows the shopper down a long list — header height + gap */
    .nakha-cp-{{ id }}-summary { /* data-sticky-fit — see main.js */ position: sticky; top: 96px; }
  }

  .nakha-cp-{{ id }}-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .nakha-cp-{{ id }}-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 6px;
  }

  .nakha-cp-{{ id }}-summary-box {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  /* ---- free-shipping progress ---- */
  .nakha-cp-{{ id }}-ship {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-bg-tertiary);
  }
  .nakha-cp-{{ id }}-bar {
    display: block;
    height: 5px;
    border-radius: var(--radius-pill);
    background: var(--color-border-strong);
    overflow: hidden;
  }
  .nakha-cp-{{ id }}-bar > span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--color-basil);
    transition: width var(--t-slow) var(--ease-out);
  }

  /* ---- reassurance ---- */
  .nakha-cp-trust {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 14px 0 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }
  .nakha-cp-trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--color-text-secondary);
  }
  .nakha-cp-trust-item svg { flex: none; color: var(--color-basil); }
</style>


<section id="nakha-cp-{{ id }}" class="nakha-section"
         x-data="cartInteraction({
           items: [{% for item in cart.items %}{ id: '{{ item._id }}', qty: {{ item.quantity }}, productId: '{{ item.productId }}', variantId: '{{ item.variantId or '' }}', slug: {{ (item.productData.slug or item.productData.handle or '') | dump }} }{% if not loop.last %},{% endif %}{% endfor %}],
           eagerStock: true,
           confirmRemove: {{ 'true' if confirmRemove else 'false' }}
         })">
  <div class="nakha-container">

    {# ═══════════════ has items ═══════════════ #}
    <div x-show="activeItems.length > 0" {% if itemCount == 0 %}x-cloak{% endif %}>

      {% if showBreadcrumb %}
        <nav class="nakha-crumbs mb-5" aria-label="breadcrumb">
          <a href="/">{{ t('common.home') }}</a>
          <svg class="nakha-crumbs-sep shrink-0" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/>
          </svg>
          <span aria-current="page">{{ title }}</span>
        </nav>
      {% endif %}

      <div class="flex items-baseline gap-3 flex-wrap mb-6">
        <{{ fullTag }} class="nakha-cp-{{ id }}-title">{{ title }}</{{ fullTag }}>
        <span class="nakha-caption">
          <span class="nakha-num" data-cart-count-text>{% ui "count.njk", n=(cart.totalQuantity or 0) %}</span>
        </span>
      </div>

      <div class="nakha-cp-{{ id }}-row">

        {# ═════════ items ═════════ #}
        <div data-cart-container>
          <div class="nakha-cp-{{ id }}-list">
            {# rows come from ui/cart.njk in 'list' mode — same macro as the drawer #}
            {% ui "cart.njk", variant='list' %}
          </div>

          <div class="nakha-cp-{{ id }}-actions">
            <a href="{{ shopUrl }}" class="nakha-link">
              <svg class="nakha-flip" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6"/>
              </svg>
              {{ t('pages.cart.continue_shopping') }}
            </a>
            <button type="button" @click="Qumra.cart.clear()"
                    class="nakha-btn nakha-btn--ghost nakha-btn--sm">
              {{ t('pages.cart.clear') }}
            </button>
          </div>
        </div>

        {# ═════════ summary ═════════ #}
        <div class="nakha-cp-{{ id }}-summary">
          <div class="nakha-cp-{{ id }}-summary-box" data-cart-footer>

            <span class="nakha-subtitle">{{ t('pages.cart.order_summary') }}</span>

            {# ---- free shipping progress ----
               Rendered server-side from the cart total. CartManager repaints the
               numbers around it on every change but not this bar, so it can lag
               by one interaction until the page is re-fetched — acceptable for a
               nudge, and far better than not showing it at all. #}
            {% if freeThreshold > 0 %}
              {% set remaining = freeThreshold - (cart.totalPrice | default(0)) %}
              <div class="nakha-cp-{{ id }}-ship">
                {% if remaining > 0 %}
                  <span class="nakha-text-sm" style="color: var(--color-text-primary); font-weight: 600;">
                    {{ t('pages.cart.free_shipping_left') }} <span class="nakha-num">{{ remaining | money }}</span>
                  </span>
                {% else %}
                  <span class="nakha-text-sm inline-flex items-center gap-2" style="color: var(--color-basil); font-weight: 700;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4 12.5 9.5 18 20 6.5"/>
                    </svg>
                    {{ t('pages.cart.free_shipping_earned') }}
                  </span>
                {% endif %}
                <span class="nakha-cp-{{ id }}-bar">
                  <span style="width: {{ 100 if remaining <= 0 else ((cart.totalPrice | default(0)) / freeThreshold * 100) | round }}%;"></span>
                </span>
              </div>
            {% endif %}

            <div class="flex flex-col">
              <div class="nakha-summary-row">
                <span>{{ t('pages.cart.subtotal') }}</span>
                <span data-cart-total>{{ cart.totalPrice | money }}</span>
              </div>

              {% if showSavings %}
                <div class="nakha-summary-row nakha-summary-row is-save" data-cart-savings-row
                     {% if not cart.totalSavings or cart.totalSavings <= 0 %}style="display: none;"{% endif %}>
                  <span>{{ t('pages.cart.savings') }}</span>
                  <span data-cart-savings>-{{ cart.totalSavings | money }}</span>
                </div>
              {% endif %}

              {% if showDiscount and cart.couponApplied %}
                <div class="nakha-summary-row nakha-summary-row is-save">
                  <span>{{ t('pages.cart.discount') }}</span>
                  <span>-{{ cart.couponDiscount | money }}</span>
                </div>
              {% endif %}

              <div class="nakha-summary-row">
                <span>{{ t('pages.cart.shipping') }}</span>
                <span style="color: var(--color-text-tertiary); font-weight: 500;">{{ t('pages.cart.calculated_at_checkout') }}</span>
              </div>

              <div class="nakha-summary-row nakha-summary-row is-total">
                <span>{{ t('pages.cart.total') }}</span>
                <span data-cart-total>{{ cart.totalPrice | money }}</span>
              </div>
            </div>

            <p class="nakha-citem-note" x-show="checkoutBlocked" x-cloak role="alert">{{ t('pages.cart.stock_blocked') }}</p>
            <a href="{{ checkoutUrl }}" class="nakha-btn nakha-btn--primary nakha-btn--lg nakha-btn--block"
               @click="goCheckout($event)" :aria-disabled="checkoutBlocked ? 'true' : 'false'"
               :style="checkoutBlocked ? 'opacity:.5;cursor:not-allowed' : ''">
              {{ t('pages.cart.checkout') }}
              <svg class="nakha-flip" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/>
              </svg>
            </a>

            {# ---- reassurance: the last doubts before a big-ticket click ---- #}
            {% if hasTrust %}
              <ul class="nakha-cp-trust">
                {{ trustLine(trust1, 'lock') }}
                {{ trustLine(trust2, 'warranty') }}
                {{ trustLine(trust3, 'returns') }}
              </ul>
            {% endif %}

            {% if noteText %}
              <p class="nakha-caption text-center m-0">{{ noteText }}</p>
            {% endif %}
          </div>
        </div>

      </div>
    </div>

    {# ═══════════════ empty ═══════════════ #}
    <div x-show="activeItems.length === 0" {% if itemCount > 0 %}x-cloak{% endif %} data-cart-empty>
      <div class="nakha-empty">
        <span class="nakha-empty-icon" style="width: 88px; height: 88px;">
          <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"
               stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 4h2.2l1.9 10.4a1.8 1.8 0 0 0 1.77 1.48h7.9a1.8 1.8 0 0 0 1.76-1.42L20.3 7.5H6.2"/>
            <circle cx="9.5" cy="19.5" r="1.4"/><circle cx="17" cy="19.5" r="1.4"/>
          </svg>
        </span>
        <{{ emptyTag }} class="nakha-cp-{{ id }}-title">{{ t('cart.empty_title') }}</{{ emptyTag }}>
        <p class="nakha-text-sm m-0 max-w-md mx-auto">{{ t('cart.empty_message') }}</p>
        <a href="{{ shopUrl }}" class="nakha-btn nakha-btn--primary nakha-btn--lg mt-2">
          {{ t('cart.continue_shopping') }}
        </a>
      </div>
    </div>

  </div>
</section>

{# Per-section palette. Emits nothing at all unless `colors_enabled` is on, so
   the switch IS the revert. Must stay after the widget's own <style> — see the
   partial's header for why. #}
{% ui "section-colors.njk", scope='#nakha-cp-' ~ id, c=d %}

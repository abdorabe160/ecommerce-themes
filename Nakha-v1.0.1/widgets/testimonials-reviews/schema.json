  "blocks": {
    "review": {
      "name": "تقييم",
      "settings": {
        "headline": {
          "type": "string",
          "label": {
            "ar": "عنوان التقييم (سطر قصير)",
            "en": "Review Headline (one short line)"
          },
          "default": ""
        },
        "review_text": {
          "type": "text",
          "label": {
            "ar": "نص التقييم",
            "en": "Review Text"
          },
          "default": ""

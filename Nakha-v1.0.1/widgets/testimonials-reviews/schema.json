        "reviewer_name": {
          "type": "string",
          "label": {
            "ar": "اسم العميل",
            "en": "Reviewer Name"
          },
          "default": ""
        },
        "reviewer_role": {
          "type": "string",
          "label": {
            "ar": "المدينة أو صفة العميل",

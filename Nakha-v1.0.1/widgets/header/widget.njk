{# ============================================================================
   NAKHA HEADER — restaurant · bakery · food ordering
   ----------------------------------------------------------------------------
   Rows:
     1. marquee strip   (scrolling claims — the offer bar)
     2. main bar        (menu · logo · search · cart)
     3. quick-links rail (الأكثر طلباً — the only category strip on desktop)

   ── There is no desktop category nav, and that is deliberate ───────────────
   No inline nav, no mega dropdowns. Categories live in ONE place — the drawer —
   on every screen size. Which makes the menu button load-bearing rather than a
   mobile leftover, so it is visible at every width and carries a text label on
   desktop. A burger that only appears under 1024px would leave desktop with no
   route to the menu at all.

   The `mega` blocks are still the taxonomy source: the drawer renders each one
   as an accordion. They just no longer paint a dropdown panel.

   ── Why the settings are still called goals_* ──────────────────────────────
   `goals_label` / `goals_menu` / `show_goals_row` keep their original keys
   because ui/sidebar.njk reads locals of those names and is not ported yet.
   The merchant-facing labels say "الروابط السريعة"; only the identifiers are
   historical. Rename them in the same pass that ports the drawer, not before.

   Contracts with assets/main.js — do not rename:
     toggleModal('sidebar' | 'search' | 'cart')   ·   $store.cart.totalQuantity
     $store.modal.current
   ========================================================================= #}

{% set id = widget.id %}
{% set d = widget.data %}
{% set megas = widget.blocks | default([]) %}

{% set isSticky = d.sticky | default(true) %}
{% set logoH = d.logo_height | default(36) %}
{% set storeName = (store.name or 'NAKHA') | trim %}{% set _sw = (storeName | replace('  ', ' ')).split(' ') %}{% set storeShort = (_sw.slice(0, 3).join(' ') ~ '…') if (_sw | length) > 3 else storeName %}
{% set logo = d.header_logo if d.header_logo and d.header_logo.fileUrl else store.logo %}

{% set searchStyle = d.search_style | default('icon', true) %}
{% set searchPlaceholder = d.search_placeholder | default(t('defaults.search_dishes'), true) %}
{% set hasSearch = searchStyle != 'hidden' %}
{% set inlineSearch = searchStyle == 'inline' %}

{% set showCart = d.show_cart | default(true) %}
{% set showLang = d.show_language_switcher | default(true) %}

{# ---- marquee claims: up to five strings, rendered as one scrolling track ----
   Bound to plain variables first rather than filtering inside the array
   literal — the two-step form is the one this theme already relies on and it
   keeps the `| default` out of a construct whose parsing varies. #}
{% set showAnnounce = d.show_announcement | default(true) %}
{% set claim1 = d.claim_1 | default('') %}
{% set claim2 = d.claim_2 | default('') %}
{% set claim3 = d.claim_3 | default('') %}
{% set claim4 = d.claim_4 | default('') %}
{% set claim5 = d.claim_5 | default('') %}
{% set claims = [claim1, claim2, claim3, claim4, claim5] %}
{% set hasClaims = claim1 or claim2 or claim3 or claim4 or claim5 %}

{# ---- menus (consumed by the drawer, not by this bar) ---- #}
{% set simpleMenu = d.header_menu or [] %}
{% set dealText = d.deal_link_text | default(t('defaults.todays_deals'), true) %}
{% set dealUrl = d.deal_link_url | default('/shop', true) %}

{# ---- quick-links rail ---- #}
{% set showGoals = d.show_goals_row | default(true) %}
{% set goalsLabel = d.goals_label | default(t('defaults.best_sellers'), true) %}
{% set goalsMenu = d.goals_menu or [] %}

{% set rawLang = localization.language | default('ar') %}
{% set currentLang = rawLang if rawLang == 'en' else 'ar' %}


{# ============================ MACROS ============================ #}

{# Brand: uploaded logo, or the wordmark fallback #}
{% macro brand(logo, h, name) %}
  {% if logo and logo.fileUrl %}
    <img src="{{ logo.fileUrl }}" alt="{{ name }}" class="w-auto object-contain" style="height: {{ h }}px;"/>
  {% else %}
    <span class="nakha-wordmark">{{ name }}</span>
  {% endif %}
{% endmacro %}

{# The inline search form — rendered twice (bar centre + mobile row) #}
{% macro searchForm(placeholder, label, cls) %}
  <form action="/shop" method="get" class="nakha-searchbar {{ cls }}" role="search">
    <span class="nakha-searchbar-icon" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7.25"/>
        <path stroke-linecap="round" d="m20.5 20.5-4.2-4.2"/>
      </svg>
    </span>
    <input type="search" name="q" class="nakha-searchbar-input"
           placeholder="{{ placeholder }}" aria-label="{{ label }}" autocomplete="off"/>
    <button type="submit" class="nakha-searchbar-submit">{{ label }}</button>
  </form>
{% endmacro %}

{# One pass of the marquee. Called six times — the count must stay even for the
   -50% keyframe to loop without a seam, and short copy must still fill a wide screen. #}
{% macro claimRun(list, hidden) %}
  <div class="flex items-center" style="gap: var(--marquee-gap, 40px);"
       {% if hidden %}aria-hidden="true"{% endif %}>
    {% for c in list %}
      {% if c %}
        <span class="nakha-offer-item">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style="opacity:.6" aria-hidden="true">
            <circle cx="12" cy="12" r="4.5"/>
          </svg>
          {{ c }}
        </span>
      {% endif %}
    {% endfor %}
  </div>
{% endmacro %}


<style>
  /* ---- responsive visibility -----------------------------------------------
     These are NOT Tailwind's `lg:hidden` / `max-lg:hidden` utilities, and that
     is on purpose. Tailwind here comes from the Play CDN, which generates its
     CSS only AFTER its script has run and scanned the DOM — so for the first
     frames of every page load none of those classes exist, and every element
     meant to be hidden paints anyway. This block ships inline with the widget,
     so it is correct on frame one. Breakpoints mirror Tailwind's defaults. */
  @media (max-width: 1023px) { .nakha-hd-{{ id }}-desk { display: none !important; } }
  @media (min-width: 1024px) { .nakha-hd-{{ id }}-mob  { display: none !important; } }

  /* The merchant sets the logo height; width follows the aspect ratio. The cap
     is tied to the viewport as well as to a pixel value — on a phone a wide
     logo must never push the menu button or the cart out of the row. */
  .nakha-hd-{{ id }}-brand img { max-width: min(190px, 44vw); }
  .nakha-hd-{{ id }}-brand .nakha-wordmark {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--color-header-text);
    white-space: nowrap;
  }
  @media (max-width: 767px) {
    .nakha-hd-{{ id }}-brand .nakha-wordmark { font-size: 1.2rem; }
  }

  /* ---- menu button ----
     The only route to the menu, so it is never hidden and it says what it is on
     desktop. An icon-only control at 1440px reads as a leftover. */
  .nakha-menubtn-{{ id }} {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 42px;
    padding-inline: 14px;
    border: 1.5px solid transparent;
    border-radius: var(--radius-btn);
    background: transparent;
    color: var(--color-header-text);
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
    transition: border-color var(--t-fast) var(--ease-soft),
                color var(--t-fast) var(--ease-soft),
                background-color var(--t-fast) var(--ease-soft);
  }
  .nakha-menubtn-{{ id }}:hover {
    border-color: var(--color-appetite);
    color: var(--color-appetite);
    background: var(--color-appetite-wash);
  }
  .nakha-menubtn-{{ id }} .label { display: none; }
  @media (min-width: 1024px) {
    .nakha-menubtn-{{ id }} { border-color: var(--color-header-border); }
    .nakha-menubtn-{{ id }} .label { display: inline; }
  }
  @media (max-width: 1023px) {
    .nakha-menubtn-{{ id }} { padding-inline: 9px; margin-inline-start: -9px; }
  }

  /* ---- main bar grid: start | centre | end ---- */
  .nakha-bar-{{ id }} {
    display: grid;
    align-items: center;
    gap: 20px;
    min-height: 74px;
    grid-template-columns: auto minmax(0, 1fr) auto;
  }
  @media (max-width: 1023px) {
    .nakha-bar-{{ id }} { gap: 10px; min-height: 60px; }
  }

  /* ---- marquee tones ----
     NO `overflow: hidden` on this strip, ever. The language dropdown is a child
     of it and opens *below* it, so an overflow clip on the bar erases the panel
     entirely — the button toggles, Alpine renders, and nothing is visible. The
     clipping the marquee actually needs belongs to .nakha-offer itself (see
     style.css §07), which wraps only the scrolling track. */
  .nakha-mq-{{ id }} {
    --marquee-dur: {{ (d.marquee_speed | default(34, true)) * 3 }}s;
    --marquee-gap: 44px;
    padding-block: 9px;
  }
  .nakha-mq-{{ id }}--appetite { background: var(--color-announcement); color: var(--color-announcement-text); }
  .nakha-mq-{{ id }}--dark     { background: var(--color-char); color: var(--color-cream); }
  .nakha-mq-{{ id }}--light    { background: var(--color-surface-alt); color: var(--color-text-primary); border-block-end: 1px solid var(--color-border); }

  .nakha-mqrow-{{ id }} { position: relative; display: flex; align-items: center; }
  /* min-width:0 is required: a flex child defaults to min-width:auto, so the
     track's intrinsic width would push the row wider than the container and
     the strip would scroll the page sideways instead of scrolling itself.
     The background/padding resets undo .nakha-offer's standalone styling —
     here the tone is carried by the strip, not by the scroller. */
  .nakha-mqrow-{{ id }} .nakha-offer {
    flex: 1;
    min-width: 0;
    background: none;
    color: inherit;
    padding-block: 0;
  }
  .nakha-mqrow-{{ id }} .nakha-offer-item svg { color: currentColor; }

  .nakha-mqlang-{{ id }} {
    position: relative;
    z-index: 2;
    flex: none;
    display: flex;
    align-items: center;
    padding-inline-end: 14px;
    margin-inline-end: 4px;
    border-inline-end: 1px solid currentColor;
    opacity: 0.9;
  }

  /* ---- quick-links rail ---- */
  .nakha-goals-{{ id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    border-top: 1px solid var(--color-header-border);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nakha-goals-{{ id }}::-webkit-scrollbar { display: none; }
  .nakha-goals-{{ id }} .label {
    flex: none;
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-appetite);
    white-space: nowrap;
  }
  .nakha-goals-{{ id }} a {
    flex: none;
    padding: 8px 14px;
    border: 1.5px solid var(--color-header-border);
    border-radius: var(--radius-btn);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-header-text);
    white-space: nowrap;
    transition: border-color var(--t-fast) var(--ease-soft), color var(--t-fast) var(--ease-soft);
  }
  .nakha-goals-{{ id }} a:hover { border-color: var(--color-appetite); color: var(--color-appetite); }
  /* the offers link is the one appetite item, pushed to the far end */
  .nakha-goals-{{ id }} a.deal {
    margin-inline-start: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-color: var(--color-appetite-line);
    background: var(--color-appetite-wash);
    color: var(--color-appetite-ink);
  }
  .nakha-goals-{{ id }} a.deal:hover { border-color: var(--color-appetite); }

  /* ---- language dropdown ----
     Positioned here rather than with Tailwind's `absolute top-full start-0`:
     those utilities do not exist until the Play CDN has scanned the DOM, and
     a dropdown that lands in the flow for even one frame shoves the strip open.
     Same reasoning as the visibility helpers at the top of this file. */
  .nakha-lang-{{ id }} {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 800;
    cursor: pointer;
    transition: opacity var(--t-fast) var(--ease-soft);
  }
  .nakha-lang-{{ id }}:hover { opacity: 0.7; }

  .nakha-langdrop-{{ id }} {
    position: absolute;
    inset-block-start: calc(100% + 8px);
    inset-inline-start: 0;
    z-index: var(--z-mega);
    min-width: 170px;
    padding: 5px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
  }
  .nakha-langdrop-{{ id }} button {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 9px 12px;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text-primary);
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    text-align: start;
    cursor: pointer;
    transition: background var(--t-fast) var(--ease-soft), color var(--t-fast) var(--ease-soft);
  }
  .nakha-langdrop-{{ id }} button:hover:not(:disabled) { background: var(--color-appetite-wash); }
  .nakha-langdrop-{{ id }} button:disabled { color: var(--color-appetite); cursor: default; }
</style>

<header id="nakha-header-{{ id }}" class="nakha-header{{ ' nakha-header--sticky' if isSticky }}">

  {# ==================== Marquee strip ==================== #}
  {% if showAnnounce and (hasClaims or showLang) %}
  <div class="nakha-mq-{{ id }} nakha-mq-{{ id }}--{{ d.announcement_tone | default('appetite', true) }}">
    <div class="nakha-container">
      <div class="nakha-mqrow-{{ id }}">

        {# language, pinned at the start edge #}
        {% if showLang %}
        <div x-data="{ open: false }" class="nakha-mqlang-{{ id }}">
          <button type="button"
                  @click="open = !open"
                  @click.outside="open = false"
                  class="nakha-lang-{{ id }}"
                  aria-label="{{ t('common.language') }}">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
              <circle cx="12" cy="12" r="9"/>
              <path stroke-linecap="round" d="M3.6 9h16.8M3.6 15h16.8"/>
              <path stroke-linecap="round" d="M12 3a14 14 0 0 0 0 18a14 14 0 0 0 0-18"/>
            </svg>
            <span>{{ 'EN' if currentLang == 'en' else 'ع' }}</span>
          </button>

          <div x-show="open" x-cloak
               x-transition:enter="transition ease-out duration-150"
               x-transition:enter-start="opacity-0 -translate-y-1"
               x-transition:enter-end="opacity-100 translate-y-0"
               x-transition:leave="transition ease-in duration-100"
               x-transition:leave-start="opacity-100"
               x-transition:leave-end="opacity-0"
               class="nakha-langdrop-{{ id }}">
            {% form 'lang' %}
              <button type="submit" name="lang" value="ar" {% if currentLang == 'ar' %}disabled{% endif %}>
                <span class="font-body">العربية</span>
                {% if currentLang == 'ar' %}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M4 12.5 9.5 18 20 6.5"/></svg>
                {% endif %}
              </button>
              <button type="submit" name="lang" value="en" {% if currentLang == 'en' %}disabled{% endif %}>
                <span class="font-body-en">English</span>
                {% if currentLang == 'en' %}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M4 12.5 9.5 18 20 6.5"/></svg>
                {% endif %}
              </button>
            {% endform %}
          </div>
        </div>
        {% endif %}

        {# the scrolling track — content twice, see the macro's note #}
        {% if hasClaims %}
          <div class="nakha-offer">
            <div class="nakha-offer-track">
              {{ claimRun(claims, false) }}
              {% for _r in [1, 2, 3, 4, 5] %}{{ claimRun(claims, true) }}{% endfor %}
            </div>
          </div>
        {% endif %}

      </div>
    </div>
  </div>
  {% endif %}

  {# ========================= Main bar ========================= #}
  <div class="nakha-header-bar">
    <div class="nakha-container">
      <div class="nakha-bar-{{ id }}">

        {# ---------- START · menu + logo ---------- #}
        <div class="flex items-center gap-3 min-w-0 justify-start">
          <button type="button"
                  onclick="toggleModal('sidebar')"
                  class="nakha-menubtn-{{ id }}"
                  aria-label="{{ t('common.menu') }}">
            <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" d="M3.5 7h17M3.5 12h17M3.5 17h11"/>
            </svg>
            <span class="label">{{ t('common.menu') }}</span>
          </button>

          <a href="/" class="nakha-hd-{{ id }}-brand flex items-center shrink-0 min-w-0" aria-label="{{ storeName }}" title="{{ storeName }}">
            {{ brand(logo, logoH, storeShort) }}
          </a>
        </div>

        {# ---------- CENTRE · search, when the merchant wants it inline ------ #}
        <div class="min-w-0 flex items-center justify-center">
          {% if inlineSearch %}
            {{ searchForm(searchPlaceholder, t('common.search'), 'nakha-hd-' ~ id ~ '-desk') }}
          {% endif %}
        </div>

        {# ---------- END · actions ---------- #}
        <div class="flex items-center justify-end gap-1 shrink-0">

          {% if hasSearch and not inlineSearch %}
            <button type="button" onclick="toggleModal('search')" class="nakha-btn-icon" aria-label="{{ t('header.search') }}">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="7.25"/>
                <path stroke-linecap="round" d="m20.5 20.5-4.2-4.2"/>
              </svg>
            </button>
          {% endif %}

          {# No wishlist button: `pages/` has no wishlist route, so the icon
             would be a dead link. main.js ships WishlistManager and an
             `$store.wishlist` (which exposes `ids`, not a `count`), so adding
             one later is a page + a badge bound to `$store.wishlist.ids.length`. #}

          {% if showCart %}
            {# The count is a CSS ::after fed by `data-count` (style.css §05), not
               a child span: the SSR attribute paints the right number on frame
               one and Alpine only keeps the same attribute up to date. A span
               bound with x-show/x-cloak would be blank until Alpine boots —
               which on a returning visitor is a cart badge that flickers in. #}
            <button type="button" onclick="toggleModal('cart')"
                    class="nakha-btn-icon nakha-btn-icon--count"
                    aria-label="{{ t('header.cart') }}"
                    x-data
                    data-count="{{ cart.totalQuantity | default(0) }}"
                    :data-count="$store.cart.totalQuantity">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 4h2.2l1.9 10.4a1.8 1.8 0 0 0 1.77 1.48h7.9a1.8 1.8 0 0 0 1.76-1.42L20.3 7.5H6.2"/>
                <circle cx="9.5" cy="19.5" r="1.4"/>
                <circle cx="17" cy="19.5" r="1.4"/>
              </svg>
            </button>
          {% endif %}
        </div>

      </div>
    </div>

    {# ---------- Mobile search row (inline mode only) ---------- #}
    {% if inlineSearch %}
      <div class="nakha-hd-{{ id }}-mob" style="border-top: 1px solid var(--color-header-border);">
        <div class="nakha-container" style="padding-block: 10px;">
          {{ searchForm(searchPlaceholder, t('common.search'), '') }}
        </div>
      </div>
    {% endif %}

    {# ==================== Quick-links rail ====================
       The only category strip on desktop. On mobile the drawer covers it. #}
    {% if showGoals and (goalsMenu or dealText) %}
    <div class="nakha-hd-{{ id }}-desk">
      <div class="nakha-container">
        <div class="nakha-goals-{{ id }}">
          {% if goalsLabel %}<span class="label">{{ goalsLabel }}</span>{% endif %}
          {% if goalsMenu %}
            {% for item in (goalsMenu.items if goalsMenu.items else goalsMenu) %}
              <a href="{{ item.url | default('#') }}">{{ item.title }}</a>
            {% endfor %}
          {% endif %}
          {% if dealText %}
            <a href="{{ dealUrl }}" class="deal">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2.6a.7.7 0 0 1 .62.38l2.4 4.66 5.16.78a.7.7 0 0 1 .38 1.2l-3.74 3.6.88 5.1a.7.7 0 0 1-1.01.74L12 16.65l-4.62 2.4a.7.7 0 0 1-1.01-.73l.88-5.1-3.73-3.6a.7.7 0 0 1 .38-1.2l5.15-.79 2.4-4.66A.7.7 0 0 1 12 2.6Z"/>
              </svg>
              {{ dealText }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
    {% endif %}
  </div>
</header>

{# Spacer — reserves the height the fixed header vacated. See the note on
   .nakha-header--sticky in style.css §10 for why the header is fixed, not
   sticky (body's overflow-x makes a sticky descendant scroll away). #}
{% if isSticky %}
  <div id="nakha-header-spacer-{{ id }}" aria-hidden="true"></div>
{% endif %}

<script>
  (function () {
    var header = document.getElementById('nakha-header-{{ id }}');
    var spacer = document.getElementById('nakha-header-spacer-{{ id }}');
    if (!header) return;

    /* The header is position:fixed when sticky, so it no longer occupies flow
       space. The spacer mirrors its height — remeasured whenever the header can
       change size (font swap on load, viewport resize, rail wrapping).

       The same measurement is published as --header-h on the document root,
       because a full-height hero needs `calc(100svh - <header>)` and the
       header's height is not knowable at author time: it depends on the
       marquee being on, the rail existing, and on how the merchant's own logo
       scales the bar. `html { scroll-padding-top }` (style.css §02) reads it
       too, so in-page anchors land below the header instead of under it. */
    var sync = function () {
      var h = header.offsetHeight;
      if (spacer) spacer.style.height = h + 'px';
      document.documentElement.style.setProperty('--header-h', h + 'px');
    };
    sync();
    window.addEventListener('load', sync);
    window.addEventListener('resize', sync);
    if (window.ResizeObserver) new ResizeObserver(sync).observe(header);

    /* Shadow only once the page has actually moved. A 1px sentinel watched by
       IntersectionObserver rather than a scroll listener: it fires off the main
       thread, so the shadow never lags a fast scroll. Only meaningful while the
       header is fixed — in static flow it scrolls away with everything else. */
    {% if isSticky %}
    if (spacer && window.IntersectionObserver) {
      var sentinel = document.createElement('div');
      sentinel.setAttribute('aria-hidden', 'true');
      sentinel.style.cssText = 'height:1px;width:100%;';
      spacer.parentNode.insertBefore(sentinel, spacer);
      new IntersectionObserver(function (entries) {
        header.classList.toggle('is-stuck', !entries[0].isIntersecting);
      }, { threshold: 0 }).observe(sentinel);
    }
    {% endif %}
  })();
</script>

{# ---- Global panels triggered from the header ----
   The drawer is where the taxonomy lives now, so `megas` matters more here
   than it used to: it is the ONLY place those sections are rendered.
   sidebar.njk, search.njk and cart.njk are all on the NAKHA classes; the port
   shim they briefly leaned on has been removed from style.css. #}

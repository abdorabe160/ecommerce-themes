{# ============================================================================
   NAKHA CART — the drawer AND the cart page's row list, in one file
   ----------------------------------------------------------------------------
   ⚠️  Why one file: the row markup exists exactly once (the `row` macro below).
   Splitting it out meant `{% ui %}` calling `{% ui %}` — a construct with NO
   precedent anywhere in this theme, so it is avoided everywhere now.
   Do not reintroduce nested {% ui %} here.

   ⚠️  THE ROW HAS A JS TWIN in assets/main.js, which renders the same markup
   when CartManager appends a row to an already-open drawer. Change the `row`
   macro → change that too. Styling is all in style.css → "Cart line item", so
   they cannot drift visually — only the markup order has to stay in sync.
   The twin is `RiyadaCartItem.build()` (name kept — it is exported on window);
   both sides are now on the NAKHA classes and were renamed together.

   ⚠️  Every data-* below is read by CartManager._refreshDrawer():
       data-cart-container · data-cart-list · data-cart-footer · data-cart-empty
       data-cart-count-bar · data-cart-count · data-cart-total
       data-cart-savings-row · data-cart-savings
       data-cart-item · data-item-total · data-item-compare

   Locals:
     data.variant   'drawer' (header mini-cart) | 'list' (cart page rows only)
   ========================================================================= #}

{% set variant = data.variant | default('drawer') %}
{% set isDrawer = variant == 'drawer' %}
{% set itemCount = cart.items | length %}


{# ============================ THE ROW ============================
   Written once. Both variants call it.
   =============================================================== #}
{% macro row(item, compact, onClick) %}
  {% set pd = item.productData %}
  {% set url = '/products/' ~ (pd.slug | default(pd.handle) | default('')) %}
  {% set img = pd.image.fileUrl if pd.image and pd.image.fileUrl else '' %}
  {% set hasCompare = item.compareAtPrice and item.compareAtPrice > item.price %}

<div class="nakha-citem{% if compact %} nakha-citem--compact{% endif %}"
     data-cart-item="{{ item._id }}"
     x-show="activeItems.includes('{{ item._id }}')"
     x-transition:enter="transition ease-out duration-200"
     x-transition:enter-start="opacity-0 translate-y-2"
     x-transition:enter-end="opacity-100 translate-y-0"
     x-transition:leave="transition ease-in duration-150"
     x-transition:leave-start="opacity-100"
     x-transition:leave-end="opacity-0"
     :class="removingId === '{{ item._id }}' && 'is-removing'">

  <a href="{{ url }}" class="nakha-citem-media relative"{% if onClick %} @click="{{ onClick }}"{% endif %}>
    {% if img %}
      <img src="{{ img }}" alt="{{ pd.title }}" loading="lazy"/>
    {% else %}
      <span class="absolute inset-0 flex items-center justify-center" style="color: var(--color-border-strong);">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
             stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.75" cy="9" r="1.6"/>
          <path d="m4 17 5-4.5 4.5 4 3-2.5L21 18"/>
        </svg>
      </span>
    {% endif %}
  </a>

  <div class="nakha-citem-body">

    <div class="flex items-start justify-between gap-2">
      <a href="{{ url }}" class="nakha-citem-name nakha-clamp-2"{% if onClick %} @click="{{ onClick }}"{% endif %}>
        {{ pd.title }}
      </a>
      <button type="button" @click="removeItem('{{ item._id }}')" class="nakha-citem-remove"
              aria-label="{{ t('pages.cart.remove_item') }}">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    {# Variant options — in this catalogue that is overwhelmingly the SIZE, so
       it is never collapsed or truncated: a cart row that hides which size you
       picked is the single fastest way to earn a return. #}
    {% if item.variantData and item.variantData.options and (item.variantData.options | length) > 0 %}
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        {% for opt in item.variantData.options %}
          <span class="nakha-citem-opt">
            {{ opt.option.name }}:
            {% if opt.option.type == 'color' %}
              <span class="nakha-citem-dot" style="background: {{ opt.value | default('#3D3D3D') }};"></span>
            {% endif %}
            <span style="color: var(--color-text-secondary);">{{ opt.label }}</span>
          </span>
        {% endfor %}
      </div>
    {% endif %}

    {# why this line can't be bought as-is — HAS A JS TWIN in RiyadaCartItem.build #}
    <p class="nakha-citem-note" x-show="stockNote('{{ item._id }}')" x-cloak x-text="stockNote('{{ item._id }}')"></p>

    <div class="nakha-citem-foot">
      <div class="nakha-qty nakha-qty--sm">
        <button type="button" @click="decrement('{{ item._id }}')" aria-label="-">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" d="M5 12h14"/>
          </svg>
        </button>
        <span class="nakha-qty-value">
          <span x-show="updating !== '{{ item._id }}'" x-text="quantities['{{ item._id }}']">{{ item.quantity }}</span>
          <span x-show="updating === '{{ item._id }}'" x-cloak class="nakha-spinner"
                style="width: 13px; height: 13px; border-width: 1.5px;"></span>
        </span>
        <button type="button" @click="increment('{{ item._id }}')" :disabled="atCap('{{ item._id }}')" aria-label="+">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" d="M12 5v14M5 12h14"/>
          </svg>
        </button>
      </div>

      <div class="text-end">
        {# Unit price × quantity. Rendered unconditionally — gating it on
           quantity > 1 server-side means it never appears when the shopper
           raises the quantity from 1 in the same session. The price is static
           (per-unit never changes); only the multiplier is Alpine-reactive, so
           it tracks +/- instantly without waiting for the cart round trip. #}
        <span class="nakha-citem-unit" title="{{ t('pages.cart.unit_price') }}">
          <bdi>{{ item.price | money }}</bdi>
          <span aria-hidden="true">×</span>
          <bdi x-text="quantities['{{ item._id }}']">{{ item.quantity }}</bdi>
        </span>
        <span class="nakha-price nakha-price--sm block" data-item-total="{{ item._id }}"
              :class="updating === '{{ item._id }}' && 'opacity-50'">{{ item.totalPrice | money }}</span>
        <span class="nakha-price-was block" data-item-compare="{{ item._id }}"
              {% if not hasCompare %}style="display: none;"{% endif %}>{{ item.totalCompareAtPrice | money }}</span>
      </div>
    </div>

    {# shown only when the host passed confirmRemove: true (the cart page) #}
    <div class="nakha-citem-confirm" x-show="confirmRemoveId === '{{ item._id }}'" x-cloak>
      <span>{{ t('pages.cart.remove_item') }}؟</span>
      <div class="flex items-center gap-2">
        <button type="button" @click="removeItem('{{ item._id }}')" class="nakha-btn nakha-btn--danger nakha-btn--xs">
          {{ t('common.delete') }}
        </button>
        <button type="button" @click="confirmRemoveId = null" class="nakha-btn nakha-btn--ghost nakha-btn--xs">
          {{ t('common.cancel') }}
        </button>
      </div>
    </div>

  </div>
</div>
{% endmacro %}


{# ============================ VARIANTS ============================ #}

{% if not isDrawer %}

  {# ---------- rows only — the cart page supplies its own chrome ---------- #}
  <div class="flex flex-col gap-2" data-cart-list>
    {% for item in cart.items %}
      {{ row(item, false, '') }}
    {% endfor %}
  </div>

{% else %}

  {# ---------- header mini-cart drawer ---------- #}
  <div x-data="cartInteraction({
         items: [{% for item in cart.items %}{ id: '{{ item._id }}', qty: {{ item.quantity }}, productId: '{{ item.productId }}', variantId: '{{ item.variantId or '' }}', slug: {{ (item.productData.slug or item.productData.handle or '') | dump }} }{% if not loop.last %},{% endif %}{% endfor %}]
       })" x-cloak>

    <div x-show="$store.modal.current === 'cart'"
         @click="$store.modal.close()"
         class="nakha-overlay"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"></div>

    <div class="nakha-drawer"
         :class="{ 'is-open': $store.modal.current === 'cart' }"
         role="dialog"
         aria-label="{{ t('pages.cart.title') }}">

      {# ===== head ===== #}
      <div class="nakha-drawer-head">
        <div class="flex items-center gap-2.5 min-w-0">
          <span class="nakha-drawer-title">{{ t('pages.cart.title') }}</span>
          <span class="nakha-caption" data-cart-count-bar
                {% if itemCount == 0 %}style="display: none;"{% endif %}>
            {# same forms as ui/count.njk, written out: no nested ui tag in this partial #}
            {% set _cn = (cart.totalQuantity or 0) | int %}{% set _cm = _cn % 100 %}
            <span class="nakha-num" data-cart-count-text>{% if _cn == 1 %}{{ t('counts.product_one') }}{% elif _cn == 2 %}{{ t('counts.product_two') }}{% elif _cm >= 3 and _cm <= 10 %}{{ t('counts.product_few') | replace('{n}', _cn) }}{% else %}{{ t('counts.product_many') | replace('{n}', _cn) }}{% endif %}</span>
          </span>
        </div>
        <button type="button" @click="$store.modal.close()"
                class="nakha-btn-icon nakha-btn-icon--sm"
                aria-label="{{ t('common.close') }}">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      {# ===== items ===== #}
      <div class="nakha-drawer-body nakha-scroll-thin"
           data-cart-container
           style="padding: 10px;{% if itemCount == 0 %} display: none;{% endif %}">
        {# data-cart-list marks where _refreshDrawer appends new rows #}
        <div class="flex flex-col" data-cart-list>
          {% for item in cart.items %}
            {{ row(item, true, '$store.modal.close()') }}
          {% endfor %}
        </div>
      </div>

      {# ===== footer ===== #}
      <div class="nakha-drawer-foot flex flex-col gap-3"
           data-cart-footer
           {% if itemCount == 0 %}style="display: none;"{% endif %}>

        <div class="flex flex-col">
          <div class="nakha-summary-row is-save" data-cart-savings-row
               {% if not cart.totalSavings or cart.totalSavings <= 0 %}style="display: none;"{% endif %}>
            <span>{{ t('pages.cart.savings') }}</span>
            <span data-cart-savings>-{{ cart.totalSavings | money }}</span>
          </div>

          <div class="nakha-summary-row is-total">
            <span>{{ t('pages.cart.total') }}</span>
            <span data-cart-total>{{ cart.totalPrice | money }}</span>
          </div>
        </div>

        <p class="nakha-citem-note" x-show="checkoutBlocked" x-cloak role="alert">{{ t('pages.cart.stock_blocked') }}</p>
        <a href="/checkout" class="nakha-btn nakha-btn--primary nakha-btn--lg nakha-btn--block"
           @click="goCheckout($event)" :aria-disabled="checkoutBlocked ? 'true' : 'false'"
           :style="checkoutBlocked ? 'opacity:.5;cursor:not-allowed' : ''">
          {{ t('pages.cart.checkout') }}
        </a>
        <a href="/cart" class="nakha-btn nakha-btn--outline nakha-btn--sm nakha-btn--block"
           @click="$store.modal.close()">
          {{ t('pages.cart.view_cart') }}
        </a>
      </div>

      {# ===== empty ===== #}
      <div class="flex-1 flex items-center justify-center px-6"
           data-cart-empty
           {% if itemCount > 0 %}style="display: none;"{% endif %}>
        <div class="nakha-empty" style="padding-block: 0;">
          <span class="nakha-empty-icon">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                 stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 4h2.2l1.9 10.4a1.8 1.8 0 0 0 1.77 1.48h7.9a1.8 1.8 0 0 0 1.76-1.42L20.3 7.5H6.2"/>
              <circle cx="9.5" cy="19.5" r="1.4"/><circle cx="17" cy="19.5" r="1.4"/>
            </svg>
          </span>
          <span class="nakha-empty-title">{{ t('cart.empty_title') }}</span>
          <p class="nakha-text-sm m-0">{{ t('cart.empty_subtitle') }}</p>
          <a href="/shop" class="nakha-btn nakha-btn--primary nakha-btn--sm mt-1"
             @click="$store.modal.close()">
            {{ t('cart.continue_shopping') }}
          </a>
        </div>
      </div>

    </div>
  </div>

{% endif %}

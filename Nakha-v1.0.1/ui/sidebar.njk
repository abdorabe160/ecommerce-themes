{# ============================================================================
   NAKHA DRAWER — the menu
   ----------------------------------------------------------------------------
   Mirrors the header's taxonomy, in the order a phone shopper needs it:
     quick links → menu sections → plain links → offers
   The quick-links grid leads because "عايز حاجة حلوة" is a faster decision than
   "عايز تشيز كيك" — and a chip grid is scannable in one glance where a list
   is not.

   Locals (all supplied by the header widget):
     data.megas · data.simple_menu · data.goals_menu · data.goals_label
     data.deal_text · data.deal_url · data.currentLang · data.showLang
   The goals_* names are historical — see the note in widgets/header/widget.njk.

   Contract with assets/main.js — do not rename:
     $store.modal.current === 'sidebar'

   ── Why .is-open and not x-show ────────────────────────────────────────────
   x-show toggles `display`, which cannot be transitioned, so the panel would
   snap in. The drawer stays in the layout and slides on a transform instead —
   see .nakha-drawer in style.css §10. The overlay DOES use x-show, because it
   only fades and has nothing to slide.
   ========================================================================= #}

{% set megas = data.megas | default([]) %}
{% set simpleMenu = data.simple_menu %}
{% set goalsMenu = data.goals_menu %}
{% set goalsLabel = data.goals_label | default('') %}
{% set dealText = data.deal_text | default('') %}
{% set dealUrl = data.deal_url | default('/shop') %}
{% set sbLang = data.currentLang | default(localization.language) | default('ar') %}
{% set showLang = data.showLang | default(true) %}

{# One menu bound in several places (quick links, every mega column, the plain
   list) printed the same links again under each heading. Mega groups win,
   then the plain list, then the quick-links grid; a menu that already
   appeared is dropped, and a group heading left with no links goes with it. #}
{% set _sbSeen = [] %}
{% set megaGroups = [] %}
{% for block in megas %}
  {% set b = block.data or {} %}
  {% set _groups = [] %}
  {% for n in [1, 2, 3, 4] %}
    {% set _t = b['col' ~ n ~ '_title'] %}
    {% set _m = b['col' ~ n ~ '_menu'] %}
    {% set _mk = (_m | dump) if _m else '' %}
    {% if _t and _mk and not (_mk in _sbSeen) %}
      {% set _p = _groups.push({ title: _t, menu: _m }) %}
      {% set _p2 = _sbSeen.push(_mk) %}
    {% endif %}
  {% endfor %}
  {% set _p3 = megaGroups.push(_groups) %}
{% endfor %}
{% if simpleMenu and ((simpleMenu | dump) in _sbSeen) %}{% set simpleMenu = null %}{% endif %}
{% if simpleMenu %}{% set _s = _sbSeen.push(simpleMenu | dump) %}{% endif %}
{% if goalsMenu and ((goalsMenu | dump) in _sbSeen) %}{% set goalsMenu = null %}{% endif %}

{% macro sbLinks(menu) %}
  {% if menu %}
    {% for item in (menu.items if menu.items else menu) %}
      <a href="{{ item.url | default('#') }}" class="nakha-sb-sublink">{{ item.title }}</a>
      {# sub-items arrive under `item.menu` (measured), not `children` #}
      {% for s in (item.menu or item.children or []) %}
        <a href="{{ s.url | default('#') }}" class="nakha-sb-sublink" style="padding-inline-start: 1.75rem; opacity: .85;">{{ s.title }}</a>
        {% for s3 in (s.menu or s.children or []) %}
          <a href="{{ s3.url | default('#') }}" class="nakha-sb-sublink" style="padding-inline-start: 2.75rem; opacity: .8;">{{ s3.title }}</a>
        {% endfor %}
      {% endfor %}
    {% endfor %}
  {% endif %}
{% endmacro %}

<style>
  /* accordion trigger and plain link share one look, so the drawer reads as
     one list even though half its rows open and half navigate */
  .nakha-sb-row {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 15px 2px;
    border: 0;
    background: transparent;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
    color: var(--color-text-primary);
    text-align: start;
    cursor: pointer;
    transition: color var(--t-fast) var(--ease-soft);
  }
  .nakha-sb-row:hover { color: var(--color-appetite); }
  .nakha-sb-item + .nakha-sb-item { border-top: 1px solid var(--color-border); }

  .nakha-sb-caret {
    width: 28px;
    height: 28px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1.5px solid var(--color-border);
    color: var(--color-text-secondary);
    transition: transform var(--t-base) var(--ease-out),
                background var(--t-fast) var(--ease-soft),
                border-color var(--t-fast) var(--ease-soft),
                color var(--t-fast) var(--ease-soft);
  }
  .nakha-sb-item.is-open .nakha-sb-caret {
    transform: rotate(180deg);
    background: var(--color-appetite);
    border-color: var(--color-appetite);
    color: var(--color-text-on-appetite);
  }

  .nakha-sb-panel { padding-bottom: 14px; }

  .nakha-sb-group-title {
    display: block;
    margin: 12px 0 6px;
    font-size: 0.71875rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--color-appetite);
  }

  .nakha-sb-sublink {
    display: block;
    padding: 9px 12px;
    margin-bottom: 2px;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    transition: background var(--t-fast) var(--ease-soft), color var(--t-fast) var(--ease-soft);
  }
  .nakha-sb-sublink:hover { background: var(--color-appetite-wash); color: var(--color-appetite); }

  .nakha-sb-viewall {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-block-start: 8px;
    margin-inline-start: 12px;
    font-size: 0.8125rem;
    font-weight: 800;
    color: var(--color-appetite);
  }

  /* quick links — a chip grid, not a list. Two columns is the most a 380px
     drawer can hold without the labels wrapping to two lines. */
  .nakha-sb-goals {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
    margin-bottom: 20px;
  }
  .nakha-sb-goals a {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 13px 12px;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.3;
    transition: border-color var(--t-fast) var(--ease-soft), background var(--t-fast) var(--ease-soft);
  }
  .nakha-sb-goals a:hover { border-color: var(--color-appetite); background: var(--color-appetite-wash); }

  /* offers — the one appetite row in the drawer */
  .nakha-sb-deal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 18px;
    padding: 14px;
    border-radius: var(--radius-card);
    background: var(--color-appetite);
    color: var(--color-text-on-appetite);
    font-size: 0.9375rem;
    font-weight: 800;
    box-shadow: var(--shadow-sm);
  }

  /* language segmented control */
  .nakha-sb-seg {
    display: flex;
    gap: 3px;
    padding: 3px;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-btn);
    background: var(--color-bg-tertiary);
  }
  .nakha-sb-seg button {
    flex: 1;
    padding: 9px 0;
    border: 0;
    border-radius: var(--radius-btn);
    background: transparent;
    color: var(--color-text-secondary);
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 700;
    cursor: pointer;
    transition: background var(--t-fast) var(--ease-soft), color var(--t-fast) var(--ease-soft);
  }
  .nakha-sb-seg button.is-active {
    background: var(--color-appetite);
    color: var(--color-text-on-appetite);
  }
</style>

<div x-data="{ open: null }" x-cloak>

  {# ---- Overlay ---- #}
  <div x-show="$store.modal.current === 'sidebar'"
       @click="$store.modal.close()"
       class="nakha-overlay"
       x-transition:enter="transition ease-out duration-200"
       x-transition:enter-start="opacity-0"
       x-transition:enter-end="opacity-100"
       x-transition:leave="transition ease-in duration-150"
       x-transition:leave-start="opacity-100"
       x-transition:leave-end="opacity-0"></div>

  {# ---- Drawer ---- #}
  <div class="nakha-drawer nakha-drawer--start"
       :class="{ 'is-open': $store.modal.current === 'sidebar' }"
       style="width: min(380px, 92vw);"
       role="dialog"
       aria-label="{{ t('common.menu') }}">

    {# head #}
    <div class="nakha-drawer-head">
      <a href="/" class="nakha-wordmark nakha-wordmark--sm" title="{{ store.name | default('NAKHA') }}">{% ui "store-name.njk" %}</a>
      <button type="button"
              @click="$store.modal.close()"
              class="nakha-btn-icon nakha-btn-icon--sm"
              aria-label="{{ t('common.close') }}">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    {# body #}
    <div class="nakha-drawer-body nakha-scroll-thin">

      {# ---- quick links grid ---- #}
      {% if goalsMenu %}
        {# goalsLabel is '' when unset, and `| default` only fires on
           `undefined` — so the fallback needs an explicit if, not a filter. #}
        <span class="nakha-sb-group-title" style="margin-top: 0;">
          {% if goalsLabel %}{{ goalsLabel }}{% else %}{{ t('common.categories') }}{% endif %}
        </span>
        <div class="nakha-sb-goals">
          {% for item in (goalsMenu.items if goalsMenu.items else goalsMenu) %}
            <a href="{{ item.url | default('#') }}">
              <span class="truncate">{{ item.title }}</span>
            </a>
          {% endfor %}
        </div>
      {% endif %}

      <nav aria-label="{{ t('common.menu') }}">

        {# ---- mega blocks as accordions ---- #}
        {% for block in megas %}
          {% set b = block.data %}
          {% if b.nav_label %}
            {% set key = 'sb' ~ loop.index %}
            <div class="nakha-sb-item" :class="open === '{{ key }}' && 'is-open'">
              {% set groups = megaGroups[loop.index0] %}
              {% if groups | length %}
                <button type="button"
                        class="nakha-sb-row"
                        @click="open = open === '{{ key }}' ? null : '{{ key }}'"
                        :aria-expanded="open === '{{ key }}'">
                  <span>{{ b.nav_label }}</span>
                  <span class="nakha-sb-caret">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/>
                    </svg>
                  </span>
                </button>

                <div x-show="open === '{{ key }}'" x-collapse class="nakha-sb-panel">
                  {% for g in groups %}
                    <span class="nakha-sb-group-title">{{ g.title }}</span>
                    {{ sbLinks(g.menu) }}
                  {% endfor %}

                  <a href="{{ b.nav_url | default('#') }}" class="nakha-sb-viewall">
                    {{ t('common.view_all') }}
                    <svg class="nakha-flip" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/>
                    </svg>
                  </a>
                </div>
              {% else %}
                {# no columns configured — behave as a plain link #}
                <a href="{{ b.nav_url | default('#') }}" class="nakha-sb-row">
                  <span>{{ b.nav_label }}</span>
                  <svg class="nakha-flip" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity:.4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/>
                  </svg>
                </a>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}

        {# ---- plain links ---- #}
        {% if simpleMenu %}
          {% for item in (simpleMenu.items if simpleMenu.items else simpleMenu) %}
            <div class="nakha-sb-item">
              <a href="{{ item.url | default('#') }}" class="nakha-sb-row">
                <span>{{ item.title }}</span>
                <svg class="nakha-flip" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity:.4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/>
                </svg>
              </a>
              {# sub-items arrive under `item.menu` (measured), not `children` #}
              {% for s in (item.menu or item.children or []) %}
                <a href="{{ s.url | default('#') }}" class="nakha-sb-sublink">{{ s.title }}</a>
                {# third level, indented under its parent #}
                {% for s3 in (s.menu or s.children or []) %}
                  <a href="{{ s3.url | default('#') }}" class="nakha-sb-sublink" style="padding-inline-start: 1.75rem; opacity: .85;">{{ s3.title }}</a>
                {% endfor %}
              {% endfor %}
            </div>
          {% endfor %}
        {% endif %}
      </nav>

      {# ---- offers ---- #}
      {% if dealText %}
        <a href="{{ dealUrl }}" class="nakha-sb-deal">
          <span class="inline-flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.6a.7.7 0 0 1 .62.38l2.4 4.66 5.16.78a.7.7 0 0 1 .38 1.2l-3.74 3.6.88 5.1a.7.7 0 0 1-1.01.74L12 16.65l-4.62 2.4a.7.7 0 0 1-1.01-.73l.88-5.1-3.73-3.6a.7.7 0 0 1 .38-1.2l5.15-.79 2.4-4.66A.7.7 0 0 1 12 2.6Z"/>
            </svg>
            {{ dealText }}
          </span>
          <svg class="nakha-flip" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/>
          </svg>
        </a>
      {% endif %}
    </div>

    {# foot #}
    {% if showLang %}
      <div class="nakha-drawer-foot">
        <span class="nakha-caption block mb-2">{{ t('common.language') }}</span>
        {% form 'lang' %}
          <div class="nakha-sb-seg">
            <button type="submit" name="lang" value="ar" class="font-body {{ 'is-active' if sbLang == 'ar' }}">العربية</button>
            <button type="submit" name="lang" value="en" class="font-body-en {{ 'is-active' if sbLang == 'en' }}">English</button>
          </div>
        {% endform %}
      </div>
    {% endif %}

  </div>
</div>

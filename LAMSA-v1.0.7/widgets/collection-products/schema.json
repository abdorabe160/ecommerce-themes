{
  "name": "منتجات",
  "settings": {
    "eyebrow": {
      "type": "string",
      "label": { "ar": "نص تمهيدي (فوق العنوان)", "en": "Eyebrow (above title)" },
      "default": "الأكثر مبيعاً"
    },
    "title": {
      "type": "text",
      "label": { "ar": "عنوان السكشن — استخدمي <em>كلمة</em> لتلوينها", "en": "Section Title — wrap a word in <em> to accent it" },
      "default": "منتجات تُحبّها <em>بشرتك</em>"
    },
    "description": {
      "type": "text",
      "label": { "ar": "وصف قصير (اختياري)", "en": "Short Description (optional)" },
      "default": ""
    },
    "featuredCollection": {
      "type": "products",
      "label": { "ar": "المنتجات (اتركيها فارغة لعرض الأحدث تلقائياً)", "en": "Products (leave empty to auto-show the latest)" },
      "default": []
    },
    "layout": {
      "type": "select",
      "label": { "ar": "التقسيم", "en": "Layout" },
      "default": "grid",
      "options": [
        { "value": "grid", "label": { "ar": "شبكة", "en": "Grid" } },
        { "value": "slider", "label": { "ar": "سلايدر", "en": "Slider" } },
        { "value": "spotlight", "label": { "ar": "منتج مميّز + شبكة", "en": "Spotlight + grid" } }
      ]
    },
    "header_align": {
      "type": "select",
      "label": { "ar": "محاذاة العنوان", "en": "Header Alignment" },
      "default": "split",
      "options": [
        { "value": "split", "label": { "ar": "العنوان يمين والرابط شمال", "en": "Title start · link end" } },
        { "value": "center", "label": { "ar": "في الوسط", "en": "Centered" } }
      ]
    },
    "background": {
      "type": "select",
      "label": { "ar": "خلفية السكشن", "en": "Section Background" },
      "default": "white",
      "options": [
        { "value": "white", "label": { "ar": "أبيض", "en": "White" } },
        { "value": "blush", "label": { "ar": "وردي فاتح", "en": "Blush" } },
        { "value": "rose", "label": { "ar": "وردي", "en": "Rose wash" } },
        { "value": "sage", "label": { "ar": "سيج فاتح", "en": "Sage wash" } }
      ]
    },
    "limit": {
      "type": "number",
      "label": { "ar": "عدد المنتجات", "en": "Products Limit" },
      "default": 8,
      "min": 2,
      "max": 30,
      "step": 1
    },
    "columns_desktop": {
      "type": "select",
      "label": { "ar": "عدد الأعمدة (كمبيوتر)", "en": "Columns (Desktop)" },
      "default": "4",
      "options": [
        { "value": "2", "label": { "ar": "عمودان", "en": "2 Columns" } },
        { "value": "3", "label": { "ar": "٣ أعمدة", "en": "3 Columns" } },
        { "value": "4", "label": { "ar": "٤ أعمدة", "en": "4 Columns" } },
        { "value": "5", "label": { "ar": "٥ أعمدة", "en": "5 Columns" } }
      ]
    },
    "columns_mobile": {
      "type": "select",
      "label": { "ar": "عدد الأعمدة (موبايل)", "en": "Columns (Mobile)" },
      "default": "2",
      "options": [
        { "value": "1", "label": { "ar": "عمود واحد", "en": "1 Column" } },
        { "value": "2", "label": { "ar": "عمودان", "en": "2 Columns" } }
      ]
    },
    "card_image_ratio": {
      "type": "select",
      "label": { "ar": "أبعاد صورة البطاقة", "en": "Card Image Ratio" },
      "default": "1/1",
      "options": [
        { "value": "1/1", "label": { "ar": "مربّع", "en": "Square" } },
        { "value": "4/5", "label": { "ar": "طولي خفيف", "en": "Portrait" } },
        { "value": "3/4", "label": { "ar": "طولي", "en": "Tall" } }
      ]
    },
    "view_all_url": {
      "type": "string",
      "label": { "ar": "رابط عرض الكل (اتركيه فارغاً لإخفائه)", "en": "View All URL (leave empty to hide)" },
      "default": "/shop"
    },
    "view_all_text": {
      "type": "string",
      "label": { "ar": "نص رابط عرض الكل", "en": "View All Text" },
      "default": ""
    },
    "show_arrows": {
      "type": "boolean",
      "label": { "ar": "أسهم التنقل (للسلايدر)", "en": "Navigation Arrows (slider)" },
      "default": true
    },
    "show_progress": {
      "type": "boolean",
      "label": { "ar": "شريط التقدّم (للسلايدر)", "en": "Progress Bar (slider)" },
      "default": true
    }
  },
  "presets": [
    {
      "category": "الصفحة الرئيسية",
      "name": "منتجات"
    }
  ]
}

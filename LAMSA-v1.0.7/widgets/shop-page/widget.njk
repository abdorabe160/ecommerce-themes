{# ============================================================================
   LAMSA SHOP PAGE — the browsing shell for /shop, /shop/:handle and /shop?q=
   ----------------------------------------------------------------------------
   ⚠️  This widget is only the CHROME. The product grid itself is rendered by
   the `shop-products` widget, which Qumra injects into
   #products-grid-wrapper[data-qumra-section="shop-products"].

   ⚠️  CONTRACT with collectionFilter() in assets/main.js — do not rename:
     · x-data="collectionFilter({ section: 'shop-products', … })"
     · #products-grid-wrapper  → where the section is mounted
     · #products-count         → filled from #products-count-data after a run
     · state used here: loading · filtersOpen · sortOpen · currentSort
                        priceMin/priceMax · activeCount · collectionId
                        sortBy() · clearFilters() · setCollection() · goToPage()
   Translations are NOT dumped here any more — main.js falls back to the shared
   strings in __QUMRA_CONFIG__.card.
   ========================================================================= #}

{% set id = widget.id %}
{% set d = widget.data %}

{# /shop/<handle> sends context.shop.collection, /collections/<handle> context.collection #}
{% set pageCol = context.collection or (context.shop.collection if context.shop else null) %}
{# never list a hidden collection or the platform's own «Home Page» #}
{% set collections = [] %}
{% for c in (context.collections | default([], true)) %}
  {% if c.title and c.title != 'Home Page' and c.handle != 'home-page' and not c.deleted and not (c.salesChannels and c.salesChannels.onlineStore == false) %}{% set _ = collections.push(c) %}{% endif %}
{% endfor %}
{% set filters = (context.shop.filters.available if (context.shop and context.shop.filters) else context.filters) or [] %}

{% set showBreadcrumb = d.show_breadcrumb | default(true) %}
{% set showSearch = d.show_search | default(true) %}
{% set showRail = d.show_collection_rail | default(true) %}
{% set sidebarCollections = d.show_sidebar_collections | default(false) %}
{% set showSort = d.show_sort | default(true) %}
{% set showFilters = (d.show_filters | default(true)) and (filters | length) > 0 %}

{% set colsD = d.columns_desktop | default('3') %}
{% set colsM = d.columns_mobile | default('2') %}
{% set ratio = d.card_image_ratio | default('1/1') %}

{# the collection page reuses this widget — its title wins over the setting #}
{% set pageTitle = pageCol.title if pageCol and pageCol.title else (d.title | default(t('pages.shop.all_products'), true)) %}
{% set pageDesc = pageCol.description if pageCol and pageCol.description else (d.description | default('')) %}

{# Range filter handles drive priceMin/priceMax in the Alpine component. They are
   emitted as a JS array inline in the x-data below (see `rangeHandles`).
   The previous version captured a single handle in a loop, which picked the LAST
   range filter; the component now takes the FIRST, so the topmost slider in the
   panel — the one a shopper reads as "price" — is the one actually applied.
   ⚠️  Known gap: ui/filter-panel.njk renders a slider per range filter but they
   all bind to the same priceMin/priceMax pair, so a second range filter moves
   with the first. Needs per-handle state in collectionFilter() to fix properly. #}

{% if colsD == '2' %}{% set gridClass = 'md:grid-cols-2' %}
{% elif colsD == '4' %}{% set gridClass = 'md:grid-cols-3 lg:grid-cols-4' %}
{% else %}{% set gridClass = 'md:grid-cols-2 lg:grid-cols-3' %}{% endif %}


<style>
  .lamsa-shop-{{ id }}-title {
    margin: 0;
    font-family: var(--font-display-ar);
    font-size: clamp(1.625rem, 3.4vw, 2.375rem);
    font-weight: 700;
    line-height: 1.24;
    color: var(--color-text-primary);
  }
  html[dir="ltr"] .lamsa-shop-{{ id }}-title { font-family: var(--font-display-en); }
  html[dir="rtl"] .lamsa-shop-{{ id }}-title { line-height: 1.34; }

  /* sort dropdown */
  .lamsa-shop-{{ id }}-sortmenu {
    min-width: 220px;
    padding: 6px;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
  }
  .lamsa-shop-{{ id }}-sortmenu button {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 14px;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text-secondary);
    font-family: inherit;
    font-size: 0.875rem;
    text-align: start;
    cursor: pointer;
    transition: background var(--t-fast) var(--ease-soft), color var(--t-fast) var(--ease-soft);
  }
  .lamsa-shop-{{ id }}-sortmenu button:hover { background: var(--color-accent-light); color: var(--color-text-primary); }
  .lamsa-shop-{{ id }}-sortmenu button.is-active { color: var(--color-accent-dark); font-weight: 700; }

  /* the grid fades while a filter request is in flight */
  .lamsa-shop-{{ id }}-results { transition: opacity var(--t-base) var(--ease-soft); }
  .lamsa-shop-{{ id }}-results.is-loading { opacity: 0.4; pointer-events: none; }
</style>


<section id="lamsa-shop-{{ id }}" class="lamsa-section"
         x-data="collectionFilter({
           collectionId: '{{ (pageCol._id if pageCol else '') }}',
           rangeHandles: [{% for filter in filters %}{% if filter.inputType == 'range' %}'{{ filter.handle }}',{% endif %}{% endfor %}],
           section: 'shop-products',
           collections: [{% for col in collections %}{ id: '{{ col._id }}', slug: {{ (col.slug or '') | dump | escape }}, title: {{ col.title | dump | escape }} }{% if not loop.last %},{% endif %}{% endfor %}],
           cardSettings: {
             gridClass: '{{ gridClass }}',
             imageRatio: '{{ ratio }}'
           }
         })">

  <div class="lamsa-container">

    {# ═════════════════ breadcrumb ═════════════════ #}
    {% if showBreadcrumb %}
      <nav class="flex items-center gap-2 flex-wrap mb-6 lamsa-caption" aria-label="breadcrumb">
        <a href="/" class="hover:text-accent transition-colors">{{ t('common.home') }}</a>
        <svg class="rtl-flip shrink-0" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="opacity:.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/>
        </svg>
        {% if pageCol and pageCol.title %}
          <a href="/shop" class="hover:text-accent transition-colors">{{ t('pages.shop.title') }}</a>
          <svg class="rtl-flip shrink-0" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="opacity:.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/>
          </svg>
          <span style="color: var(--color-text-secondary);">{{ pageCol.title }}</span>
        {% else %}
          <span style="color: var(--color-text-secondary);">{{ t('pages.shop.title') }}</span>
        {% endif %}
      </nav>
    {% endif %}

    {# ═════════════════ header ═════════════════ #}
    <div class="flex flex-col gap-4 mb-8">
      <h1 class="lamsa-shop-{{ id }}-title">
        <span x-show="!searchQuery">{{ pageTitle }}</span>
        <span x-show="searchQuery" x-cloak>
          {{ t('pages.search.results_for') }}
          <span style="color: var(--color-accent);" x-text="'“' + searchQuery + '”'"></span>
        </span>
      </h1>

      {% if pageDesc %}
        <p class="lamsa-head-desc m-0" style="max-width: 62ch;">{{ pageDesc | safe }}</p>
      {% endif %}

      {% if showSearch %}
        <div class="lamsa-search max-w-md" x-data="{ q: '' }" x-init="q = searchQuery">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85">
            <circle cx="11" cy="11" r="7.25"/><path stroke-linecap="round" d="m20.5 20.5-4.2-4.2"/>
          </svg>
          <input type="search"
                 x-model="q"
                 @keydown.enter="setSearchQuery(q)"
                 @search="setSearchQuery(q)"
                 placeholder="{{ t('pages.shop.search_placeholder') }}"
                 aria-label="{{ t('pages.search.title') }}"/>
        </div>
      {% endif %}
    </div>

    {# ═════════════════ collection rail ═════════════════ #}
    {% if showRail and (collections | length) > 0 %}
      <div class="lamsa-chip-rail mb-7">
        <button type="button" class="lamsa-chip" :class="!collectionId && 'is-active'"
                @click="setCollection('', '')">
          {{ t('pages.shop.all_products') }}
        </button>
        {% for col in collections %}
          <button type="button" class="lamsa-chip"
                  :class="collectionId === '{{ col._id }}' && 'is-active'"
                  @click="setCollection('{{ col._id }}', '{{ (col.slug | default('')) }}')">
            {{ col.title }}
            {% if col.productsCount %}<span class="lamsa-chip-count font-num">{{ col.productsCount }}</span>{% endif %}
          </button>
        {% endfor %}
      </div>
    {% endif %}

    {# ═════════════════ body ═════════════════ #}
    <div class="flex items-start gap-9">

      {% if showFilters %}
        {% ui "filter-panel.njk", variant='sidebar', filters=filters, collections=collections, show_collections=sidebarCollections %}
      {% endif %}

      <div class="flex-1 min-w-0">

        {# ---------- toolbar ---------- #}
        <div class="flex items-center justify-between gap-3 flex-wrap mb-6">

          <div class="flex items-center gap-2.5">
            {% if showFilters %}
              <button type="button" @click="filtersOpen = true"
                      class="lamsa-btn lamsa-btn--outline lamsa-btn--sm lg:hidden">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
                     stroke-linecap="round">
                  <path d="M3.5 6.5h17M6.5 12h11M10 17.5h4"/>
                </svg>
                {{ t('pages.collection.filter') }}
                <span class="lamsa-badge lamsa-badge--sale font-num" x-show="activeCount > 0" x-cloak
                      x-text="activeCount"></span>
              </button>
            {% endif %}

            <span class="lamsa-caption inline-flex items-center gap-2" x-show="loading" x-cloak>
              <span class="lamsa-spinner" style="width: 14px; height: 14px; border-width: 1.5px;"></span>
              {{ t('common.loading') }}
            </span>
          </div>

          {% if showSort %}
            <div class="relative" @click.outside="sortOpen = false">
              <button type="button" @click="sortOpen = !sortOpen"
                      class="lamsa-btn lamsa-btn--outline lamsa-btn--sm"
                      :aria-expanded="sortOpen">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
                     stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 4v16m0 0-3-3m3 3 3-3M17 20V4m0 0-3 3m3-3 3 3"/>
                </svg>
                {{ t('search.sort_by') }}
              </button>

              <div x-show="sortOpen" x-cloak
                   x-transition:enter="transition ease-out duration-200"
                   x-transition:enter-start="opacity-0 -translate-y-1"
                   x-transition:enter-end="opacity-100 translate-y-0"
                   class="absolute top-full mt-2 end-0 z-50 lamsa-shop-{{ id }}-sortmenu">
                {# written out flat on purpose — an array of object literals in
                   {% set %} is another construct with no precedent in this theme #}
                {% macro sortItem(value, label) %}
                  <button type="button"
                          :class="currentSort === '{{ value }}' && 'is-active'"
                          @click="sortBy('{{ value }}')">
                    <span>{{ label }}</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
                         x-show="currentSort === '{{ value }}'">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4 12.5 9.5 18 20 6.5"/>
                    </svg>
                  </button>
                {% endmacro %}
                {{ sortItem('newest',        t('search.newest')) }}
                {{ sortItem('price_asc',     t('search.price_low_high')) }}
                {{ sortItem('price_desc',    t('search.price_high_low')) }}
                {{ sortItem('highest_rated', t('search.highest_rated')) }}
              </div>
            </div>
          {% endif %}
        </div>

        {# ---------- results ----------
             Qumra mounts the `shop-products` widget inside this wrapper.
             Do not put anything else in it — a re-render replaces its contents. #}
        <div class="lamsa-shop-{{ id }}-results" :class="loading && 'is-loading'">
          <div id="products-grid-wrapper" data-qumra-section="shop-products"></div>
        </div>

      </div>
    </div>
  </div>

  {# ═════════════════ mobile filter drawer ═════════════════ #}
  {% if showFilters %}
    {% ui "filter-panel.njk", variant='drawer', filters=filters, collections=collections, show_collections=sidebarCollections %}
  {% endif %}
</section>

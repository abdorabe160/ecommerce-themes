{# ===== ATTAR STEPS — Fragrance ritual · connected gold numerals ===== #}
{% set eyebrow = widget.data.eyebrow | default('') %}
{% set stepsTitle = widget.data.steps_title | safe %}
{% set steps = widget.blocks | default([]) %}
{% set id = widget.id %}
{% set n = steps | length %}
{% set cols = n if n <= 4 else 4 %}

{% if steps and n > 0 %}
<style>
  .attar-steps-{{ id }} .attar-step-num {
    position: relative;
    width: 64px; height: 64px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 999px;
    background: radial-gradient(120% 120% at 50% 22%, var(--color-accent-light) 0%, var(--color-bg-secondary) 68%);
    border: 1px solid rgba(201, 162, 39, 0.34);
    color: var(--color-accent);
    font-family: var(--font-heading-en);
    font-size: 1.7rem; line-height: 1;
    transition: border-color 0.4s ease, box-shadow 0.5s ease, transform 0.5s ease;
  }
  .attar-steps-{{ id }} .attar-step-num::after {
    content: ''; position: absolute; inset: 5px;
    border-radius: 999px; border: 1px solid rgba(201, 162, 39, 0.14);
    transition: border-color 0.4s ease;
  }
  .attar-steps-{{ id }} .attar-step:hover .attar-step-num {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-accent-light), 0 12px 30px -14px rgba(201, 162, 39, 0.55);
    transform: translateY(-3px);
  }
  .attar-steps-{{ id }} .attar-step:hover .attar-step-num::after { border-color: rgba(201, 162, 39, 0.4); }

  /* Connecting gold line behind the numerals (desktop) */
  .attar-steps-{{ id }} .attar-steps-line {
    position: absolute; top: 32px; inset-inline: 8%;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(201,162,39,0.35) 12%, rgba(201,162,39,0.35) 88%, transparent);
  }

  .attar-steps-{{ id }} .attar-step-title {
    font-family: var(--font-heading-ar);
    font-size: 1.25rem; font-weight: 600; line-height: 1.3;
    color: var(--color-text-primary);
  }
  .attar-steps-{{ id }} .attar-step-desc {
    font-family: var(--font-body-ar);
    font-size: 13.5px; line-height: 1.9; color: var(--color-text-secondary);
    max-width: 26ch;
  }
</style>

<section id="{{ id }}" class="attar-steps-{{ id }} py-24 max-sm:py-14" style="background: var(--color-bg-secondary);">
  <div class="container mx-auto px-6 max-sm:px-4">

    {% if eyebrow or stepsTitle %}
      <div class="text-center mb-16 max-sm:mb-10">
        {% if eyebrow %}
        <div class="flex items-center justify-center gap-3 mb-5">
          <span class="attar-kicker-line"></span>
          <span class="editorial-label">{{ eyebrow }}</span>
          <span class="attar-kicker-line"></span>
        </div>
        {% endif %}
        {% if stepsTitle %}
          <h2 class="font-heading-ar" style="font-weight: 500; font-size: clamp(2rem, 4.5vw, 3.2rem); line-height: 1.15; letter-spacing: -0.015em; color: var(--color-text-primary);">{{ stepsTitle }}</h2>
        {% endif %}
      </div>
    {% endif %}

    <div class="relative">
      {% if n > 1 %}<div class="attar-steps-line hidden lg:block"></div>{% endif %}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-{{ cols }} gap-x-8 gap-y-14 relative">
        {% for step in steps %}
          {% set num = ('0' ~ loop.index) if loop.index < 10 else loop.index %}
          <div class="attar-step flex flex-col items-center text-center gap-4">
            <span class="attar-step-num">{{ num }}</span>
            {% if step.data.step_title %}
              <h3 class="attar-step-title">{{ step.data.step_title }}</h3>
            {% endif %}
            {% if step.data.step_description %}
              <p class="attar-step-desc">{{ step.data.step_description }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

  </div>
</section>
{% endif %}

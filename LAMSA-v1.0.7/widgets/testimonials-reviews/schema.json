      "default": "blush",
      "options": [
        {
          "value": "white",
          "label": {
            "ar": "أبيض",
            "en": "White"
          }
        },
        {
          "value": "blush",
          "label": {
            "ar": "وردي فاتح",
            "en": "Blush"
          }
        },
        {
          "value": "rose",
          "label": {
            "ar": "وردي",
            "en": "Rose wash"
          }
        },
        {
          "value": "sage",
          "label": {
            "ar": "سيج فاتح",
            "en": "Sage wash"
          }
        }
      ]
    },
    "columns": {
      "type": "select",
      "label": {
        "ar": "عدد الأعمدة (كمبيوتر)",

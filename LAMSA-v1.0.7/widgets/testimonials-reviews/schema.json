    "autoplay": {
      "type": "boolean",
      "label": {
        "ar": "تشغيل السلايدر تلقائياً",
        "en": "Autoplay Slider"
      },
      "default": false
    },
    "autoplay_speed": {
      "type": "number",
      "label": {
        "ar": "سرعة التبديل (ثانية)",
        "en": "Autoplay Delay (seconds)"
      },
      "default": 6,
      "min": 3,
      "max": 15,
      "step": 1
    }
  },
  "blocks": {
    "review": {
      "name": "تقييم",
      "settings": {
        "review_text": {
          "type": "text",
          "label": {
            "ar": "نص التقييم",
            "en": "Review Text"
          },
          "default": ""
        },
        "reviewer_name": {
          "type": "string",
          "label": {
            "ar": "اسم العميلة",
            "en": "Reviewer Name"
          },
          "default": ""
        },
        "reviewer_role": {
          "type": "string",
          "label": {
            "ar": "المدينة أو نوع البشرة",
            "en": "City or skin type"
          },
          "default": ""
        },
        "rating": {
          "type": "number",
          "label": {
            "ar": "التقييم (من ٥)",
            "en": "Rating (out of 5)"
          },
          "default": 5,
          "min": 1,
          "max": 5,
          "step": 1
        },
        "verified": {
          "type": "boolean",
          "label": {
            "ar": "شراء موثّق",
            "en": "Verified purchase"
          },
          "default": true
        },
        "avatar": {
          "type": "media",
          "label": {
            "ar": "صورة العميلة (اختياري)",
            "en": "Reviewer Photo (optional)"
          }
        },
        "image_before": {
          "type": "media",
          "label": {
            "ar": "صورة «قبل» — ترفعينها مع «بعد» لعرض المقارنة",
            "en": "\"Before\" image — upload with \"after\" to show the comparison"
          }
        },
        "image_after": {
          "type": "media",
          "label": {
            "ar": "صورة «بعد»",
            "en": "\"After\" image"
          }
        },
        "duration": {
          "type": "string",
          "label": {
            "ar": "مدة الاستخدام (تظهر فوق المقارنة)",
            "en": "Usage duration (shown above the comparison)"
          },
          "default": ""
        },
        "product": {
          "type": "products",
          "label": {
            "ar": "المنتج المُقيَّم (اختياري — اختاري منتجاً واحداً)",
            "en": "Reviewed product (optional — pick one)"
          },
          "default": []
        }
      }
    }
  },
  "presets": [
    {
      "category": "الصفحة الرئيسية",
      "name": "آراء العملاء"
    }
  ]
}

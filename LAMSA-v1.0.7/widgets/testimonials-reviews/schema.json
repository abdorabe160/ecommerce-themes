      "default": "3",
      "options": [
        {
          "value": "2",
          "label": {
            "ar": "عمودان",
            "en": "2"
          }
        },
        {
          "value": "3",
          "label": {
            "ar": "٣ أعمدة",
            "en": "3"
          }
        },
        {
          "value": "4",
          "label": {
            "ar": "٤ أعمدة",
            "en": "4"
          }
        }
      ]
    },
    "ba_ratio": {
      "type": "select",
      "label": {
        "ar": "أبعاد صور قبل/بعد",

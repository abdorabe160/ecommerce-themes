      },
      "default": "1/1",
      "options": [
        {
          "value": "1/1",
          "label": {
            "ar": "مربّع",
            "en": "Square"
          }
        },
        {
          "value": "4/5",
          "label": {
            "ar": "طولي خفيف",
            "en": "Portrait 4:5"
          }
        },
        {
          "value": "4/3",
          "label": {
            "ar": "عرضي",
            "en": "Landscape 4:3"
          }
        }
      ]
    },
    "show_summary": {
      "type": "boolean",
      "label": {
        "ar": "إظهار ملخّص التقييم أعلى السكشن",
        "en": "Show the rating summary above the section"
      },
      "default": true
    },
    "summary_rating": {
      "type": "string",
      "label": {
        "ar": "متوسّط التقييم",
        "en": "Average Rating"
      },
      "default": ""

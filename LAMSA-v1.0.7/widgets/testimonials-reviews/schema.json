    "layout": {
      "type": "select",
      "label": {
        "ar": "التقسيم",
        "en": "Layout"
      },
      "default": "slider",
      "options": [
        {
          "value": "slider",
          "label": {
            "ar": "سلايدر",
            "en": "Slider"
          }
        },
        {
          "value": "grid",
          "label": {
            "ar": "شبكة",
            "en": "Grid"
          }
        }
      ]
    },
    "background": {
      "type": "select",
      "label": {
        "ar": "خلفية السكشن",

<!DOCTYPE html>
{#
  ============================================================================
  LAMSA · لمسة — Root layout
  Beauty & skincare · Soft Clinical design language
  ----------------------------------------------------------------------------
  Order matters here:
    1. Fonts (preconnect early)      2. {% seo %} + {% qumra_head %}
    3. style.css (the design system) 4. :root overrides from Theme Editor
    5. Tailwind CDN + config mapped onto the CSS vars
    6. Swiper / GLightbox CSS
  Body:
    header template → {% content %} → footer template → global overlays
    → vendor JS → __QUMRA_CONFIG__ → {% qumra_scripts %} → main.js
  NOTE: {% qumra_head %} / {% qumra_scripts %} do NOT ship Tailwind, fonts,
        Alpine, Swiper or GLightbox — they are all loaded manually below.
  ============================================================================
#}
{% set lang = localization.language | default('ar') %}
{% set isRtl = lang != 'en' %}

{# ---- Fonts: display + body, per script, driven by theme settings ---- #}
{% set fontDisplayAr = settings.fontDisplayArabic | default('El Messiri', true) %}
{% set fontBodyAr    = settings.fontBodyArabic    | default('Tajawal', true) %}
{% set fontLatin     = settings.fontLatin         | default('Poppins', true) %}

{# ---- Shape knobs: corner style → card / button / input / media radii ---- #}
{% set cornerStyle = settings.cornerStyle | default('soft', true) %}
{% if cornerStyle == 'sharp' %}
  {% set rCard = '4px' %}{% set rInput = '4px' %}{% set rMedia = '4px' %}
{% elif cornerStyle == 'rounded' %}
  {% set rCard = '14px' %}{% set rInput = '10px' %}{% set rMedia = '14px' %}
{% elif cornerStyle == 'pillowy' %}
  {% set rCard = '28px' %}{% set rInput = '20px' %}{% set rMedia = '28px' %}
{% else %}
  {% set rCard = '20px' %}{% set rInput = '14px' %}{% set rMedia = '20px' %}
{% endif %}

{% set buttonStyle = settings.buttonStyle | default('pill', true) %}
{% if buttonStyle == 'square' %}{% set rBtn = '4px' %}
{% elif buttonStyle == 'rounded' %}{% set rBtn = '14px' %}
{% else %}{% set rBtn = '999px' %}{% endif %}

{# ---- Card shadow depth ---- #}
{% set cardShadow = settings.cardShadow | default('soft', true) %}
{% if cardShadow == 'none' %}
  {% set shCard = 'none' %}{% set shCardHover = 'var(--shadow-sm)' %}
{% elif cardShadow == 'lifted' %}
  {% set shCard = 'var(--shadow-md)' %}{% set shCardHover = 'var(--shadow-lg)' %}
{% else %}
  {% set shCard = 'var(--shadow-sm)' %}{% set shCardHover = 'var(--shadow-md)' %}
{% endif %}

{# ---- Section rhythm ---- #}
{% set spacing = settings.sectionSpacing | default('normal', true) %}
{% if spacing == 'compact' %}{% set secPy = '60px' %}{% set secPySm = '40px' %}
{% elif spacing == 'roomy' %}{% set secPy = '120px' %}{% set secPySm = '72px' %}
{% else %}{% set secPy = '88px' %}{% set secPySm = '56px' %}{% endif %}

{% set containerWidth = settings.containerWidth | default('1280', true) %}

<html lang="{{ lang }}" dir="{{ 'rtl' if isRtl else 'ltr' }}"{% if not (settings.enableAnimations | default(true)) %} class="lamsa-no-motion"{% endif %}>
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    {# ===== Editor-only furniture =====
       A section added in the builder and not filled in yet shows an «add…»
       empty state so the merchant can see it. Shoppers must never see that:
       on the live store (the top window — the builder previews in an iframe,
       the same test the scroll reveal in main.js uses) `[data-lamsa-empty]`
       sections and `.lamsa-editor-only` notes are removed before first paint.
       `[hidden]` is forced too: a class with its own `display` beats it. #}
    <script>if (window.self === window.top) document.documentElement.classList.add('lamsa-live');</script>
    <style>.lamsa-live [data-lamsa-empty], .lamsa-live .lamsa-editor-only { display: none !important; } [hidden] { display: none !important; }</style>
    <meta name="theme-color" content="{{ settings.backgroundColor | default('#FFF5F7', true) }}"/>

    {# ===== Google Search Console =====
       Google reads this from the homepage HTML. Paste ONLY the token out of the
       content="..." of the tag Google hands you — pasting the whole tag puts a
       literal <meta …> inside this one's content and verification fails. #}
    {% if settings.googleSiteVerification %}
      {# Merchants paste what Google shows them, and what Google shows them is
         the whole attribute. Strip the wrapper rather than let verification
         fail on a paste that was reasonable. Bare token passes through. #}
      {# Google shows the WHOLE tag (<meta name="google-site-verification"
         content="…" />); the replace chain left «<meta name=… abc /» in the
         attribute and verification failed. Take the content value when there
         is one, otherwise the bare token. #}
      {% set gsvRaw = settings.googleSiteVerification | trim %}
      {% set _gvI = gsvRaw.indexOf('content=') %}{% set _gvTail = gsvRaw.slice(_gvI + 8) | trim if _gvI > -1 else '' %}{% set gsvMatch = [gsvRaw, _gvTail.slice(1).split(_gvTail.slice(0, 1))[0]] if _gvTail else false %}
      {% set gsv = (gsvMatch[1] if gsvMatch else gsvRaw | replace('"', '') | replace("'", '')) | trim %}
      <meta name="google-site-verification" content="{{ gsv }}"/>
    {% endif %}

    {# ===== Google Analytics 4 =====
       Production only. `qumra theme dev` and the Theme Editor preview both run
       the full layout, so without this gate the merchant's own editing session
       lands in their traffic — and on a new store that is most of it.

       `async` + placed this high so the pageview fires early without the script
       ever blocking the render. The id goes through `dump` on the JS side so it
       arrives as a properly quoted string rather than pasted into source. #}
    {% set gaId = settings.googleAnalyticsId | trim %}
    {% if gaId %}
      <script>
        /* The gate, and it has to be client-side: `store.mode` describes the
           STORE, not the server, so it still says "production" under
           `qumra theme dev` — a local session would otherwise land in the
           merchant's real traffic. The host is the only honest signal.
           `?lamsa_debug=1` still prints every event to the console either way. */
        (function () {
          /* Theme Editor preview loads the real storefront in an iframe, so
             without this every time the merchant opens the editor it counts as
             a visit to their own store.

             Narrowed to the Qumra admin specifically rather than "any frame":
             Google's own Test installation check, and tag debuggers, may load
             the page framed too, and a blanket block would make them report a
             missing tag that is in fact there. */
          if (window.self !== window.top && (document.referrer || '').indexOf('qumra.cloud') !== -1) return;

          var h = location.hostname;
          if (h === 'localhost' || h === '127.0.0.1' || h === '[::1]' ||
              /\.local$/.test(h) || /^192\.168\./.test(h) || /^10\./.test(h) ||
              /\.trycloudflare\.com$/.test(h) || /\.ngrok(-free)?\.(io|app)$/.test(h)) {
            return;
          }
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', {{ gaId | dump | safe }});
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' +
                  encodeURIComponent({{ gaId | dump | safe }});
          document.head.appendChild(s);
        })();
      </script>
    {% endif %}

    {# ===== Google Fonts ===== #}
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link
      href="https://fonts.googleapis.com/css2?family={{ fontDisplayAr | replace(' ', '+') }}:wght@400;500;600;700&family={{ fontBodyAr | replace(' ', '+') }}:wght@300;400;500;700;800&family={{ fontLatin | replace(' ', '+') }}:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"/>

    {% seo %}
    {% qumra_head %}

    {# after seo: it points at /favicon.ico, and the last link wins #}
    {% if settings.favicon and settings.favicon.fileUrl %}
      <link rel="icon" href="{{ settings.favicon.fileUrl }}"/>
      <link rel="apple-touch-icon" href="{{ settings.favicon.fileUrl }}"/>
    {% endif %}

    {# ===== LAMSA design system ===== #}
    {% set assetv = '6db08993' %}
    <link rel="stylesheet" href="{{ 'style.css' | assets }}?v={{ assetv }}"/>

    {# ===== Brand colour =====
       primaryColor is the one colour a merchant changes. The hover, dark, soft and
       light shades are settings of their own with rose defaults, so a store that
       only changed the primary kept rose hovers and chips. A shade still on its
       default follows the primary; the default rose pair is left exactly as it is. #}
    {% set pc = settings.primaryColor | default('#C97B8E', true) %}
    {% set pcOwn = pc != '#C97B8E' %}
    {% set pcHover = settings.primaryColorHover | default('#B36679', true) %}
    {% set pcDark = settings.primaryColorDark | default('#9E5568', true) %}
    {% set pcSoft = settings.primaryColorSoft | default('#F5D3DB', true) %}
    {% set pcLight = settings.primaryColorLight | default('#FBE8EC', true) %}
    {% if pcOwn and pcHover == '#B36679' %}{% set pcHover = 'color-mix(in srgb, ' ~ pc ~ ' 86%, #000)' %}{% endif %}
    {% if pcOwn and pcDark == '#9E5568' %}{% set pcDark = 'color-mix(in srgb, ' ~ pc ~ ' 74%, #000)' %}{% endif %}
    {% if pcOwn and pcSoft == '#F5D3DB' %}{% set pcSoft = 'color-mix(in srgb, ' ~ pc ~ ' 30%, #fff)' %}{% endif %}
    {% if pcOwn and pcLight == '#FBE8EC' %}{% set pcLight = 'color-mix(in srgb, ' ~ pc ~ ' 14%, #fff)' %}{% endif %}

    {# ===== Theme Editor overrides — always applied, no gate ===== #}
    <style>
      :root {
        /* Accent · dusty rose */
        --color-accent:        {{ settings.primaryColor | default('#C97B8E', true) }};
        --color-accent-hover:  {{ pcHover }};
        --color-accent-dark:   {{ pcDark }};
        --color-accent-soft:   {{ pcSoft }};
        --color-accent-light:  {{ pcLight }};
        /* Contrast floor. The accent fills buttons, badges and chips under white
           text and colours links on the blush ground; the default dusty rose gave
           3.1:1 there. Each value is re-declared through a relative colour that
           caps its lightness, so a light pick is deepened only as far as 4.5:1
           needs and a dark pick passes through untouched. A browser without
           relative colours keeps the line above. `l * 1`, never a bare `l`,
           inside min(): the bare channel crashes Chromium ≤ 130. */
        --color-accent:        oklch(from {{ settings.primaryColor | default('#C97B8E', true) }} min(l * 1, 0.53) c h);
        --color-accent-hover:  oklch(from {{ pcHover }} min(l * 1, 0.47) c h);
        --color-accent-dark:   oklch(from {{ pcDark }} min(l * 1, 0.42) c h);
        {% if pcOwn %}
        --shadow-accent: 0 8px 22px -8px color-mix(in srgb, {{ pc }} 45%, transparent);
        --shadow-focus:  0 0 0 4px color-mix(in srgb, {{ pc }} 18%, transparent);
        --lamsa-ring:    color-mix(in srgb, {{ pc }} 35%, transparent);
        {% endif %}

        /* Status colours: empty keeps the theme's own look. Text gets the same
           lightness floor as the accent. */
        {% if settings.saleColor %}
        --color-sale:          {{ settings.saleColor }};
        --color-sale:          oklch(from {{ settings.saleColor }} min(l * 1, 0.53) c h);
        --color-sale-soft:     color-mix(in srgb, {{ settings.saleColor }} 14%, #fff);
        {% endif %}
        {% if settings.successColor %}
        --color-success:       {{ settings.successColor }};
        --color-success:       oklch(from {{ settings.successColor }} min(l * 1, 0.5) c h);
        --color-success-light: color-mix(in srgb, {{ settings.successColor }} 14%, #fff);
        --color-stock:         var(--color-success);
        --color-stock-soft:    var(--color-success-light);
        {% endif %}
        {% if settings.warningColor %}
        --color-warning:       {{ settings.warningColor }};
        --color-warning:       oklch(from {{ settings.warningColor }} min(l * 1, 0.5) c h);
        --color-warning-light: color-mix(in srgb, {{ settings.warningColor }} 14%, #fff);
        --color-low:           var(--color-warning);
        --color-low-soft:      var(--color-warning-light);
        {% endif %}

        /* Sage · trust */
        --color-sage:          {{ settings.sageColor | default('#7FA99B', true) }};
        --color-sage-hover:    {{ settings.sageColorDark | default('#6B9285', true) }};
        --color-sage-soft:     {{ settings.sageColorSoft | default('#CFE1DA', true) }};
        --color-sage-light:    {{ settings.sageColorLight | default('#EAF2EF', true) }};
        /* same floor for the sage fills (badges, announcement bar, bands) */
        --color-sage:          oklch(from {{ settings.sageColor | default('#7FA99B', true) }} min(l * 1, 0.52) c h);
        --color-sage-hover:    oklch(from {{ settings.sageColorDark | default('#6B9285', true) }} min(l * 1, 0.46) c h);

        /* Surfaces */
        --color-bg-primary:    {{ settings.backgroundColor | default('#FFF5F7', true) }};
        --color-bg-secondary:  {{ settings.surfaceColor | default('#FFFFFF', true) }};
        --color-bg-tertiary:   {{ settings.wellColor | default('#FDECF0', true) }};
        --color-surface:       {{ settings.surfaceColor | default('#FFFFFF', true) }};
        --color-section-a:     {{ settings.backgroundColor | default('#FFF5F7', true) }};
        --color-section-b:     {{ settings.surfaceColor | default('#FFFFFF', true) }};

        /* Text */
        --color-text-primary:   {{ settings.textColor | default('#3B2C31', true) }};
        --color-text-secondary: {{ settings.textSecondaryColor | default('#6E585E', true) }};
        --color-text-tertiary:  {{ settings.textTertiaryColor | default('#76636A', true) }};
        /* captions, counts, breadcrumbs: was 2.9:1 on the blush ground */
        --color-text-tertiary:  oklch(from {{ settings.textTertiaryColor | default('#76636A', true) }} min(l * 1, 0.53) c h);

        /* Lines */
        --color-border:        {{ settings.borderColor | default('#F4DFE4', true) }};
        --color-border-strong: {{ settings.borderStrongColor | default('#E7C6CE', true) }};
        --color-border-hover:  {{ settings.borderStrongColor | default('#E7C6CE', true) }};
        --color-border-focus:  {{ settings.primaryColor | default('#C97B8E', true) }};

        /* Header */
        --color-header:        {{ settings.headerColor | default('#FFF5F7', true) }};
        --color-header-text:   {{ settings.headerTextColor | default('#3B2C31', true) }};
        --color-header-border: {{ settings.borderColor | default('#F4DFE4', true) }};

        /* Footer */
        --color-footer:            {{ settings.footerColor | default('#3B2C31', true) }};
        --color-footer-text:       {{ settings.footerTextColor | default('#C9B6BB', true) }};
        --color-footer-text-muted: {{ settings.footerMutedColor | default('#B09BA1', true) }};
        /* on the dark footer the floor is a minimum lightness (was 3.9:1) */
        --color-footer-text-muted: oklch(from {{ settings.footerMutedColor | default('#B09BA1', true) }} max(l * 1, 0.72) c h);
        --color-footer-heading:    {{ settings.footerHeadingColor | default('#FFF5F7', true) }};
        --color-footer-border:     {{ settings.footerBorderColor | default('#4E3B40', true) }};

        /* Typography */
        --font-display-ar: '{{ fontDisplayAr }}', '{{ fontBodyAr }}', system-ui, sans-serif;
        --font-display-en: '{{ fontLatin }}', system-ui, -apple-system, sans-serif;
        --font-body-ar:    '{{ fontBodyAr }}', system-ui, -apple-system, sans-serif;
        --font-body-en:    '{{ fontLatin }}', system-ui, -apple-system, sans-serif;
        --font-size-base:  {{ settings.baseFontSize | default(16, true) }}px;

        /* Shape */
        --radius-card:  {{ rCard }};
        --radius-input: {{ rInput }};
        --radius-media: {{ rMedia }};
        --radius-btn:   {{ rBtn }};

        /* Elevation */
        --shadow-card:       {{ shCard }};
        --shadow-card-hover: {{ shCardHover }};

        /* Rhythm */
        --section-py:    {{ secPy }};
        --section-py-sm: {{ secPySm }};
        --container-max: {{ containerWidth }}px;
      }
    </style>

    {# ===== Tailwind CDN — config maps utilities onto the CSS vars ===== #}
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          container: {
            center: true,
            padding: { DEFAULT: '24px', sm: '16px', lg: '24px' },
            screens: { '2xl': '{{ containerWidth }}px' },
          },
          extend: {
            colors: {
              accent: {
                DEFAULT: 'var(--color-accent)',
                hover: 'var(--color-accent-hover)',
                dark: 'var(--color-accent-dark)',
                soft: 'var(--color-accent-soft)',
                light: 'var(--color-accent-light)',
              },
              sage: {
                DEFAULT: 'var(--color-sage)',
                hover: 'var(--color-sage-hover)',
                soft: 'var(--color-sage-soft)',
                light: 'var(--color-sage-light)',
              },
              /* legacy alias — old widgets still use accent-secondary */
              'accent-secondary': {
                DEFAULT: 'var(--color-sage)',
                hover: 'var(--color-sage-hover)',
                light: 'var(--color-sage-light)',
              },
              surface: 'var(--color-surface)',
              ink: 'var(--color-text-primary)',
              success: 'var(--color-success)',
              error: 'var(--color-error)',
              warning: 'var(--color-warning)',
              header: 'var(--color-header)',
              footer: 'var(--color-footer)',
              'footer-text': 'var(--color-footer-text)',
              'footer-muted': 'var(--color-footer-text-muted)',
              'footer-heading': 'var(--color-footer-heading)',
              'footer-border': 'var(--color-footer-border)',
            },
            backgroundColor: {
              primary: 'var(--color-bg-primary)',
              secondary: 'var(--color-bg-secondary)',
              tertiary: 'var(--color-bg-tertiary)',
              'section-a': 'var(--color-section-a)',
              'section-b': 'var(--color-section-b)',
              /* legacy aliases */
              green: 'var(--color-sage-light)',
              peach: 'var(--color-accent-light)',
            },
            textColor: {
              primary: 'var(--color-text-primary)',
              secondary: 'var(--color-text-secondary)',
              tertiary: 'var(--color-text-tertiary)',
            },
            borderColor: {
              DEFAULT: 'var(--color-border)',
              soft: 'var(--color-border)',
              strong: 'var(--color-border-strong)',
              hover: 'var(--color-border-strong)',
              focus: 'var(--color-border-focus)',
            },
            fontFamily: {
              display: ['{{ fontDisplayAr }}', '{{ fontLatin }}', 'Georgia', 'serif'],
              'display-en': ['{{ fontLatin }}', 'system-ui', 'sans-serif'],
              body: ['{{ fontBodyAr }}', 'system-ui', 'sans-serif'],
              'body-en': ['{{ fontLatin }}', 'system-ui', 'sans-serif'],
              /* legacy aliases */
              'heading-ar': ['{{ fontDisplayAr }}', 'serif'],
              'heading-en': ['{{ fontLatin }}', 'serif'],
              'body-ar': ['{{ fontBodyAr }}', 'system-ui', 'sans-serif'],
            },
            borderRadius: {
              none: '0px',
              xs: 'var(--radius-xs)',
              sm: 'var(--radius-sm)',
              DEFAULT: 'var(--radius-md)',
              md: 'var(--radius-md)',
              lg: 'var(--radius-lg)',
              xl: 'var(--radius-xl)',
              '2xl': 'var(--radius-2xl)',
              '3xl': 'var(--radius-2xl)',
              card: 'var(--radius-card)',
              btn: 'var(--radius-btn)',
              input: 'var(--radius-input)',
              media: 'var(--radius-media)',
              full: '9999px',
            },
            boxShadow: {
              xs: 'var(--shadow-xs)',
              sm: 'var(--shadow-sm)',
              DEFAULT: 'var(--shadow-sm)',
              md: 'var(--shadow-md)',
              lg: 'var(--shadow-lg)',
              xl: 'var(--shadow-xl)',
              accent: 'var(--shadow-accent)',
              sage: 'var(--shadow-sage)',
              card: 'var(--shadow-card)',
              focus: 'var(--shadow-focus)',
              none: 'none',
            },
            transitionTimingFunction: {
              out: 'cubic-bezier(0.22, 0.61, 0.36, 1)',
              soft: 'cubic-bezier(0.4, 0, 0.2, 1)',
            },
            fontSize: {
              display: ['clamp(2.125rem, 5vw, 3.5rem)', { lineHeight: '1.14', letterSpacing: '-0.01em' }],
              headline: ['clamp(1.625rem, 3.6vw, 2.5rem)', { lineHeight: '1.2' }],
            },
            spacing: {
              section: 'var(--section-py)',
              'section-sm': 'var(--section-py-sm)',
            },
          },
        },
      }
    </script>

    {# ===== Swiper + GLightbox CSS ===== #}
    {# ===== Swiper.js CSS ===== #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11.2.10/swiper-bundle.min.css"/>

    {# ===== Swiper.js =====
       MUST load in <head>, synchronously. Widgets init their sliders from an
       inline <script> that runs while the body is parsed — i.e. BEFORE the end
       of <body>. If Swiper were loaded at the bottom, `typeof Swiper` would be
       'undefined' at that moment and every slider would silently skip init. #}
    <script src="https://cdn.jsdelivr.net/npm/swiper@11.2.10/swiper-bundle.min.js"></script>
    <script>
      /* Anything that moves on its own must stop while it is off-screen —
         `document.hidden` only covers a background tab. Widgets call this
         right after `new Swiper(...)` when autoplay is on. It resumes only an
         autoplay IT paused, so one the visitor stopped by interacting
         (disableOnInteraction) stays stopped. Defined here, not in main.js,
         because widget scripts run while the body is still parsing. */
      window.lamsaAutoplayWhenVisible = function (swiper, el) {
        if (!swiper || !swiper.autoplay) return;
        /* animations off in the theme, or the visitor asked for less motion */
        if (document.documentElement.classList.contains('lamsa-no-motion') ||
            window.matchMedia('(prefers-reduced-motion: reduce)').matches) { swiper.autoplay.stop(); return; }
        if (!el || !('IntersectionObserver' in window)) return;
        var pausedByUs = false;
        new IntersectionObserver(function (entries) {
          if (entries[0].isIntersecting) {
            if (pausedByUs) { pausedByUs = false; swiper.autoplay.start(); }
          } else if (swiper.autoplay.running) {
            pausedByUs = true; swiper.autoplay.stop();
          }
        }, { threshold: 0 }).observe(el);
      };
    </script>

    {# ===== GLightbox CSS + JS ===== (same reason as Swiper: inline widget init) #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox@3.3.1/dist/css/glightbox.min.css"/>
    <script src="https://cdn.jsdelivr.net/npm/glightbox@3.3.1/dist/js/glightbox.min.js"></script>

    {% if settings.customCSS %}
      <style>{{ settings.customCSS | safe }}</style>
    {% endif %}
  </head>

  <body>
    {# ===== Header ===== #}
    {% template "header" %}

    {# ===== Page content ===== #}
    <main id="lamsa-main" data-store-name="{{ store.name }}">{% content %}</main>

    {# ===== Footer ===== #}
    {% template "footer" %}

    {# ===== Exactly one H1 =====
       The hero prints the home H1 on the server. A merchant can still remove the
       hero or add a second one, and no template can see that, so this reads the
       finished page: no H1 gets the store name, hidden; extra ones become H2. #}
    <script>
      (function () {
        var all = document.querySelectorAll('h1'), main = document.getElementById('lamsa-main');
        for (var i = 1; i < all.length; i++) {
          var h2 = document.createElement('h2');
          h2.className = all[i].className;
          h2.innerHTML = all[i].innerHTML;
          all[i].parentNode.replaceChild(h2, all[i]);
        }
        if (all.length || !main) return;
        var name = main.getAttribute('data-store-name') || document.title;
        if (!name) return;
        var h = document.createElement('h1');
        h.className = 'sr-only';
        h.textContent = name;
        main.insertBefore(h, main.firstChild);
      })();
    </script>

    {# =====================================================================
       Quick View modal — content is fetched and injected by main.js
       (Alpine `quickView()` + #quick-view-content-dynamic are contractual)
       ===================================================================== #}
    <div x-data="quickView()" @quick-view.window="openQuickView($event.detail.slug)" x-cloak>
      <div x-show="$store.modal.current === 'quick-view'"
           @click="$store.modal.close()"
           class="lamsa-overlay"
           x-transition:enter="transition ease-out duration-300"
           x-transition:enter-start="opacity-0"
           x-transition:enter-end="opacity-100"
           x-transition:leave="transition ease-in duration-200"
           x-transition:leave-start="opacity-100"
           x-transition:leave-end="opacity-0"></div>

      <div x-show="$store.modal.current === 'quick-view'"
           x-transition:enter="transition ease-out duration-300"
           x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
           x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
           x-transition:leave="transition ease-in duration-200"
           x-transition:leave-start="opacity-100"
           x-transition:leave-end="opacity-0"
           class="lamsa-modal">
        <div class="lamsa-modal-panel" @click.outside="$store.modal.close()">
          <button @click="$store.modal.close()"
                  type="button"
                  aria-label="{{ t('common.close') }}"
                  class="lamsa-btn-icon lamsa-btn-icon--filled lamsa-btn-icon--sm lamsa-modal-close">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>

          <div class="p-6 max-sm:p-5">
            {# Loading #}
            <div x-show="loading" class="flex items-center justify-center py-24">
              <span class="lamsa-spinner" style="width: 30px; height: 30px;"></span>
            </div>

            {# Error #}
            <div x-show="error && !loading" class="lamsa-empty">
              <span class="lamsa-empty-icon">
                <svg class="w-9 h-9" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                </svg>
              </span>
              <p class="lamsa-text-sm">{{t('common.error')}}</p>
            </div>

            {# Injected product markup — Alpine.initTree() runs on it #}
            <div x-show="!loading && !error" id="quick-view-content-dynamic"></div>
          </div>
        </div>
      </div>
    </div>

    {# ===== Toast host (id is contractual with main.js) ===== #}
    <div id="toast-container"
         class="fixed top-5 inset-x-0 z-[9999] flex flex-col items-center gap-2 pointer-events-none px-4"></div>

    {# ===== Alpine.js =====
       Stays at the bottom and deferred: main.js registers the stores and
       components on `alpine:init`, so Alpine must boot after main.js is parsed.
       Swiper/GLightbox are in <head> instead — see the note there. #}
    {# Alpine plugins MUST be deferred before the Alpine core script #}
    <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/collapse@3.17.5/dist/cdn.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.17.5/dist/cdn.min.js"></script>

    {# ===== Runtime config consumed by main.js ===== #}
    <script>
      window.__QUMRA_CONFIG__ = {
        currency: '{{ localization.currency.currencyCode | default("SAR", true) }}',
        currencySymbol: '{{ localization.currency.currencySymbol | default("ر.س", true) }}',
        language: '{{ lang }}',
        exchangeRate: {{ localization.market.exchangeRate | default(1, true) }},
        moneyFormatSample: '{{ 1000 | money }}',
        cartTotalQuantity: {{ cart.totalQuantity | default(0, true) }},
        wishlistIds: [{% for p in wishlist.products %}'{{ p._id }}'{% if not loop.last %},{% endif %}{% endfor %}],
        messages: {
          addedToCart: '{{t("pages.product.added_to_cart")}}',
          addError: '{{t("common.error")}}',
          outOfStock: '{{t("cart.out_of_stock")}}'
        },
        {# Single source of truth for LamsaCard.build() — widgets must NOT
           dump their own copies of these strings any more. #}
        card: {
          addToCart: {{ t('pages.product.add_to_cart') | dump | safe }},
          added: {{ t('pages.product.added') | dump | safe }},
          chooseOptions: {{ t('pages.product.choose_options') | dump | safe }},
          viewProduct: {{ t('pages.product.view_product') | dump | safe }},
          outOfStock: {{ t('pages.product.out_of_stock') | dump | safe }},
          quickView: {{ t('pages.product.quick_view') | dump | safe }},
          noProducts: {{ t('products.no_products') | dump | safe }},
          noResults: {{ t('pages.search.no_results') | dump | safe }},
          tryDifferent: {{ t('pages.search.try_different') | dump | safe }},
          products: {{ t('pages.search.products') | dump | safe }},
          resultsFor: {{ t('pages.search.results_for') | dump | safe }},
          home: {{ t('common.home') | dump | safe }},
          prev: {{ t('common.prev') | dump | safe }},
          next: {{ t('common.next') | dump | safe }},
          countOne: {{ t('count.product_one') | dump | safe }},
          countTwo: {{ t('count.product_two') | dump | safe }},
          countFew: {{ t('count.product_few') | dump | safe }},
          countMany: {{ t('count.product_many') | dump | safe }}
        },
        {# Strings for LamsaCartItem.build() — same single-source rule as `card`. #}
        cart: {
          remove: {{ t('pages.cart.remove_item') | dump | safe }},
          unitPrice: {{ t('pages.cart.unit_price') | dump | safe }}
        },
        {# Product-card defaults, mirrored from the theme settings so the AJAX
           renderer matches the SSR partial without extra plumbing. #}
        cardDefaults: {
          imageRatio: '{{ settings.cardImageRatio | default("1/1", true) }}',
          showSwatches: {{ 'true' if settings.cardShowSwatches | default(true) else 'false' }},
          showRating: {{ 'true' if settings.cardShowRating | default(true) else 'false' }},
          showSuitability: {{ 'true' if settings.cardShowSuitability | default(true) else 'false' }},
          showSecondImage: {{ 'true' if settings.cardShowSecondImage | default(true) else 'false' }},
          showQuickView: {{ 'true' if settings.cardShowQuickView | default(true) else 'false' }},
          atcStyle: '{{ settings.cardAddToCartStyle | default("tray", true) }}'
        }
      };
    </script>

    {% qumra_scripts %}

    {# main.js registers the Alpine stores/components — must run before Alpine boots #}
    <script src="{{ 'main.js' | assets }}?v={{ assetv }}"></script>

    {% if settings.customJS %}
      <script>{{ settings.customJS | safe }}</script>
    {% endif %}
  </body>
</html>

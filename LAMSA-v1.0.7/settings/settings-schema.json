  {
    "label": {
      "ar": "بطاقة المنتج",
      "en": "Product Card"
    },
    "settings": {
      "cardImageRatio": {
        "type": "select",
        "label": {
          "ar": "نسبة صورة المنتج",
          "en": "Product Image Ratio"
        },
        "default": "1/1",
        "options": [
          {
            "value": "1/1",
            "label": {
              "ar": "مربّع",
              "en": "Square"
            }
          },
          {
            "value": "4/5",
            "label": {
              "ar": "طولي خفيف",
              "en": "Portrait"
            }
          },
          {
            "value": "3/4",
            "label": {
              "ar": "طولي",
              "en": "Tall"
            }
          }
        ]
      },
      "cardShowSwatches": {
        "type": "boolean",
        "label": {
          "ar": "إظهار سواتش الدرجات",
          "en": "Show Shade Swatches"
        },
        "default": true
      },
      "cardShowRating": {
        "type": "boolean",
        "label": {
          "ar": "إظهار التقييم بالنجوم",
          "en": "Show Star Rating"
        },
        "default": true
      },
      "cardShowSuitability": {
        "type": "boolean",
        "label": {
          "ar": "إظهار وسم «مناسب لـ»",
          "en": "Show \"Suitable For\" Tag"
        },
        "default": true
      },
      "cardShowSecondImage": {
        "type": "boolean",
        "label": {
          "ar": "تبديل الصورة عند المرور",
          "en": "Swap Image on Hover"
        },
        "default": true
      },
      "cardShowQuickView": {
        "type": "boolean",
        "label": {
          "ar": "إظهار زر العرض السريع",
          "en": "Show Quick View Button"
        },
        "default": true
      },
      "cardAddToCartStyle": {
        "type": "select",
        "label": {
          "ar": "زر الإضافة للسلة",
          "en": "Add to Cart Button"
        },
        "default": "tray",
        "options": [
          {
            "value": "tray",
            "label": {
              "ar": "يظهر عند المرور",
              "en": "Reveal on hover"
            }
          },
          {
            "value": "always",
            "label": {
              "ar": "ظاهر دائماً",
              "en": "Always visible"
            }
          },
          {
            "value": "hidden",
            "label": {
              "ar": "مخفي",
              "en": "Hidden"
            }
          }
        ]
      },
      "lowStockThreshold": {
        "type": "number",
        "label": {
          "ar": "حدّ تحذير «بقي عدد قليل» — نفس الرقم في صفحة المنتج والعرض السريع",
          "en": "Low-stock warning threshold — shared by the product page and Quick View"
        },
        "default": 3,
        "min": 0,
        "max": 50,
        "step": 1
      }
    }

{# ============================================================================
   LAMSA SEARCH — soft sheet dropping from the top
   Uses Qumra.search.suggest() (debounced in main.js).
   ========================================================================= #}

<style>
  .lamsa-srch-sheet {
    position: fixed;
    top: 0;
    inset-inline: 0;
    z-index: var(--z-drawer);
    max-height: 88vh;
    max-height: 88dvh;
    overflow-y: auto;
    background: var(--color-surface);
    border-end-start-radius: var(--radius-xl);
    border-end-end-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
  }

  .lamsa-srch-field .lamsa-srch-input,
  .lamsa-srch-input {
    flex: 1;
    min-width: 0;
    padding: 6px 4px;
    border: 0;
    background: transparent;
    outline: none;
    font-family: var(--font-display-ar);
    font-size: clamp(1.25rem, 3.4vw, 1.875rem);
    font-weight: 600;
    color: var(--color-text-primary);
  }
  html[dir="ltr"] .lamsa-srch-input { font-family: var(--font-display-en); }
  .lamsa-srch-input:focus { box-shadow: none; }
  .lamsa-srch-input::placeholder { color: var(--color-text-tertiary); font-weight: 400; }

  .lamsa-srch-field {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 20px;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-bg-primary);
    transition: border-color var(--t-fast) var(--ease-soft), box-shadow var(--t-fast) var(--ease-soft);
  }
  .lamsa-srch-field:focus-within { border-color: var(--color-accent); box-shadow: var(--shadow-focus); }

  .lamsa-srch-hit {
    display: flex;
    gap: 14px;
    padding: 10px;
    border-radius: var(--radius-md);
    transition: background var(--t-fast) var(--ease-soft);
  }
  .lamsa-srch-hit:hover { background: var(--color-accent-light); }

  .lamsa-srch-thumb {
    width: 62px;
    height: 62px;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--color-bg-tertiary);
  }
  .lamsa-srch-thumb img { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 640px) {
    .lamsa-srch-field { padding: 8px 16px; gap: 10px; }
    .lamsa-srch-thumb { width: 54px; height: 54px; }
  }
</style>

<div x-data x-cloak>

  {# ---- Overlay ---- #}
  <div x-show="$store.modal.current === 'search'"
       @click="$store.modal.close()"
       class="lamsa-overlay"
       x-transition:enter="transition ease-out duration-300"
       x-transition:enter-start="opacity-0"
       x-transition:enter-end="opacity-100"
       x-transition:leave="transition ease-in duration-200"
       x-transition:leave-start="opacity-100"
       x-transition:leave-end="opacity-0"></div>

  {# ---- Sheet ---- #}
  <div x-show="$store.modal.current === 'search'"
       x-transition:enter="transition ease-out duration-300"
       x-transition:enter-start="opacity-0 -translate-y-6"
       x-transition:enter-end="opacity-100 translate-y-0"
       x-transition:leave="transition ease-in duration-200"
       x-transition:leave-start="opacity-100 translate-y-0"
       x-transition:leave-end="opacity-0 -translate-y-4"
       class="lamsa-srch-sheet custom-scrollbar"
       x-data="{
         query: '',
         products: [],
         queries: [],
         searching: false,
         run() {
           if (this.query.length < 2) { this.products = []; this.queries = []; this.searching = false; return }
           this.searching = true;
           Qumra.search.suggest(this.query, (data) => {
             const r = data.resources || {};
             this.products = r.products || data.products || [];
             this.queries  = r.queries  || [];
             this.searching = false;
           }, 6);
         },
         money(v) { return Qumra.utils.formatMoney(v) },
         off(p) {
           const c = p.pricing && p.pricing.compareAtPrice, x = p.pricing && p.pricing.price;
           return (c && c > x) ? Math.round(((c - x) / c) * 100) : 0;
         }
       }">

    <div class="lamsa-container py-7 max-sm:py-5">

      {# head #}
      <div class="flex items-center justify-between gap-4 mb-5">
        <span class="lamsa-eyebrow">
          <span class="lamsa-eyebrow-dot"></span>
          {{ t('pages.search.title') }}
        </span>
        <button type="button"
                @click="$store.modal.close()"
                class="lamsa-btn-icon lamsa-btn-icon--sm"
                aria-label="{{ t('common.close') }}">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      {# field #}
      <form action="/shop" method="get" class="lamsa-srch-field">
        <svg class="shrink-0" width="21" height="21" viewBox="0 0 24 24" fill="none"
             stroke="var(--color-accent)" stroke-width="1.9">
          <circle cx="11" cy="11" r="7.25"/>
          <path stroke-linecap="round" d="m20.5 20.5-4.2-4.2"/>
        </svg>
        <input type="search"
               name="q"
               x-model="query"
               @input.debounce.120ms="run()"
               class="lamsa-srch-input"
               placeholder="{{ t('header.search_placeholder') }}"
               autocomplete="off"
               aria-label="{{ t('pages.search.title') }}"/>
        <button type="button"
                x-show="query.length > 0"
                @click="query = ''; run()"
                class="lamsa-btn-icon lamsa-btn-icon--sm shrink-0"
                aria-label="{{ t('common.cancel') }}">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
        <button type="submit" class="lamsa-btn lamsa-btn--primary lamsa-btn--sm shrink-0 max-sm:hidden">
          {{ t('common.search') }}
        </button>
      </form>

      {# ---- suggested queries ---- #}
      <div x-show="queries.length > 0" class="pt-6">
        <p class="lamsa-caption mb-3 m-0">{{ t('pages.search.suggestions') }}</p>
        <div class="flex flex-wrap gap-2">
          <template x-for="q in queries" :key="q">
            <a :href="'/shop?q=' + encodeURIComponent(q)" class="lamsa-chip font-body" x-text="q"></a>
          </template>
        </div>
      </div>

      {# ---- product hits ---- #}
      <div x-show="products.length > 0" class="pt-6">
        <div class="flex items-center justify-between gap-3 mb-3">
          <p class="lamsa-caption m-0">{{ t('pages.search.products') }}</p>
          <a :href="'/shop?q=' + encodeURIComponent(query)" class="lamsa-link font-body">
            {{ t('pages.search.view_all') }}
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/>
            </svg>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-1">
          <template x-for="item in products" :key="item._id">
            <a :href="'/products/' + (item.slug || item.handle)"
               @click="$store.modal.close()"
               class="lamsa-srch-hit">

              <div class="lamsa-srch-thumb">
                <template x-if="item.images && item.images.length">
                  <img :src="item.images[0].fileUrl" :alt="item.title" loading="lazy"/>
                </template>
                <template x-if="!item.images || !item.images.length">
                  <div class="w-full h-full flex items-center justify-center" style="color: var(--color-text-tertiary); opacity:.4;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <rect x="3" y="3" width="18" height="18" rx="3"/>
                      <circle cx="8.75" cy="9" r="1.6"/>
                      <path stroke-linecap="round" stroke-linejoin="round" d="m4 17 5-4.5 4.5 4 3-2.5L21 18"/>
                    </svg>
                  </div>
                </template>
              </div>

              <div class="flex-1 min-w-0 flex flex-col justify-center gap-1">
                <p class="font-display text-[15px] leading-snug line-clamp-1 m-0"
                   style="color: var(--color-text-primary);" x-text="item.title"></p>

                <div class="flex items-center gap-2 flex-wrap">
                  <span class="lamsa-price" style="font-size: 0.9375rem;" x-text="money(item.pricing.price)"></span>
                  <template x-if="off(item) > 0">
                    <span class="lamsa-price-was" x-text="money(item.pricing.compareAtPrice)"></span>
                  </template>
                  <template x-if="off(item) > 0">
                    <span class="lamsa-badge lamsa-badge--sale" x-text="'−' + off(item) + '%'"></span>
                  </template>
                </div>
              </div>
            </a>
          </template>
        </div>
      </div>

      {# ---- loading ---- #}
      <div x-show="searching" x-cloak class="py-14 flex items-center justify-center">
        <span class="lamsa-spinner" style="width: 26px; height: 26px;"></span>
      </div>

      {# ---- no results ---- #}
      <div x-show="!searching && query.length >= 2 && products.length === 0 && queries.length === 0"
           x-cloak
           class="lamsa-empty" style="padding-block: var(--space-8);">
        <span class="lamsa-empty-icon" style="width: 68px; height: 68px;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="11" cy="11" r="7.25"/>
            <path stroke-linecap="round" d="m20.5 20.5-4.2-4.2"/>
          </svg>
        </span>
        <h4 class="m-0">{{ t('pages.search.no_results') }}</h4>
        <p class="lamsa-text-sm m-0">{{ t('pages.search.try_different') }}</p>
      </div>

    </div>
  </div>
</div>

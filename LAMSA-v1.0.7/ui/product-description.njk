{# ============================================================================
   LAMSA PRODUCT DESCRIPTION · section splitter
   ----------------------------------------------------------------------------
   Qumra products have ONE rich-text field (description) and no metafields, so
   the merchant splits it with bracket markers, each on its own line:

     [وصف قصير]              → short   (under the price)
     [الحجم]                 → size    (a clear "الحجم: …" chip)
     [وصف طويل]              → long    (the description panel)
     [تفاصيل: المكونات]       → details (one accordion panel per marker)

   English aliases work too: [short] [size] [long] [details: Ingredients].
   Anything before the first marker counts as long. A description with no
   markers at all renders exactly as before — nothing to migrate.

   Usage — renders ONE part, capture it with a block set:
     set shortHtml  →  ui "product-description.njk", description=p.description, part='short'
   part: 'short' | 'long' | 'size' | 'details'

   ⚠️  Qalab sandbox limits that shaped this file:
       · string methods: only split / slice / indexOf work — substring,
         substr and lastIndexOf throw "attempted to call a non-function"
       · no regex literals
       · `set` inside a for loop does not survive the loop, and push() on an
         array nested in an object throws — so everything is collected into
         FLAT top-level arrays, and the edge clean-up is unrolled, not looped.
   ========================================================================= #}

{% set raw = data.description | default('') %}
{% set part = data.part | default('long') %}

{% set shortKeys = ['وصف قصير', 'الوصف القصير', 'وصف مختصر', 'short', 'short description'] %}
{% set longKeys = ['وصف طويل', 'الوصف الطويل', 'الوصف', 'الوصف الكامل', 'long', 'long description', 'description'] %}
{% set sizeKeys = ['الحجم', 'حجم', 'المقاس', 'size'] %}

{# The rich-text editor wraps each marker in its own tags (<p>[الحجم]</p>), so
   a section body starts with the marker's closing tags and the one before it
   ends with the marker's opening tags. Strip up to three of each. #}
{% macro clean(html) %}
  {%- set s = html | trim -%}
  {%- if s.indexOf('</') == 0 %}{% set s = s.slice(s.indexOf('>') + 1) | trim %}{% endif -%}
  {%- if s.indexOf('</') == 0 %}{% set s = s.slice(s.indexOf('>') + 1) | trim %}{% endif -%}
  {%- if s.indexOf('</') == 0 %}{% set s = s.slice(s.indexOf('>') + 1) | trim %}{% endif -%}
  {#- trailing opener: the text after the last "<" is a whole tag with
      nothing after it, and it is not a closing / void media tag -#}
  {%- set tail = s.split('<') | last -%}
  {%- if s.indexOf('<') != -1 and tail.slice(-1) == '>' and tail.indexOf('/') != 0 and tail.indexOf('img') != 0 and tail.indexOf('hr') != 0 %}{% set s = s.slice(0, s.length - tail.length - 1) | trim %}{% endif -%}
  {%- set tail = s.split('<') | last -%}
  {%- if s.indexOf('<') != -1 and tail.slice(-1) == '>' and tail.indexOf('/') != 0 and tail.indexOf('img') != 0 and tail.indexOf('hr') != 0 %}{% set s = s.slice(0, s.length - tail.length - 1) | trim %}{% endif -%}
  {%- set tail = s.split('<') | last -%}
  {%- if s.indexOf('<') != -1 and tail.slice(-1) == '>' and tail.indexOf('/') != 0 and tail.indexOf('img') != 0 and tail.indexOf('hr') != 0 %}{% set s = s.slice(0, s.length - tail.length - 1) | trim %}{% endif -%}
  {{- s | safe -}}
{% endmacro %}

{# ---------------- split on "[" and keep only recognised markers ----------
   secs  = [{ key, title }]          one entry per recognised marker
   parts = [{ i, text }]             i = index into secs, -1 = before any marker #}
{% set secs = [] %}
{% set parts = [] %}
{% for chunk in raw.split('[') %}
  {% if loop.first %}
    {% if parts.push({ i: -1, text: chunk }) %}{% endif %}
  {% else %}
    {% set close = chunk.indexOf(']') %}
    {% set label = (chunk.slice(0, close) | replace('<br>', ' ') | striptags | replace('&nbsp;', ' ') | trim) if close > 0 and close < 60 else '' %}
    {% set lbl = label | lower %}
    {% if lbl and shortKeys.indexOf(lbl) != -1 %}{% set key = 'short' %}
    {% elif lbl and longKeys.indexOf(lbl) != -1 %}{% set key = 'long' %}
    {% elif lbl and sizeKeys.indexOf(lbl) != -1 %}{% set key = 'size' %}
    {% elif lbl and (lbl.indexOf('تفاصيل') == 0 or lbl.indexOf('details') == 0) %}{% set key = 'details' %}
    {% else %}{% set key = '' %}{% endif %}

    {% if key %}
      {% set colon = label.indexOf(':') %}
      {% set title = (label.slice(colon + 1) | trim) if colon != -1 else '' %}
      {% if secs.push({ key: key, title: title }) %}{% endif %}
      {% if parts.push({ i: (secs | length) - 1, text: chunk.slice(close + 1) }) %}{% endif %}
    {% else %}
      {# a literal "[" inside the text — give it back to the open section #}
      {% if parts.push({ i: (secs | length) - 1, text: '[' ~ chunk }) %}{% endif %}
    {% endif %}
  {% endif %}
{% endfor %}

{# the raw HTML of section n (n = -1 → text before the first marker) #}
{% macro sectionText(n, parts) %}{% for pt in parts %}{% if pt.i == n %}{{ pt.text | safe }}{% endif %}{% endfor %}{% endmacro %}

{# ---------------- render the requested part ----------------------------- #}
{% if part == 'short' %}
  {% for sec in secs %}{% if sec.key == 'short' %}{{ clean(sectionText(loop.index0, parts)) }}{% endif %}{% endfor %}

{% elif part == 'size' %}
  {% for sec in secs %}{% if sec.key == 'size' %}{{ sectionText(loop.index0, parts) | replace('</p>', ' ') | replace('<br>', ' ') | striptags | replace('&nbsp;', ' ') | trim }}{% endif %}{% endfor %}

{% elif part == 'long' %}
  {% if (secs | length) == 0 %}
    {{ raw | safe }}
  {% else %}
    {{ clean(sectionText(-1, parts)) }}
    {% for sec in secs %}{% if sec.key == 'long' %}{{ clean(sectionText(loop.index0, parts)) }}{% endif %}{% endfor %}
  {% endif %}

{% elif part == 'details' %}
  {% for sec in secs %}
    {% if sec.key == 'details' %}
      {% set html = clean(sectionText(loop.index0, parts)) %}
      {% if html | replace('<br>', ' ') | striptags | trim %}
        <div class="lamsa-acc-item" x-data="{ open: false }" :class="open && 'is-open'">
          <button type="button" class="lamsa-acc-trigger" @click="open = !open" :aria-expanded="open">
            <span class="flex items-center gap-2.5 min-w-0">
              <span class="text-accent shrink-0">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="4.5" y="3.5" width="15" height="17" rx="2.5"/><path d="M8.5 8.5h7M8.5 12h7M8.5 15.5h4"/>
                </svg>
              </span>
              <span>{{ sec.title | default(t('pages.product.details'), true) }}</span>
            </span>
            <span class="lamsa-acc-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/>
              </svg>
            </span>
          </button>
          <div x-show="open" x-collapse class="lamsa-acc-panel">
            <div class="lamsa-prose">{{ html }}</div>
          </div>
        </div>
      {% endif %}
    {% endif %}
  {% endfor %}
{% endif %}

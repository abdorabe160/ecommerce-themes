{#-
  Cart drawer (included once by the layout, no params). Client-rendered from the root decafeApp() state:
  cartItems / cartCount / cartSubtotal / cartTotal / cartSavings, updateItem / removeItem / checkout.
  Free-shipping meter when settings.freeShippingThreshold > 0 (store-currency MAJOR units → Decafe.Money.fromMajor).
  Line prices are platform units → formatMoney().
-#}
{%- set fst = (settings.freeShippingThreshold | default(0)) | float -%}
<div x-cloak class="dc-cart-drawer">
  <div x-show="isOpen('cart')" x-cloak class="overlay" @click="closeModal()" aria-hidden="true"
       x-transition:enter="transition-opacity duration-500 ease-calm" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
       x-transition:leave="transition-opacity duration-300 ease-calm" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"></div>

  <aside x-show="isOpen('cart')" x-cloak class="drawer" data-modal="cart" role="dialog" aria-modal="true" aria-labelledby="dc-cart-drawer-title"
         @keydown="trapFocus($event)"
         x-transition:enter="transition-transform duration-500 ease-calm" x-transition:enter-start="ltr:translate-x-full rtl:-translate-x-full" x-transition:enter-end="translate-x-0"
         x-transition:leave="transition-transform duration-300 ease-calm" x-transition:leave-start="translate-x-0" x-transition:leave-end="ltr:translate-x-full rtl:-translate-x-full">

    <header class="drawer__head">
      <h2 id="dc-cart-drawer-title" class="flex items-center gap-2.5 font-display text-lg font-medium">
        {{ t('cart.title') }}
        <span x-show="cartCount > 0" class="grid h-6 min-w-6 place-items-center rounded-full bg-espresso px-1.5 text-[0.72rem] font-medium tabular-nums text-cream" x-text="cartCount"{% if not (cart and cart.totalQuantity > 0) %} style="display:none"{% endif %}>{{ cart.totalQuantity if (cart and cart.totalQuantity) else 0 }}</span>
      </h2>
      <button type="button" class="icon-btn -me-2" @click="closeModal()" aria-label="{{ t('a11y.close_dialog') }}">
        {% ui "icon.njk", name="close", size=22 %}
      </button>
    </header>

    {#- live region: announces count changes (not the initial value) -#}
    <p class="sr-only" role="status" aria-live="polite"
       x-effect="const n = cartCount; if ($el.dataset.ready) { $el.textContent = {{ t('cart.announce') | dump | escape }}.replace('{count}', n); } else { $el.dataset.ready = '1'; }"></p>

    {%- if fst > 0 %}
    <div x-show="cartItems.length" class="border-b border-espresso/10 px-5 py-4"
         x-data="{ get goal() { return Decafe.Money.fromMajor({{ fst }}); }, get left() { return Math.max(0, this.goal - cartTotal); }, get pct() { return this.goal > 0 ? Math.min(100, Math.round(cartTotal / this.goal * 100)) : 0; } }">
      <p class="flex items-center gap-2 text-sm text-espresso">
        <span class="text-caramel">{% ui "icon.njk", name="truck", size=18 %}</span>
        <span x-show="left > 0" x-text="{{ t('cart.free_ship_left') | dump | escape }}.replace('{amount}', formatMoney(left))"></span>
        <span x-show="left <= 0" x-cloak>{{ t('cart.free_ship_done') }}</span>
      </p>
      <div class="mt-3 h-1 overflow-hidden rounded-full bg-espresso/10" role="progressbar" aria-label="{{ t('cart.free_ship_progress') }}" aria-valuemin="0" aria-valuemax="100" :aria-valuenow="pct">
        <div class="h-full w-0 rounded-full bg-caramel transition-[width] duration-700 ease-calm" :style="'width:' + pct + '%'"></div>
      </div>
    </div>
    {%- endif %}

    {#- items -#}
    <div class="drawer__body" x-show="cartItems.length">
      <ul class="divide-y divide-espresso/10" role="list">
        <template x-for="item in cartItems" :key="item._id">
          <li class="grid grid-cols-[72px_1fr] gap-4 py-4 transition-opacity duration-300 first:pt-0"
              :class="isBusy('item:' + item._id) && 'opacity-60'" :aria-busy="isBusy('item:' + item._id).toString()">
            <a :href="itemUrl(item)" class="block aspect-[4/5] w-[72px] overflow-hidden rounded-card bg-beige" tabindex="-1" aria-hidden="true">
              <template x-if="itemImage(item)">
                <img :src="itemImage(item)" alt="" width="72" height="90" class="h-full w-full object-cover" loading="lazy" decoding="async">
              </template>
              <template x-if="!itemImage(item)">
                <span class="grid h-full place-items-center text-coffee/50">{% ui "icon.njk", name="bean", size=26 %}</span>
              </template>
            </a>
            <div class="flex min-w-0 flex-col">
              <div class="flex items-start justify-between gap-3">
                <a :href="itemUrl(item)" class="line-clamp-2 font-display text-[0.95rem] font-medium leading-snug text-espresso hover:text-coffee" x-text="itemTitle(item)"></a>
                <button type="button" class="-me-2 -mt-2 icon-btn h-10 w-10 shrink-0 text-muted-ink hover:text-sale" @click="removeItem(item)"
                        :disabled="isBusy('item:' + item._id)" :aria-label="{{ t('cart.remove') | dump | escape }} + ': ' + itemTitle(item)">
                  {% ui "icon.njk", name="trash", size=18 %}
                </button>
              </div>
              <p class="mt-0.5 text-xs text-muted-ink" x-show="itemOptions(item)" x-text="itemOptions(item)"></p>
              <div class="mt-auto flex items-end justify-between gap-3 pt-3">
                <div class="qty qty-sm" role="group" :aria-label="{{ t('product.quantity') | dump | escape }} + ': ' + itemTitle(item)">
                  <button type="button" @click="updateItem(item, item.quantity - 1)" :disabled="isBusy('item:' + item._id)" aria-label="{{ t('product.decrease') }}">{% ui "icon.njk", name="minus", size=15 %}</button>
                  <output class="text-sm" aria-live="off" x-text="item.quantity"></output>
                  <button type="button" @click="updateItem(item, item.quantity + 1)" :disabled="isBusy('item:' + item._id)" aria-label="{{ t('product.increase') }}">{% ui "icon.njk", name="plus", size=15 %}</button>
                </div>
                <div class="text-end leading-tight">
                  <p class="price text-[0.95rem]">
                    <s class="price__compare" x-show="item.compareAtPrice > item.price" x-text="formatMoney(item.compareAtPrice * item.quantity)"></s>
                    <span x-text="formatMoney(itemLineTotal(item))"></span>
                  </p>
                  <p class="mt-1 text-[0.72rem] text-muted-ink tabular-nums" x-show="item.quantity > 1" x-text="{{ t('cart.unit_price') | dump | escape }}.replace('{price}', formatMoney(item.price))"></p>
                </div>
              </div>
            </div>
          </li>
        </template>
      </ul>
    </div>

    {#- empty -#}
    <div class="drawer__body flex flex-col items-center justify-center text-center" x-show="!cartItems.length">
      <span class="mb-6 grid h-20 w-20 place-items-center rounded-full bg-espresso/5 text-coffee">{% ui "icon.njk", name="cart", size=32 %}</span>
      <p class="font-display text-xl">{{ t('cart.empty') }}</p>
      <p class="mt-2 max-w-[18rem] text-sm text-muted-ink">{{ t('cart.empty_text') }}</p>
      <a href="/shop" class="btn btn-dark mt-8" @click="closeModal()">
        {{ t('cart.start_shopping') }} {% ui "icon.njk", name="arrow", size=18, cls="btn-arrow" %}
      </a>
    </div>

    {#- summary -#}
    <footer class="drawer__foot pb-[max(1.25rem,env(safe-area-inset-bottom))]" x-show="cartItems.length">
      <dl class="space-y-2 text-sm">
        <div class="flex items-center justify-between gap-4">
          <dt class="text-muted-ink">{{ t('cart.subtotal') }}</dt>
          <dd class="price" x-text="formatMoney(cartSubtotal)"></dd>
        </div>
        <div class="flex items-center justify-between gap-4 text-sale" x-show="cartSavings > 0">
          <dt>{{ t('cart.savings') }}</dt>
          <dd class="font-display font-medium tabular-nums" x-text="formatMoney(cartSavings)"></dd>
        </div>
        <div class="flex items-center justify-between gap-4" x-show="cart.couponApplied">
          <dt class="flex items-center gap-2 text-muted-ink">
            {% ui "icon.njk", name="gift", size=16 %}
            <span>{{ t('cart.discount') }}</span>
            <span class="badge badge-soft border border-espresso/10 uppercase" dir="ltr" x-show="typeof cart.couponApplied === 'string'" x-text="cart.couponApplied"></span>
          </dt>
          <dd class="font-display font-medium tabular-nums text-sale" x-show="cart.couponDiscount > 0" x-text="'−' + formatMoney(cart.couponDiscount)"></dd>
        </div>
        <div class="flex items-center justify-between gap-4 border-t border-espresso/10 pt-2 text-base" x-show="cartTotal !== cartSubtotal">
          <dt class="font-display font-medium">{{ t('cart.total') }}</dt>
          <dd class="price text-lg" x-text="formatMoney(cartTotal)"></dd>
        </div>
      </dl>
      <p class="mt-3 text-xs text-muted-ink">{{ t('cart.shipping_note') }}</p>
      <button type="button" class="btn btn-primary btn-block mt-4" @click="checkout()" :disabled="isBusy('checkout')" :aria-busy="isBusy('checkout').toString()">
        <span x-show="isBusy('checkout')" class="spinner" aria-hidden="true"></span>
        <span>{{ t('cart.checkout') }}</span>
        <span x-show="!isBusy('checkout')">{% ui "icon.njk", name="arrow", size=18, cls="btn-arrow" %}</span>
      </button>
      <a href="/cart" class="mt-2 flex min-h-11 items-center justify-center font-display text-sm text-coffee underline-offset-4 hover:underline">{{ t('cart.view_cart') }}</a>
    </footer>
  </aside>
</div>

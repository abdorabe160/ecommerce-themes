        },
        "default": false
      },
      "cartOpenOnAdd": {
        "type": "boolean",
        "label": {
          "ar": "فتح السلة الجانبية بعد الإضافة",
          "en": "Open cart drawer after adding"
        },
        "default": true
      },
      "freeShippingThreshold": {
        "type": "number",
        "label": {
          "ar": "حد الشحن المجاني (بعملة المتجر، 0 لإخفاء الشريط)",
          "en": "Free-shipping threshold (store currency, 0 hides the bar)"
        },
        "default": 0,
        "min": 0
      },
      "deliveryNote": {
        "type": "string",
        "label": {
          "ar": "ملاحظة التوصيل في صفحة المنتج",

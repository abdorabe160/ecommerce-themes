  {
    "label": {
      "ar": "المنتجات والسلة",
      "en": "Products & cart"
    },
    "settings": {
      "showWishlist": {
        "type": "boolean",
        "label": {
          "ar": "إظهار زر المفضلة",
          "en": "Show wishlist button"
        },
        "default": true
      },
      "showCardButtons": {
        "type": "boolean",
        "label": {
          "ar": "إظهار أزرار الشراء على كروت المنتجات",
          "en": "Show buy buttons on product cards"
        },
        "default": true
      },
      "followProductStock": {
        "type": "boolean",
        "label": {
          "ar": "احترام مخزون المنتجات (إظهار نفد المخزون)",
          "en": "Respect tracked stock (show sold out)"
        },
        "default": true
      },
      "lowStockThreshold": {
        "type": "range",
        "label": {
          "ar": "تنبيه الكمية المحدودة عند",

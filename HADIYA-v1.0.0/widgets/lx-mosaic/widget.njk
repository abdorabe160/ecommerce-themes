{# ============================================================================
   HADIYA · Luxe · شبكة المناسبات  (lx-mosaic)
   ----------------------------------------------------------------------------
   ┌───────────────┬───────┬───────┐
   │               │   2   │   3   │      tile 1 is the feature: two columns,
   │       1       ├───────┼───────┤      two rows. Tiles 2–5 fill the rest.
   │               │   4   │   5   │      A 6th+ tile flows on in the grid.
   └───────────────┴───────┴───────┘
   Copy sits at the foot of each photograph on a dark gradient; the photo
   leans in on hover. Phone: tile 1 full width, the rest two-up.

   Tiles without an upload take the demo slots (assets/slot-tile-N.jpg), in order, so
   a fresh install is never a grid of grey boxes. Links are plain strings —
   a picker inside a block is reported to break the editor's block panel.

   Styling: assets/theme.css → "LUXE · lx-mosaic".
   ========================================================================= #}

{% set id = widget.id %}
{% set d = widget.data %}
{% set tiles = widget.blocks | default([], true) %}
{# Demo slots: assets/slot-tile-1…8.jpg — each preset fills them with its own photos. #}
{# slot-tile-3 and -5 show people, so they are not fallbacks (owner's rule). #}
{% set DEMO = ['slot-tile-1.jpg', 'slot-tile-2.jpg', 'slot-tile-6.jpg', 'slot-tile-4.jpg', 'slot-tile-8.jpg', 'slot-tile-7.jpg', 'slot-tile-1.jpg', 'slot-tile-2.jpg'] %}

{% macro mediaUrl(m) %}{% if m %}{% if m is string %}{{ m }}{% elif m.fileUrl %}{{ m.fileUrl }}{% elif m.url %}{{ m.url }}{% endif %}{% endif %}{% endmacro %}

<section id="lx-mosaic-{{ id }}"{% if (tiles | length) == 0 %} data-hy-empty{% endif %} class="lx-mosaic" {% if d.title %}aria-labelledby="lx-mosaic-t-{{ id }}"{% endif %}>
  <div class="lx-in">
    {% if d.title or d.eyebrow or d.more_text %}
      <div class="lx-head">
        <div>
          {% if d.eyebrow %}<p class="lx-eyebrow">{{ d.eyebrow }}</p>{% endif %}
          {% if d.title %}<h2 id="lx-mosaic-t-{{ id }}" class="lx-title">{{ d.title }}</h2>{% endif %}
        </div>
        {% if d.more_text %}<a class="lx-link" href="{{ d.more_url | default('/collections', true) }}">{{ d.more_text }}
          <svg class="rtl-flip" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>{% endif %}
      </div>
    {% endif %}

    <div class="lx-mosaic-grid">
      {% for block in tiles %}{% set b = block.data %}
        {% set img = mediaUrl(b.image) | trim %}
        {% set img = img if (img | length) else (DEMO[loop.index0 % 8] | assets) %}
        <a class="lx-tile" href="{{ b.url | default('/shop', true) }}">
          <img src="{{ img }}" alt="" loading="lazy"/>
          <span class="lx-tile-copy">
            <span class="lx-tile-label">{{ b.label }}</span>
            {% if b.sub %}<span class="lx-tile-sub">{{ b.sub }}</span>{% endif %}
          </span>
        </a>
      {% else %}
        {% for i in range(0, 5) %}
          <div class="lx-tile" aria-hidden="true" data-hy-placeholder>
            <img src="{{ DEMO[i] | assets }}" alt="" loading="lazy"/>
            <span class="lx-tile-copy"><span class="hy-ph-line" style="width: 40%;"></span></span>
          </div>
        {% endfor %}
        <p class="hy-ph-hint">{{ t('common.placeholder_add') }}</p>
      {% endfor %}
    </div>
  </div>
</section>

{% ui "section-colors.njk", scope='#lx-mosaic-' ~ id, c=d %}

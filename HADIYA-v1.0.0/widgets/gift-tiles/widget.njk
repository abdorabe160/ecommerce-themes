  'cake':      '<path d="M4 20.5h16v-8a1.5 1.5 0 0 0-1.5-1.5h-13A1.5 1.5 0 0 0 4 12.5z"/><path d="M4 15.5c2 1.3 4 1.3 6 0s4-1.3 6 0 3 .9 4 .6"/><path d="M8 11V8M12 11V8M16 11V8"/><path d="M8 5.5v-.01M12 5.5v-.01M16 5.5v-.01"/>',
  'rings':     '<circle cx="9" cy="14.5" r="5.5"/><circle cx="15" cy="14.5" r="5.5"/><path d="m7.5 6 1.5-2.5h3L13.5 6 10.5 9z"/>',
  'baby':      '<circle cx="12" cy="11" r="7.5"/><path d="M9.3 10.5h.01M14.7 10.5h.01"/><path d="M9.8 14c1.3 1 3.1 1 4.4 0"/><path d="M12 3.5c1.5 0 2 1.5 1 2.5"/>',
  'cap':       '<path d="M2.5 9.5 12 5l9.5 4.5L12 14z"/><path d="M6.5 11.5V16c3 2.5 8 2.5 11 0v-4.5"/><path d="M21.5 9.5v5"/>',
  'lantern':   '<path d="M12 2.5v2"/><path d="M9 4.5h6l1 3H8z"/><path d="M8 7.5c-2.5 3-2.5 8 0 11h8c2.5-3 2.5-8 0-11"/><path d="M12 7.5v11M9 18.5h6l-1 2.5h-4z"/>',
  'moon':      '<path d="M15.5 3.5a8.5 8.5 0 1 0 5 13.5A7 7 0 0 1 15.5 3.5Z"/><path d="m18 6.5.6 1.4 1.4.6-1.4.6-.6 1.4-.6-1.4-1.4-.6 1.4-.6z"/>',
  'heart':     '<path d="M12 20.5S3.5 15.2 3.5 9.4A4.4 4.4 0 0 1 12 7.3a4.4 4.4 0 0 1 8.5 2.1c0 5.8-8.5 11.1-8.5 11.1Z"/>',
  'flower':    '<circle cx="12" cy="9" r="2.4"/><path d="M12 6.6c0-3 1.3-4.1 2.6-3.3 1.3.8.9 2.9-.4 4.3M12 6.6c0-3-1.3-4.1-2.6-3.3-1.3.8-.9 2.9.4 4.3M14.4 9c3 0 4.1 1.3 3.3 2.6-.8 1.3-2.9.9-4.3-.4M9.6 9c-3 0-4.1 1.3-3.3 2.6.8 1.3 2.9.9 4.3-.4"/><path d="M12 11.4v9.1M12 17c-2-2-4.5-2-5.5-1 1 1.5 3.5 2 5.5 1Z"/>',
  'her':       '<path d="M7 9.5h10l-1.5 11h-7z"/><path d="M9.5 9.5V7a2.5 2.5 0 0 1 5 0v2.5"/><path d="M12 13.5c-1-1-2.5-.2-2 1 .4 1 2 1.8 2 1.8s1.6-.8 2-1.8c.5-1.2-1-2-2-1Z"/>',
  'him':       '<rect x="7" y="6.5" width="10" height="11" rx="3"/><path d="M9 6.5 9.5 3h5l.5 3.5M9 17.5l.5 3.5h5l.5-3.5"/><path d="M12 9.5V12l1.5 1"/>',
  'kids':      '<path d="M12 2.5c3.3 0 5.5 2.6 5.5 5.6 0 3.4-2.9 6.4-5.5 6.4S6.5 11.5 6.5 8.1c0-3 2.2-5.6 5.5-5.6Z"/><path d="m11 14.5-.5 1.5h3l-.5-1.5"/><path d="M12 16c0 2-2 2.5-2 4.5"/>',
  'briefcase': '<rect x="3" y="7.5" width="18" height="12.5" rx="2"/><path d="M8.5 7.5V5.5a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v2"/><path d="M3 12.5h18M10.5 12.5v2h3v-2"/>'
} %}
{# ICONS goes in as an argument, not read from the template scope — portable
   whatever scoping Qalab gives macros. #}
{% macro ico(k, cls, M) %}{% if M[k] %}<svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{{ M[k] | safe }}</svg>{% endif %}{% endmacro %}

{% set look = 'card' if d.style == 'card' else 'arch' %}
{% set bg = 'var(--hy-sec-bg, var(--color-bg-tertiary))' if d.background == 'well' else 'var(--hy-sec-bg, transparent)' %}
{# palette defaults for untinted tiles — the gift-paper family, cycled #}
{% set TINTS = ['#F3E3DC', '#EDE6DA', '#E6EEEA', '#EFE7DF', '#E4ECE8', '#F5E9E2'] %}

<section id="hd-tiles-{{ id }}"{% if (tiles | length) == 0 %} data-hy-empty{% endif %} class="hd-tiles hd-tiles--{{ look }}" style="background: {{ bg }};"
         {% if d.title %}aria-labelledby="hd-tiles-t-{{ id }}"{% endif %}>
  <div class="hd-tiles-in">
    {% if d.title or d.more_text %}
      <div class="hd-head">
        {% if d.title %}<h2 id="hd-tiles-t-{{ id }}" class="hd-title">{{ d.title }}</h2>{% endif %}
        {% if d.more_text %}<a class="hd-more" href="{{ d.more_url | default('/collections', true) }}">{{ d.more_text }}</a>{% endif %}
      </div>
    {% endif %}

    <div class="hd-grid">
      {% for block in tiles %}{% set b = block.data %}
        {% set img = mediaUrl(b.image) | trim %}
        {% set tint = b.tint | default(TINTS[loop.index0 % 6], true) %}
        <a class="hd-tile" href="{{ b.url | default('/shop', true) }}">
          <span class="hd-tile-media {{ 'has-img' if img | length }}" style="--hd-tile-bg: {{ tint }};">
            {% if img | length %}<img src="{{ img }}" alt="" loading="lazy"/>{% endif %}
            {% set icon = b.icon | default('gift', true) %}
            {{ ico(icon, 'hd-tile-ico ' ~ ('hd-tile-ico--sm' if img | length else ''), ICONS) }}
            {% if look == 'card' %}
              <span class="hd-tile-copy">
                <span class="hd-tile-label">{{ b.label }}</span>
                {% if b.hint %}<span class="hd-tile-hint">{{ b.hint }}</span>{% endif %}
              </span>
            {% endif %}
          </span>
          {% if look == 'arch' %}<span class="hd-tile-label">{{ b.label }}</span>{% endif %}
        </a>
      {% else %}
        {# Empty section in the editor: skeleton tiles with the add-hint, never
           a blank band. Not links — nothing to go to yet. #}
        {% for i in range(0, 4) %}
          <div class="hd-tile" aria-hidden="true" data-hy-placeholder>
            <span class="hd-tile-media" style="--hd-tile-bg: {{ TINTS[i] }};"></span>
            <span class="hy-ph-line" style="width: 60%;"></span>
          </div>
        {% endfor %}
        <p class="hy-ph-hint">{{ t('common.placeholder_add') }}</p>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #hd-tiles-{{ id }} {
    --hd-cols-set: {{ d.columns_desktop | default('6', true) }};
    --hd-cols-t: {{ 3 if (d.columns_desktop | default('6', true) | int) > 3 else (d.columns_desktop | default('3', true)) }};
    --hd-cols-m: {{ d.columns_mobile | default('2', true) }};
  }
</style>

{% ui "section-colors.njk", scope='#hd-tiles-' ~ id, c=d %}

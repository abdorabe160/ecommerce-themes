{% macro socialLink(url, kind, label) %}
  {% if url %}
    <a href="{{ url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ label }}">{{ social(kind) }}</a>
  {% endif %}
{% endmacro %}

{# One contact cell. The four slots are passed in explicitly rather than looped:
   Nunjucks cannot build `d['contact' ~ i ~ '_title']` from a loop variable in
   this engine — the same reason editorial-products lists its four thumbnails by
   hand. An empty slot renders NOTHING at all, so a merchant using three of the
   four gets three cells and three-way dividers, not a gap. #}
{% macro contactCell(icon, title, text, url) %}
  {% if text %}
    <div class="hy-fcontact-item">
      {% if icon and icon != 'none' %}
        <span class="hy-fcontact-icon">{{ contactIcon(icon) }}</span>
      {% endif %}
      {# ⚠️  `dir="auto"` on the two merchant strings, and it is not decoration.
         A phone number starts with `+` and digits — none of them a STRONG
         character — so in an Arabic document it inherits RTL and
         "+966 55 000 0000" renders as "0000 000 55 966+". `dir="auto"` picks
         the direction from the first strong character in the value itself:
         Latin/numeric copy goes LTR, Arabic copy stays RTL, and the merchant
         does not have to know any of this. The cell keeps its RTL placement
         because `.hy-fcontact-body` aligns its children to the cross-START,
         which is a logical edge — see the note in the CSS. #}
      <div class="hy-fcontact-body">
        {% if title %}<span class="hy-fcontact-title" dir="auto">{{ title }}</span>{% endif %}
        {% if text %}
          {% if url %}
            <a class="hy-fcontact-text hy-fcontact-text--link" dir="auto" href="{{ url }}">{{ text }}</a>
          {% else %}
            <span class="hy-fcontact-text" dir="auto">{{ text }}</span>
          {% endif %}
        {% endif %}
      </div>
    </div>
  {% endif %}
{% endmacro %}


<footer id="hy-footer-{{ id }}" class="hy-footer">
  <style>
    /* `--fo-cols` is the rendered link-column count. The subscribe band is not
       one of them — see the note at the top of this file. */
    #hy-footer-{{ id }} {
      --fo-cols: {{ (footCols | length) if (footCols | length) > 0 else 1 }};
      --fo-round: {{ d.corner_radius | default(0, true) }}px;
      --fo-inset: {{ d.side_inset | default(0, true) }}px;
      {% if (igShots | length) == 0 %}--fo-ig: 0;{% endif %}
      --fc-cols: {{ fcCount if fcCount > 0 else 1 }};
      {% if contactIconColor %}--color-footer-accent: {{ contactIconColor }};{% endif %}
    }
    {% if bg %}#hy-footer-{{ id }} { --fo-bg: {{ bg }}; --color-footer: {{ bg }}; }{% endif %}
    {% if bar %}#hy-footer-{{ id }} { --fo-bar: {{ bar }}; }{% endif %}
    {% if foHeading %}#hy-footer-{{ id }} { --color-footer-heading: {{ foHeading }}; }{% endif %}
    {% if foText %}#hy-footer-{{ id }} { --color-footer-text: {{ foText }}; --color-footer-text-muted: color-mix(in srgb, {{ foText }} 72%, transparent); }{% endif %}
    {% if foBorder %}#hy-footer-{{ id }} { --color-footer-border: {{ foBorder }}; }{% endif %}
  </style>

  {# The footer mixes its own `--color-footer-*` family with the GENERIC tokens
     (`--color-border`, `--color-surface`, `--color-text-*`) — the newsletter
     field, the social ring and the payment badges all paint from those. Without
     this the picks landed on half the footer and left the other half on the
     theme palette, which is what "الألوان مش شغالة" looked like. #}
  {% ui "section-colors.njk", scope='#hy-footer-' ~ id, c=d %}

  {# ═══════════════════ contact strip ═══════════════════ #}
  {% if showContact and fcCount > 0 %}
    {# id="contact" is a stable anchor: a "تواصل معنا" button anywhere links
       to `#contact` instead of a contact page the store may not have. #}
    <div class="hy-container" id="contact">
      <div class="hy-fcontact">
        {{ contactCell(d.contact1_icon, d.contact1_title, d.contact1_text, d.contact1_url) }}
        {{ contactCell(d.contact2_icon, d.contact2_title, d.contact2_text, d.contact2_url) }}
        {{ contactCell(d.contact3_icon, d.contact3_title, d.contact3_text, d.contact3_url) }}
        {{ contactCell(d.contact4_icon, d.contact4_title, d.contact4_text, d.contact4_url) }}
      </div>
    </div>
  {% endif %}

  <div class="hy-container">
    {# ═══════════ subscribe band ═══════════
       The reference gives the newsletter the whole top of the footer —
       headline on one side, field on the other. It used to be one COLUMN
       beside the links, which is why it is lifted OUT of `.hy-footer-top`
       here rather than restyled where it stood. #}
    {#- No list-provider URL = no field, so the «subscribe» headline would promise
        something the page cannot do: on the live store it goes (editor keeps it
        so the merchant sees what to set up). -#}
    <div class="hy-footer-sub{% if showNl and not nlAction and not (showBrand and brandText) %} hy-editor-only{% endif %}" x-data="{ sent: false }">
      {% if showNl %}
        <div class="hy-footer-sub-copy">
          {% if d.newsletter_title %}<h2 class="hy-footer-lead-title{% if not nlAction %} hy-editor-only{% endif %}">{{ d.newsletter_title }}</h2>{% endif %}
          {% if d.newsletter_text %}<p class="hy-footer-text{% if not nlAction %} hy-editor-only{% endif %}">{{ d.newsletter_text }}</p>{% endif %}
          {% if showBrand and brandText %}<div class="hy-footer-blurb">{{ brandText | safe }}</div>{% endif %}
        </div>
        <div class="hy-footer-sub-form">

          {# The field is a NATIVE form POST, not fetch(): list providers send no
             CORS headers, so fetch() fails silently and the shopper is told they
             subscribed when nothing was stored. With no action URL the field is
             not rendered at all — an input that posts nowhere collects nothing
             while looking like it works. #}
          {% if nlAction %}
            <span class="hy-footer-hint" x-show="sent" x-cloak>{{ t('newsletter.success') }}</span>

            {# ---- Validation messages in the STORE's language ----
               `type="email"` + `required` already stop a bad address — the
               browser refuses to submit and `@submit` never runs, so the success
               line cannot appear on a rejected entry. What the browser then
               shows is ITS OWN tooltip, in the BROWSER's language: an Arabic
               shopper on an English Chrome reads "Please include an '@'".

               `novalidate` turns the native bubble off and `checkValidity()`
               keeps the native RULES — the check is still the browser's, only
               the sentence is ours. Cheaper and safer than a hand-written
               regex, which is how email validation goes wrong.

               `@submit` is `.prevent`ed only when invalid, so a good address
               still posts to the provider exactly as before. #}
            <form action="{{ nlAction }}" method="post" target="_blank" rel="noopener"
                  class="hy-footer-form" novalidate
                  x-data="{ err: '' }" x-show="!sent"
                  @submit="
                    const f = $el.querySelector('input[type=email]');
                    if (f.checkValidity()) { err = ''; sent = true; return; }
                    $event.preventDefault();
                    err = f.value.trim() === ''
                      ? {{ t('newsletter.error_empty')  | dump | escape }}
                      : {{ t('newsletter.error_format') | dump | escape }};
                    f.focus();
                  ">
              <div class="hy-footer-field">
                <input type="email" name="{{ nlField }}" required autocomplete="email" inputmode="email"
                       :aria-invalid="err ? 'true' : 'false'"
                       @input="err = ''"
                       placeholder="{{ nlPlaceholder }}" aria-label="{{ t('common.email') }}"/>
              </div>

              {% if nlButton %}
                <button type="submit" class="hy-footer-send hy-footer-send--label">{{ nlButton }}</button>
              {% else %}
                {# No label set: fall back to the arrow disc, which survives a
                   narrow column that a word would not. #}
                <button type="submit" class="hy-footer-send" aria-label="{{ t('newsletter.button') }}">
                  <svg class="rtl-flip" width="16" height="16" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 12h15M13 6l6 6-6 6"/>
                  </svg>
                </button>
              {% endif %}

              {# Bots fill every field they find; a human never sees this one.

                 ⚠️  The hiding is INLINE, not left to `.hy-hp` in style.css — which
                 still carries the same declarations and the reasoning behind them.
                 A honeypot is the one element in the theme that must not depend on
                 an external stylesheet: this form is `display: flex` with the email
                 field on `flex: 1`, so the instant `.hy-hp` does not apply, the trap
                 claims real flex space, squeezes the email field down to a rounded
                 stub, and prints "Leave this field empty" to every shopper. It fails
                 OPEN, loudly, in the footer of every page. A stale cache, a CSS file
                 that 404s, or a published build older than this one is enough to do
                 it — and all three are outside this template's control. Inline
                 styles are not, and they beat every stylesheet.

                 `clip-path` rather than `left: -9999px`: see the note in style.css
                 → the offset version adds a ten-thousand-pixel horizontal scrollbar
                 to every Arabic page. #}
              <div class="hy-hp" aria-hidden="true"
                   style="position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0;">
                <label><span>Leave this field empty</span>
                  <input type="text" name="hy_hp" tabindex="-1" autocomplete="off"/></label>
              </div>
              {# aria-live so the message is announced, not just drawn. #}
              <p class="hy-footer-err" x-show="err" x-text="err" x-cloak
                 role="alert" aria-live="assertive"></p>
            </form>

            {% if nlNote %}
              {# ⚠️  A <div>, NOT a <p>. A `text` field comes back as block HTML
                   (`<p>…</p>`), and a <p> cannot contain a <p> — the browser
                   closes the outer one and the content becomes a SIBLING, so
                   every style on this class stops reaching the text. The inner
                   margins are reset in the CSS. #}
              <div class="hy-footer-note">{{ nlNote | safe }}</div>
            {% endif %}
          {% else %}
            <span class="hy-footer-hint hy-editor-only">{{ t('newsletter.setup_hint') }}</span>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <div class="hy-footer-top">

      {# ═══════════ link columns ═══════════ #}
      {% for fc in footCols %}
          <div class="hy-footer-col">
            {% if fc.title %}<h2 class="hy-footer-heading">{{ fc.title }}</h2>{% endif %}
            {% if fc.items | length %}
              <nav class="hy-footer-links">
                {% for item in fc.items %}
                  <a href="{{ item.url | default('#', true) }}"{{ extAttrs(item.url) }}>{{ item.title }}</a>
                {% endfor %}
              </nav>
            {% endif %}
          </div>
      {% endfor %}

      {# ═══════════ instagram ═══════════
         Three pictures and a handle, not an API feed: Qumra has no Instagram
         connection, so this is images the merchant uploads and links. Calling
         it a feed when nothing refreshes it would be the lie. #}
      {% if igShots | length > 0 %}
        <div class="hy-footer-col">
          {% if d.instagram_title %}<h2 class="hy-footer-heading">{{ d.instagram_title }}</h2>{% endif %}
          <div class="hy-footer-ig">
            {% for g in igShots %}
              <a href="{{ g.url or igLink or '#' }}"{{ extAttrs(g.url or igLink) }} class="hy-footer-ig-tile">
                <img src="{{ g.src }}" alt="" loading="lazy"/>
              </a>
            {% endfor %}
          </div>
          {% if d.instagram_handle %}
            <a href="{{ d.instagram_url | default('#', true) }}"{{ extAttrs(d.instagram_url) }} class="hy-footer-ig-handle">{{ d.instagram_handle }}</a>
          {% endif %}
        </div>
      {% endif %}

    </div>

    {# ═══════════════════ utility row ═══════════════════ #}
    <div class="hy-footer-util">
      <div class="hy-footer-util-start">

        {% if showLang %}
          {# Where the reference puts a country/currency picker. See the note at
             the top of this file: the market is resolved server-side and there
             is no storefront form for it — the language is the one thing a
             shopper can switch from here. #}
          <div class="hy-footer-lang" x-data="{ open: false }" @click.outside="open = false">
            <button type="button" class="hy-footer-lang-btn" @click="open = !open"
                    :aria-expanded="open ? 'true' : 'false'" aria-label="{{ t('common.language') }}">
              <span>{{ 'English' if currentLang == 'en' else 'العربية' }}</span>
              <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor"
                   stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 4.5 6 8l3.5-3.5"/>
              </svg>
            </button>

            <div class="hy-footer-lang-drop" x-show="open" x-cloak
                 x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0 translate-y-1"
                 x-transition:enter-end="opacity-100 translate-y-0">
              {% form 'lang' %}
                <button type="submit" name="lang" value="ar" {% if currentLang == 'ar' %}disabled{% endif %}>
                  <span class="font-body">العربية</span>
                </button>
                <button type="submit" name="lang" value="en" {% if currentLang == 'en' %}disabled{% endif %}>
                  <span class="font-body-en">English</span>
                </button>
              {% endform %}
            </div>
          </div>
        {% endif %}

        {% if showPay %}
          <div class="hy-footer-pay" role="list" aria-label="{{ t('footer.payments') }}">
            {% if hasPayImg %}
              {# Uploaded artwork REPLACES the drawn row — see the note at the
                 top of ui/payment-icons.njk. #}
              {% if (payImg1 | length) > 0 %}<img src="{{ payImg1 }}" alt="" loading="lazy"/>{% endif %}
              {% if (payImg2 | length) > 0 %}<img src="{{ payImg2 }}" alt="" loading="lazy"/>{% endif %}
              {% if (payImg3 | length) > 0 %}<img src="{{ payImg3 }}" alt="" loading="lazy"/>{% endif %}
            {% else %}
              {% if d.pay_mada %}{% ui "payment-icons.njk", key='mada', label='mada' %}{% endif %}
              {% if d.pay_visa %}{% ui "payment-icons.njk", key='visa', label='Visa' %}{% endif %}
              {% if d.pay_mastercard %}{% ui "payment-icons.njk", key='mastercard', label='Mastercard' %}{% endif %}
              {% if d.pay_amex %}{% ui "payment-icons.njk", key='amex', label='American Express' %}{% endif %}
              {% if d.pay_applepay %}{% ui "payment-icons.njk", key='applepay', label='Apple Pay' %}{% endif %}
              {% if d.pay_stcpay %}{% ui "payment-icons.njk", key='stcpay', label='STC Pay' %}{% endif %}
              {% if d.pay_tabby %}{% ui "payment-icons.njk", key='tabby', label='Tabby' %}{% endif %}
              {% if d.pay_tamara %}{% ui "payment-icons.njk", key='tamara', label='Tamara' %}{% endif %}
              {% if d.pay_paypal %}{% ui "payment-icons.njk", key='paypal', label='PayPal' %}{% endif %}
              {% if d.pay_cod %}{% ui "payment-icons.njk", key='cod', label=t('footer.cod') %}{% endif %}
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="hy-footer-social hy-footer-social--{{ socialStyle }}">
        {{ socialLink(d.social_facebook, 'facebook', 'Facebook') }}
        {{ socialLink(d.social_x, 'x', 'X') }}
        {{ socialLink(d.social_instagram, 'instagram', 'Instagram') }}
        {{ socialLink(d.social_tiktok, 'tiktok', 'TikTok') }}
        {{ socialLink(d.social_youtube, 'youtube', 'YouTube') }}
        {{ socialLink(d.social_snapchat, 'snapchat', 'Snapchat') }}
        {{ socialLink(d.social_whatsapp, 'whatsapp', 'WhatsApp') }}
        {{ socialLink(d.social_pinterest, 'pinterest', 'Pinterest') }}
      </div>
    </div>
  </div>

  {# ═══════════════════ bottom bar ═══════════════════ #}
  <div class="hy-footer-bottom">
    <div class="hy-container hy-footer-bar">

      <span>
        {# The year is written by the script below rather than typed into the
           setting — a hardcoded "© 2026" is wrong from January and nobody
           notices for months. #}
        © <span data-hy-year>2026</span>{% if copyright %} {{ copyright }}{% endif %}
      </span>

      {% if bottomMenu %}
        <nav class="hy-footer-legal">
          {% for item in (bottomMenu.items if bottomMenu.items else bottomMenu) %}
            <a href="{{ item.url | default('#', true) }}"{{ extAttrs(item.url) }}>{{ item.title }}</a>
          {% endfor %}
        </nav>
      {% endif %}

    </div>
  </div>
</footer>

<script>
  (function () {
    var el = document.querySelector('#hy-footer-{{ id }} [data-hy-year]');
    if (el) el.textContent = new Date().getFullYear();
  })();
</script>

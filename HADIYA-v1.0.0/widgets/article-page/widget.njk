{# ============================================================================
   HYPER ARTICLE PAGE — /articles/<handle>
   ----------------------------------------------------------------------------
   One post: title, meta, hero, prose body, tags, share, then related articles.

   The measure is deliberately narrow (~68ch). An article set to the shop's
   full 1440px would run 200 characters a line and become unreadable — this is
   the one place in the theme that does not use the wide container.

   Related cards are ui/article-card.njk, the same `.hy-post-*` object used
   everywhere else. Styling: style.css → "15.27 BLOG".
   ========================================================================= #}

{% set id = widget.id %}
{% set d = widget.data %}
{% set a = context.article | default({}, true) %}
{# the platform sends the related list next to the article, as context.related_articles #}
{% set related = context.related_articles or a.relatedArticles or a.related or [] %}

{% set showHero = d.show_hero | default(true) %}
{% set showMeta = d.show_meta | default(true) %}
{% set showShare = d.show_share | default(true) %}
{% set showTags = d.show_tags | default(true) %}
{% set showRelated = d.show_related | default(true) %}
{% set relatedTitle = d.related_title if (d.related_title | default('', true) | trim | length) > 0 else t('pages.blog.related_articles') %}
{% set relatedLimit = d.related_limit | default(3) %}

{# the cover arrives as { fileUrl }, as imageUrl, or as a plain string #}
{% if a.image and a.image.fileUrl and not a.image.notFound %}{% set heroImg = a.image.fileUrl %}
{% elif a.imageUrl %}{% set heroImg = a.imageUrl %}
{% elif a.image and a.image is string %}{% set heroImg = a.image %}
{% else %}{% set heroImg = '' %}{% endif %}
{% set body = a.content or a.description %}
{% set postDate = a.publishedAt or a.createdAt %}
{% set blogHandle = (a.blog.handle or a.blog.slug) if a.blog else ((a.category.handle or a.category.slug) if a.category else '') %}
{% set backUrl = ('/blogs/' ~ blogHandle) if blogHandle else '/blogs' %}


<article id="hy-article-{{ id }}" class="hy-article"
         x-data="{ copied: false,
                   async share() {
                     var url = window.location.href;
                     if (navigator.share) {
                       try { await navigator.share({ title: document.title, url: url }); return; }
                       catch (e) { /* dismissed — fall through to copy */ }
                     }
                     try { await navigator.clipboard.writeText(url); } catch (e) { return; }
                     this.copied = true;
                     setTimeout(() => { this.copied = false; }, 2000);
                   } }">

  <div class="hy-container hy-container--narrow">

    <nav class="hy-crumbs" aria-label="{{ t('common.home') }}">
      <a href="/">{{ t('common.home') }}</a>
      <svg class="rtl-flip" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/>
      </svg>
      <a href="{{ backUrl }}">{{ (a.blog.title if a.blog else '') or t('pages.blog.title') }}</a>
    </nav>

    <header class="hy-article-head">
      {# `category` is the whole BlogCategory document, not a string — see the
         same note in ui/article-card.njk. Its name is `.title`. #}
      {% set cat = a.category %}
      {% set catName = '' %}
      {% if cat %}
        {% set catName = cat.title | default(cat.name, true) | default('', true) %}
        {% if not catName and (cat | string) != '[object Object]' %}
          {% set catName = cat | string %}
        {% endif %}
      {% endif %}
      {% if catName %}<span class="hy-blog-eyebrow">{{ catName }}</span>{% endif %}

      <h1 class="hy-article-title">{{ a.title or t('pages.blog.title') }}</h1>

      {% if showMeta and (postDate or a.views) %}
        <div class="hy-article-meta">
          {% if postDate %}
            {# ISO stays in `datetime` for machines; localiseDates() in main.js
               rewrites the visible text with the storefront's language. #}
            <time datetime="{{ postDate }}" data-hy-date>{{ (postDate | string).slice(0, 10) }}</time>
          {% endif %}
          {% if postDate and a.views %}
            <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 1.5c.7 6.1 4.4 9.8 10.5 10.5-6.1.7-9.8 4.4-10.5 10.5-.7-6.1-4.4-9.8-10.5-10.5C7.6 11.3 11.3 7.6 12 1.5Z"/>
            </svg>
          {% endif %}
          {% if a.views %}
            <span><bdi>{{ a.views }}</bdi> {{ t('pages.blog.views') }}</span>
          {% endif %}
        </div>
      {% endif %}
    </header>
  </div>

  {# The hero breaks the measure on purpose — the photograph gets the page
     width while the words keep their column. #}
  {% if showHero and heroImg %}
    <div class="hy-container">
      <div class="hy-article-hero">
        <img src="{{ heroImg }}" alt="{{ a.title }}" fetchpriority="high"/>
      </div>
    </div>
  {% endif %}

  <div class="hy-container hy-container--narrow">

    {% if body %}
      <div class="taqa-prose hy-article-body">{{ body | safe }}</div>
    {% endif %}

    {% if showTags and a.tags and (a.tags | length) > 0 %}
      <div class="hy-article-tags">
        {#- Tags arrive as objects on live stores ({ name, displayName… }), not
            strings — printed raw they read «[object Object]». -#}
        {% for tag in a.tags %}{% if tag is string %}{% set tagText = tag %}{% elif tag.displayName %}{% set tagText = tag.displayName %}{% elif tag.name %}{% set tagText = tag.name %}{% elif tag.title %}{% set tagText = tag.title %}{% elif tag.label %}{% set tagText = tag.label %}{% elif tag.value %}{% set tagText = tag.value %}{% else %}{% set tagText = "" %}{% endif %}{% if tagText %}<span class="hy-article-tag">{{ tagText }}</span>{% endif %}{% endfor %}
      </div>
    {% endif %}

    {% if showShare %}
      <div class="hy-article-share">
        <span class="hy-blog-eyebrow" style="margin: 0;">{{ t('pages.blog.share_article') }}</span>
        <button type="button" @click="share()" class="hy-btn hy-btn--outline hy-btn--sm">
          <span x-text="copied ? '{{ t('pages.blog.copied') }}' : '{{ t('common.share') }}'">{{ t('common.share') }}</span>
        </button>
      </div>
    {% endif %}

    <div class="hy-article-back">
      <a href="{{ backUrl }}" class="hy-cart-back">
        <svg class="rtl-flip" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6"/>
        </svg>
        {{ t('pages.blog.back_to_articles') }}
      </a>
    </div>

  </div>

  {# ═════════════ related ═════════════ #}
  {% if showRelated and (related | length) > 0 %}
    <div class="hy-article-related">
      <div class="hy-container">
        <div class="hy-blog-head hy-blog-head--row">
          <h2 class="hy-blog-title hy-blog-title--sm">{{ relatedTitle }}</h2>
        </div>
        {% set relN = (related | length) if (related | length) < relatedLimit else relatedLimit %}
        <div class="hy-blog-grid hy-blog-grid--c{{ 2 if relN == 2 else 3 }}" style="--blog-cols: {{ 2 if relN == 2 else 3 }};">
          {% for ra in related %}
            {% if loop.index <= relatedLimit %}
              {% ui "article-card.njk", article=ra, show_date='on', show_excerpt='off' %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}
</article>

{# Per-section palette. Emits nothing at all unless `colors_enabled` is on. #}
{% ui "section-colors.njk", scope='#hy-article-' ~ id, c=d %}

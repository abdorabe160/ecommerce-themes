{# الهيدر — مطابق لـ mavin-wear.com: شريط إعلانات أسود متحرك + هيدر 3 أعمدة (القائمة | الشعار | الأيقونات)
   - القائمة الكاملة من 1024px، والبرجر من 1023px وأقل (RSP-05). القوائم المنسدلة بتتظبط جوه الشاشة (mwHeader.fit).
   - شريط الإعلانات بيتقفل ويفضل مقفول طول الجلسة (sessionStorage) من غير ما يرمش عند التحميل. #}
{% set wd = widget.data if (widget.data and (widget.data | length)) else (widget.settings or {}) %}
{% set ann = [wd.announcement_text, wd.announcement_text_2, wd.announcement_text_3] | select('string') | list %}
{% set annList = [] %}{% for a in ann %}{% if a | trim %}{% set _ = annList.push(a) %}{% endif %}{% endfor %}
{% set menu = wd.menu if (wd.menu and not (wd.menu is string)) else [] %}
{% set storeName = store.name if (store and store.name) else '' %}
{% set lang = localization.language | default('ar') %}
{% set isAr = lang == 'ar' %}
{% set curCode = (localization.currency.currencyCode if (localization and localization.currency and localization.currency.currencyCode) else '') %}
{% set wishOn = settings and settings.showWishlist == true %}

{% set iconBag %}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5.5 8.5h13l-.9 11.2a1.5 1.5 0 0 1-1.5 1.3H7.9a1.5 1.5 0 0 1-1.5-1.3L5.5 8.5Z" stroke="currentColor" stroke-width="1.65" stroke-linejoin="round"/><path d="M9 10.5V7a3 3 0 0 1 6 0v3.5" stroke="currentColor" stroke-width="1.65" stroke-linecap="round"/></svg>{% endset %}
{% set iconHeart %}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-9.2-9.4C1.6 7.6 3.9 4 7.4 4c2 0 3.6 1.1 4.6 2.7C13 5.1 14.6 4 16.6 4c3.5 0 5.8 3.6 4.6 7.1-1.7 4.8-9.2 9.4-9.2 9.4Z" stroke="currentColor" stroke-width="1.65" stroke-linejoin="round"/></svg>{% endset %}
{% set iconSearch %}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="7" stroke="currentColor" stroke-width="1.65"/><path d="m15.8 15.8 5.2 5.2" stroke="currentColor" stroke-width="1.65" stroke-linecap="round"/></svg>{% endset %}
{% set iconClose %}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>{% endset %}
{% set iconChevron %}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m5 9 7 7 7-7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endset %}

<div class="mw-header-wrap{% if not (annList | length) %} mw-header-wrap--no-ann{% endif %}{% if wd.sticky_header == false %} mw-header-wrap--static{% endif %}" id="mw-header" x-data="mwHeader()" @keydown.escape.window="closeAll()">
  {% if annList | length %}
  <script>try { if (sessionStorage.getItem('mw-ann-closed') === '1') document.documentElement.classList.add('mw-ann-closed'); } catch (e) {}</script>
  <div class="mw-announcement" role="region" aria-label="{{ t('header.announcements') }}">
    <div class="mw-announcement__inner">
      <div class="mw-marquee" style="--mw-marquee-dur: {{ wd.announcement_speed | default(60) }}s">
        {% for copy in [0, 1] %}
        <ul class="mw-marquee__track"{% if copy %} aria-hidden="true"{% endif %}>
          {% for n in range(0, 4) %}{% for text in annList %}
            <li class="mw-marquee__item">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="1.5" stroke="currentColor" stroke-width="1.6"/><path d="M8.5 9.5a3.5 3.5 0 0 0 7 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              <span dir="auto">{{ text }}</span>
            </li>
          {% endfor %}{% endfor %}
        </ul>
        {% endfor %}
      </div>
      {% if wd.announcement_link_text %}
        <a class="mw-announcement__link" href="{{ wd.announcement_link_url | default('/collections') }}">{{ wd.announcement_link_text }}</a>
      {% endif %}
      {% if wd.announcement_closable != false %}
        <button type="button" class="mw-announcement__close" @click="closeAnnouncement()" aria-label="{{ t('header.close_announcement') }}">{{ iconClose | safe }}</button>
      {% endif %}
    </div>
  </div>
  {% endif %}

  <header class="mw-header">
    <div class="mw-header__inner">
      {# ===== Start: burger (mobile) · nav (desktop) · search · notifications ===== #}
      <div class="mw-header__start">
        <button type="button" class="mw-icon-btn mw-header__burger" @click="openDrawer('menu')" aria-label="{{ t('header.menu') }}" :aria-expanded="(panel === 'menu').toString()">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 7.5h18M3 16.5h18" stroke="currentColor" stroke-width="1.65" stroke-linecap="round"/></svg>
        </button>

        <nav class="mw-nav" aria-label="{{ t('header.categories') }}">
          {% for item in menu %}{% if item and item.title %}
            {% set kids = item.children | default([]) %}
            {% set ext = (item.url or '') | string | lower %}
            <div class="mw-nav__item" {% if kids | length %}@mouseenter="openMenu({{ loop.index0 }}, $el)" @mouseleave="closeMenu()" :class="{ 'is-open': menuOpen === {{ loop.index0 }} }"{% endif %}>
              <a href="{{ item.url | default('#') }}" class="mw-nav__link"{% if ext.indexOf('http') == 0 %} target="_blank" rel="noopener noreferrer"{% endif %}{% if kids | length %} aria-haspopup="true" :aria-expanded="(menuOpen === {{ loop.index0 }}).toString()" @focus="openMenu({{ loop.index0 }}, $el.parentElement)"{% endif %}>
                <span>{{ item.title }}</span>{% if kids | length %}{{ iconChevron | safe }}{% endif %}
              </a>
              {% if kids | length %}
                {% set hasGrand = false %}
                {% for c in kids %}{% if c.children and (c.children | length) %}{% set hasGrand = true %}{% endif %}{% endfor %}
                <div class="mw-nav__dropdown{% if hasGrand %} mw-nav__dropdown--mega{% endif %}" @focusout="if (!$el.contains($event.relatedTarget)) closeMenu()">
                  {% for c in kids %}{% if c and c.title %}
                    {% set cext = (c.url or '') | string | lower %}
                    {% if c.children and (c.children | length) %}
                      <div class="mw-nav__col">
                        <a href="{{ c.url | default('#') }}" class="mw-nav__col-title"{% if cext.indexOf('http') == 0 %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ c.title }}</a>
                        {% for g in c.children %}{% if g and g.title %}{% set gext = (g.url or '') | string | lower %}<a href="{{ g.url | default('#') }}"{% if gext.indexOf('http') == 0 %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ g.title }}</a>{% endif %}{% endfor %}
                      </div>
                    {% else %}
                      <a href="{{ c.url | default('#') }}"{% if cext.indexOf('http') == 0 %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ c.title }}</a>
                    {% endif %}
                  {% endif %}{% endfor %}
                </div>
              {% endif %}
            </div>
          {% endif %}{% endfor %}
        </nav>

        {% if wd.show_search != false %}
        <button type="button" class="mw-icon-btn mw-icon-btn--search" @click="openDrawer('search')" aria-label="{{ t('header.search') }}">{{ iconSearch | safe }}</button>
        {% endif %}

        {% if wd.show_notification != false and wd.notification_title %}
        <div class="mw-notif" @click.outside="notif = false">
          <button type="button" class="mw-icon-btn" @click="notif = !notif; seen = true" :aria-expanded="notif.toString()" aria-label="{{ t('header.notifications') }}">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 16.5V11a6 6 0 1 1 12 0v5.5l1.5 2H4.5l1.5-2Z" stroke="currentColor" stroke-width="1.65" stroke-linejoin="round"/><path d="M10 20.5a2 2 0 0 0 4 0" stroke="currentColor" stroke-width="1.65" stroke-linecap="round"/></svg>
            <span class="mw-header__count mw-header__count--alert" x-show="!seen">1</span>
          </button>
          <div class="mw-notif__panel" x-show="notif" x-cloak x-transition.opacity>
            <div class="mw-notif__head">
              <span>{{ t('header.notifications') }}</span>
              <button type="button" class="mw-drawer__close" @click="notif = false" aria-label="{{ t('common.close') }}">{{ iconClose | safe }}</button>
            </div>
            <div class="mw-notif__row">
              <div>
                <p class="mw-notif__title">{{ wd.notification_title }}</p>
                {% if wd.notification_text %}<p class="mw-notif__text">{{ wd.notification_text }}</p>{% endif %}
                {% if wd.notification_button %}<a href="{{ wd.notification_url | default('/collections') }}" class="mw-btn mw-btn--filled">{{ wd.notification_button }}</a>{% endif %}
              </div>
            </div>
            <p class="mw-notif__empty">{{ t('header.caught_up') }}</p>
          </div>
        </div>
        {% endif %}
      </div>

      {# ===== Center: logo (alt = اسم المتجر، الاسم الطويل بيتقص) ===== #}
      {% set logoUrl = (wd.logo.fileUrl if (wd.logo and wd.logo.fileUrl) else (store.logo.fileUrl if (store and store.logo and store.logo.fileUrl) else '')) %}
      {# من غير اسم متجر: اسم وصول عام مترجم («الرئيسية») + أيقونة بيت — مش اسم براند #}
      {% set logoLabel = storeName or t('common.home') %}
      <a href="/" class="mw-header__logo" aria-label="{{ logoLabel }}" title="{{ logoLabel }}">
        {% if logoUrl %}
          <img src="{{ logoUrl }}" alt="{{ logoLabel }}" width="168" height="32"/>
        {% elif storeName %}
          <span class="mw-header__logo-text" dir="auto">{{ storeName }}</span>
        {% else %}
          <svg class="mw-header__logo-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3.5 10.5 12 3.5l8.5 7V20a.5.5 0 0 1-.5.5h-5v-6h-6v6H4a.5.5 0 0 1-.5-.5v-9.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
        {% endif %}
      </a>

      {# ===== End: language · currency · wishlist · cart ===== #}
      <div class="mw-header__end">
        {% if wd.show_language != false %}
          {% if isAr %}
            <a href="{{ wd.english_url | default('/en') }}" class="mw-header__text-link" hreflang="en" lang="en" data-mw-lang="en">English</a>
          {% else %}
            <a href="{{ wd.arabic_url | default('/ar') }}" class="mw-header__text-link" hreflang="ar" lang="ar" data-mw-lang="ar">العربية</a>
          {% endif %}
        {% endif %}
        {% if wd.currencies %}
        <div class="mw-currency mw-header__currency" data-mw-currency data-currencies="{{ wd.currencies | trim }}" data-current="{{ curCode }}" hidden></div>
        {% endif %}
        {% if wishOn %}
        <a href="/wishlist" class="mw-icon-btn mw-header__wish" aria-label="{{ t('wishlist.title') }}">
          {{ iconHeart | safe }}
          <span class="mw-header__count" x-show="$store.mw.wish.length > 0" x-cloak x-text="$store.mw.wish.length"></span>
        </a>
        {% endif %}
        <a href="/cart" class="mw-icon-btn mw-header__cart" @click.prevent="openCart()" aria-label="{{ t('header.cart') }}">
          {{ iconBag | safe }}
          <span class="mw-header__count" x-show="$store.mw.cart.totalQuantity > 0" x-cloak x-text="$store.mw.cart.totalQuantity"></span>
        </a>
      </div>
    </div>
  </header>

  <div class="mw-page-dim" :class="{ 'is-visible': menuOpen !== null }" aria-hidden="true"></div>

  {# ===== Mobile menu drawer (≤1023px) — 3 مستويات كأكورديون ===== #}
  <div class="mw-drawer mw-drawer--menu" :class="{ 'is-open': panel === 'menu' }" role="dialog" aria-modal="true" aria-label="{{ t('header.menu') }}" :aria-hidden="(panel !== 'menu').toString()">
    <div class="mw-drawer__overlay" @click="closeAll()"></div>
    <div class="mw-drawer__panel">
      <div class="mw-drawer__head">
        <span class="mw-drawer__title">{{ t('header.menu') }}</span>
        <button type="button" class="mw-drawer__close" @click="closeAll()" aria-label="{{ t('common.close') }}">{{ iconClose | safe }}</button>
      </div>
      <ul class="mw-drawer__nav">
        {% for item in menu %}{% if item and item.title %}
          {% set ext = (item.url or '') | string | lower %}
          <li>
            {% if item.children and (item.children | length) %}
              <details class="mw-drawer__group">
                <summary>{{ item.title }}{{ iconChevron | safe }}</summary>
                <div class="mw-drawer__sub">
                  <a href="{{ item.url | default('#') }}"{% if ext.indexOf('http') == 0 %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ t('common.view_all') }}</a>
                  {% for c in item.children %}{% if c and c.title %}
                    {% set cext = (c.url or '') | string | lower %}
                    {% if c.children and (c.children | length) %}
                      <details class="mw-drawer__group mw-drawer__group--l2">
                        <summary>{{ c.title }}{{ iconChevron | safe }}</summary>
                        <div class="mw-drawer__sub">
                          <a href="{{ c.url | default('#') }}"{% if cext.indexOf('http') == 0 %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ t('common.view_all') }}</a>
                          {% for g in c.children %}{% if g and g.title %}{% set gext = (g.url or '') | string | lower %}<a href="{{ g.url | default('#') }}"{% if gext.indexOf('http') == 0 %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ g.title }}</a>{% endif %}{% endfor %}
                        </div>
                      </details>
                    {% else %}
                      <a href="{{ c.url | default('#') }}"{% if cext.indexOf('http') == 0 %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ c.title }}</a>
                    {% endif %}
                  {% endif %}{% endfor %}
                </div>
              </details>
            {% else %}
              <a class="mw-drawer__nav-link" href="{{ item.url | default('#') }}"{% if ext.indexOf('http') == 0 %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ item.title }}</a>
            {% endif %}
          </li>
        {% endif %}{% endfor %}
      </ul>
      <div class="mw-drawer__foot">
        {% if wishOn %}<a href="/wishlist">{{ iconHeart | safe }}<span>{{ t('wishlist.title') }}</span></a>{% endif %}
        {% if wd.show_language != false %}
          {% if isAr %}<a href="{{ wd.english_url | default('/en') }}" hreflang="en" lang="en" data-mw-lang="en">English</a>{% else %}<a href="{{ wd.arabic_url | default('/ar') }}" hreflang="ar" lang="ar" data-mw-lang="ar">العربية</a>{% endif %}
        {% endif %}
        {% if wd.currencies %}<div class="mw-currency" data-mw-currency data-currencies="{{ wd.currencies | trim }}" data-current="{{ curCode }}" hidden></div>{% endif %}
      </div>
    </div>
  </div>

  {# ===== Search drawer ===== #}
  <div class="mw-drawer mw-search" :class="{ 'is-open': panel === 'search' }" role="dialog" aria-modal="true" aria-label="{{ t('header.search') }}" :aria-hidden="(panel !== 'search').toString()">
    <div class="mw-drawer__overlay" @click="closeAll()"></div>
    <div class="mw-drawer__panel" x-data="mwSearch()" data-popular="{{ wd.popular_searches | default('') }}">
      <div class="mw-search__body">
        <form class="mw-search__form" action="/search" method="get" role="search" @submit.prevent="submit()">
          {{ iconSearch | safe }}
          <input class="mw-search__input" type="search" name="q" x-model="query" maxlength="120"
                 @input.debounce.250ms="input()" @keydown.arrow-down.prevent="move(1)" @keydown.arrow-up.prevent="move(-1)"
                 placeholder="{{ t('header.search_placeholder') }}" aria-label="{{ t('header.search') }}"
                 autocomplete="off" role="combobox" aria-autocomplete="list" aria-controls="mw-search-panel" :aria-expanded="searched.toString()"/>
          <span class="mw-spinner mw-search__spin" x-show="loading" x-cloak></span>
          <button type="button" class="mw-search__clear" x-show="query.length" x-cloak @click="clear()">{{ t('header.clear') }}</button>
          <button type="button" class="mw-drawer__close mw-search__x" @click="closeAll()" aria-label="{{ t('common.close') }}">{{ iconClose | safe }}</button>
        </form>

        {# قبل الكتابة: عمليات البحث السابقة + الأكثر بحثاً #}
        <div class="mw-search__idle" x-show="!q" x-cloak>
          <div class="mw-search__group" x-show="recent.length">
            <p class="mw-search__label"><span>{{ t('search.recent') }}</span><button type="button" class="mw-search__label-link" @click="clearRecent()">{{ t('header.clear') }}</button></p>
            <div class="mw-search__chips">
              <template x-for="t in recent" :key="'r' + t"><button type="button" class="mw-chip-s" @click="use(t)"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6"/></svg><span x-text="t"></span></button></template>
            </div>
          </div>
          <div class="mw-search__group" x-show="popular.length">
            <p class="mw-search__label"><span>{{ t('search.popular') }}</span></p>
            <div class="mw-search__chips">
              <template x-for="t in popular" :key="'p' + t"><button type="button" class="mw-chip-s" @click="use(t)"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m4 15 5-5 4 4 7-7M15 7h5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><span x-text="t"></span></button></template>
            </div>
          </div>
        </div>

        {# أثناء الكتابة: اقتراحات + تصنيفات + المنتجات المتاحة بالاسم ده #}
        <div class="mw-search__results" id="mw-search-panel" x-show="q && searched" x-cloak>
          <aside class="mw-search__side" x-show="terms.length || cols.length">
            <div class="mw-search__group" x-show="terms.length">
              <p class="mw-search__label"><span>{{ t('search.suggestions') }}</span></p>
              <ul class="mw-search__list" role="listbox">
                <template x-for="(t, i) in terms" :key="'t' + i">
                  <li><button type="button" class="mw-search__term" :class="{ 'is-active': active === i }" :data-nav="i" :data-term="t" @click="use(t)" role="option" :aria-selected="(active === i).toString()">
                    {{ iconSearch | safe }}<span x-html="hl(t)"></span>
                  </button></li>
                </template>
              </ul>
            </div>
            <div class="mw-search__group" x-show="cols.length">
              <p class="mw-search__label"><span>{{ t('search.collections') }}</span></p>
              <ul class="mw-search__list">
                <template x-for="(c, i) in cols" :key="'c' + i">
                  <li><a class="mw-search__term" :href="c.url" :class="{ 'is-active': active === terms.length + i }" :data-nav="terms.length + i" @click="remember()">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="4" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.6"/><rect x="13" y="4" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.6"/><rect x="4" y="13" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.6"/><rect x="13" y="13" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.6"/></svg>
                    <span x-html="hl(c.title)"></span>
                  </a></li>
                </template>
              </ul>
            </div>
          </aside>

          <div class="mw-search__main">
            <p class="mw-search__label" x-show="products.length"><span x-html="availableText"></span></p>
            <ul class="mw-search__products">
              <template x-for="(p, i) in products" :key="p._id">
                <li class="mw-search__product" :class="{ 'is-out': p.stock <= 0, 'is-active': active === terms.length + cols.length + i }" :data-nav="terms.length + cols.length + i"
                    :data-id="p._id" :data-handle="p.handle" :data-url="p.url" :data-options="p.hasOptions ? '1' : '0'" :data-stock="p.stock === Infinity ? -1 : p.stock" :data-title="p.title">
                  <a :href="p.url" class="mw-search__pimg" @click="remember()" tabindex="-1"><img :src="img(p)" :alt="p.title" loading="lazy" width="120" height="160"/></a>
                  <div class="mw-search__pinfo">
                    <a :href="p.url" class="mw-search__ptitle" x-html="hl(p.title)" @click="remember()"></a>
                    <div class="mw-price">
                      <s x-show="p.compare > p.price" x-text="money(p.compare)"></s>
                      <span :class="{ 'is-sale': p.compare > p.price }" x-text="money(p.price)"></span>
                    </div>
                    <span class="mw-search__pstock" :class="'is-' + stockOf(p).kind" x-text="stockOf(p).text"></span>
                  </div>
                  <button type="button" class="mw-search__padd" x-show="p.stock > 0" @click="$store.mw.cardAction($el, 'add')" :disabled="$store.mw.isBusy('add:' + p._id)" aria-label="{{ t('product.add_to_cart') }}">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5.5 8.5h13l-.9 11.2a1.5 1.5 0 0 1-1.5 1.3H7.9a1.5 1.5 0 0 1-1.5-1.3L5.5 8.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 10.5V7a3 3 0 0 1 6 0v3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    <span>{{ t('search.add') }}</span>
                  </button>
                </li>
              </template>
            </ul>

            <div class="mw-search__none" x-show="!loading && !error && !products.length">
              <p>{{ t('search.no_match') }} <bdi><b x-text="q"></b></bdi></p>
              <div class="mw-search__chips" x-show="popular.length">
                <template x-for="t in popular" :key="'np' + t"><button type="button" class="mw-chip-s" @click="use(t)"><span x-text="t"></span></button></template>
              </div>
            </div>
            <p class="mw-search__msg" x-show="error" role="alert">{{ t('header.search_error') }}</p>

            <button type="button" class="mw-btn mw-btn--filled mw-search__all" x-show="total > 0" @click="go()">
              <span>{{ t('search.view_all') }}</span><span class="mw-search__count" x-text="total"></span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

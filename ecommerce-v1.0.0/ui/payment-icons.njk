{# ============================================================================
   ui/payment-icons.njk — one payment badge
   ----------------------------------------------------------------------------
     {% ui "payment-icons.njk", key='visa' %}

   ⚠️  These are DRAWN marks, not the official brand assets. They are here so a
   merchant gets a legible, consistent payment row out of the box without
   uploading ten logo files. Some payment providers require their exact
   trademark artwork in their brand guidelines — a store under such an
   agreement should use the media badges in the footer settings instead, which
   replace this row entirely.

   Everything except Mastercard's rings, Apple's mark and the cash note is a
   WORDMARK: a span whose colour comes from `.hy-pay--<key>` in the CSS rather
   than from an inline style, so a merchant recolouring the footer does not have
   to fight ten hardcoded values.

   The set leans Gulf-first — mada, STC Pay, Tabby, Tamara — because those are
   the methods an Arabic storefront actually offers. Diners and Discover are
   deliberately absent: they are in the reference design but effectively unused
   in this market, and an unused badge is a lie about what the store accepts.

   Styling lives in assets/style.css → "15.20.1 PAYMENT BADGES".
   ========================================================================= #}

{# Locals from `{% ui %}` arrive under `data` — every other partial in ui/
   reads them that way (`data.product`, `data.scope`, `data.kind`). Reading a
   bare `key` here rendered an empty badge with no error at all. #}
{% set k = data.key | default('') %}

<span class="hy-pay hy-pay--{{ k }}" role="img" aria-label="{{ data.label | default(k) }}">

  {% if k == 'mastercard' %}
    {# The two rings. The overlap is a third path with `mix-blend-mode` off and
       an explicit orange fill — blend modes are unreliable inside the tiny
       rasterisations some email/PDF renderers make of a page. #}
    <svg viewBox="0 0 34 22" width="30" height="20" aria-hidden="true">
      <circle cx="13" cy="11" r="7.6" fill="#EB001B"/>
      <circle cx="21" cy="11" r="7.6" fill="#F79E1B"/>
      <path fill="#FF5F00" d="M17 5.2a7.6 7.6 0 0 0 0 11.6 7.6 7.6 0 0 0 0-11.6Z"/>
    </svg>

  {% elif k == 'applepay' %}
    <span class="hy-pay-row">
      <svg viewBox="0 0 16 20" width="12" height="15" fill="currentColor" aria-hidden="true">
        <path d="M11.2 3.1c.6-.8 1-1.8.9-2.9-.9 0-2 .6-2.6 1.4-.6.7-1.1 1.8-.9 2.8 1 .1 2-.5 2.6-1.3Zm.9 1.5c-1.4-.1-2.6.8-3.3.8-.7 0-1.7-.8-2.8-.7-1.5 0-2.8.9-3.6 2.2-1.5 2.6-.4 6.5 1.1 8.7.7 1 1.6 2.2 2.7 2.1 1.1 0 1.5-.7 2.8-.7 1.3 0 1.6.7 2.8.7 1.2 0 1.9-1 2.6-2.1.8-1.2 1.1-2.3 1.2-2.4 0 0-2.3-.9-2.3-3.4 0-2.1 1.7-3.1 1.8-3.2-1-1.4-2.5-1.6-3-1.6Z"/>
      </svg>
      <span class="hy-pay-word">Pay</span>
    </span>

  {% elif k == 'cod' %}
    {# Cash on delivery. A banknote rather than a wordmark, because "الدفع عند
       الاستلام" does not fit a 46px badge in any language. #}
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor"
         stroke-width="1.5" aria-hidden="true">
      <rect x="2.5" y="6" width="19" height="12" rx="2"/>
      <circle cx="12" cy="12" r="2.6"/>
      <path stroke-linecap="round" d="M5.6 9.4h.01M18.4 14.6h.01"/>
    </svg>

  {% elif k == 'mada' %}
    {# The real mark is a wordmark with a green/blue chevron pair. The chevrons
       carry the recognition, so they are drawn and the word is set beside
       them. #}
    <span class="hy-pay-row">
      <svg viewBox="0 0 14 12" width="11" height="10" aria-hidden="true">
        <path fill="#84B740" d="M0 8.4 4.6 0h2.6L2.6 8.4H0Z"/>
        <path fill="#159BD7" d="M6.2 8.4 10.8 0h2.6L8.8 8.4H6.2Z"/>
      </svg>
      <span class="hy-pay-word">mada</span>
    </span>

  {% elif k == 'paypal' %}
    {# Two-tone: the brand sets "Pay" darker than "Pal". #}
    <span class="hy-pay-word"><b>Pay</b><i>Pal</i></span>

  {% elif k == 'visa' %}
    <span class="hy-pay-word">VISA</span>
  {% elif k == 'amex' %}
    <span class="hy-pay-word">AMEX</span>
  {% elif k == 'stcpay' %}
    <span class="hy-pay-word">stc<i>pay</i></span>
  {% elif k == 'tabby' %}
    <span class="hy-pay-word">tabby</span>
  {% elif k == 'tamara' %}
    <span class="hy-pay-word">tamara</span>
  {% endif %}

</span>

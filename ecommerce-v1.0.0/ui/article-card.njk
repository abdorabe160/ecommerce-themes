{# ============================================================================
   HYPER ARTICLE CARD — shared by blogs-page, blog-page and article-page
   ----------------------------------------------------------------------------
   Built on the SAME `.hy-post-*` classes as the homepage post grid
   (assets/style.css → "15.18 POST GRID"), so an article looks identical whether
   a reader meets it on the home page or inside the blog. Only the container
   around it differs.

   Locals:
     article       (required) the article, or a blog when `is_blog` is on
     show_date     default true
     show_excerpt  default true
     kind          'blog' renders a BLOG (links to /blogs/<handle>, shows its
                   article count); anything else is an article (/articles/<handle>)

   ⚠️  `kind` is a STRING, not a boolean flag. Qalab's `{% ui %}` is a custom tag
   and a bare `true` did not survive the trip — the blog list rendered every
   card as an article and pointed all of them at the article route. Strings pass
   reliably (`variant='list'`, `image_ratio='3x4'`), so locals here use them.

   No <style> block: this repeats, so all styling lives in style.css.
   ========================================================================= #}

{% set a = data.article %}

{% if a %}
  {% set img = a.image.fileUrl if a.image and a.image.fileUrl else '' %}
  {# 'on' / 'off' strings — a bare boolean does not survive `{% ui %}`. A real
     boolean from a variable is accepted too; only 'off'/'false' turns it off. #}
  {% set showDate = (data.show_date | string) != 'false' and (data.show_date | string) != 'off' if data.show_date is defined else true %}
  {% set showExcerpt = (data.show_excerpt | string) != 'false' and (data.show_excerpt | string) != 'off' if data.show_excerpt is defined else true %}
  {% set isBlog = (data.kind | default('article')) == 'blog' %}
  {# ⚠️  /articles/<handle>, PLURAL. The singular /article/<handle> answers with a
     302 to the plural form on the live store, so every card in the theme was
     costing the reader a redirect — and a redirect that leaves the dev proxy
     for the production domain while developing. Verified against the running
     store: /articles/… → 200, /article/… → 302. #}
  {% set url = ('/blogs/' if isBlog else '/articles/') ~ (a.handle | default(a.slug) | default(a._id)) %}
  {% set body = a.description if isBlog else a.excerpt %}

  {# ⚠️  `category` is NOT a string. The API returns the whole BlogCategory
     document — {_id, title, handle, description, image, …} — so printing it
     straight rendered the literal "[object Object]" on every card. The name
     lives in `.title`; the `or` chain keeps the card working if an endpoint
     ever hands back a bare string instead. #}
  {% set cat = a.category %}
  {% set catName = '' %}
  {% if cat %}
    {% set catName = cat.title | default(cat.name) | default('') %}
    {% if not catName and (cat | string) != '[object Object]' %}
      {% set catName = cat | string %}
    {% endif %}
  {% endif %}

<a href="{{ url }}" class="hy-post hy-post--stacked">

  <div class="hy-post-media">
    {% if img %}
      <img src="{{ img }}" alt="{{ a.title }}" loading="lazy"/>
    {% else %}
      <span class="hy-post-noimg">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H12v16H5.5A1.5 1.5 0 0 1 4 18.5Z"/>
          <path d="M12 4h6.5A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5H12"/>
        </svg>
      </span>
    {% endif %}
  </div>

  <div class="hy-post-body">
    {% if isBlog %}
      {% if a.articlesCount %}
        <div class="hy-post-meta">
          <span><bdi>{{ a.articlesCount }}</bdi> {{ t('pages.blog.articles_count') }}</span>
        </div>
      {% endif %}
    {% elif (showDate and a.createdAt) or catName %}
      <div class="hy-post-meta">
        {% if catName %}<span>{{ catName }}</span>{% endif %}
        {% if catName and showDate and a.createdAt %}
          <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 1.5c.7 6.1 4.4 9.8 10.5 10.5-6.1.7-9.8 4.4-10.5 10.5-.7-6.1-4.4-9.8-10.5-10.5C7.6 11.3 11.3 7.6 12 1.5Z"/>
          </svg>
        {% endif %}
        {% if showDate and a.createdAt %}
          {# Nunjucks has no date filter, so the ISO value stays in `datetime`
             for machines and main.js localises the visible text — the same
             `data-hy-date` hook the post grid uses. #}
          <time datetime="{{ a.createdAt }}" data-hy-date>{{ (a.createdAt | string).slice(0, 10) }}</time>
        {% endif %}
      </div>
    {% endif %}

    <h3 class="hy-post-title hy-clamp-2">{{ a.title }}</h3>

    {% if showExcerpt and body %}
      <p class="hy-post-excerpt hy-clamp-2">{{ body | replace('<', ' <') | striptags }}</p>
    {% endif %}
  </div>
</a>
{% endif %}

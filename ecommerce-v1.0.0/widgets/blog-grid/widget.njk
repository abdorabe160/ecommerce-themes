{#
  ============================================================================
  BLOG GRID · شبكة المقالات
  ----------------------------------------------------------------------------
  /blogs/<handle> → that blog's articles (context.articles), server-paginated.
  /blogs          → Qumra hands only the blog list, so the articles of every
                    blog are gathered by HxPosts (assets/hx.js, data-card="bg").
  Card: rounded picture, category line, bold title, author · date, excerpt.
  Nothing yet → six demo articles (theme pictures, texts in the visitor's
  language) in the editor only; the live store shows a plain empty message.

  ⚠️ HxPosts scrapes `.hx-bg-card` (and the older `a.hy-post`) on blog pages:
  keep .hx-bg-title a / time[datetime] / .hx-bg-excerpt / .hx-bg-cat in place.
  Styles: assets/sections.css → "BLOG GRID".
  ============================================================================
#}

{% set id = widget.id %}
{% set d = widget.data %}
{% set blog = context.blog | default({}) %}
{% set articles = context.articles | default(blog.articles) | default([]) %}
{% set blogs = context.blogs | default([]) %}
{% set pagination = context.pagination %}
{% set onBlog = (blog.title | default('') | length) > 0 %}
{% set showCat = d.show_category != false %}
{% set showDate = d.show_date != false %}
{% set showEx = d.show_excerpt != false %}
{% set pageTitle = blog.title if onBlog else t('bx.blog') %}
{% set pageSub = blog.description if onBlog else t('bx.blogs_sub') %}
{% set demoImgs = ['pg-demo-2.jpg', 'pg-demo-5.jpg', 'hx-demo-6.jpg', 'pg-demo-4.jpg', 'pg-demo-1.jpg', 'hx-demo-3.jpg'] %}

{% macro card(url, img, cat, ttl, author, date, excerpt, showCat, showDate, showEx, demo) %}
  <article class="hx-bg-card{{ ' is-demo' if demo }}">
    <a href="{{ url }}" class="hx-bg-media" tabindex="-1" aria-hidden="true">{% if img %}<img src="{{ img }}" alt="" loading="lazy"/>{% else %}<span class="hx-bg-noimg"></span>{% endif %}</a>
    {% if showCat and cat %}<p class="hx-bg-cat">{{ cat }}</p>{% endif %}
    <h2 class="hx-bg-title" dir="auto"><a href="{{ url }}">{{ ttl }}</a></h2>
    {% if author or (showDate and date) %}
      <p class="hx-bg-meta">
        {% if author %}<span class="hx-bg-author"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path stroke-linecap="round" d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>{{ author }}</span>{% endif %}
        {% if author and showDate and date %}<span class="hx-bg-dot" aria-hidden="true">·</span>{% endif %}
        {% if showDate and date %}<time datetime="{{ date }}" data-hy-date>{{ (date | string).slice(0, 10) }}</time>{% endif %}
      </p>
    {% endif %}
    {% if showEx and excerpt %}<p class="hx-bg-excerpt">{{ excerpt | replace('<', ' <') | striptags }}</p>{% endif %}
  </article>
{% endmacro %}

{% macro catOf(a) %}{% if a.category %}{{ a.category.title | default(a.category.name) | default('') }}{% endif %}{% endmacro %}
{% macro authorOf(a) %}{% if a.author %}{% if a.author is string %}{{ a.author }}{% else %}{{ a.author.name | default((a.author.firstName | default('')) ~ ' ' ~ (a.author.lastName | default(''))) }}{% endif %}{% endif %}{% endmacro %}

<section id="hx-bg-{{ id }}"
         class="hx-bg hx-bgc{{ d.columns_desktop | default(3) }} {{ 'is-zoom' if d.hover_zoom != false }} is-r-{{ d.image_ratio | default('wide') }}"
         style="--bg-cols: {{ d.columns_desktop | default(3) }}; --pt: {{ d.padding_top if d.padding_top is defined else 16 }}px; --pb: {{ d.padding_bottom if d.padding_bottom is defined else 48 }}px;">
  <div class="hx-bg-wrap">
    {% if d.show_breadcrumb != false %}
      <nav class="hx-crumbs" aria-label="breadcrumb">
        <a href="/">{{ t('common.home') }}</a><span aria-hidden="true">/</span>
        {% if onBlog %}<a href="/blogs">{{ t('bx.blog') }}</a><span aria-hidden="true">/</span>{% endif %}
        <span aria-current="page">{{ pageTitle }}</span>
      </nav>
    {% endif %}

    {% if d.show_heading != false %}
      <header class="hx-bg-head">
        <h1 class="hx-bg-h">{{ pageTitle }}</h1>
        {% if pageSub %}<div class="hx-bg-sub">{{ pageSub | safe }}</div>{% endif %}
      </header>
    {% endif %}

    {% if not onBlog and (blogs | length) > 1 %}
      <nav class="hx-bg-chips" aria-label="{{ t('bx.blog') }}">
        <span class="hx-bg-chip is-on" aria-current="page">{{ t('bx.all') }}</span>
        {% for b in blogs %}{% if b.title %}<a class="hx-bg-chip" href="/blogs/{{ b.handle | default(b.slug) | default(b._id) }}">{{ b.title }}</a>{% endif %}{% endfor %}
      </nav>
    {% elif not onBlog %}
      {% for b in blogs %}<a hidden href="/blogs/{{ b.handle | default(b.slug) | default(b._id) }}">{{ b.title }}</a>{% endfor %}
    {% endif %}

    {% if (articles | length) > 0 %}
      <div class="hx-bg-grid">
        {% for a in articles %}
          {{ card('/articles/' ~ (a.handle | default(a.slug) | default(a._id)), a.image.fileUrl if a.image and a.image.fileUrl else '', catOf(a) | trim, a.title, authorOf(a) | trim, a.createdAt, a.excerpt, showCat, showDate, showEx) }}
        {% endfor %}
      </div>

      {% if pagination and pagination.totalPages > 1 %}
        <nav class="hx-bg-pager" aria-label="pagination">
          {% if pagination.currentPage > 1 %}<a href="?page={{ pagination.currentPage - 1 }}" class="hx-bg-pg is-arrow" aria-label="{{ t('common.prev') }}"><svg class="rtl-flip" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6"/></svg></a>{% endif %}
          {% for n in range(1, pagination.totalPages + 1) %}
            {% if n == pagination.currentPage %}<span class="hx-bg-pg is-on" aria-current="page"><bdi>{{ n }}</bdi></span>
            {% elif n == 1 or n == pagination.totalPages or (n >= pagination.currentPage - 1 and n <= pagination.currentPage + 1) %}<a href="?page={{ n }}" class="hx-bg-pg"><bdi>{{ n }}</bdi></a>
            {% elif n == pagination.currentPage - 2 or n == pagination.currentPage + 2 %}<span class="hx-bg-gap">…</span>{% endif %}
          {% endfor %}
          {% if pagination.hasNextPage %}<a href="?page={{ pagination.currentPage + 1 }}" class="hx-bg-pg is-arrow" aria-label="{{ t('common.next') }}"><svg class="rtl-flip" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/></svg></a>{% endif %}
        </nav>
      {% endif %}
    {% else %}
      {# /blogs (or an empty blog): demo cards, replaced by real articles when HxPosts finds any #}
      <div class="hx-bg-grid{{ ' is-empty-ok' if onBlog }}" {% if not onBlog %}data-hx-posts data-card="bg" data-limit="24" data-cat="{{ 'on' if showCat else 'off' }}" data-date="{{ 'on' if showDate else 'off' }}" data-excerpt="{{ 'on' if showEx else 'off' }}"{% endif %}>
        {% for n in [1, 2, 3, 4, 5, 6] %}
          {% set k = ((n - 1) % 4) + 1 %}
          {{ card('/blogs', demoImgs[n - 1] | assets, t('bx.demo_cat'), t('posts.a' ~ k ~ '.title'), t('bx.demo_author'), '2026-10-0' ~ n, t('posts.a' ~ k ~ '.excerpt'), showCat, showDate, showEx, true) }}
        {% endfor %}
      </div>
      <div class="hy-empty hx-bg-empty">
        <span class="hy-empty-title">{{ t('pages.blog.no_articles_desc') }}</span>
        <a href="/shop" class="hy-btn hy-btn--outline hy-btn--sm">{{ t('pages.shop.all_products') }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% if not onBlog and (articles | length) == 0 %}
<script>
  (function () {
    function boot() { var el = document.querySelector('#hx-bg-{{ id }} [data-hx-posts]'); if (el && window.HxPosts) HxPosts.fill(el); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
  })();
</script>
{% endif %}

{
  "name": "محتوى الصفحة",
  "settings": {
    "show_breadcrumb": {
      "type": "boolean",
      "label": {
        "ar": "إظهار مسار التنقّل",
        "en": "Show breadcrumb"
      },
      "default": true
    },
    "show_title": {
      "type": "boolean",
      "label": {
        "ar": "إظهار عنوان الصفحة",
        "en": "Show the page title"
      },
      "default": true
    },
    "eyebrow": {
      "type": "string",
      "label": {
        "ar": "نص تمهيدي فوق العنوان (اختياري)",
        "en": "Eyebrow above the title (optional)"
      },
      "default": ""
    },
    "title_override": {
      "type": "string",
      "label": {
        "ar": "عنوان بديل (اتركه فارغاً لاستخدام عنوان الصفحة من لوحة التحكّم)",
        "en": "Override title (empty = use the page title from the dashboard)"
      },
      "default": ""
    },
    "width": {
      "type": "select",
      "label": {
        "ar": "عرض النص",
        "en": "Text width"
      },
      "default": "narrow",
      "options": [
        {
          "value": "narrow",
          "label": {
            "ar": "ضيّق — أسهل في القراءة (موصى به)",
            "en": "Narrow — easier to read (recommended)"
          }
        },
        {
          "value": "wide",
          "label": {
            "ar": "بعرض الصفحة",
            "en": "Full page width"
          }
        }
      ]
    },
    "background": {
      "type": "select",
      "label": {
        "ar": "خلفية الصفحة",
        "en": "Page Background"
      },
      "default": "white",
      "options": [
        {
          "value": "white",
          "label": {
            "ar": "أبيض",
            "en": "White"
          }
        },
        {
          "value": "well",
          "label": {
            "ar": "بيج فاتح",
            "en": "Warm off-white"
          }
        }
      ]
    },
    "fallback_text": {
      "type": "text",
      "label": {
        "ar": "نص احتياطي (يظهر فقط إذا لم يكن للصفحة محتوى في لوحة التحكّم) — يقبل HTML",
        "en": "Fallback text (shown only when the page has no content in the dashboard) — HTML allowed"
      },
      "default": ""
    },
    "show_updated": {
      "type": "boolean",
      "label": {
        "ar": "إظهار تاريخ آخر تحديث إن وُجد",
        "en": "Show the last-updated date when available"
      },
      "default": false
    },
    "colors_enabled": {
      "type": "boolean",
      "label": {
        "ar": "ألوان مخصّصة لهذا القسم — أطفئه للرجوع لألوان الثيم",
        "en": "Custom colours for this section — switch off to restore the theme palette"
      },
      "default": false
    },
    "color_bg": {
      "type": "color",
      "label": {
        "ar": "لون الخلفية",
        "en": "Background colour"
      },
      "default": ""
    },
    "color_card": {
      "type": "color",
      "label": {
        "ar": "لون خلفية البطاقات",
        "en": "Card background"
      },
      "default": ""
    },
    "color_title": {
      "type": "color",
      "label": {
        "ar": "لون العنوان",
        "en": "Title colour"
      },
      "default": ""
    },
    "color_text": {
      "type": "color",
      "label": {
        "ar": "لون النص والوصف",
        "en": "Body & description colour"
      },
      "default": ""
    },
    "color_accent": {
      "type": "color",
      "label": {
        "ar": "لون التمييز — الكلمة الملوّنة والأيقونات والروابط",
        "en": "Accent — highlighted word, icons, links"
      },
      "default": ""
    },
    "color_border": {
      "type": "color",
      "label": {
        "ar": "لون الحدود والفواصل",
        "en": "Borders & dividers"
      },
      "default": ""
    },
    "show_sidebar": {
      "type": "boolean",
      "label": {
        "ar": "▸ العمود الجانبي (روابط مهمة + بطاقة)",
        "en": "▸ Sidebar (key links + card)"
      },
      "default": true
    },
    "side_title": {
      "type": "string",
      "label": {
        "ar": "عنوان البطاقة — فارغ = النص الافتراضي بلغة الزائر",
        "en": "Card title — empty = default text in the visitor's language"
      },
      "default": ""
    },
    "side_text": {
      "type": "string",
      "label": {
        "ar": "نص البطاقة — فارغ = النص الافتراضي بلغة الزائر",
        "en": "Card text — empty = default text in the visitor's language"
      },
      "default": ""
    },
    "side_button": {
      "type": "string",
      "label": {
        "ar": "نص الزر — فارغ = النص الافتراضي بلغة الزائر",
        "en": "Button text — empty = default text in the visitor's language"
      },
      "default": ""
    },
    "side_url": {
      "type": "string",
      "label": {
        "ar": "رابط الزر",
        "en": "Button link"
      },
      "default": "/shop"
    },
    "link_privacy": {
      "type": "string",
      "label": {
        "ar": "رابط سياسة الخصوصية — فارغ = إخفاء",
        "en": "Privacy policy link — empty hides it"
      },
      "default": ""
    },
    "link_terms": {
      "type": "string",
      "label": {
        "ar": "رابط الشروط والأحكام — فارغ = إخفاء",
        "en": "Terms link — empty hides it"
      },
      "default": ""
    },
    "link_shipping": {
      "type": "string",
      "label": {
        "ar": "رابط سياسة الشحن — فارغ = إخفاء",
        "en": "Shipping policy link — empty hides it"
      },
      "default": ""
    }
  },
  "presets": [
    {
      "category": "الصفحات",
      "name": "محتوى الصفحة"
    }
  ]
}
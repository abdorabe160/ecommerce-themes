{#
  ============================================================================
  FEATURED COLLECTION · تشكيلات مميزة
  ----------------------------------------------------------------------------
  A product carousel: eyebrow + title, a countdown and "view all" on the
  other side, then a scroll-snap rail of ui/hx-card.njk cards.

  Where the products come from, in order:
    1. `products` picked in the editor  → rendered on the server;
    2. else the first `collection`      → fetched: /ajax/search/products?collectionId=
    3. else the newest in the store     → HayatAuto (main.js), one shared request.
  Fetched products are built by HxCard.build (assets/hx.js), the card's twin.
  An empty store keeps the grey skeleton cards.

  Styles: assets/sections.css → "FEATURED COLLECTION" + "PRODUCT CARD".
  ============================================================================
#}

{% set id = widget.id %}
{% set d = widget.data %}

{% set picked = d.products | default([]) %}
{% set hasPicked = (picked | length) > 0 %}
{# On a product page the platform's own related list comes first; with fewer than
   two the script below falls back to the newest products. A section where the
   merchant picked products or a collection keeps that choice. #}
{% set relList = (context.related_products | default([])) if (context and context.product) else [] %}
{% set useRel = (not hasPicked) and (not (d.collection and (d.collection | length) > 0)) and (relList | length) >= 2 %}
{% if useRel %}{% set picked = relList %}{% set hasPicked = true %}{% endif %}

{# `collections` arrives as a list; it may hold objects or bare ids. #}
{% set cols = d.collection | default([]) %}
{% set col = cols[0] if (cols | length) > 0 else null %}
{% set colId = (col if col is string else (col._id | default(''))) if col else '' %}
{% set colHandle = (col.handle | default(col.slug) | default("")) if (col and not (col is string)) else "" %}

{% set viewText = (d.view_all_text or t('common.view_all')) if d.show_view_all != false else '' %}
{% set viewUrl = d.view_all_url | default('') %}
{% set viewUrl = viewUrl if viewUrl else (('/shop/' ~ colHandle) if colHandle else '/shop') %}

{% set cdOn = d.countdown_enabled | default(true) %}
{% set cdMode = d.countdown_mode | default('daily') %}

{% set per = d.columns_desktop | default(6) %}
{% set perM = d.columns_mobile | default('2.2') %}
{% set limit = d.limit | default(12) %}

{% macro onoff(v) %}{{ 'off' if v == false else 'on' }}{% endmacro %}
{% set fRating = onoff(d.show_rating) | trim %}
{% set fThumbs = onoff(d.show_thumbs) | trim %}
{% set fStock  = onoff(d.show_stock) | trim %}
{% set fQuick  = onoff(d.show_quick_view) | trim %}
{% set fAtc    = onoff(d.show_atc) | trim %}
{% set fHover  = onoff(d.hover_images) | trim %}
{% set saleBadge = (d.sale_badge or t('featured.sale_badge')) if d.show_sale_badge != false else '' %}
{% set lowBadge  = (d.low_badge or t('featured.low_badge')) if d.show_low_badge != false else '' %}
{% set note      = (d.card_note | default('', true)) if d.show_note != false else '' %}
{% set eyebrow = (d.eyebrow or t('featured.eyebrow')) if d.show_eyebrow != false else '' %}
{% set title = d.title or t('featured.title') %}
{% set cdLabel = d.countdown_label or t('featured.countdown') %}

<section id="hx-fc-{{ id }}"
         class="hx-fc is-fit-{{ d.image_fit | default('contain') }}"
         style="--fc-per: {{ per }}; --fc-per-m: {{ perM }}; --hx-card-bg: {{ d.image_bg | default('color-mix(in srgb, var(--hx-primary, var(--color-accent)) 5%, white)', true) }}; --fc-timer-bg: {{ d.timer_bg | default('var(--hx-deal, var(--color-deal))', true) }}; --fc-timer-fg: {{ d.timer_text | default('var(--color-text-on-deal, white)', true) }}; --pt: {{ d.padding_top | default(32) }}px; --pb: {{ d.padding_bottom | default(32) }}px;{% if d.colors_enabled and d.color_accent %} --fc-accent: {{ d.color_accent }};{% endif %}">
  <div class="hx-fc-wrap {{ 'is-full' if d.full_width | default(true) }}">

    <header class="hx-fc-head">
      <div class="hx-fc-titles">
        {% if eyebrow %}<p class="hx-fc-eyebrow">{{ eyebrow | safe }}</p>{% endif %}
        {% if title %}<h2 class="hx-fc-title">{{ title | safe }}</h2>{% endif %}
      </div>
      {% if cdOn or viewText %}
        <div class="hx-fc-side">
          {% if cdOn %}
            <div class="hx-fc-cd" data-hx-countdown data-mode="{{ cdMode }}" data-end="{{ d.countdown_end | default('') }}">
              {% if cdLabel %}<span class="hx-fc-cd-label">{{ cdLabel | safe }}</span>{% endif %}
              <span class="hx-fc-cd-boxes" dir="ltr" role="timer">
                <b data-hx-cd="d">00</b><i>:</i><b data-hx-cd="h">00</b><i>:</i><b data-hx-cd="m">00</b><i>:</i><b data-hx-cd="s">00</b>
              </span>
            </div>
          {% endif %}
          {% if viewText %}
            <a href="{{ viewUrl }}" class="hx-fc-all">{{ viewText | safe }}
              <svg class="hx-fc-all-ico" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m6 7 5 5-5 5M13 7l5 5-5 5"/></svg>
            </a>
          {% endif %}
        </div>
      {% endif %}
    </header>

    <div class="hx-fc-rail" data-hx-rail>
      <div class="hx-fc-track" data-hx-track
           {% if not hasPicked %}data-hx-fill data-col="{{ colId }}" data-limit="{{ limit }}"{% endif %}>
        {% if hasPicked %}
          {% for p in picked %}{% if not (useRel and p._id == context.product._id) %}
            {% ui "hx-card.njk", product=p, sale_badge=saleBadge, low_badge=lowBadge, note=note, rating=fRating, thumbs=fThumbs, stock=fStock, quick=fQuick, atc=fAtc, hover=fHover %}
          {% endif %}{% endfor %}
        {% else %}
          {# Stand-ins while the store has no products (or before the fetch
             answers): six demo products with their own pictures
             (assets/hx-demo-N.jpg, CC0). The script replaces them the moment
             real products arrive and leaves them if none ever do. #}
          {% set demos = [
            { _id: 'demo1', title: t('featured.demo.p1'), slug: 'demo', pricing: { price: 890, compareAtPrice: 1190 }, averageRating: 4.5, reviewsCount: 12, quantity: 20, images: [{ fileUrl: 'hx-demo-1.jpg' | assets }] },
            { _id: 'demo2', title: t('featured.demo.p2'), slug: 'demo', pricing: { price: 1490, compareAtPrice: 0 }, averageRating: 5, reviewsCount: 31, quantity: 20, images: [{ fileUrl: 'hx-demo-2.jpg' | assets }] },
            { _id: 'demo3', title: t('featured.demo.p3'), slug: 'demo', pricing: { price: 12990, compareAtPrice: 15990 }, averageRating: 4, reviewsCount: 8, quantity: 4, images: [{ fileUrl: 'hx-demo-3.jpg' | assets }] },
            { _id: 'demo4', title: t('featured.demo.p4'), slug: 'demo', pricing: { price: 24990, compareAtPrice: 0 }, averageRating: 4.5, reviewsCount: 19, quantity: 20, images: [{ fileUrl: 'hx-demo-4.jpg' | assets }] },
            { _id: 'demo5', title: t('featured.demo.p5'), slug: 'demo', pricing: { price: 690, compareAtPrice: 990 }, averageRating: 5, reviewsCount: 44, quantity: 20, images: [{ fileUrl: 'hx-demo-5.jpg' | assets }] },
            { _id: 'demo6', title: t('featured.demo.p6'), slug: 'demo', pricing: { price: 290, compareAtPrice: 0 }, averageRating: 4, reviewsCount: 6, quantity: 3, images: [{ fileUrl: 'hx-demo-6.jpg' | assets }] }
          ] %}
          {% for dp in demos %}
            {% ui "hx-card.njk", product=dp, demo='on', sale_badge=saleBadge, low_badge=lowBadge, note=note, rating=fRating, thumbs='off', stock=fStock, quick='off', atc='off', hover='off' %}
          {% endfor %}
        {% endif %}
      </div>
      {% if d.show_arrows | default(true) %}
        <button type="button" class="hx-fc-arrow is-prev" data-hx-prev aria-label="{{ t('common.prev') }}">
          <svg class="rtl-flip" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 6 9 12l6 6"/></svg>
        </button>
        <button type="button" class="hx-fc-arrow is-next" data-hx-next aria-label="{{ t('common.next') }}">
          <svg class="rtl-flip" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/></svg>
        </button>
      {% endif %}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('hx-fc-{{ id }}');
    if (!root) return;
    var cardOpts = {
      saleBadge: {{ saleBadge | dump | safe }}, lowBadge: {{ lowBadge | dump | safe }}, note: {{ note | dump | safe }},
      rating: {{ 'false' if fRating == 'off' else 'true' }}, thumbs: {{ 'false' if fThumbs == 'off' else 'true' }},
      stock: {{ 'false' if fStock == 'off' else 'true' }}, quickView: {{ 'false' if fQuick == 'off' else 'true' }},
      atc: {{ 'false' if fAtc == 'off' else 'true' }}, hoverImages: {{ 'false' if fHover == 'off' else 'true' }},
      t: {
        quickView: {{ t('pages.product.quick_view') | dump | safe }}, addToCart: {{ t('pages.product.add_to_cart') | dump | safe }},
        image: {{ t('common.image') | dump | safe }}, inStock: {{ t('common.in_stock') | dump | safe }},
        outOfStock: {{ t('pages.product.out_of_stock') | dump | safe }},
        close: {{ t('common.close') | dump | safe }}, fullDetails: {{ t('pages.product.view_full_details') | dump | safe }}
      }
    };

    function boot() {
      if (!window.HxRail) return;
      var rail = root.querySelector('[data-hx-rail]');
      HxRail.init(rail);
      root.querySelectorAll('[data-hx-countdown]').forEach(function (el) { HxCountdown.init(el); });

      var track = root.querySelector('[data-hx-fill]');
      if (!track) return;
      var limit = Number(track.getAttribute('data-limit')) || 12;
      var colId = track.getAttribute('data-col');

      /* No `limit` on the request: the search endpoint rejects it (see
         HayatAuto in main.js), so the list is cut here instead. */
      var get = colId
        ? fetch('/ajax/search/products?q=&collectionId=' + encodeURIComponent(colId), { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : {}; })
            .then(function (d) { return (d && (d.products || d.data)) || []; })
            .catch(function () { return []; })
        : (window.HayatAuto ? HayatAuto.take(limit) : Promise.resolve([]));

      /* The demo cards stay invisible (their space kept) until the answer is
         in, so a store WITH products never flashes them. Settled after 5s
         whatever happens, so a failed request still shows something. */
      function settle() { track.classList.add('is-settled'); HxRail.refresh(rail); }
      var guard = setTimeout(settle, 5000);
      get.then(function (list) {
        clearTimeout(guard);
        /* on a product page the rail is "you may also like": never the product itself */
        var here = decodeURIComponent((location.pathname.match(/\/products\/([^/?#]+)/) || [])[1] || '');
        if (here && list) list = list.filter(function (p) { return (p.slug || p.handle || p._id) !== here; });
        /* the open product was the only other one: a lone card is not a rail */
        if (here && list && list.length === 1) root.hidden = true;
        if (list && list.length) {
          track.innerHTML = list.slice(0, limit).map(function (p) { return HxCard.build(p, cardOpts); }).join('');
        }
        settle();
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();
  })();
</script>

{% ui "section-colors.njk", scope='#hx-fc-' ~ id, c=d %}

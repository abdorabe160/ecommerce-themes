{# ============================================================================
   MUHARRIK · LINE FIELD — the ground a slide stands on when it has no image.
   ----------------------------------------------------------------------------
   morva's contour field, re-imagined for the garage: a tyre-tread chevron
   field fading out towards the bottom, two sweeping road bands with a dashed
   centre line that drives (stroke-dashoffset), and square waypoint pins.
   Everything is drawn in currentColor; the CSS (assets/mh-hero.css → .mh-topo)
   sets that to the accent at low opacity, so the colour picker still works.

   Locals (strings — a bare boolean does not survive Qalab's {% ui %} tag):
     uid   suffix for the <pattern>/<mask> ids — REQUIRED when more than one
           field renders on a page, or every copy paints from the first one's
           defs (and none at all once that slide is removed by the editor).
   ========================================================================= #}
{% set uid = data.uid | default('0', true) %}
<svg class="mh-topo" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="mh-tread-{{ uid }}" width="56" height="40" patternUnits="userSpaceOnUse" patternTransform="rotate(-18)">
      <path d="M0 30 L14 10 L28 30 L42 10 L56 30" fill="none" stroke="currentColor" stroke-width="1"/>
      <path d="M0 38 L56 38" fill="none" stroke="currentColor" stroke-width="0.6" stroke-dasharray="6 10"/>
    </pattern>
    <linearGradient id="mh-fade-{{ uid }}" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.95"/>
      <stop offset="0.55" stop-color="#FFFFFF" stop-opacity="0.45"/>
      <stop offset="1" stop-color="#FFFFFF" stop-opacity="0.08"/>
    </linearGradient>
    <mask id="mh-mask-{{ uid }}"><rect width="1600" height="900" fill="url(#mh-fade-{{ uid }})"/></mask>
  </defs>

  {# tread field #}
  <rect class="mh-topo-tread" width="1600" height="900" fill="url(#mh-tread-{{ uid }})" mask="url(#mh-mask-{{ uid }})"/>

  {# roads: a soft band, a hairline edge, a driving dashed centre line #}
  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <path d="M-80 760 C 320 700, 520 380, 900 400 S 1420 520, 1720 160" stroke-width="72" stroke-opacity="0.09"/>
    <path d="M-80 760 C 320 700, 520 380, 900 400 S 1420 520, 1720 160" stroke-width="1" stroke-opacity="0.55"/>
    <path class="mh-topo-dash" d="M-80 760 C 320 700, 520 380, 900 400 S 1420 520, 1720 160" stroke-width="2" stroke-dasharray="26 22"/>

    <path d="M-80 210 C 300 250, 560 620, 1000 640 S 1500 560, 1720 720" stroke-width="44" stroke-opacity="0.07"/>
    <path class="mh-topo-dash is-slow" d="M-80 210 C 300 250, 560 620, 1000 640 S 1500 560, 1720 720" stroke-width="1.4" stroke-dasharray="14 18"/>

    {# distance ticks along the first road #}
    <path d="M300 702 l0 -16 M520 540 l0 -16 M1100 428 l0 -16 M1420 470 l0 -16" stroke-width="1" stroke-opacity="0.6"/>
  </g>

  {# waypoints — square pins, HUD style #}
  <g fill="currentColor">
    <rect x="896" y="396" width="8" height="8"/>
    <rect x="1416" y="512" width="6" height="6" fill-opacity="0.7"/>
    <rect x="996" y="636" width="6" height="6" fill-opacity="0.7"/>
    <rect x="316" y="696" width="5" height="5" fill-opacity="0.6"/>
  </g>
  <g fill="none" stroke="currentColor" stroke-width="1" stroke-opacity="0.8">
    <rect x="888" y="388" width="24" height="24"/>
  </g>
</svg>

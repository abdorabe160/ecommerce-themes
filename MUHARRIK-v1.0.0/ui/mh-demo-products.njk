{% set mode = data.mode | default('cards', true) %}

{% if mode == 'json' %}
{{- MH_DEMO | dump | safe -}}

{% elif mode == 'item' %}
  {% set ix = data.index | default(0, true) | int %}
  {% set ix = ix if (ix >= 0 and ix < (MH_DEMO | length)) else 0 %}
  {% set it = MH_DEMO[ix] %}
  {% set f = data.field | default('title', true) %}
  {%- if f == 'title' %}{{ it.title }}
  {%- elif f == 'price' %}{{ it.pricing.price }}
  {%- elif f == 'was' %}{{ it.pricing.compareAtPrice }}
  {%- elif f == 'img' %}{{ it.images[0].fileUrl }}
  {%- elif f == 'qty' %}{{ it.quantity }}
  {%- elif f == 'rating' %}{{ it.averageRating }}
  {%- elif f == 'reviews' %}{{ it.reviewsCount }}
  {%- elif f == 'cat' %}{{ it.collections[0].title }}
  {%- elif f == 'slug' %}{{ it.slug }}
  {%- endif -%}

{% else %}
  {% set from = data.from | default(0, true) | int %}
  {% set count = data.count | default(12, true) | int %}
  {% set total = MH_DEMO | length %}
  {% set from = from if (from >= 0 and from < total) else 0 %}
  {% set upto = (from + count) if (from + count) <= total else total %}
  {% set wrap = data.wrap | default('', true) %}
  {% set numbered = (data.number | string) == 'on' if data.number is defined else false %}
  {% set fRating = data.rating | default('on', true) %}
  {% set fStock  = data.stock | default('on', true) %}
  {% set saleBadge = data.sale_badge | default('', true) %}
  {% set lowBadge  = data.low_badge | default('', true) %}
  {% set note      = data.note | default('', true) %}

  {% for i in range(from, upto) %}
    {% set dp = MH_DEMO[i] %}
    {% set n = loop.index %}
    {% if wrap %}<div class="{{ wrap }}"{% if numbered %} data-n="{{ ('0' ~ n) if n < 10 else n }}"{% endif %}>{% endif %}
      {% ui "hx-card.njk", product=dp, demo='on', sale_badge=saleBadge, low_badge=lowBadge, note=note, rating=fRating, thumbs='off', stock=fStock, quick='off', atc='off', hover='off' %}
    {% if wrap %}</div>{% endif %}
  {% endfor %}
{% endif %}

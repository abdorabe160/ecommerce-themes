{
  "name": "الهيدر الرئيسي",
  "settings": {
    "full_width": {
      "type": "boolean",
      "label": {
        "ar": "▸ عرض كامل للشاشة",
        "en": "▸ Full-width layout"
      },
      "default": true
    },
    "sticky": {
      "type": "boolean",
      "label": {
        "ar": "▸ تثبيت الشريط الرئيسي أعلى الصفحة عند التمرير",
        "en": "▸ Stick the main row to the top on scroll"
      },
      "default": true
    },
    "header_logo": {
      "type": "media",
      "label": {
        "ar": "الشعار — اتركه فارغًا لاستخدام شعار المتجر",
        "en": "Logo — leave empty to use the store logo"
      }
    },
    "logo_height": {
      "type": "range",
      "label": {
        "ar": "ارتفاع الشعار",
        "en": "Logo height"
      },
      "default": 40,
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px"
    },
    "topbar_enabled": {
      "type": "boolean",
      "label": {
        "ar": "▸ الشريط العلوي المتحرك (تيكر) فوق الهيدر",
        "en": "▸ Ticker strip above the bar"
      },
      "default": true
    },
    "topbar_tone": {
      "type": "select",
      "label": {
        "ar": "مظهر الشريط العلوي",
        "en": "Ticker tone"
      },
      "default": "hairline",
      "options": [
        {
          "value": "yellow",
          "label": {
            "ar": "أصفر — لون الثيم الأساسي",
            "en": "Yellow — the theme accent"
          }
        },
        {
          "value": "hairline",
          "label": {
            "ar": "جرافيت — خط رفيع وفواصل صفراء (الافتراضي)",
            "en": "Graphite — hairline with yellow separators (default)"
          }
        },
        {
          "value": "custom",
          "label": {
            "ar": "مخصّص — يستخدم ألوان التدرّج أدناه",
            "en": "Custom — uses the gradient colours below"
          }
        }
      ]
    },
    "topbar_bg_start": {
      "type": "color",
      "label": {
        "ar": "لون بداية التدرّج (المظهر المخصّص فقط)",
        "en": "Gradient start (custom tone only)"
      },
      "default": ""
    },
    "topbar_bg_end": {
      "type": "color",
      "label": {
        "ar": "لون نهاية التدرّج — نفس اللون الأول = لون واحد (المظهر المخصّص فقط)",
        "en": "Gradient end — same as start = solid (custom tone only)"
      },
      "default": ""
    },
    "topbar_text": {
      "type": "color",
      "label": {
        "ar": "لون نص الشريط (المظهر المخصّص فقط)",
        "en": "Bar text colour (custom tone only)"
      },
      "default": ""
    },
    "topbar_speed": {
      "type": "range",
      "label": {
        "ar": "سرعة الحركة",
        "en": "Scroll speed"
      },
      "default": 50,
      "min": 20,
      "max": 140,
      "step": 5,
      "unit": "px/s"
    },
    "topbar_pause": {
      "type": "boolean",
      "label": {
        "ar": "إيقاف الحركة عند مرور الماوس",
        "en": "Pause on hover"
      },
      "default": true
    },
    "show_menu_button": {
      "type": "boolean",
      "label": {
        "ar": "▸ زر «القائمة» (≡) في بداية الشريط — يفتح القائمة الجانبية",
        "en": "▸ “Menu” button (≡) at the start of the bar — opens the side drawer"
      },
      "default": true
    },
    "menu_button_label": {
      "type": "string",
      "label": {
        "ar": "وصف الزر لقارئات الشاشة — فارغ = «القائمة»",
        "en": "Button label for screen readers — empty = “Menu”"
      },
      "default": ""
    },
    "menu_button_bg": {
      "type": "color",
      "label": {
        "ar": "خلفية الزر — فارغ = إطار رفيع يمتلئ بالأصفر عند المرور",
        "en": "Button background — empty = hairline outline, fills yellow on hover"
      },
      "default": ""
    },
    "menu_button_text": {
      "type": "color",
      "label": {
        "ar": "لون نص الزر — فارغ = لون نص الهيدر",
        "en": "Button text — empty = the header text colour"
      },
      "default": ""
    },
    "show_search": {
      "type": "boolean",
      "label": {
        "ar": "▸ زر البحث — يفتح لوحة بحث كاملة العرض أسفل الشريط",
        "en": "▸ Search button — opens a full-width search sheet under the bar"
      },
      "default": true
    },
    "search_placeholder": {
      "type": "string",
      "label": {
        "ar": "نص الإرشاد داخل البحث — فارغ = النص الافتراضي",
        "en": "Search placeholder — empty = default"
      },
      "default": ""
    },
    "search_categories": {
      "type": "collections",
      "label": {
        "ar": "قائمة «كل التصنيفات» — البحث يتم داخل التصنيف المختار",
        "en": "“All categories” dropdown — search runs inside the chosen collection"
      }
    },
    "search_voice": {
      "type": "boolean",
      "label": {
        "ar": "زر البحث الصوتي — يظهر فقط في المتصفحات الداعمة",
        "en": "Voice search — shown only in supporting browsers"
      },
      "default": true
    },
    "search_products_title": {
      "type": "string",
      "label": {
        "ar": "عنوان «الأكثر بحثًا» — فارغ = الافتراضي",
        "en": "“Most searched” heading — empty = default"
      },
      "default": ""
    },
    "search_products": {
      "type": "products",
      "label": {
        "ar": "منتجات «الأكثر بحثًا» تظهر عند فتح البحث",
        "en": "“Most searched” products shown when search opens"
      }
    },
    "search_collections_title": {
      "type": "string",
      "label": {
        "ar": "عنوان «تصفّح التصنيفات» — فارغ = الافتراضي",
        "en": "“Explore collections” heading — empty = default"
      },
      "default": ""
    },
    "search_collections": {
      "type": "collections",
      "label": {
        "ar": "تصنيفات تظهر عند فتح البحث",
        "en": "Collections shown when search opens"

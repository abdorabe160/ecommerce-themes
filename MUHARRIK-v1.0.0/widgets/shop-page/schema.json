{
  "name": "صفحة المتجر",
  "settings": {
    "show_banner": {
      "type": "boolean",
      "label": {
        "ar": "▸ لافتة أعلى الصفحة",
        "en": "▸ Banner at the top"
      },
      "default": true
    },
    "banner_title": {
      "type": "string",
      "label": {
        "ar": "عنوان اللافتة — فارغ = النص الافتراضي بلغة الزائر",
        "en": "Banner title — empty = default text in the visitor's language"
      },
      "default": ""
    },
    "banner_text": {
      "type": "string",
      "label": {
        "ar": "سطر اللافتة — فارغ = النص الافتراضي",
        "en": "Banner line — empty = default text"
      },
      "default": ""
    },
    "banner_image": {
      "type": "media",
      "label": {
        "ar": "صورة اللافتة — فارغ = صورة الثيم",
        "en": "Banner image — empty = the theme's picture"
      }
    },
    "banner_url": {
      "type": "string",
      "label": {
        "ar": "رابط اللافتة",
        "en": "Banner link"
      },
      "default": "/shop"
    },
    "filter_layout": {
      "type": "select",
      "label": {
        "ar": "▸ مكان الفلاتر — كمبيوتر",
        "en": "▸ Filters placement — desktop"
      },
      "default": "drawer",
      "options": [
        {
          "value": "drawer",
          "label": {
            "ar": "لوحة جانبية تفتح بزر «فلتر»",
            "en": "A side panel opened by the “Filter” button"
          }
        },
        {
          "value": "sidebar",
          "label": {
            "ar": "عمود ثابت بجانب المنتجات",
            "en": "A fixed column beside the products"
          }
        }
      ]
    },
    "default_view": {
      "type": "select",
      "label": {
        "ar": "طريقة العرض الافتراضية",
        "en": "Default view"
      },
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": {
            "ar": "شبكة",
            "en": "Grid"
          }
        },
        {
          "value": "list",
          "label": {
            "ar": "قائمة",
            "en": "List"
          }
        }
      ]
    },
    "title": {
      "type": "string",
      "label": {

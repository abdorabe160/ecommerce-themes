{# ============================================================================
   PAGE CONTENT — MUHARRIK: the custom/static page body (policies, about…)
   ----------------------------------------------------------------------------
   Renders /pages/{slug} — about, contact, terms, privacy, shipping policy…
   Look: mono crumb, mono kicker (eyebrow), display title, mono "updated"
   readout, a hairline under the head; then the prose on dark (yellow links,
   square yellow bullets, hairline tables) beside a sidebar of hairline boxes
   (key pages, with a yellow help panel).

   FIELD NAMES (verified on the dev store, QA pass): `context.page` is
   { title, handle, content, cover, visibility } — the body is `content`
   (HTML; empty when the merchant has not written the page). The chain below
   still tolerates the other names, and falls back to the `fallback_text`
   setting, then to a setup hint. `page` (the global) only carries
   title / type / url.

   The measure is narrow by default: a policy page set to the shop's full
   1440px runs ~200 characters a line and stops being readable.
   The `background` select (white / warm) keeps its id; on the dark ground its
   effect is retired — the page paints from the theme tokens.
   Styling: assets/sections.css → "CONTENT PAGE", re-voiced in assets/mh-content.css.
   ========================================================================= #}

{% set id = widget.id %}
{% set d = widget.data %}

{% set showBreadcrumb = d.show_breadcrumb | default(true) %}
{% set showTitle = d.show_title | default(true) %}
{% set eyebrow = d.eyebrow | default('', true) %}
{% set width = d.width | default('narrow', true) %}
{% set bg = d.background | default('white', true) %}
{% set fallbackText = d.fallback_text | default('', true) %}
{% set showUpdated = d.show_updated | default(false) %}

{# ---- the page record: context.page if the runtime provides one, else the global ---- #}
{% set cp = context.page | default({}, true) %}

{# ---- title: setting wins, then the page record, then the global ---- #}
{% set pageTitle = d.title_override | default('', true) %}
{% if not pageTitle %}{% set pageTitle = cp.title | default('', true) %}{% endif %}
{% if not pageTitle %}{% set pageTitle = page.title | default('', true) %}{% endif %}

{# ---- body: first non-empty source wins ---- #}
{% set body = cp.content | default('', true) %}
{% if not body %}{% set body = cp.body | default('', true) %}{% endif %}
{% if not body %}{% set body = cp.description | default('', true) %}{% endif %}
{% if not body %}{% set body = cp.html | default('', true) %}{% endif %}
{% if not body %}{% set body = page.content | default('', true) %}{% endif %}
{% if not body %}{% set body = page.body | default('', true) %}{% endif %}
{% if not body %}{% set body = page.description | default('', true) %}{% endif %}

{% set updated = cp.updatedAt | default(cp.createdAt, true) | default('', true) %}


{% set showSide = d.show_sidebar != false %}
<section id="hy-pg-{{ id }}" class="hy-pg hx-pgp {{ 'is-side' if showSide }} is-bg-{{ bg }}">
  <div class="hx-pgp-band">
    <div class="hx-pgp-wrap">
      {% if showBreadcrumb %}
        <nav class="hx-crumbs mh-mono" aria-label="breadcrumb">
          <a href="/">{{ t('common.home') }}</a><span aria-hidden="true">/</span>
          <span aria-current="page">{{ pageTitle | default(t('common.home'), true) }}</span>
        </nav>
      {% endif %}
      {% if showTitle and pageTitle %}
        <div class="hx-pgp-head">
          <div class="hx-pgp-head-main">
            {% if eyebrow %}<p class="hx-pgp-eyebrow mh-kicker">{{ eyebrow }}</p>{% endif %}
            <h1 class="hx-pgp-title mh-h">{{ pageTitle }}</h1>
          </div>
          {% if showUpdated and updated %}
            <p class="hx-pgp-updated mh-mono">{{ t('pages.about.last_updated') }} <time datetime="{{ updated }}" data-hy-date>{{ updated | truncate(10, '') }}</time></p>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>

  <div class="hx-pgp-wrap hx-pgp-grid {{ 'is-narrow' if width == 'narrow' }}">
    <div class="hx-pgp-card">
      {% if body %}
        {# `.taqa-prose` is the shared typography for authored HTML; `.mh-prose` re-voices it on dark #}
        <div class="taqa-prose hy-pg-body hx-pgp-body mh-prose" dir="auto">{{ body | safe }}</div>
      {% else %}
        <div class="hx-pgp-empty mh-hud">
          <span class="hx-pgp-empty-ico"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/></svg></span>
          <p class="hx-pgp-empty-t">{{ t('pages.page.empty_title') }}</p>
          <div class="hx-pgp-empty-d mh-mono">{{ (fallbackText | default('', true) | replace('</', ' </') | replace('<br', ' <br') | striptags | trim) or t('pages.page.empty_desc') }}</div>
        </div>
      {% endif %}
    </div>

    {% if showSide %}
      <aside class="hx-pgp-side">
        <nav class="hx-pgp-box" aria-label="{{ t('pgx.links') }}">
          <p class="hx-pgp-bt mh-kicker">{{ t('pgx.links') }}</p>
          <ul class="hx-pgp-links" role="list">
            {% for l in [['/pages/privacy-policy', t('pgx.privacy'), 'lock'], ['/pages/terms-of-service', t('pgx.terms'), 'doc'], ['/pages/shipping-policy', t('pgx.shipping'), 'truck']] %}
              <li><a href="{{ l[0] }}" data-hx-pgp-link>
                <span class="hx-pgp-lnum mh-mono" aria-hidden="true">{{ '0' ~ loop.index }}</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{% if l[2] == 'lock' %}<rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/>{% elif l[2] == 'doc' %}<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>{% else %}<path d="M2.5 6.5h11v9h-11z"/><path d="M13.5 9.5h4l3 3v3h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>{% endif %}</svg>
                <span>{{ l[1] }}</span>
                <svg class="rtl-flip hx-pgp-chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/></svg>
              </a></li>
            {% endfor %}
          </ul>
        </nav>
        <div class="hx-pgp-box is-promo mh-hud">
          <p class="hx-pgp-bt">{{ (d.side_title or t('pgx.help_title')) | safe }}</p>
          <p class="hx-pgp-bx">{{ (d.side_text or t('pgx.help_text')) | safe }}</p>
          <a href="{{ d.side_url | default('/shop', true) }}" class="hx-pgp-btn">{{ (d.side_button or t('pgx.help_btn')) | safe }} <span class="mh-arrow" aria-hidden="true">→</span></a>
        </div>
      </aside>
    {% endif %}
  </div>
</section>

<script>
  (function () {
    var here = decodeURIComponent(location.pathname).replace(/^\/[a-z]{2}(?=\/)/, '').replace(/\/$/, '');
    document.querySelectorAll('#hy-pg-{{ id }} [data-hx-pgp-link]').forEach(function (a) {
      if (a.getAttribute('href') === here) { a.classList.add('is-on'); a.setAttribute('aria-current', 'page'); }
    });
  })();
</script>

{# Per-section palette. Emits nothing at all unless `colors_enabled` is on. #}
{% ui "section-colors.njk", scope='#hy-pg-' ~ id, c=d %}

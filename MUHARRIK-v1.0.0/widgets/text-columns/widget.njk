{#
  ============================================================================
  TEXT COLUMNS · أعمدة النص — MUHARRIK: the TRUST STRIP
  ----------------------------------------------------------------------------
  A strip of service promises (warranty, installation, fast shipping, genuine
  parts) that steps one item along every few seconds and loops forever
  (HxLoop, assets/hx.js). With no blocks yet it shows the car-store promises
  (grid: warranty · installation · genuine parts · fast delivery), bilingual
  in the template (`carCopy`); the other icons read locales → columns.*.

  MUHARRIK look: hairline-divided columns, a mono index number per column
  (a CSS counter, so it always reads 01…0n in VISUAL order even after HxLoop
  re-orders the DOM), a yellow line icon, display-face title, mono sub line.
  The icon tile knobs (icon_bg / icon_radius / icon_size) are kept in the
  schema but their effect is retired by assets/mh-content.css.

  Styles: assets/sections.css → "TEXT COLUMNS", re-voiced in assets/mh-content.css.
  ============================================================================
#}

{% set id = widget.id %}
{% set d = widget.data %}
{% set blocks = widget.blocks | default([], true) %}

{% set items = [] %}
{% for block in blocks %}
  {% set b = block.data | default(block.settings, true) | default({}, true) %}
  {% set _ = items.push(b) %}
{% endfor %}
{% set layout = d.layout | default('loop', true) %}
{% set isGrid = layout == 'grid' %}
{% set isAr = (localization.language | default('ar', true)) != 'en' %}
{# ---- the car-store promises: bilingual in the template (the locale copy for
        these icons is the generic ecommerce one). A merchant's own title /
        text always wins; an empty one gets this line in the visitor's language. #}
{% set carCopy = {
  shield: { title: ('ضمان حتى 5 سنوات' if isAr else 'Up to 5-year warranty'), text: ('ضمان رسمي على كل قطعة — استبدال أو إصلاح بلا تعقيد.' if isAr else 'Official warranty on every part — swap or repair, no fuss.') },
  wrench: { title: ('تركيب احترافي' if isAr else 'Pro installation'), text: ('فنيون متخصصون يركّبون لك في المركز أو عند بابك.' if isAr else 'Specialist technicians fit it at our centre or at your door.') },
  box:    { title: ('قطع أصلية 100%' if isAr else '100% genuine parts'), text: ('موردون معتمدون وأرقام قطع مطابقة — لا شيء مقلّد.' if isAr else 'Authorised suppliers and matching part numbers — nothing counterfeit.') },
  truck:  { title: ('توصيل سريع' if isAr else 'Fast delivery'), text: ('شحن خلال 24–48 ساعة لكل المدن الرئيسية.' if isAr else 'Ships in 24–48 h to every major city.') },
  gauge:  { title: ('فحص وتوافق' if isAr else 'Fit & inspection'), text: ('نتأكد من توافق القطعة مع سيارتك قبل الشحن.' if isAr else 'We check the part fits your car before it ships.') },
  car:    { title: ('يناسب سيارتك' if isAr else 'Fits your car'), text: ('اختر الماركة والموديل ونعرض لك القطع المناسبة فقط.' if isAr else 'Pick make and model and we show only the parts that fit.') }
} %}
{% if (items | length) == 0 %}
  {% if isGrid %}
    {% set items = [{ icon: 'shield' }, { icon: 'wrench' }, { icon: 'box' }, { icon: 'truck' }] %}
  {% else %}
    {% set items = [{ icon: 'truck' }, { icon: 'shield' }, { icon: 'wrench' }, { icon: 'box' }, { icon: 'card' }, { icon: 'support' }] %}
  {% endif %}
{% endif %}

{% set perD = d.columns_desktop | default(5, true) %}
{% set perT = d.columns_tablet | default(3, true) %}
{% set perM = d.columns_mobile | default('1.6', true) %}
{% set auto = d.autoplay | default(true) %}

{% macro mediaUrl(m) %}{% if m %}{% if m is string %}{{ m }}{% elif m.fileUrl %}{{ m.fileUrl }}{% elif m.url %}{{ m.url }}{% endif %}{% endif %}{% endmacro %}

{% macro icon(k) %}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {% if k == 'delivery' %}<path d="M14.5 3.5 19 5v3.6c0 2.9-1.9 5-4.5 5.9-2.6-.9-4.5-3-4.5-5.9V5l4.5-1.5Z"/><path d="m12.7 8.6 1.3 1.3 2.4-2.6"/><path d="M3 20.5v-6h2.5v6H3Z"/><path d="M5.5 15.5 8 13.6c.6-.5 1.4-.5 2 0l1.6 1.4h2.2c.7 0 1.2.5 1.2 1.2s-.5 1.2-1.2 1.2H10.5M5.5 19.5h7.3l4.8-3.4c.5-.4.6-1.1.2-1.6-.4-.5-1.1-.6-1.6-.3l-2.4 1.5"/>
  {% elif k == 'returns' %}<circle cx="12" cy="12" r="5.2"/><path d="M13.6 10.4c-.3-.6-.9-.9-1.6-.9-.9 0-1.6.5-1.6 1.2 0 1.6 3.3.8 3.3 2.5 0 .7-.7 1.3-1.7 1.3-.8 0-1.4-.4-1.7-1M12 8.6v.9M12 14.5v.9"/><path d="M4 12a8 8 0 0 1 13.7-5.6M20 12a8 8 0 0 1-13.7 5.6"/><path d="M17.9 3.4v3.2h-3.2M6.1 20.6v-3.2h3.2"/>
  {% elif k == 'truck' %}<path d="M2.5 6.5h11v9h-11z"/><path d="M13.5 9.5h4l3 3v3h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/><path d="M4.5 9.5h4M4.5 12h2.5"/>
  {% elif k == 'shield' %}<path d="M12 3 19 5.6v5.2c0 4.4-2.9 7.9-7 9.2-4.1-1.3-7-4.8-7-9.2V5.6L12 3Z"/><path d="M12 7.5a3.8 3.8 0 1 0 0 7.6 3.8 3.8 0 0 0 0-7.6Z"/><path d="m10.4 11.3 1.1 1.1 2.2-2.2"/>
  {% elif k == 'card' %}<rect x="2.5" y="5.5" width="17" height="11" rx="2"/><path d="M2.5 9h17M5.5 13.5h4"/><circle cx="18" cy="16.5" r="3.6" fill="var(--hy-sec-bg, var(--color-bg-primary))"/><path d="m16.5 16.5 1.1 1.1 1.9-2"/>
  {% elif k == 'wrench' %}<path d="M14.7 6.3a4 4 0 0 0 5 5L9.5 21.5a2.1 2.1 0 0 1-3-3L16.7 8.3"/><path d="M14.7 6.3 17.5 3.5a4 4 0 0 1 2.2 6.3"/><path d="M8 16l1.5 1.5"/>
  {% elif k == 'gauge' %}<path d="M4 15.5a8 8 0 1 1 16 0"/><path d="M12 15.5l3.5-5"/><circle cx="12" cy="15.5" r="1.4"/><path d="M3 19.5h18"/>
  {% elif k == 'car' %}<path d="M3.5 13.5 5.3 8.6c.3-.8 1-1.3 1.9-1.3h9.6c.9 0 1.6.5 1.9 1.3l1.8 4.9"/><path d="M3 13.5h18v4.5h-2.5M3 18h2.5M8.5 18h7"/><circle cx="6.5" cy="18" r="1.8"/><circle cx="17.5" cy="18" r="1.8"/><path d="M6.5 11h11"/>
  {% elif k == 'hand' %}<path d="M3 20.5v-6h2.5v6H3Z"/><path d="M5.5 15.5 8 13.6c.6-.5 1.4-.5 2 0l1.6 1.4h2.2c.7 0 1.2.5 1.2 1.2s-.5 1.2-1.2 1.2H10.5M5.5 19.5h7.3l4.8-3.4c.5-.4.6-1.1.2-1.6-.4-.5-1.1-.6-1.6-.3l-2.4 1.5"/><path d="M8.5 7.5S10.6 4 14.5 4s6 3.5 6 3.5-2.1 3.5-6 3.5-6-3.5-6-3.5Z"/><circle cx="14.5" cy="7.5" r="1.4"/>
  {% elif k == 'support' %}<path d="M4.5 13v-1a7.5 7.5 0 0 1 15 0v1"/><rect x="3" y="12.5" width="4" height="5.5" rx="1.5"/><rect x="17" y="12.5" width="4" height="5.5" rx="1.5"/><path d="M19 18v.5a2.5 2.5 0 0 1-2.5 2.5H13"/>
  {% elif k == 'gift' %}<rect x="3.5" y="8.5" width="17" height="4" rx="1"/><path d="M5 12.5v8h14v-8M12 8.5v12M12 8.5S10.8 4 8.3 4.3C6.5 4.5 6.7 7 8.4 8.2M12 8.5s1.2-4.5 3.7-4.2c1.8.2 1.6 2.7-.1 3.9"/>
  {% elif k == 'tag' %}<path d="M3.5 12.6V4.5a1 1 0 0 1 1-1h8.1l8 8a1.4 1.4 0 0 1 0 2l-7.1 7.1a1.4 1.4 0 0 1-2 0l-8-8Z"/><circle cx="8" cy="8" r="1.4"/>
  {% elif k == 'box' %}<path d="m12 3 8 4v10l-8 4-8-4V7l8-4Z"/><path d="m4 7 8 4 8-4M12 11v10M8 5l8 4"/>
  {% elif k == 'clock' %}<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
  {% elif k == 'star' %}<path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9L12 3.5Z"/>
  {% endif %}
</svg>
{% endmacro %}

<section id="hx-tc-{{ id }}"{% if (blocks | length) == 0 %} data-hy-empty{% endif %}
         class="hx-tc {{ 'has-dividers' if d.show_dividers }} {{ 'is-grid' if isGrid }}"
         style="--tc-per: {{ perD }}; --tc-per-t: {{ perT }}; --tc-per-m: {{ perM }}; --pt: {{ d.padding_top | default(32) }}px; --pb: {{ d.padding_bottom | default(32) }}px;">
         {# icon_size / icon_radius / icon_bg / icon_color stay in the schema but are retired: the strip draws a bare yellow line icon #}
  <div class="hx-tc-wrap {{ 'is-full' if d.full_width | default(true) }}">
    <div class="hx-tc-viewport" {% if not isGrid %}data-hx-loop{% endif %}
         data-autoplay="{{ 'true' if auto else 'false' }}"
         data-interval="{{ d.interval | default(4, true) }}"
         data-pause="{{ 'false' if d.pause_on_hover == false else 'true' }}">
      <ul class="hx-tc-track" data-hx-loop-track role="list">
        {% for b in items %}
          {% set k = b.icon | default('delivery', true) %}
          {% set img = mediaUrl(b.icon_image) | trim %}
          {# car promises (shield / wrench / box / truck / gauge / car) read carCopy; the rest read the locale #}
          {% set hasCopy = k in ['delivery', 'returns', 'card', 'hand', 'support', 'gift', 'tag', 'clock', 'star'] %}
          {% if carCopy[k] %}
            {% set title = b.title or carCopy[k].title %}
            {% set sub = b.text or (carCopy[k].text if isGrid else '') %}
          {% else %}
            {% set title = b.title or ((t('columns.g.' ~ k ~ '.title') if isGrid else t('columns.' ~ k)) if hasCopy else '') %}
            {% set sub = b.text or (t('columns.g.' ~ k ~ '.text') if (isGrid and hasCopy) else '') %}
          {% endif %}
          {% set url = b.url | default('', true) %}
          <li class="hx-tc-item{{ ' hy-editor-only' if not (b.title or b.text) }}">
            {% if url %}<a href="{{ url }}" class="hx-tc-link">{% else %}<div class="hx-tc-link">{% endif %}
              <span class="hx-tc-hud" aria-hidden="true">
                <span class="hx-tc-num mh-mono"></span>
                <span class="hx-tc-rule"></span>
                {% if (img | length) > 0 %}
                  <span class="hx-tc-icon is-img"><img src="{{ img }}" alt="" loading="lazy"/></span>
                {% elif k != 'none' %}
                  <span class="hx-tc-icon">{{ icon(k) }}</span>
                {% endif %}
              </span>
              <span class="hx-tc-txt">
                {% if title %}<span class="hx-tc-title">{{ title | safe }}</span>{% endif %}
                {% if sub %}<span class="hx-tc-sub">{{ sub | safe }}</span>{% endif %}
              </span>
            {% if url %}</a>{% else %}</div>{% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

<script>
  (function () {
    function boot() {
      var el = document.querySelector('#hx-tc-{{ id }} [data-hx-loop]');
      if (el && window.HxLoop) HxLoop.init(el);
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();
  })();
</script>

{% ui "section-colors.njk", scope='#hx-tc-' ~ id, c=d %}

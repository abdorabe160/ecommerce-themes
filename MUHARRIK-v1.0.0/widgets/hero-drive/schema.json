        {
          "value": "full",
          "label": {
            "ar": "ملء الشاشة (تحت الهيدر)",
            "en": "Full screen (below the header)"
          }
        },
        {
          "value": "large",
          "label": {
            "ar": "كبير",
            "en": "Large"
          }

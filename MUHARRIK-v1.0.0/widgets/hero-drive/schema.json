            "ar": "المنتصف",
            "en": "Centre"
          }
        },
        {
          "value": "left",
          "label": {
            "ar": "اليسار",
            "en": "Left"
          }
        },
        {
          "value": "right",
          "label": {
            "ar": "اليمين",
            "en": "Right"
          }
        },
        {
          "value": "top",
          "label": {
            "ar": "الأعلى",
            "en": "Top"
          }
        },
        {
          "value": "bottom",
          "label": {
            "ar": "الأسفل",
            "en": "Bottom"
          }
        }
      ]

    "color_text": { "type": "color", "label": { "ar": "لون النص", "en": "Text colour" }, "default": "" },
    "color_accent": { "type": "color", "label": { "ar": "لون التمييز (الأصفر)", "en": "Accent (the yellow)" }, "default": "" },

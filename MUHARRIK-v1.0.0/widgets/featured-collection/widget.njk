{#
  ============================================================================
  FEATURED COLLECTION · تشكيلات مميزة
  ----------------------------------------------------------------------------
  A product carousel: eyebrow + title, a countdown and "view all" on the
  other side, then a scroll-snap rail of ui/hx-card.njk cards.

  Where the products come from, in order:
    1. `products` picked in the editor  → rendered on the server;
    2. else the first `collection`      → fetched: /ajax/search/products?collectionId=
    3. else the newest in the store     → HayatAuto (main.js), one shared request.
  Fetched products are built by HxCard.build (assets/hx.js), the card's twin.
  An empty store keeps the grey skeleton cards.

  Styles: assets/sections.css → "FEATURED COLLECTION" + "PRODUCT CARD";
  MUHARRIK skin (head, countdown readout, arrows): assets/mh-home-b.css.
  ============================================================================
#}

{% set id = widget.id %}
{% set d = widget.data %}

{% set picked = d.products | default([], true) %}
{#- On a product page with the «related» preset and nothing picked, use the
    platform's own related products (`context.related_products`, measured on a
    live store) instead of the store's newest — and never the product itself. -#}
{% if (picked | length) == 0 and (d.title_preset | default('', true)) == 'related' and context and context.product %}
  {% set rel = [] %}
  {% for rp in (context.related_products or context.related or []) %}{% if rp and rp._id != context.product._id %}{% set _ = rel.push(rp) %}{% endif %}{% endfor %}
  {% if (rel | length) > 0 %}{% set picked = rel %}{% endif %}
{% endif %}
{% set hasPicked = (picked | length) > 0 %}

{# `collections` arrives as a list; it may hold objects or bare ids. #}
{% set cols = d.collection | default([], true) %}
{% set col = cols[0] if (cols | length) > 0 else null %}
{% set colId = (col if col is string else (col._id | default('', true))) if col else '' %}
{% set colHandle = (col.handle | default(col.slug, true) | default("", true)) if (col and not (col is string)) else "" %}

{% set viewText = (d.view_all_text or t('common.view_all')) if d.show_view_all != false else '' %}
{% set viewUrl = d.view_all_url | default('', true) %}
{% set viewUrl = viewUrl if viewUrl else (('/shop/' ~ colHandle) if colHandle else '/shop') %}

{# Off unless the section says true. Sections saved from pages/index.json hold the key, so they keep what they have. #}
{% set cdOn = d.countdown_enabled == true %}
{% set cdMode = d.countdown_mode | default('daily', true) %}

{% set per = d.columns_desktop | default(6, true) %}
{% set perM = d.columns_mobile | default('2.2', true) %}
{% set limit = d.limit | default(12, true) %}

{% macro onoff(v) %}{{ 'off' if v == false else 'on' }}{% endmacro %}
{% set fRating = onoff(d.show_rating) | trim %}
{% set fThumbs = onoff(d.show_thumbs) | trim %}
{% set fStock  = onoff(d.show_stock) | trim %}
{% set fQuick  = onoff(d.show_quick_view) | trim %}
{% set fAtc    = onoff(d.show_atc) | trim %}
{% set fHover  = onoff(d.hover_images) | trim %}
{% set saleBadge = (d.sale_badge or t('featured.sale_badge')) if d.show_sale_badge != false else '' %}
{% set lowBadge  = (d.low_badge or t('featured.low_badge')) if d.show_low_badge != false else '' %}
{% set note      = (d.card_note or t('featured.note')) if d.show_note != false else '' %}
{% set eyebrow = (d.eyebrow or t('featured.eyebrow')) if d.show_eyebrow != false else '' %}
{# `title_en` is optional: when the visitor browses in English and the merchant
   filled it, it replaces the main title (which is usually typed in Arabic). #}
{% set isEn = (localization.language | default('ar', true)) == 'en' %}
{# With the title field empty, `title_preset` decides the automatic title:
   the locale's "Best sellers!" (the home default), the bilingual "You may
   also like" (product and cart pages, where the rail is the newest products),
   or no title at all. #}
{% set preset = d.title_preset | default('bestsellers', true) %}
{% set autoTitle = t('featured.title') if preset == 'bestsellers' else (('You may also like' if isEn else 'قد يعجبك أيضًا') if preset == 'related' else '') %}
{% set title = (d.title_en if (isEn and (d.title_en | default('', true) | trim)) else d.title) or autoTitle %}
{% set cdLabel = d.countdown_label or t('featured.countdown') %}

<section id="hx-fc-{{ id }}"
         class="hx-fc is-fit-{{ d.image_fit | default('contain', true) }}"
         style="--fc-per: {{ per }}; --fc-per-m: {{ perM }}; --hx-card-bg: {{ d.image_bg | default('var(--color-bg-tertiary)', true) }}; --fc-timer-bg: {{ d.timer_bg | default('color-mix(in srgb, var(--color-deal) 78%, #000)', true) }}; --fc-timer-fg: {{ d.timer_text | default('var(--color-text-on-deal)', true) }}; --pt: {{ d.padding_top | default(32) }}px; --pb: {{ d.padding_bottom | default(32) }}px;{% if d.colors_enabled and d.color_accent %} --fc-accent: {{ d.color_accent }};{% endif %}">
  <div class="hx-fc-wrap {{ 'is-full' if d.full_width | default(true) }}">

    {# MUHARRIK: morva head — mono kicker + display title on the start side,
       the countdown readout and the outlined "view all" on the end side. #}
    <header class="hx-fc-head mh-head mh-reveal">
      <div class="hx-fc-titles mh-head-main">
        {% if eyebrow %}<p class="hx-fc-eyebrow mh-kicker">{{ eyebrow | safe }}</p>{% endif %}
        {% if title %}<h2 class="hx-fc-title mh-h">{{ title | safe }}</h2>{% endif %}
      </div>
      {% if cdOn or viewText %}
        <div class="hx-fc-side">
          {% if cdOn %}
            <div class="hx-fc-cd is-{{ d.timer_style | default('readout', true) }}" data-hx-countdown data-mode="{{ cdMode }}" data-end="{{ d.countdown_end | default('', true) }}">
              {% if cdLabel %}<span class="hx-fc-cd-label mh-led is-warn">{{ cdLabel | safe }}</span>{% endif %}
              <span class="hx-fc-cd-boxes" dir="ltr" role="timer">
                <b data-hx-cd="d">00</b><i>:</i><b data-hx-cd="h">00</b><i>:</i><b data-hx-cd="m">00</b><i>:</i><b data-hx-cd="s">00</b>
              </span>
            </div>
          {% endif %}
          {% if viewText %}
            <a href="{{ viewUrl }}" class="hx-fc-all mh-viewall">{{ viewText | safe }}
              <svg class="hx-fc-all-ico" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m6 7 5 5-5 5M13 7l5 5-5 5"/></svg>
            </a>
          {% endif %}
        </div>
      {% endif %}
    </header>

    <div class="hx-fc-rail" data-hx-rail>
      <div class="hx-fc-track" data-hx-track
           {% if not hasPicked %}data-hx-fill data-col="{{ colId }}" data-limit="{{ limit }}" data-exclude="{{ context.product._id if (context and context.product) else '' }}"{% endif %}>
        {% if hasPicked %}
          {% for p in picked %}
            {% ui "hx-card.njk", product=p, sale_badge=saleBadge, low_badge=lowBadge, note=note, rating=fRating, thumbs=fThumbs, stock=fStock, quick=fQuick, atc=fAtc, hover=fHover %}
          {% endfor %}
        {% else %}
          {# Stand-ins while the store has no products (or before the fetch
             answers): six demo products with their own pictures
             (assets/hx-demo-N.jpg, CC0). The script replaces them the moment
             real products arrive and leaves them if none ever do. #}
          {% set demos = [
            { _id: 'demo1', title: t('featured.demo.p1'), slug: 'demo', pricing: { price: 890, compareAtPrice: 1190 }, averageRating: 4.5, reviewsCount: 12, quantity: 20, images: [{ fileUrl: 'mh-p01.jpg' | assets }] },
            { _id: 'demo2', title: t('featured.demo.p2'), slug: 'demo', pricing: { price: 1490, compareAtPrice: 0 }, averageRating: 5, reviewsCount: 31, quantity: 20, images: [{ fileUrl: 'mh-p09.jpg' | assets }] },
            { _id: 'demo3', title: t('featured.demo.p3'), slug: 'demo', pricing: { price: 12990, compareAtPrice: 15990 }, averageRating: 4, reviewsCount: 8, quantity: 4, images: [{ fileUrl: 'mh-p11.jpg' | assets }] },
            { _id: 'demo4', title: t('featured.demo.p4'), slug: 'demo', pricing: { price: 24990, compareAtPrice: 0 }, averageRating: 4.5, reviewsCount: 19, quantity: 20, images: [{ fileUrl: 'mh-p04.jpg' | assets }] },
            { _id: 'demo5', title: t('featured.demo.p5'), slug: 'demo', pricing: { price: 690, compareAtPrice: 990 }, averageRating: 5, reviewsCount: 44, quantity: 20, images: [{ fileUrl: 'mh-p14.jpg' | assets }] },
            { _id: 'demo6', title: t('featured.demo.p6'), slug: 'demo', pricing: { price: 290, compareAtPrice: 0 }, averageRating: 4, reviewsCount: 6, quantity: 3, images: [{ fileUrl: 'mh-p15.jpg' | assets }] }
          ] %}
          {% for dp in demos %}
            {% ui "hx-card.njk", product=dp, demo='on', sale_badge=saleBadge, low_badge=lowBadge, note=note, rating=fRating, thumbs='off', stock=fStock, quick='off', atc='off', hover='off' %}
          {% endfor %}
        {% endif %}
      </div>
      {% if d.show_arrows | default(true) %}
        <button type="button" class="hx-fc-arrow is-prev" data-hx-prev aria-label="{{ t('common.prev') }}">
          <svg class="rtl-flip" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 6 9 12l6 6"/></svg>
        </button>
        <button type="button" class="hx-fc-arrow is-next" data-hx-next aria-label="{{ t('common.next') }}">
          <svg class="rtl-flip" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/></svg>
        </button>
      {% endif %}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('hx-fc-{{ id }}');
    if (!root) return;
    var cardOpts = {
      saleBadge: {{ saleBadge | dump | safe }}, lowBadge: {{ lowBadge | dump | safe }}, note: {{ note | dump | safe }},
      rating: {{ 'false' if fRating == 'off' else 'true' }}, thumbs: {{ 'false' if fThumbs == 'off' else 'true' }},
      stock: {{ 'false' if fStock == 'off' else 'true' }}, quickView: {{ 'false' if fQuick == 'off' else 'true' }},
      atc: {{ 'false' if fAtc == 'off' else 'true' }}, hoverImages: {{ 'false' if fHover == 'off' else 'true' }},
      t: {
        quickView: {{ t('pages.product.quick_view') | dump | safe }}, addToCart: {{ t('pages.product.add_to_cart') | dump | safe }},
        image: {{ t('common.image') | dump | safe }}, inStock: {{ t('common.in_stock') | dump | safe }},
        outOfStock: {{ t('pages.product.out_of_stock') | dump | safe }},
        close: {{ t('common.close') | dump | safe }}, fullDetails: {{ t('pages.product.view_full_details') | dump | safe }}
      }
    };

    function boot() {
      if (!window.HxRail) return;
      var rail = root.querySelector('[data-hx-rail]');
      HxRail.init(rail);
      root.querySelectorAll('[data-hx-countdown]').forEach(function (el) { HxCountdown.init(el); });

      var track = root.querySelector('[data-hx-fill]');
      if (!track) return;
      var limit = Number(track.getAttribute('data-limit')) || 12;
      var colId = track.getAttribute('data-col');

      /* No `limit` on the request: the search endpoint rejects it (see
         HayatAuto in main.js), so the list is cut here instead. */
      var get = colId
        ? fetch('/ajax/search/products?q=&collectionId=' + encodeURIComponent(colId), { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : {}; })
            .then(function (d) { return (d && (d.products || d.data)) || []; })
            .catch(function () { return []; })
        : (window.HayatAuto ? HayatAuto.take(limit) : Promise.resolve([]));

      /* The demo cards stay invisible (their space kept) until the answer is
         in, so a store WITH products never flashes them. Settled after 5s
         whatever happens, so a failed request still shows something. */
      function settle() { track.classList.add('is-settled'); HxRail.refresh(rail); }
      var guard = setTimeout(settle, 5000);
      get.then(function (list) {
        clearTimeout(guard);
        if (list && list.length) {
          /* on a product page, never offer the product being viewed */
          var skip = track.getAttribute('data-exclude');
          if (skip) list = list.filter(function (p) { return String(p._id) !== skip; });
          track.innerHTML = list.slice(0, limit).map(function (p) { return HxCard.build(p, cardOpts); }).join('');
        }
        settle();
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();
  })();
</script>

{% ui "section-colors.njk", scope='#hx-fc-' ~ id, c=d %}

      "options": [
        { "value": "narrow", "label": { "ar": "ضيّقة", "en": "Narrow" } },
        { "value": "medium", "label": { "ar": "متوسطة", "en": "Medium" } },
        { "value": "wide", "label": { "ar": "عريضة", "en": "Wide" } }

      "options": [
        { "value": "auto", "label": { "ar": "تلقائي — تظهر فقط لو لم يُختر شيء والمتجر فارغ", "en": "Auto — only when nothing is picked and the store is empty" } },
        { "value": "always", "label": { "ar": "دائمًا — ما لم تختر منتجات يدويًا", "en": "Always — unless products are picked by hand" } }
      ]
    },
    "limit": {

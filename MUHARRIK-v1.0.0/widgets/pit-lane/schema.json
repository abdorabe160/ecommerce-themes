    "view_all_text": {
      "type": "string",
      "label": { "ar": "نص «عرض الكل» — فارغ = النص الافتراضي بلغة الزائر", "en": "“View all” label — empty = default text in the visitor's language" },
      "default": ""
    },
    "view_all_url": {
      "type": "string",

          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%"
        },
        "y": {
          "type": "range",
          "label": { "ar": "موضع النقطة عموديًا % (0 = أعلى · فارغ/0 = الموضع الافتراضي للنوع)", "en": "Hotspot Y % (0 = top · empty/0 = the type's default)" },

        "image": {
          "type": "media",
          "label": { "ar": "صورة اللوحة — يفضّل ٨٠٠×١٠٠٠ (فارغ = صورة الفئة من الثيم)", "en": "Panel image — 800×1000 recommended (empty = the theme's category photo)" }
        }
      }

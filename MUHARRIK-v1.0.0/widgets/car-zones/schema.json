            { "value": "tyres", "label": { "ar": "الإطارات والجنوط", "en": "Tyres and wheels" } },
            { "value": "interior", "label": { "ar": "الداخلية (المقصورة)", "en": "Interior (cabin)" } },
            { "value": "electronics", "label": { "ar": "الإلكترونيات (لوحة القيادة)", "en": "Electronics (dashboard)" } },
            { "value": "care", "label": { "ar": "العناية (الطلاء)", "en": "Care (paint)" } },
            { "value": "engine", "label": { "ar": "الصيانة (غطاء المحرك)", "en": "Maintenance (engine bay)" } }

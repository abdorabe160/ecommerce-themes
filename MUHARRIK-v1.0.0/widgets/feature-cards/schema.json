{
  "name": "مميزات بارزة",
  "settings": {
    "full_width": {
      "type": "boolean",
      "label": {
        "ar": "▸ عرض كامل للشاشة",
        "en": "▸ Full-width layout"
      },
      "default": true
    },
    "show_title": {
      "type": "boolean",
      "label": {
        "ar": "▸ العنوان",
        "en": "▸ Title"
      },
      "default": true
    },
    "title": {
      "type": "string",
      "label": {
        "ar": "العنوان — فارغ = النص الافتراضي بلغة الزائر",
        "en": "Title — empty = default text in the visitor's language"
      },
      "default": ""
    },
    "kicker": {
      "type": "string",
      "label": {
        "ar": "السطر الصغير فوق العنوان (مثل: 01 / العناية بالسيارة)",
        "en": "Kicker above the title (e.g. 01 / CAR CARE)"
      },
      "default": "",
      "info": {
        "ar": "فارغ = عدد البطاقات، أو «مميزات بارزة» عند كتابة عنوان مخصص",
        "en": "Empty = the card count, or “Stand out Features” under a custom title"
      }
    },
    "dark": {
      "type": "boolean",
      "label": {
        "ar": "خلفية داكنة",
        "en": "Dark background"
      },
      "default": true
    },
    "bg": {
      "type": "color",
      "label": {
        "ar": "لون الخلفية — فارغ = افتراضي",
        "en": "Background — empty = default"
      },
      "default": ""
    },
    "padding_top": {
      "type": "range",
      "label": {
        "ar": "المسافة العلوية",
        "en": "Top spacing"
      },
      "default": 32,
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px"
    },
    "padding_bottom": {
      "type": "range",
      "label": {
        "ar": "المسافة السفلية",
        "en": "Bottom spacing"
      },
      "default": 32,
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px"

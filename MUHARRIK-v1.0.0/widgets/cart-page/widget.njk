{# ============================================================================
   HYPER CART PAGE
   ----------------------------------------------------------------------------
   Rows come from ui/cart.njk in 'list' mode — the same macro the header drawer
   uses, so the two views of the cart can never disagree.

   ⚠️  data-* hooks read by CartManager._updateUI() / _refreshDrawer():
       data-cart-count · data-cart-total · data-cart-savings-row · data-cart-savings
       data-cart-container · data-cart-footer · data-cart-empty · data-cart-list
       (plus data-cart-item / data-item-total / data-item-compare inside each row)

   ⚠️  NO coupon input. Qumra exposes cart.couponApplied / couponDiscount as
   READ-ONLY values and documents no coupon endpoint — an input here could not
   submit anywhere. The applied discount is displayed; entering one happens at
   checkout.

   Styling: assets/style.css → "15.25 CART", restyled by assets/sections.css → "CART PAGE" (.hx-cartp),
   re-voiced by assets/mh-commerce.css → "CART PAGE" (MUHARRIK: hairline rows on
   the panel ground, mono readouts, the summary as a framed receipt).
   ========================================================================= #}

{% set id = widget.id %}
{% set d = widget.data %}
{% set isAr = (localization.language | default('ar', true)) != 'en' %}

{# `| default()` alone would keep an EMPTY string, so the merchant could not
   clear the field to get the translated title back. #}
{% set title = d.title if (d.title | default('', true) | trim | length) > 0 else t('pages.cart.title') %}
{% set showBreadcrumb = d.show_breadcrumb | default(true) %}
{% set showSavings = d.show_savings | default(true) %}
{% set showDiscount = d.show_discount_row | default(true) %}
{% set freeThreshold = d.free_shipping_threshold | default(0, true) %}
{% set confirmRemove = d.confirm_remove | default(true) %}
{% set checkoutUrl = d.checkout_url | default('/checkout', true) %}
{% set shopUrl = d.continue_shopping_url | default('/shop', true) %}
{% set noteText = (d.note_text | default('', true) | trim) or ('الشحن يُحتسب عند إتمام الطلب · تأكّد من توافق القطعة مع عربيتك قبل الدفع' if isAr else 'Shipping is calculated at checkout · Check that the part fits your car before paying') %}

{# Bilingual defaults, the way widgets/hero-slider does it: an EMPTY field
   falls back to copy in the visitor's language, so a store that serves both
   languages never shows Arabic reassurance lines under an English summary.
   A merchant who types a text keeps it in both languages. #}
{#- The reassurance list is a set of promises (payment, delivery days,
    returns) — opt-in, and the merchant's own words. -#}
{% set showTrust = d.show_trust_row | default(false) %}
{% set trust1 = (d.trust1_text | default('', true) | trim) or ('طرق الدفع المتاحة تظهر عند إتمام الطلب' if isAr else 'Payment options show at checkout') %}
{% set trust2 = (d.trust2_text | default('', true) | trim) or ('التوصيل لباب البيت' if isAr else 'Delivery to your door') %}
{% set trust3 = (d.trust3_text | default('', true) | trim) or ('الاستبدال والاسترجاع حسب سياسة المتجر' if isAr else 'Exchanges and returns per store policy') %}
{% set hasTrust = showTrust and (trust1 or trust2 or trust3) %}

{% set itemCount = cart.items | length %}


{# ---------------- one reassurance line ---------------- #}
{% macro trustLine(text, icon) %}
  {% if text %}
    <li class="hy-cart-trust-item">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        {% if icon == 'lock' %}
          <rect x="4.5" y="10.5" width="15" height="10"/>
          <path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/>
        {% elif icon == 'warranty' %}
          <path d="M12 3l7.5 3v5.6c0 4.5-3.1 7.3-7.5 8.9-4.4-1.6-7.5-4.4-7.5-8.9V6z"/>
          <path d="M9 12.2l2.2 2.2 4.3-4.4"/>
        {% else %}
          <path d="M3 12a9 9 0 1 0 9-9 9.7 9.7 0 0 0-6.7 2.7L3 8"/><path d="M3 3v5h5"/>
        {% endif %}
      </svg>
      <span>{{ text }}</span>
    </li>
  {% endif %}
{% endmacro %}


<section id="hy-cart-{{ id }}" class="hy-cart hx-cartp"
         x-data="cartInteraction({
           {# slug + variantId travel with the line so cartInteraction can resolve
              the real stock — the cart payload itself carries none. #}
           items: [{% for item in cart.items %}{ id: '{{ item._id }}', qty: {{ item.quantity | default(1, true) }}, slug: '{{ item.productData.slug | default(item.productData.handle, true) | default('', true) }}', variantId: {{ ("'" ~ item.variantId ~ "'") if item.variantId else 'null' }} }{% if not loop.last %},{% endif %}{% endfor %}],
           {# the cart PAGE is a deliberate visit, so resolve stock on mount #}
           eagerStock: true,
           {# The bar below follows these two. `cartTotal` is seeded from the
              server render and replaced on every cart:updated. #}
           cartTotal: {{ cart.totalPrice | default(0, true) }},
           freeThreshold: {{ freeThreshold }},
           strings: window.__hyCartStrings || {},
           confirmRemove: {{ 'true' if confirmRemove else 'false' }}
         })">
  <div class="hy-container">

    {# ═══════════════ has items ═══════════════ #}
    <div x-show="activeItems.length > 0" {% if itemCount == 0 %}x-cloak{% endif %}>

      {% if showBreadcrumb %}
        <nav class="hx-crumbs mh-crumb" aria-label="breadcrumb">
          <a href="/">{{ t('common.home') }}</a><span class="mh-crumb-sep" aria-hidden="true">/</span>
          <span aria-current="page">{{ title }}</span>
        </nav>
      {% endif %}

      <div class="hy-cart-head">
      {# ---- Exactly one <h1> in the SERVED html ----
         Both branches live in the DOM at once — they are toggled with x-show,
         not with a server `if`, because the cart can empty client-side and the
         empty state has to be able to appear without a page load. That left two
         <h1> elements in the document, one of them `display: none`.

         Screen readers were never affected (display:none is dropped from the
         accessibility tree) but a crawler parses the DOM, so the served page
         carried two. `itemCount` IS known server-side, so the tag is chosen
         there: whichever branch the server rendered as visible gets the <h1>,
         and the other gets a <p> wearing the same class. #}
        {% if itemCount > 0 %}
          <h1 class="hy-cart-title mh-h">{{ title }}</h1>
        {% else %}
          <p class="hy-cart-title mh-h">{{ title }}</p>
        {% endif %}
        {# readout on the end side: count wording, kept current by CartManager._updateUI #}
        <span class="hy-cart-qty mh-mono" data-cart-qty-label>{% ui "count.njk", n=(cart.totalQuantity or 0), kind='product' %}</span>
      </div>

      <div class="hy-cart-grid">

        {# ═════════ items ═════════ #}
        <div class="hy-cart-items" data-cart-container>
          {# rows come from ui/cart.njk in 'list' mode — same macro as the drawer #}
          {% ui "cart.njk", variant='list' %}

          <div class="hy-cart-actions">
            <a href="{{ shopUrl }}" class="hy-cart-back">
              <span class="mh-arrow" aria-hidden="true">←</span>
              {{ t('pages.cart.continue_shopping') }}
            </a>
            <button type="button" @click="Qumra.cart.clear()" class="hy-cart-clear">
              {{ t('pages.cart.clear') }}
            </button>
          </div>
        </div>

        {# ═════════ summary ═════════ #}
        <aside class="hy-cart-aside">
          {# the receipt: a framed panel with HUD corners, mono rows, a display total #}
          <div class="hy-cart-box mh-panel mh-hud" data-cart-footer>

            <span class="hy-cart-box-title">{{ t('pages.cart.order_summary') }}</span>

            {# ---- free shipping progress ----
               Rendered server-side from the cart total. CartManager repaints the
               numbers around it on every change but not this bar, so it can lag
               by one interaction until the page is re-fetched — acceptable for a
               nudge, and far better than not showing it at all. #}
            {# ⚠️  The threshold is in the SAME unit as cart.totalPrice — i.e. the
               number the shopper reads. Measured on this store, `{{ 1000 | money }}`
               renders "1,000ج.م": the money filter does NOT divide, so a 500 ج.م
               product has price 500. A threshold written in minor units (50000)
               would never be reached and the bar would sit at 8% forever. #}
            {% if freeThreshold > 0 %}
              {% set remaining = freeThreshold - (cart.totalPrice | default(0, true)) %}
              {# Both states are RENDERED, and Alpine picks between them. The
                 server value decides which one is visible on first paint (via
                 the `style` fallbacks) and `x-show` takes over from there — so
                 the bar follows a quantity change instead of waiting for a
                 reload, and neither state flashes before Alpine boots.

                 The width has the same pair: an inline `width` from the server
                 for the first frame, replaced by `:style` afterwards. #}
              <div class="hy-cart-ship">
                {# The locale string carries an `{amount}` token (the drawer fills it
                   with `| replace`). Here the amount is LIVE (Alpine rewrites it on
                   every +/−), so the string is split around the token and the
                   <bdi> sits where the token was — printing the string whole left
                   a literal "{amount}" in the sentence. #}
                {% set shipParts = (t('pages.cart.free_shipping_left') ~ '').split('{amount}') %}
                <span class="hy-cart-ship-text"
                      x-show="!shipEarned()"
                      {% if remaining <= 0 %}style="display: none;"{% endif %}>
                  {{ shipParts[0] }}<bdi x-text="money(shipRemaining())">{{ remaining | money }}</bdi>{{ shipParts[1] | default('', true) }}
                </span>
                <span class="hy-cart-ship-text hy-cart-ship-text--won"
                      x-show="shipEarned()"
                      {% if remaining > 0 %}style="display: none;"{% endif %}>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 12.5 9.5 18 20 6.5"/>
                  </svg>
                  {{ t('pages.cart.free_shipping_earned') }}
                </span>
                <span class="hy-cart-bar" aria-hidden="true">
                  <span :style="'width: ' + shipPct() + '%'"
                        style="width: {{ 100 if remaining <= 0 else ((cart.totalPrice | default(0, true)) / freeThreshold * 100) | round }}%;"></span>
                </span>
              </div>
            {% endif %}

            <div class="hy-sum">
              <div class="hy-sum-row">
                <span>{{ t('pages.cart.subtotal') }}</span>
                <span data-cart-total>{{ cart.totalPrice | default(0, true) | money }}</span>
              </div>

              {% if showSavings %}
                <div class="hy-sum-row hy-sum-row--save" data-cart-savings-row
                     {% if not cart.totalSavings or cart.totalSavings <= 0 %}style="display: none;"{% endif %}>
                  <span>{{ t('pages.cart.savings') }}</span>
                  {# `.hy-neg`, and it must be a CLASS rather than a `<bdi>` wrapper. `-`
                     is a neutral character: alone in an Arabic line it drifts to the
                     logical end and "−50,000" renders as "50,000−". A `<bdi>` would fix
                     the ordering, but main.js writes `el.textContent = '-' + …` into
                     [data-cart-savings] on every cart update, which DELETES any child
                     element. The isolation has to be on the element the JS writes to. #}
                  <span class="hy-neg" data-cart-savings>-{{ cart.totalSavings | default(0, true) | money }}</span>
                </div>
              {% endif %}

              {% if showDiscount and cart.couponApplied %}
                <div class="hy-sum-row hy-sum-row--save">
                  <span>{{ t('pages.cart.discount') }}</span>
                  <span class="hy-neg">-{{ cart.couponDiscount | default(0, true) | money }}</span>
                </div>
              {% endif %}

              <div class="hy-sum-row">
                <span>{{ t('pages.cart.shipping') }}</span>
                <span class="hy-sum-muted">{{ t('pages.cart.calculated_at_checkout') }}</span>
              </div>

              <div class="hy-sum-row hy-sum-row--total">
                <span>{{ t('pages.cart.total') }}</span>
                <span data-cart-total>{{ cart.totalPrice | default(0, true) | money }}</span>
              </div>
            </div>

            {# ⚠️  An <a>, so there is no `:disabled` — the theme says as much beside
               the pager in 15.26. The block is therefore three things together:
               `@click.prevent` when it must not proceed, `is-blocked` for the look,
               and `aria-disabled` so it is announced rather than only greyed.
               The link is NOT removed: a checkout button that vanishes reads as a
               broken page, while one that says why reads as an instruction. #}
            <a href="{{ checkoutUrl }}"
               class="hy-btn hy-btn--solid hy-btn--lg hy-btn--block"
               :class="hasSoldOut() && 'is-blocked'"
               :aria-disabled="hasSoldOut() ? 'true' : 'false'"
               @click="if (hasSoldOut()) $event.preventDefault()">
              {{ t('pages.cart.checkout') }} <span class="mh-arrow" aria-hidden="true">→</span>
            </a>
            <p class="hy-cart-blocked" x-show="hasSoldOut()" x-cloak role="alert">
              {{ t('pages.cart.blocked_sold_out') }}
            </p>

            {# ---- reassurance: the last doubts before the click ---- #}
            {% if hasTrust %}
              <ul class="hy-cart-trust">
                {{ trustLine(trust1, 'lock') }}
                {{ trustLine(trust2, 'warranty') }}
                {{ trustLine(trust3, 'returns') }}
              </ul>
            {% endif %}

            {% if noteText %}
              <p class="hy-cart-note">{{ noteText }}</p>
            {% endif %}
          </div>
        </aside>

      </div>
    </div>

    {# ═══════════════ empty ═══════════════ #}
    {# ⚠️  `pages.cart.*`, not `cart.*`. The old keys were one level short, so
       t() fell through and the empty cart printed the key strings themselves. #}
    <div x-show="activeItems.length === 0" {% if itemCount > 0 %}x-cloak{% endif %} data-cart-empty>
      <div class="hy-empty hy-cart-empty mh-panel">
        <span class="hy-cart-empty-icon hy-cart-empty-icon--lg mh-hud">
          <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 4h2.2l1.9 10.4a1.8 1.8 0 0 0 1.77 1.48h7.9a1.8 1.8 0 0 0 1.76-1.42L20.3 7.5H6.2"/>
            <circle cx="9.5" cy="19.5" r="1.4"/><circle cx="17" cy="19.5" r="1.4"/>
          </svg>
        </span>
        {# The mirror of the note above — this branch takes the <h1> when the
           server rendered an empty cart. #}
        {% if itemCount == 0 %}
          <h1 class="hy-cart-title hy-cart-title--empty">{{ t('pages.cart.empty_title') }}</h1>
        {% else %}
          <p class="hy-cart-title hy-cart-title--empty">{{ t('pages.cart.empty_title') }}</p>
        {% endif %}
        <p class="hy-cart-empty-text">{{ t('pages.cart.empty_message') }}</p>
        <a href="{{ shopUrl }}" class="hy-btn hy-btn--solid hy-btn--lg">
          {{ t('pages.cart.continue_shopping') }}
        </a>
      </div>
    </div>

  </div>
</section>

{# Per-section palette. Emits nothing at all unless `colors_enabled` is on, so
   the switch IS the revert. #}
{% ui "section-colors.njk", scope='#hy-cart-' ~ id, c=d %}

      "type": "select",
      "label": {
        "ar": "السطر فوق الاسم",
        "en": "Line above the title"
      },
      "default": "collection",
      "options": [
        {
          "value": "collection",
          "label": {
            "ar": "اسم أول تصنيف للمنتج",
            "en": "The product's first collection"

      "type": "string",
      "label": {
        "ar": "شارات من تاجات المنتج — اكتب التاجات مفصولة بفاصلة، مثال: جديد, عرض اليوم",
        "en": "Badges from product tags — comma separated, e.g. new, deal"
      },
      "default": ""

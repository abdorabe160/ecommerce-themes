    "image_bg_custom": {
      "type": "boolean",
      "label": {
        "ar": "استخدام لون خلفية الصور المختار أعلاه — مطفأ = لوح الثيم الداكن",
        "en": "Use the picked picture background above — off = the theme's dark panel"
      },
      "default": false
    },
    "show_zoom": {
      "type": "boolean",
      "label": {
        "ar": "تكبير الصورة عند الضغط",
        "en": "Zoom on click"
      },
      "default": true
    },
    "show_badges": {
      "type": "boolean",
      "label": {
        "ar": "▸ شارات على الصورة",
        "en": "▸ Badges on the picture"
      },
      "default": true
    },
    "badge_sale": {
      "type": "string",
      "label": {
        "ar": "شارة الخصم — تظهر لو المنتج عليه خصم — فارغ = النص الافتراضي بلغة الزائر",
        "en": "Sale badge — shown when discounted — empty = default text in the visitor's language"
      },
      "default": ""
    },
    "badge_low": {
      "type": "string",
      "label": {
        "ar": "شارة الكمية المحدودة (5 أو أقل) — فارغ = النص الافتراضي بلغة الزائر",

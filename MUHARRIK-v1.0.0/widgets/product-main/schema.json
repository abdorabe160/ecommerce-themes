{
  "name": "تفاصيل المنتج",
  "settings": {
    "show_banner": {
      "type": "boolean",
      "label": {
        "ar": "▸ اللافتة العلوية",
        "en": "▸ Top banner"
      },
      "default": true
    },
    "banner_title": {
      "type": "string",
      "label": {
        "ar": "عنوان اللافتة — فارغ = النص الافتراضي بلغة الزائر",
        "en": "Banner title — empty = default text in the visitor's language"
      },
      "default": ""
    },
    "banner_text": {
      "type": "string",
      "label": {
        "ar": "سطر اللافتة — فارغ = النص الافتراضي بلغة الزائر",
        "en": "Banner line — empty = default text in the visitor's language"
      },
      "default": ""
    },
    "banner_image": {
      "type": "media",
      "label": {
        "ar": "صورة اللافتة — فارغ = صورة الثيم",
        "en": "Banner image — empty = the theme's picture"
      }
    },
    "banner_url": {
      "type": "string",
      "label": {
        "ar": "رابط اللافتة",
        "en": "Banner link"
      },
      "default": "/shop"
    },
    "show_breadcrumb": {
      "type": "boolean",
      "label": {
        "ar": "مسار التنقل (الرئيسية › التصنيف › المنتج)",
        "en": "Breadcrumb (Home › Collection › Product)"
      },
      "default": true
    },
    "gallery_layout": {
      "type": "select",
      "label": {
        "ar": "▸ شكل معرض الصور — كمبيوتر",
        "en": "▸ Gallery layout — desktop"
      },
      "default": "two",
      "options": [
        {
          "value": "two",
          "label": {
            "ar": "صورتان جنبًا إلى جنب",
            "en": "Two side by side"
          }
        },
        {
          "value": "one",
          "label": {
            "ar": "صورة واحدة كبيرة",
            "en": "One large picture"
          }
        }
      ]
    },
    "image_fit": {
      "type": "select",
      "label": {
        "ar": "طريقة عرض الصور",
        "en": "Picture fit"
      },
      "default": "contain",
      "options": [
        {
          "value": "contain",
          "label": {
            "ar": "كاملة داخل الإطار",
            "en": "Whole, inside the frame"
          }
        },
        {
          "value": "cover",
          "label": {
            "ar": "تملأ الإطار",
            "en": "Fill the frame"
          }
        }
      ]
    },
    "image_bg": {
      "type": "color",
      "label": {
        "ar": "خلفية إطار الصور",
        "en": "Picture frame background"
      },
      "default": ""

{# إعدادات الويدجت: widget.settings (حسب docs.qumra.cloud) مع دعم widget.data للتوافق #}
{% set wd = widget.data if (widget.data and (widget.data | length)) else (widget.settings or {}) %}
{# نصوص الإعدادات: الحقل *_en يظهر في الإنجليزية، وإلا النص الأصلي #}
{% set L = '_en' if localization.language == 'en' else '' %}
{# المنصة مالهاش مسار نشرة (GET /ajax/newsletter/subscribe زي أي مسار مش موجود)، فالفورم بيبعت مباشرة لخدمة التاجر
   في تبويب جديد وهي اللي بتأكد. من غير رابط: العملاء مايشوفوش القسم، والتلميح في المعاينة بس. #}
{% set formAction = (wd.form_action or '') | trim %}
{% set fieldName = (wd.field_name or 'email') | trim %}
{% if formAction.indexOf('https://') == 0 or formAction.indexOf('http://') == 0 %}
<section class="lg-section !pt-2">
  <div class="lg-container">
    <div class="lg-newsletter glass px-5 py-5 md:px-10 md:py-6 flex flex-col md:flex-row md:items-center gap-4 md:gap-8">
      <div class="flex items-center gap-4 flex-1 min-w-0">
        <span class="shrink-0 w-12 h-12 rounded-2xl grid place-items-center text-primary bg-[color:var(--color-surface-strong)] border border-[color:var(--color-border)]">
          {% ui "icon.njk", name="mail", cls="w-6 h-6" %}
        </span>
        <div class="min-w-0">
          <h2 class="text-lg font-semibold">{{ (wd['title' + L] or wd.title) }}</h2>
          {% if (wd['text' + L] or wd.text) %}<p class="text-sm text-muted">{{ (wd['text' + L] or wd.text) }}</p>{% endif %}
        </div>
      </div>

      <form class="lg-newsletter__form w-full md:w-auto md:min-w-[420px]" action="{{ formAction }}" method="post" target="_blank" rel="noopener noreferrer">
        <div class="flex flex-col sm:flex-row gap-2">
          <label for="lg-newsletter-{{ widget._id }}" class="sr-only">{{t('newsletter.placeholder')}}</label>
          <input id="lg-newsletter-{{ widget._id }}" type="email" name="{{ fieldName }}" required inputmode="email" autocomplete="email"
                 class="lg-input flex-1"
                 placeholder="{{t('newsletter.placeholder')}}">
          <button type="submit" class="btn btn-primary !min-h-[46px] !px-7">{{t('newsletter.subscribe')}}</button>
        </div>
      </form>
    </div>
  </div>
</section>
{% else %}
<div x-data="lgEditorOnly()">
  <template x-if="show">
    <section class="lg-section !pt-2">
      <div class="lg-container">
        <p class="lg-editor-hint">{{ t('newsletter.setup_hint') }}</p>
      </div>
    </section>
  </template>
</div>
{% endif %}

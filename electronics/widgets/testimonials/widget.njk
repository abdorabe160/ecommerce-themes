{# إعدادات الويدجت: widget.settings (حسب docs.qumra.cloud) مع دعم widget.data للتوافق #}
{% set wd = widget.data if (widget.data and (widget.data | length)) else (widget.settings or {}) %}
{# نصوص الإعدادات: الحقل *_en يظهر في الإنجليزية، وإلا النص الأصلي #}
{% set L = '_en' if localization.language == 'en' else '' %}
{# لا تُعرض الآراء الفارغة (نص الرأي مطلوب) — لا آراء وهمية افتراضية #}
{% set blocks = [] %}
{% for b in widget.blocks | default([]) %}{% if b.settings and (b.settings['text' + L] or b.settings.text) and blocks.push(b) %}{% endif %}{% endfor %}
{% set multi = blocks | length > 1 %}
{% if blocks | length %}
<section class="lg-section" data-lg-slider-scope>
  <div class="lg-container">
    <div class="glass p-5 md:p-7">
      <div class="lg-section-head">
        <div>
          {% if (wd['title' + L] or wd.title) %}<h2 class="lg-title !text-xl">{{ (wd['title' + L] or wd.title) }}</h2>{% endif %}
          {% if (wd['subtitle' + L] or wd.subtitle) %}<p class="lg-subtitle">{{ (wd['subtitle' + L] or wd.subtitle) }}</p>{% endif %}
        </div>
        {% if multi %}
          <div class="lg-slider-nav {% if blocks | length <= 3 %}lg:hidden{% endif %}">
            <button type="button" class="btn btn-glass btn-icon" data-lg-rail-prev aria-label="{{t('common.previous')}}">{% ui "icon.njk", name="prev", cls="w-4 h-4 lg-flip-rtl" %}</button>
            <button type="button" class="btn btn-glass btn-icon" data-lg-rail-next aria-label="{{t('common.next')}}">{% ui "icon.njk", name="chevron", cls="w-4 h-4 lg-flip-rtl" %}</button>
          </div>
        {% endif %}
      </div>

      <div class="lg-rail lg-rail--wide {% if blocks | length <= 3 %}lg:!grid-flow-row lg:!grid-cols-3 lg:!overflow-visible{% endif %}">
          {% for block in blocks %}
            {% set s = block.settings %}
            {% set stars = s.rating | default(5) | int %}
            <div>
              <figure class="h-full flex gap-3 p-4 md:p-5 rounded-[calc(var(--radius)-6px)] bg-[color:var(--color-surface-strong)] border border-[color:var(--color-border)]">
                {% if s.avatar and s.avatar.fileUrl %}
                  <img src="{{ s.avatar.fileUrl }}" alt="{{ (s['name' + L] or s.name) }}" loading="lazy" width="44" height="44" class="w-11 h-11 rounded-full object-cover shrink-0">
                {% else %}
                  <span class="w-11 h-11 shrink-0 rounded-full grid place-items-center font-bold text-[color:var(--color-on-primary)] bg-gradient-to-br from-primary to-secondary" aria-hidden="true">{{ ((s['name' + L] or s.name) | default('?'))[0] }}</span>
                {% endif %}
                <div class="min-w-0 space-y-1">
                  <figcaption class="text-sm font-semibold">{{ (s['name' + L] or s.name) }}</figcaption>
                  <span class="lg-stars" aria-label="{{ stars }} / 5">
                    {% for i in range(1, 6) %}{% ui "icon.njk", name="star", cls="w-3.5 h-3.5 fill-current" + ('' if i <= stars else ' is-empty') %}{% endfor %}
                  </span>
                  <blockquote class="text-sm leading-6">“{{ (s['text' + L] or s.text) | replace('</p>', ' </p>') | replace('<br', ' <br') | striptags | safe }}”</blockquote>
                  {% if s.verified %}<p class="text-xs text-muted">{{t('common.verified_customer')}}</p>{% endif %}
                </div>
              </figure>
            </div>
          {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}

{# إعدادات الويدجت: widget.settings (حسب docs.qumra.cloud) مع دعم widget.data للتوافق #}
{% set wd = widget.data if (widget.data and (widget.data | length)) else (widget.settings or {}) %}
{# أسماء الروابط المعروفة بالإنجليزية — قوائم المتجر بلغة واحدة من لوحة التحكم #}
{% set isEn = localization.language == 'en' %}
{% set routeNames = { '/': t('common.home'), '/collections': t('header.categories'), '/shop': t('nav.shop'), '/latest': t('nav.latest'), '/cart': t('header.cart'), '/wishlist': t('header.wishlist'), '/search': t('header.search') } %}
{# نصوص الإعدادات: الحقل *_en يظهر في الإنجليزية، وإلا النص الأصلي #}
{% set L = '_en' if localization.language == 'en' else '' %}
{% set menu = wd.header_menu | default([]) %}
{% set currentUrl = page.url | default('') %}
{% set hideOnScroll = wd.hide_on_scroll and wd.sticky %}

{# قائمة التصنيفات: المختارة من الإعدادات، وإلا تصنيفات توضيحية في المعاينة فقط (lgAutoCollections).
   تُلحق برابط /collections الموجود في قائمة المتجر إن وُجد، وإلا تُضاف كعنصر مستقل بعد الرئيسية. #}
{% set showCats = wd.show_categories_menu != false %}
{% set navCols = [] %}
{% for c in wd.menu_collections | default([]) %}
  {% if c and c.title and c.status != 'inactive' and c.status != 'draft' and c.active != false and c.isActive != false and c.deleted != true and not (c.salesChannels and c.salesChannels.onlineStore == false) and c.published != false %}{% if navCols.push(c) %}{% endif %}{% endif %}
{% endfor %}
{% set catsInMenu = [] %}
{% set homeInMenu = [] %}
{% set shopInMenu = [] %}
{% for item in menu %}
  {# رابط /collections موجود في قائمة المتجر (بقائمة فرعية أو بدونها)؟ لا نضيف "التصنيفات" مرة ثانية #}
  {% if item.url == '/collections' %}{% if catsInMenu.push(item) %}{% endif %}{% endif %}
  {# رابط الرئيسية موجود في قائمة المتجر؟ لا نضيف رابط الثيم حتى لا يتكرر #}
  {% if item.url == '/' or item.url == '' %}{% if homeInMenu.push(item) %}{% endif %}{% endif %}
  {# رابط المتجر موجود بالفعل (بالرابط أو بالاسم)؟ لا نكرره #}
  {% set itemTitle = (item.title or '') | trim | lower %}
  {% if item.url == '/shop' or itemTitle == 'المتجر' or itemTitle == 'shop' or itemTitle == (t('nav.shop') | lower) %}{% if shopInMenu.push(item) %}{% endif %}{% endif %}
{% endfor %}
{# رابط صفحة المتجر (/shop — كل المنتجات): يُضاف بعد الرئيسية ما لم يكن في قائمة المتجر، ويمكن إخفاؤه من الإعدادات #}
{% set showShop = wd.show_shop_link != false and not (shopInMenu | length) %}
{# page.url لا يصل من قمرة غالباً — الرابط النشط يُصحَّح في المتصفح (initActiveNav في main.js) #}
{% set onHome = currentUrl == '/' %}
{% set catsActive = '/collections' in currentUrl %}

{% macro catsNav(label, active, cols) %}
  {% set demo = not (cols | length) %}
  <div class="relative" x-data="{ open: false{% if demo %}, ...lgAutoCollections(){% endif %} }" @mouseenter="open = true" @mouseleave="open = false" @keydown.escape.stop="open = false">
    <a href="/collections" @focusin="open = true"
       class="lg-nav-link {% if active %}is-active{% endif %}" {% if active %}aria-current="page"{% endif %}
       {% if demo %}:aria-haspopup="items.length ? 'true' : 'false'"{% else %}aria-haspopup="true"{% endif %} :aria-expanded="open">
      {{ label }}
      <span class="lg-nav-caret" :class="open && 'is-open'" {% if demo %}x-show="items.length" x-cloak{% endif %}>{% ui "icon.njk", name="chevron-down", cls="w-3.5 h-3.5" %}</span>
    </a>
    <div x-cloak x-show="open{% if demo %} && items.length{% endif %}"
         x-transition:enter="transition duration-200 ease-out" x-transition:enter-start="opacity-0 -translate-y-1 scale-[.98]" x-transition:enter-end="opacity-100 translate-y-0 scale-100"
         x-transition:leave="transition duration-150" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
         class="lg-dropdown glass glass-strong">
      {% for c in cols %}
        <a href="/collections/{{ c.handle or c.slug }}" class="lg-dropdown__item"><span>{{ c.title }}</span>{% ui "icon.njk", name="chevron", cls="w-3.5 h-3.5 lg-flip-rtl lg-dropdown__arrow" %}</a>
      {% else %}
        <template x-for="c in items" :key="c._id">
          <a :href="collectionUrl(c)" class="lg-dropdown__item"><span x-text="c.title"></span>{% ui "icon.njk", name="chevron", cls="w-3.5 h-3.5 lg-flip-rtl lg-dropdown__arrow" %}</a>
        </template>
      {% endfor %}
      <a href="/collections" class="lg-dropdown__item !text-[color:var(--color-primary)] font-semibold"><span>{{t('collection.all_collections')}}</span>{% ui "icon.njk", name="arrow", cls="w-3.5 h-3.5 lg-flip-rtl" %}</a>
    </div>
  </div>
{% endmacro %}

{# شريط الإعلان — قابل للإغلاق ويظل مغلقاً خلال الجلسة (HOME-09). لا يوجد نص افتراضي عن الشحن (REG-19) #}
{% if wd.show_announcement and (wd['announcement_text' + L] or wd.announcement_text) %}
  <div class="lg-announcement" x-show="!announcementClosed" x-cloak>
    {% if wd.announcement_link %}
      <a href="{{ wd.announcement_link }}">{{ (wd['announcement_text' + L] or wd.announcement_text) }}</a>
    {% else %}
      <span>{{ (wd['announcement_text' + L] or wd.announcement_text) }}</span>
    {% endif %}
    <button type="button" class="absolute inset-y-0 end-1 my-auto w-11 h-11 grid place-items-center opacity-80 hover:opacity-100"
            @click="closeAnnouncement()" aria-label="{{t('header.close_announcement')}}">
      {% ui "icon.njk", name="close", cls="w-4 h-4" %}
    </button>
  </div>
{% endif %}

<header class="lg-header {% if not wd.sticky %}!relative{% endif %}"
        :class="{ 'is-scrolled': scrolled{% if hideOnScroll %}, 'is-hidden': navHidden{% endif %} }">
  <div class="lg-container">
    <div class="lg-header__bar glass">
      <span class="lg-glass-fx" aria-hidden="true"></span>
      <span class="lg-cursor-clip" aria-hidden="true"><span class="lg-cursor-lens"></span></span>

      {# ===== البداية: القائمة (موبايل) + الشعار ===== #}
      <div class="lg-header__start">
        <button type="button" class="lg-hbtn lg:hidden" @click="toggleModal('sidebar')" aria-label="{{t('header.menu')}}" :aria-expanded="isOpen('sidebar')">
          {% ui "icon.njk", name="menu", cls="w-5 h-5" %}
        </button>

        <a href="/" class="lg-logo" aria-label="{{ store.name }}">
          {% if store.logo and store.logo.fileUrl %}
            <img src="{{ store.logo.fileUrl }}" alt="{{ store.name }}" style="height: {{ wd.logo_height | default(34) }}px" class="w-auto max-w-[150px] object-contain" width="150" height="{{ wd.logo_height | default(34) }}">
          {% else %}
            <span class="lg-logo__mark" aria-hidden="true">{% ui "icon.njk", name="bag", cls="w-[18px] h-[18px]" %}</span>
            <span class="lg-logo__text">{{ store.name }}</span>
          {% endif %}
        </a>
      </div>

      {# ===== الوسط: روابط الديسكتوب — عدسة زجاجية تستقر على الصفحة الحالية وتتبع المؤشر (3 مستويات) ===== #}
      <nav class="lg-nav" aria-label="{{t('header.menu')}}">
        {% if not (homeInMenu | length) %}
          <a href="/" class="lg-nav-link {% if onHome %}is-active{% endif %}" {% if onHome %}aria-current="page"{% endif %}>{{t('common.home')}}</a>
        {% endif %}
        {% if showShop %}
          <a href="/shop" class="lg-nav-link">{{t('nav.shop')}}</a>
        {% endif %}
        {% if showCats and not (catsInMenu | length) %}{{ catsNav(t('header.categories'), catsActive, navCols) }}{% endif %}
        {% for item in menu %}
          {% set children = item.children or item.items or [] %}
          {% set active = (currentUrl == item.url) or (onHome and (item.url == '/' or item.url == '')) %}
          {% if showCats and item.url == '/collections' and not (children | length) %}
            {{ catsNav((routeNames[item.url] if (isEn and routeNames[item.url]) else item.title), catsActive, navCols) }}
          {% elif children | length %}
            <div class="relative" x-data="{ open: false }" @mouseenter="open = true" @mouseleave="open = false" @keydown.escape.stop="open = false">
              <a href="{{ item.url | default('#') }}" @focusin="open = true"
                 class="lg-nav-link {% if active %}is-active{% endif %}" {% if active %}aria-current="page"{% endif %} aria-haspopup="true" :aria-expanded="open">
                {{ (routeNames[item.url] if (isEn and routeNames[item.url]) else item.title) }}
                <span class="lg-nav-caret" :class="open && 'is-open'">{% ui "icon.njk", name="chevron-down", cls="w-3.5 h-3.5" %}</span>
              </a>
              <div x-cloak x-show="open"
                   x-transition:enter="transition duration-200 ease-out" x-transition:enter-start="opacity-0 -translate-y-1 scale-[.98]" x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                   x-transition:leave="transition duration-150" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
                   class="lg-dropdown glass glass-strong">
                {% for child in children %}
                  {% set grand = child.children or child.items or [] %}
                  <div class="relative" x-data="{ sub: false }" @mouseenter="sub = true" @mouseleave="sub = false">
                    <a href="{{ child.url | default('#') }}" class="lg-dropdown__item" @focus="sub = true">
                      <span>{{ (routeNames[child.url] if (isEn and routeNames[child.url]) else child.title) }}</span>
                      {% ui "icon.njk", name="chevron", cls="w-3.5 h-3.5 lg-flip-rtl lg-dropdown__arrow" %}
                    </a>
                    {% if grand | length %}
                      <div x-cloak x-show="sub" x-transition.opacity.duration.150ms class="lg-dropdown glass glass-strong">
                        {% for g in grand %}
                          <a href="{{ g.url | default('#') }}" class="lg-dropdown__item"><span>{{ (routeNames[g.url] if (isEn and routeNames[g.url]) else g.title) }}</span></a>
                        {% endfor %}
                      </div>
                    {% endif %}
                  </div>
                {% endfor %}
              </div>
            </div>
          {% else %}
            <a href="{{ item.url | default('#') }}" class="lg-nav-link {% if active %}is-active{% endif %}" {% if active %}aria-current="page"{% endif %}>{{ (routeNames[item.url] if (isEn and routeNames[item.url]) else item.title) }}</a>
          {% endif %}
        {% endfor %}
      </nav>

      {# ===== النهاية: البحث + كبسولة الأدوات ===== #}
      <div class="lg-header__end">
        {% ui "lang-switch.njk", cls="lg-lang" %}
        {% if wd.show_currency != false %}{% ui "currency-switch.njk", list=(wd.currencies or ''), cls="lg-currency--header" %}{% endif %}
        {% if wd.show_search %}
          <button type="button" class="lg-search-pill" @click="toggleModal('search')" aria-keyshortcuts="/">
            {% ui "icon.njk", name="search", cls="w-4 h-4 shrink-0" %}
            <span class="truncate">{{t('header.search_placeholder')}}</span>
          </button>
        {% endif %}

        <div class="lg-actions" data-dock>
          {% if wd.show_search %}
            <button type="button" class="lg-hbtn xl:hidden" @click="toggleModal('search')" aria-label="{{t('header.search')}}">
              {% ui "icon.njk", name="search", cls="w-[18px] h-[18px]" %}
            </button>
          {% endif %}

          {# على الشاشات الصغيرة الزر في القائمة الجانبية (sidebar.njk) حتى لا يزاحم الشعار #}
          {% ui "scheme-toggle.njk", cls="lg-hbtn hidden md:grid" %}

          <button type="button" class="lg-hbtn lg-hbtn--cart" @click="toggleModal('cart')" aria-label="{{t('header.cart')}}">
            {% ui "icon.njk", name="cart", cls="w-[18px] h-[18px]" %}
            <span class="lg-count" x-text="cartCount" x-show="cartCount > 0" {% if not cart.totalQuantity %}x-cloak{% endif %}>{{ cart.totalQuantity | default(0) }}</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</header>

{# الوسم ui يُسقط القيم true، لذا نمرر حالة التصنيفات كنص #}
{% set catsMode = 'on' if showCats else 'off' %}
{% set shopMode = 'on' if showShop else 'off' %}
{% set curMode = 'off' if wd.show_currency == false else 'on' %}
{% ui "sidebar.njk", menu=menu, cols=navCols, cats=catsMode, shop=shopMode, currency=curMode, currencies=(wd.currencies or '') %}

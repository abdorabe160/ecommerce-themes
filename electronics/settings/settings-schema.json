  {
    "label": {
      "ar": "المنتجات والسلة",
      "en": "Products & cart"
    },
    "settings": {
      "showCardButtons": {
        "type": "boolean",
        "label": {
          "ar": "أزرار «أضف إلى السلة» و«اشترِ الآن» في بطاقات المنتجات",
          "en": "“Add to cart” and “Buy now” buttons on product cards"

  {
    "label": {
      "ar": "المخزون",
      "en": "Inventory"
    },
    "settings": {
      "followProductStock": {
        "type": "boolean",
        "label": {
          "ar": "اتّباع إعدادات المخزون لكل منتج (تتبّع الكمية / الطلب المسبق) — للمتاجر التي لا تتابع الكميات. عند الإيقاف: الحالة من الكمية دائماً (0 = نفد، ومن 1 إلى حد التحذير = أوشك على النفاد) والسلة لا تتجاوز الكمية",
          "en": "Follow each product's stock settings (track quantity / backorder) — for stores that don't track quantities. When off: status always from quantity (0 = sold out, 1 to the warning threshold = almost sold out) and the cart never exceeds stock"
        },
        "default": false
      },
      "lowStockThreshold": {
        "type": "range",
        "label": {
          "ar": "حد تحذير المخزون القليل: يظهر \"أوشك على النفاد — باقي N فقط\" على المنتج عندما تكون الكمية من 1 إلى هذا الرقم (خطة اختبار قمرة: 3)",
          "en": "Low-stock warning threshold: shows \"Almost sold out — Only N left\" on the product when quantity is between 1 and this number (Qumra QA plan: 3)"
        },
        "default": 3,
        "min": 1,
        "max": 10,
        "step": 1
      }

<script type="application/json" class="lg-demo-json" data-kind="{{ data.kind | default('featured') }}">
{% if data.kind == 'collections' %}
[
  { "_id": "demo-c-phones", "title": {{ t('preview.cat_phones') | dump | replace('</', '<\\/') | safe }}, "image": {{ (img + 'phone.webp') | assets | dump | replace('</', '<\\/') | safe }} },
  { "_id": "demo-c-laptops", "title": {{ t('preview.cat_laptops') | dump | replace('</', '<\\/') | safe }}, "image": {{ (img + 'laptop.webp') | assets | dump | replace('</', '<\\/') | safe }} },
  { "_id": "demo-c-headphones", "title": {{ t('preview.cat_headphones') | dump | replace('</', '<\\/') | safe }}, "image": {{ (img + 'headphones.webp') | assets | dump | replace('</', '<\\/') | safe }} },

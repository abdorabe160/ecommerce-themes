  { "_id": "demo-c-home", "title": {{ t('preview.cat_home') | dump | replace('</', '<\\/') | safe }}, "image": {{ (img + 'speaker.webp') | assets | dump | replace('</', '<\\/') | safe }} },
  { "_id": "demo-c-empty", "title": {{ t('preview.cat_empty') | dump | replace('</', '<\\/') | safe }}, "image": {{ (img + 'watch2.webp') | assets | dump | replace('</', '<\\/') | safe }} }
]
{% elif data.kind == 'best' %}
[{{ best(img) }}]
{% elif data.kind == 'all' %}
[{{ featured(img) }},{{ best(img) }},{{ extra(img) }}]
{% else %}
[{{ featured(img) }}]

{# سلة جانبية (Drawer) — تُدار من qumraApp() #}
<div x-cloak x-show="isOpen('cart')" class="fixed inset-0 z-[60]" role="dialog" aria-modal="true" aria-label="{{t('cart.title')}}">
  <div class="lg-overlay" @click="closeModal()"
       x-show="isOpen('cart')"
       x-transition:enter="transition-opacity duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
       x-transition:leave="transition-opacity duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"></div>

  <aside class="lg-drawer glass glass-strong"
         x-show="isOpen('cart')"
         x-transition:enter="lg-win-enter" x-transition:enter-start="lg-win-from lg-win-from--end" x-transition:enter-end="lg-win-to"
         x-transition:leave="lg-win-leave" x-transition:leave-start="lg-win-to" x-transition:leave-end="lg-win-out">

    {# Header #}
    <div class="flex items-center justify-between gap-3 p-5 pb-4">
      <h2 class="text-lg font-bold flex items-center gap-2">
        {% ui "icon.njk", name="cart", cls="w-5 h-5 text-primary" %}
        {{t('cart.title')}}
        <span class="text-sm font-medium text-muted" x-show="cartCount > 0" x-text="'(' + cartCount + ')'"></span>
      </h2>
      <button type="button" class="btn btn-glass btn-icon" @click="closeModal()" aria-label="{{t('common.close')}}">
        {% ui "icon.njk", name="close" %}
      </button>
    </div>
    <div class="lg-divider mx-5"></div>

    {# Empty #}
    <template x-if="!cartItems.length">
      <div class="flex-1 flex flex-col items-center justify-center text-center gap-4 p-8">
        <div class="glass glass-pill w-20 h-20 grid place-items-center text-primary">
          {% ui "icon.njk", name="cart", cls="w-9 h-9" %}
        </div>
        <div>
          <p class="font-bold text-lg">{{t('cart.empty')}}</p>
          <p class="text-muted text-sm mt-1">{{t('cart.empty_message')}}</p>
        </div>
        <a href="/" class="btn btn-primary" @click="closeModal()">{{t('cart.continue_shopping')}}</a>
      </div>
    </template>

    {# Items #}
    <template x-if="cartItems.length">
      <div class="flex-1 lg-scroll px-5 py-4 space-y-3">
        <template x-for="item in cartItems" :key="item._id">
          <div class="glass flex gap-3 p-3 !rounded-2xl" :class="isBusy('item:' + item._id) && 'is-loading'">
            <a :href="itemUrl(item)" class="shrink-0 w-20 h-20 rounded-xl overflow-hidden bg-white/60 grid place-items-center">
              <img x-show="itemImage(item)" :src="itemImage(item)" :alt="itemTitle(item)" loading="lazy" decoding="async" class="w-full h-full object-contain p-1.5">
            </a>
            <div class="flex-1 min-w-0 flex flex-col gap-1">
              <div class="flex items-start justify-between gap-2">
                <a :href="itemUrl(item)" class="lg-clamp-44 text-sm font-semibold leading-snug line-clamp-2 min-h-[44px] hover:text-primary" x-text="itemTitle(item)"></a>
                <button type="button" class="shrink-0 w-11 h-11 -mt-2 -me-2 grid place-items-center rounded-full text-muted hover:text-[color:var(--color-danger)]" @click="removeItem(item)" aria-label="{{t('cart.remove')}}">
                  {% ui "icon.njk", name="trash", cls="w-4 h-4" %}
                </button>
              </div>
              <p class="text-xs text-muted" x-show="itemOptions(item)" x-text="itemOptions(item)"></p>
              <p class="lg-alert !py-1 !text-xs" x-show="itemUnavailable(item)" x-cloak>{{t('product.out_of_stock')}}</p>
              <p class="lg-alert !py-1 !text-xs" x-show="itemOver(item)" x-cloak x-text="itemOverText(item)"></p>
              <div class="flex flex-wrap items-center justify-between gap-2 mt-auto">
                <div class="lg-qty lg-qty--sm">
                  <button type="button" @click="updateItem(item, item.quantity - 1)" aria-label="{{t('common.decrease_quantity')}}">{% ui "icon.njk", name="minus", cls="w-3.5 h-3.5" %}</button>
                  <span x-text="item.quantity"></span>
                  <button type="button" @click="updateItem(item, item.quantity + 1)" :disabled="item.quantity >= itemMax(item)" aria-label="{{t('common.increase_quantity')}}">{% ui "icon.njk", name="plus", cls="w-3.5 h-3.5" %}</button>
                </div>
                <div class="lg-nowrap text-end">
                  <div class="text-sm font-bold" x-text="formatMoney(item.totalPrice || item.price * item.quantity)"></div>
                  <div class="text-xs lg-price--old" x-show="item.totalCompareAtPrice > item.totalPrice" x-text="formatMoney(item.totalCompareAtPrice)"></div>
                </div>
              </div>
            </div>
          </div>
        </template>
      </div>
    </template>

    {# Footer #}
    <template x-if="cartItems.length">
      <div class="p-5 pt-4 space-y-3 border-t border-[color:var(--color-border)]">
        {% ui "ship-meter.njk" %}
        <div class="flex items-center justify-between text-sm text-muted" x-show="cart.totalSavings > 0">
          <span>{{t('cart.savings')}}</span>
          <span class="lg-save font-semibold" x-text="'- ' + formatMoney(cart.totalSavings)"></span>
        </div>
        <div class="flex items-center justify-between">
          <span class="font-semibold">{{t('cart.total')}}</span>
          <span class="text-lg font-bold" x-text="formatMoney(cart.totalPrice)"></span>
        </div>
        <p class="text-xs text-muted">{{t('cart.shipping_note')}}</p>
        <div class="grid grid-cols-2 gap-2">
          <a href="/cart" class="btn btn-glass" @click="closeModal()">{{t('cart.view_cart')}}</a>
          <button type="button" class="btn btn-primary" @click="checkout()" :disabled="cartBlocked || isBusy('checkout')">{{t('cart.checkout')}}</button>
        </div>
      </div>
    </template>
  </aside>
</div>

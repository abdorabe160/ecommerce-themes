{# =========================================================
   Dark Blood - ترقيم الصفحات
   بيقرا context.pagination
   ========================================================= #}
{# الترقيم: اللي الويدجت بعته (data.pagination)، وإلا context.pagination أو context.shop.pagination #}
{% set pgn = data.pagination if (data.pagination and data.pagination.totalPages) else ((context.pagination if (context and context.pagination) else null) or (context.shop.pagination if (context and context.shop and context.shop.pagination) else null) or {}) %}
{% set current = pgn.currentPage | default(1) | int %}
{% set total = pgn.totalPages | default(1) | int %}

{% if total > 1 %}
  <nav class="blk-pagination" aria-label="{{t('common.pagination')}}">
    {% if current > 1 %}
      <a href="?page={{ current - 1 }}" rel="prev" class="blk-page-btn" aria-label="{{t('common.prev_page')}}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
      </a>
    {% else %}
      <span class="blk-page-btn is-disabled" aria-disabled="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
      </span>
    {% endif %}

    {% for p in range(1, total + 1) %}
      {% if p == 1 or p == total or (p >= current - 1 and p <= current + 1) %}
        {% if p == current %}
          <span class="blk-page-btn is-active" aria-current="page">{{ p }}</span>
        {% else %}
          <a href="?page={{ p }}" class="blk-page-btn">{{ p }}</a>
        {% endif %}
      {% elif p == current - 2 or p == current + 2 %}
        <span class="blk-page-dots">…</span>
      {% endif %}
    {% endfor %}

    {% if current < total %}
      <a href="?page={{ current + 1 }}" rel="next" class="blk-page-btn" aria-label="{{t('common.next_page')}}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
      </a>
    {% else %}
      <span class="blk-page-btn is-disabled" aria-disabled="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
      </span>
    {% endif %}
  </nav>
{% endif %}

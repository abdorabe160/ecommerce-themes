{#- Dark Blood — السلة الجانبية (CART-11)
    بتتفتح من زرار السلة في الهيدر، وبعد الإضافة لو «فتح السلة الجانبية بعد الإضافة» مفعّل.
    المحتوى بيترسم في main.js (blkCartDrawer) من السلة الحقيقية (/ajax/cart): تعديل الكمية والحذف من جواها.
    مفيش رسالة شحن مجاني إلا لو التاجر كتب حد الشحن المجاني في الإعدادات (REG-19) -#}
<div class="blk-cart-drawer" data-blk-cart-drawer hidden>
  <div class="blk-cart-drawer-scrim" data-blk-cart-close></div>
  <aside class="blk-cart-drawer-panel" role="dialog" aria-modal="true" aria-labelledby="blkCartDrawerTitle" tabindex="-1">
    <div class="blk-cart-drawer-head">
      <h2 class="blk-cart-drawer-title" id="blkCartDrawerTitle">{{t('cart.drawer_title')}} <span class="blk-cart-drawer-count" data-drawer-count></span></h2>
      <button type="button" class="blk-icon-btn blk-cart-drawer-close" data-blk-cart-close aria-label="{{t('common.close')}}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <div class="blk-cart-drawer-ship" data-drawer-ship hidden>
      <p data-drawer-ship-text></p>
      <div class="blk-stock-bar"><div class="blk-stock-progress" data-drawer-ship-bar></div></div>
    </div>
    <div class="blk-cart-drawer-body" data-drawer-body aria-live="polite">
      <div class="blk-cart-drawer-loading" data-drawer-loading><span class="blk-spinner" aria-hidden="true"></span></div>
    </div>
    <div class="blk-cart-drawer-empty" data-drawer-empty hidden>
      <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2.2 2.8h3l2.2 11a1.7 1.7 0 0 0 1.7 1.4h8.1a1.7 1.7 0 0 0 1.7-1.4l1.5-7.5H6.2"/><circle cx="9.4" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/></svg>
      <p class="blk-cart-drawer-empty-title">{{t('cart.empty_title')}}</p>
      <a href="/shop" class="blk-btn blk-btn-primary">{{t('cart.start_shopping')}}</a>
    </div>
    <div class="blk-cart-drawer-foot" data-drawer-foot hidden>
      <div class="blk-cart-drawer-row"><span>{{t('cart.subtotal')}}</span><strong data-drawer-subtotal></strong></div>
      <p class="blk-cart-drawer-note">{{t('cart.shipping_next')}}</p>
      <p class="blk-cart-drawer-block" data-drawer-block role="alert" hidden></p>
      <a href="/checkout" class="blk-btn blk-btn-primary blk-cart-drawer-checkout" data-blk-checkout>{{t('cart.checkout')}}</a>
      <a href="/cart" class="blk-btn blk-btn-outline blk-cart-drawer-view">{{t('cart.view_cart')}}</a>
    </div>
  </aside>
</div>

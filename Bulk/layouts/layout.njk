    {# عينة من فلتر | money للرقم 123456: main.js بيستنتج منها تنسيق الأسعار في الـ JS (الرمز ومكانه والخانات ووحدة السعر) #}
    <a href="#main" class="blk-skip-link">{{t('common.skip_to_content')}}</a>
    <script type="application/json" id="blkMoneySample">{{ 123456 | money | dump | replace('</', '<\\/') | safe }}</script>
    {% template "header" %}
    <main id="main" tabindex="-1">{% content %}</main>
    {#- H1 واحد بالظبط: الـ layout مايعرفش أقسام الصفحة وقت الرندر، فالتاجر لو شال الهيرو بيتضاف H1 مخفي باسم المتجر،
        ولو قسمين طلعوا H1 (نموذج التواصل بـ h1 مع البانر مثلاً) التاني بيبقى H2 بنفس شكله -#}
    <script>
      (function () {
        var list = document.querySelectorAll('h1'), main = document.getElementById('main'), el;
        if (!list.length && main) {
          el = document.createElement('h1');
          el.className = 'blk-sr-only';
          el.textContent = {{ sdName | dump | replace('</', '<\\/') | safe }};
          main.insertBefore(el, main.firstChild);
        }
        for (var i = 1; i < list.length; i++) {
          el = document.createElement('h2');
          for (var a = 0; a < list[i].attributes.length; a++) el.setAttribute(list[i].attributes[a].name, list[i].attributes[a].value);
          while (list[i].firstChild) el.appendChild(list[i].firstChild);
          list[i].parentNode.replaceChild(el, list[i]);
        }
      })();
    </script>
    {% template "footer" %}
    {% ui "blk-cart-drawer.njk" %}

    {%- set wishIds = [] -%}
    {%- for wp in (wishlist.products if (wishlist and wishlist.products) else []) -%}{%- if wp and wp._id and wishIds.push(wp._id) -%}{%- endif -%}{%- endfor %}
    {#- إعدادات الثيم اللي الـ JS محتاجها (main.js / pages.js بيقروها من window.__blk) -#}
    <script>
      window.__blk = {
        lowStock: {{ settings.lowStockThreshold | default(3, true) | int }},
        followStock: {{ 'false' if settings.followProductStock == false else 'true' }},
        cartOpenOnAdd: {{ 'false' if settings.cartOpenOnAdd == false else 'true' }},
        cardButtons: {{ 'false' if settings.showCardButtons == false else 'true' }},
        wishlist: {{ 'false' if settings.showWishlist == false else 'true' }},
        demoProducts: {{ 'true' if settings.demoProducts == true else 'false' }},
        freeShipping: {{ (settings.freeShippingThreshold or 0) | float }},
        wishlistIds: {{ wishIds | dump | safe }}
      };
    </script>
    {% qumra_scripts %}
    <script src="{{ 'main.js' | assets }}?v={{ assetv }}"></script>
    <script src="{{ 'pages.js' | assets }}?v={{ assetv }}"></script>
    {%- if settings.customJS %}
    <script id="blk-custom-js">{{ settings.customJS | safe }}</script>
    {%- endif %}
  </body>
</html>

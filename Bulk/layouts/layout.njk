{%- set lang = localization.language | default('ar') -%}
{%- set isLtr = lang == 'en' or lang == 'fr' -%}
{#- رقم نسخة الأصول: لازم يتغيّر مع أي تعديل في assets/*.css أو *.js (الـ CDN بيخزّن الملفات) -#}
{%- set assetv = '6bedd2d3' -%}
{#- الخطوط من الإعدادات (fontHeading / fontBody) — Inter دايمًا للأرقام والإنجليزي -#}
{%- set fontMap = {
  'anton': { 'family': 'Anton', 'q': 'Anton' },
  'tajawal': { 'family': 'Tajawal', 'q': 'Tajawal:wght@300;400;500;700;800;900' },
  'cairo': { 'family': 'Cairo', 'q': 'Cairo:wght@400;500;600;700;800' },
  'alexandria': { 'family': 'Alexandria', 'q': 'Alexandria:wght@400;500;600;700' },
  'readex': { 'family': 'Readex Pro', 'q': 'Readex+Pro:wght@400;500;600;700' },
  'ibm-plex': { 'family': 'IBM Plex Sans Arabic', 'q': 'IBM+Plex+Sans+Arabic:wght@400;500;600;700' }
} -%}
{%- set fh = fontMap[settings.fontHeading] or fontMap['anton'] -%}
{%- set fb = fontMap[settings.fontBody] or fontMap['tajawal'] -%}
{%- if fb.family == 'Anton' -%}{%- set fb = fontMap['tajawal'] -%}{%- endif -%}
{%- set fontQ = [fh.q] -%}
{%- if fb.q != fh.q and fontQ.push(fb.q) -%}{%- endif -%}
{%- if fh.family == 'Anton' and fb.family != 'Tajawal' and fontQ.push(fontMap['tajawal'].q) -%}{%- endif -%}
{#- «اللون العام» (brandColor) بيغطي اللون الأساسي في كل مكان؛ فاضي = اللون الأساسي -#}
{%- set brand = (settings.brandColor | trim) if (settings.brandColor and (settings.brandColor | trim | length)) else (settings.accentColor or '#C81E1E') -%}
<!DOCTYPE html>
<html lang="{{ lang }}" dir="{{ 'ltr' if isLtr else 'rtl' }}">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
    <meta name="theme-color" content="#0A0A0A"/>
    {#- قبل أي رسم: معاينة البيلدر (iframe / ?theme=) أو التاجر مفعّل «منتجات تجريبية» ← html.blk-demo-ok.
        من غيرها المنتجات والأقسام التجريبية مابتظهرش للعميل (HOME-11 / EDGE-01). والحركات حسب الإعداد -#}
    <script>
      (function (h) {
        var preview = false;
        try {
          var l = window.location;
          preview = l.protocol === 'file:' || /^(localhost|127\.0\.0\.1|\[::1\])$/.test(l.hostname)
            || /[?&](theme|theme_id|preview_theme_id|editor|preview)=/.test(l.search) || window.self !== window.top;
        } catch (e) { preview = true; }
        if (typeof window.__blkPreview === 'boolean') preview = window.__blkPreview;
        if (preview) h.classList.add('blk-preview');
        if (preview || {{ 'true' if settings.demoProducts == true else 'false' }}) h.classList.add('blk-demo-ok');
        {% if settings.enableAnimations == false %}h.classList.add('blk-no-anim');{% endif %}
      })(document.documentElement);
    </script>
    {# الخطوط الأول عشان المتصفح يبدأ يحمّلها بدري؛ سكريبت Clarity تحتها ولسه قبل seo و qumra_head #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family={{ fontQ | join('&family=') | safe }}&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    {# Microsoft Clarity بيتضاف من المنصة (مش من الثيم)، ومانع الإعلانات (زي Brave Shields) بيقفله فبيطلع
       ERR_BLOCKED_BY_CLIENT أحمر في الكونسول. السكريبت ده بيمنع إضافة سكريبت Clarity للصفحة، فمفيش طلب أصلاً ولا رسالة.
       لازم يفضل قبل qumra_head و qumra_scripts.
       ده بيوقف إحصائيات Clarity لكل الزوار؛ لتشغيلها تاني: إعدادات الثيم ← محركات البحث والإحصائيات ← "تعطيل Microsoft Clarity" #}
    {% if settings.disable_clarity !== false %}
    <script>
      (function () {
        function isClarity(node) {
          if (!node || node.nodeName !== 'SCRIPT') return false;
          var src = String(node.src || (node.getAttribute && node.getAttribute('src')) || '');
          return src.indexOf('clarity.ms/') !== -1;
        }
        ['insertBefore', 'appendChild'].forEach(function (method) {
          var original = Node.prototype[method];
          Node.prototype[method] = function (node) {
            if (isClarity(node)) return node;
            return original.apply(this, arguments);
          };
        });
      })();
    </script>
    {% endif %}
    {% seo %}
    {% qumra_head %}
    {#- Google Search Console: الوسم كامل <meta name="google-site-verification" content="…"> أو قيمة content بس -#}
    {%- set gsv = (settings.googleVerification or '') | trim -%}
    {%- if 'content=' in gsv %}{%- set gsv = (gsv.split('content=')[1] | replace('"', '') | replace("'", '') | replace('/>', '') | replace('>', '') | trim).split(' ')[0] -%}{%- endif %}
    {%- if gsv %}
    <meta name="google-site-verification" content="{{ gsv }}"/>
    {%- endif %}
    {#- QLT-11: Organization + WebSite (الـ Product و BreadcrumbList في صفحة المنتج) -#}
    {%- set sdName = store.name if (store and store.name) else 'BULK' -%}
    {%- set sdUrl = store.url if (store and store.url) else '' -%}
    {%- set sdLogo = store.logo.fileUrl if (store and store.logo and store.logo.fileUrl) else (settings.favicon.fileUrl if (settings.favicon and settings.favicon.fileUrl) else '') -%}
    <script type="application/ld+json">{{ { '@context': 'https://schema.org', '@type': 'Organization', 'name': sdName, 'url': sdUrl, 'logo': sdLogo } | dump | replace('</', '<\\/') | safe }}</script>
    <script type="application/ld+json">{{ { '@context': 'https://schema.org', '@type': 'WebSite', 'name': sdName, 'url': sdUrl, 'potentialAction': { '@type': 'SearchAction', 'target': sdUrl ~ '/search?q={search_term_string}', 'query-input': 'required name=search_term_string' } } | dump | replace('</', '<\\/') | safe }}</script>
    <link rel="stylesheet" href="{{ 'style.css' | assets }}?v={{ assetv }}"/>
    <link rel="stylesheet" href="{{ 'pages.css' | assets }}?v={{ assetv }}"/>
    {#- GEN-05: html:root أقوى من :root بتاع style.css، فألوان التاجر بتكسب دايمًا (حتى لو ترتيب الملفات اتغيّر).
        الدرجات الفاتحة/الغامقة بتتحسب من اللون، واللون الافتراضي بيسيب درجات الثيم الأصلية -#}
    <style>
      html:root {
        --blk-logo-max: {{ settings.logoMaxWidth | default(160, true) }}px;
        --blk-logo-h: {{ settings.logoHeight | default(40, true) }}px;
        --blk-accent: {{ brand }};
        {% if (brand | lower) != '#c81e1e' %}
        --blk-accent-dark: color-mix(in srgb, {{ brand }} 70%, #000);
        --blk-accent-light: color-mix(in srgb, {{ brand }} 82%, #fff);
        --blk-primary: color-mix(in srgb, {{ brand }} 88%, #fff);
        {% endif %}
        --blk-sale: {{ settings.saleColor | default('#E5484D', true) }};
        --blk-success: {{ settings.successColor | default('#22C55E', true) }};
        --blk-warning: {{ settings.warningColor | default('#F59E0B', true) }};
        --blk-font-display: '{{ fh.family }}', '{{ 'Tajawal' if fh.family == 'Anton' else fb.family }}', sans-serif;
        --blk-font-ar: '{{ fb.family }}', 'Inter', sans-serif;
        --blk-font-body: 'Inter', '{{ fb.family }}', sans-serif;
        --blk-radius-card: {{ settings.cornerRadius if (settings.cornerRadius === 0 or settings.cornerRadius > 0) else 14 }}px;
      }
    </style>
    {% if settings.favicon and settings.favicon.fileUrl %}
    <link rel="icon" href="{{ settings.favicon.fileUrl }}">
    <link rel="apple-touch-icon" href="{{ settings.favicon.fileUrl }}">
    {% endif %}
    {%- if settings.customCSS %}
    <style id="blk-custom-css">{{ settings.customCSS | safe }}</style>
    {%- endif %}
  </head>

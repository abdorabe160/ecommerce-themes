{# الإعدادات بتيجي في widget.data (وwidget.settings احتياطي) #}
{% set s = widget.data or widget.settings or {} %}
{% set isEn = localization and localization.language and localization.language != 'ar' %}
{# لون الهيدر: بيتغيّر بس لو التاجر غيّر لون الهيدر نفسه؛ غير كده بياخد «اللون العام» من إعدادات الثيم (html:root) #}
{% set headerAccent = s.accent_color if (s.accent_color and (s.accent_color | lower) != '#c81e1e') else '' %}
{#- فاضي = لون الثيم (--blk-bg). مايتكتبش فاضي عشان ماتطلعش CSS بايظة -#}
{% set bg = s.bg_color or '' %}
{# اسم المتجر: إعداد الهيدر ← اسم المتجر من المنصة ← BULK #}
{% set storeName = s.store_name or store.name or 'BULK' %}
{# الشعار: صورة الإعداد (media أو لينك نصي) ← شعار المتجر من المنصة لو موجود #}
{% set li = s.logo_image %}
{% set logoUrl = li.fileUrl if (li and li.fileUrl) else (li if (li and li.length) else ((store.logo.fileUrl) if (store and store.logo and store.logo.fileUrl) else '')) %}
{% set storeUrl = (store.url if (store and store.url) else '') | string %}

{# تبديل العملة: قايمة التاجر (أكواد بفاصلة) + اللي المنصة بتبعته. الأزرار بتتركّب في main.js لو فيه عملتين أو أكتر #}
{% set curCode = '' %}
{% if localization and localization.currency and localization.currency.currencyCode %}
  {% set curCode = localization.currency.currencyCode %}
{% elif localization and localization.market and localization.market.targetCurrencyCode %}
  {% set curCode = localization.market.targetCurrencyCode %}
{% endif %}
{% set pcodes = [] %}
{% for c in (localization.availableCurrencies if (localization and localization.availableCurrencies) else []) %}
  {% set code = ((c if (c is string) else (c.currencyCode or c.code or c.currency or '')) | string | upper) %}
  {% if code and pcodes.push(code) %}{% endif %}
{% endfor %}

{# كل قسم في الناف ليه صفحة بمنتجاته (url). الافتراضي صفحات الأقسام الافتراضية (/shop?category=<slug>؛ مش /collections/<slug> لأن المنصة بترجّع 500 لقسم مش موجود في المتجر)، والتاجر يغيّرها من الإعدادات.
   الـ slugs لازم تفضل زي BLK_DEMO_CATEGORIES في assets/pages.js #}
{% set navSections = [
  { label: s.nav_label_1, menu: s.nav_menu_1, cols: s.nav_columns_1, url: s.nav_url_1 | default('/shop?category=men') },
  { label: s.nav_label_2, menu: s.nav_menu_2, cols: s.nav_columns_2, url: s.nav_url_2 | default('/shop?category=pants') },
  { label: s.nav_label_3, menu: s.nav_menu_3, cols: s.nav_columns_3, url: s.nav_url_3 | default('/shop?category=shoes') },
  { label: s.nav_label_4, menu: s.nav_menu_4, cols: s.nav_columns_4, url: s.nav_url_4 | default('/shop?category=accessories') }
] %}
{# GEN-09: «القائمة الرئيسية» من لوحة التحكم (لو اتختارت) بتبقى الناف كله بـ 3 مستويات: العنصر ← أبناؤه ← أحفاده #}
{% set mainMenu = s.main_menu if (s.main_menu and s.main_menu.length) else [] %}
{% if mainMenu | length %}
  {% set navSections = [] %}
  {% for item in mainMenu %}
    {% if item and item.title %}
      {% if navSections.push({ label: item.title, menu: (item.children or item.items or item.subItems or []), cols: '1', url: item.url }) %}{% endif %}
    {% endif %}
  {% endfor %}
{% endif %}

{# GEN-12: اللينكات اللي بتخرج بره المتجر بتفتح في تابة جديدة بـ rel=noopener #}
{% macro linkAttrs(url) -%}
  {%- set u = (url or '') | string -%}
  href="{{ u or '#' }}"{% if ('://' in u) and not (storeUrl and (storeUrl in u)) %} target="_blank" rel="noopener noreferrer"{% endif %}
{%- endmacro %}

{# عنصر قائمة بأبنائه (المستوى التاني) وأحفاده (التالت) جوه القائمة المنسدلة #}
{% macro dropItems(items) -%}
  {%- for item in items -%}
    {%- if item and item.title -%}
      {%- set kids = item.children or item.items or item.subItems or [] -%}
      {%- if kids.length -%}
        <div class="blk-drop-group">
          <a {{ linkAttrs(item.url) }} class="blk-drop-link blk-drop-head">{{ item.title }}</a>
          <ul class="blk-drop-sub">
            {%- for kid in kids -%}{%- if kid and kid.title -%}
              <li><a {{ linkAttrs(kid.url) }} class="blk-drop-link">{{ kid.title }}</a></li>
            {%- endif -%}{%- endfor -%}
          </ul>
        </div>
      {%- else -%}
        <a {{ linkAttrs(item.url) }} class="blk-drop-link">{{ item.title }}</a>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endmacro %}

{# نفس الشجرة في قائمة الموبايل: أكورديون (details) لكل مستوى #}
{% macro sideItems(items) -%}
  {%- for item in items -%}
    {%- if item and item.title -%}
      {%- set kids = item.children or item.items or item.subItems or [] -%}
      {%- if kids.length -%}
        <details class="blk-sidebar-group blk-sidebar-group--sub">
          <summary>{{ item.title }}</summary>
          {% if item.url %}<a {{ linkAttrs(item.url) }} class="blk-sidebar-sublink blk-sidebar-sublink--all">{{ t('common.view_all') }}</a>{% endif %}
          {%- for kid in kids -%}{%- if kid and kid.title -%}
            <a {{ linkAttrs(kid.url) }} class="blk-sidebar-sublink blk-sidebar-sublink--deep">{{ kid.title }}</a>
          {%- endif -%}{%- endfor -%}
        </details>
      {%- else -%}
        <a {{ linkAttrs(item.url) }} class="blk-sidebar-sublink">{{ item.title }}</a>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endmacro %}

{% set announcement = (s.announcement_text_en if (isEn and s.announcement_text_en) else s.announcement_text) or '' %}
<div class="blk-header-wrap{% if s.sticky_header == false %} is-static{% endif %}" id="blkHeaderWrap-{{ widget.id }}">
{% if s.show_announcement == true and announcement %}
  <div class="blk-announcement" data-blk-announcement hidden>
    <div class="blk-announcement-inner">
      {% if s.announcement_link %}
        <a {{ linkAttrs(s.announcement_link) }} class="blk-announcement-text">{% ui "blk-t.njk", text=announcement %}</a>
      {% else %}
        <span class="blk-announcement-text">{% ui "blk-t.njk", text=announcement %}</span>
      {% endif %}
      <button type="button" class="blk-announcement-close" data-blk-announcement-close aria-label="{{t('common.close')}}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </div>
{% endif %}
<header class="blk-header" id="blkHeader-{{ widget.id }}" style="{% if headerAccent %}--blk-accent: {{ headerAccent }}; {% endif %}{% if bg %}--blk-bg: {{ bg }};{% endif %}">
  <div class="blk-bar">
    <div class="blk-row">

      <!-- ===== Start: burger + nav ===== -->
      <div class="blk-start">
        <button type="button" class="blk-icon-btn blk-burger" data-blk="burger-open" aria-label="{{t('common.menu')}}" aria-expanded="false" aria-controls="blkSidebar-{{ widget.id }}">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" d="M3 7h18M3 12h18M3 17h18"/>
          </svg>
        </button>

        <nav class="blk-nav" data-blk="nav" aria-label="{{t('header.main_nav')}}">
          {% for section in navSections %}
            {% if section.label %}
              <div class="blk-nav-item">
                {% if section.menu and section.menu.length %}
                  {# القسم ليه قائمة: زرار بيفتحها، وأول لينك فيها صفحة القسم كله #}
                  <button type="button" class="blk-nav-link" data-nav="{{ loop.index0 }}" aria-expanded="false" aria-haspopup="true">
                    <span>{% ui "blk-t.njk", text=section.label %}</span>
                    <svg class="blk-caret" width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 4.5 6 8l3.5-3.5"/>
                    </svg>
                  </button>
                  <div class="blk-drop" data-drop="{{ loop.index0 }}">
                    <div class="blk-drop-inner" style="--cols:{{ section.cols | default('1') }}">
                      {% if section.url %}<a {{ linkAttrs(section.url) }} class="blk-drop-link blk-drop-all">{{t('common.view_all')}}</a>{% endif %}
                      {{ dropItems(section.menu) }}
                    </div>
                  </div>
                {% elif section.url %}
                  {# من غير قائمة: اسم القسم لينك لصفحة منتجاته #}
                  <a {{ linkAttrs(section.url) }} class="blk-nav-link" data-nav-page>{% ui "blk-t.njk", text=section.label %}</a>
                {% else %}
                  <span class="blk-nav-link">{% ui "blk-t.njk", text=section.label %}</span>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </nav>
      </div>

      <!-- ===== Center: brand ===== -->
      <a href="/" class="blk-brand" aria-label="{{ storeName }}">
        {# media بيرجع object فيه fileUrl (زي الفوتر)، والنص احتياطي #}
        {% if logoUrl %}
          <img src="{{ logoUrl }}" alt="{{ storeName }}" class="blk-logo-img" height="40">
        {% else %}
          <span class="blk-wordmark" title="{{ storeName }}">{{ storeName }}</span>
        {% endif %}
      </a>

      <!-- ===== End: search + actions ===== -->
      <div class="blk-end">

        <button type="button" class="blk-search-trigger" data-blk="search-open" aria-label="{{t('search.input_aria')}}">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m20 20-3.9-3.9"/>
          </svg>
          <span class="blk-search-text">{% ui "blk-t.njk", text=s.search_trigger_text, key="defaults.search_trigger" %}</span>
        </button>

        {% if s.support_url and s.support_url != '#' %}
          <a {{ linkAttrs(s.support_url) }} class="blk-icon-btn blk-desk blk-wide-only" aria-label="{{t('common.support')}}">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M4 13a8 8 0 0 1 16 0"/>
              <rect x="3.5" y="13" width="4" height="6" rx="1.5"/>
              <rect x="16.5" y="13" width="4" height="6" rx="1.5"/>
            </svg>
          </a>
        {% endif %}

        {% if s.show_currency != false %}
          {# GEN-15: أزرار العملات بتتركّب من main.js (blkMountCurrency) لو فيه عملتين أو أكتر #}
          <div class="blk-currency-host blk-desk" data-currency-host hidden
            data-currencies="{{ (s.currencies or '') | trim }}" data-platform="{{ pcodes | join(',') }}"
            data-current="{{ curCode }}" aria-label="{{t('header.currency')}}"></div>
        {% endif %}

        {# تبديل اللغة: main.js بيحط كوكي lang (المنصة بتعرض الصفحة باللغة دي) ويعيد التحميل #}
        <a href="#" class="blk-lang-btn" data-blk-lang="{{t('common.switch_language_code')}}" lang="{{t('common.switch_language_code')}}" aria-label="{{t('common.switch_language_aria')}}">{{t('common.switch_language')}}</a>

        {% if settings.showWishlist !== false %}
          <a href="/wishlist" class="blk-icon-btn blk-wish-btn blk-desk" aria-label="{{t('header.wishlist')}}">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"/></svg>
            <span class="blk-count blk-wish-count" data-wish-count {% if not (wishlist and wishlist.count) %}hidden{% endif %}>{{ wishlist.count if (wishlist and wishlist.count) else 0 }}</span>
          </a>
        {% endif %}

        {# السلة: الدروار بيفتح بالضغط (CART-11)، ولو الـ JS ماشتغلش اللينك بيروح /cart #}
        {# العدد والإجمالي بيتحدّثوا من main.js (blkApplyCart) بعد أي إضافة أو تعديل #}
        <a href="/cart" class="blk-icon-btn blk-cart-btn{% if not cart.totalQuantity %} is-empty{% endif %}" data-blk-cart-open aria-label="{{t('common.cart')}}">
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2.2 2.8h3l2.2 11a1.7 1.7 0 0 0 1.7 1.4h8.1a1.7 1.7 0 0 0 1.7-1.4l1.5-7.5H6.2"/>
            <circle cx="9.4" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/>
          </svg>
          <span class="blk-count" aria-live="polite">{{ cart.totalQuantity | default(0) }}</span>
          <span class="blk-cart-total" data-cart-total-price>{% set headerCartTotal = (cart.totalPrice if cart else 0) or 0 %}{% ui "blk-price.njk", amount=headerCartTotal %}</span>
        </a>

      </div>

    </div>
  </div>
</header>
</div>

<!-- ===== Search overlay ===== -->
<div class="blk-search-overlay" data-blk="search-overlay" role="dialog" aria-modal="true" aria-label="{{t('search.input_aria')}}">
  <div class="blk-search-panel" data-blk="search-panel">
    {# Enter بيودّي صفحة /search?q=... #}
    <form class="blk-search-panel-inner" action="/search" method="get" role="search">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m20 20-3.9-3.9"/>
      </svg>
      <input type="search" name="q" data-blk="search-input" class="blk-search-input" aria-label="{{t('search.input_aria')}}" placeholder="{% ui "blk-t.njk", text=s.search_input_placeholder, key="defaults.search_placeholder" %}" autocomplete="off" required>
      <button type="button" class="blk-search-close" data-blk="search-close" aria-label="{{t('common.close')}}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/>
        </svg>
      </button>
    </form>
    {# اقتراحات فورية من البحث الذكي (pages.js: initSearchSuggest) #}
    <div class="blk-search-suggest" data-blk-search-suggest aria-live="polite" hidden></div>
  </div>
</div>

<!-- ===== Mobile sidebar ===== -->
<div class="blk-sidebar-overlay" data-blk="sidebar-overlay"></div>
<aside class="blk-sidebar" data-blk="sidebar" id="blkSidebar-{{ widget.id }}" aria-label="{{t('common.menu')}}">
  <div class="blk-sidebar-head">
    <span class="blk-wordmark">{{ storeName }}</span>
    <button type="button" class="blk-icon-btn" data-blk="sidebar-close" aria-label="{{t('common.close')}}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/>
      </svg>
    </button>
  </div>
  <nav class="blk-sidebar-nav" aria-label="{{t('header.main_nav')}}">
    {% for section in navSections %}
      {% if section.label %}
        {% if section.menu and section.menu.length %}
          {# على الموبايل القسم بيفتح ويعرض روابطه (أكورديون بنفس المستويات) #}
          <details class="blk-sidebar-group">
            <summary>{% ui "blk-t.njk", text=section.label %}</summary>
            {% if section.url %}<a {{ linkAttrs(section.url) }} class="blk-sidebar-sublink blk-sidebar-sublink--all">{{t('common.view_all')}}</a>{% endif %}
            {{ sideItems(section.menu) }}
          </details>
        {% elif section.url %}
          <a {{ linkAttrs(section.url) }} data-nav-page>{% ui "blk-t.njk", text=section.label %}</a>
        {% else %}
          <span class="blk-sidebar-label">{% ui "blk-t.njk", text=section.label %}</span>
        {% endif %}
      {% endif %}
    {% endfor %}
    <div class="blk-sidebar-extra">
      {% if settings.showWishlist !== false %}
        <a href="/wishlist">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"/></svg>
          <span>{{t('header.wishlist')}}</span>
        </a>
      {% endif %}
      {% if s.support_url and s.support_url != '#' %}
        <a {{ linkAttrs(s.support_url) }}>{{t('common.support')}}</a>
      {% endif %}
      <a href="/cart">{{t('common.cart_page')}}</a>
      {% if s.show_currency != false %}
        <div class="blk-currency-host blk-currency-host--side" data-currency-host hidden
          data-currencies="{{ (s.currencies or '') | trim }}" data-platform="{{ pcodes | join(',') }}"
          data-current="{{ curCode }}" aria-label="{{t('header.currency')}}"></div>
      {% endif %}
      {# تبديل اللغة (الموبايل) #}
      <a href="#" class="blk-sidebar-lang" data-blk-lang="{{t('common.switch_language_code')}}" lang="{{t('common.switch_language_code')}}">{{t('common.switch_language')}}</a>
    </div>
  </nav>
</aside>

<script>
(function () {
  var root = document.getElementById('blkHeader-{{ widget.id }}');
  if (!root) return;
  var wrap = document.getElementById('blkHeaderWrap-{{ widget.id }}');

  /* ===== 0) شريط الإعلان: بيتقفل ويفضل مقفول طول الجلسة (HOME-09) ===== */
  var ann = wrap && wrap.querySelector('[data-blk-announcement]');
  if (ann) {
    var shut = false;
    try { shut = sessionStorage.getItem('blk-ann-closed') === '1'; } catch (e) { /* التخزين مقفول */ }
    ann.hidden = shut;
    var annClose = ann.querySelector('[data-blk-announcement-close]');
    if (annClose) annClose.addEventListener('click', function () {
      ann.hidden = true;
      try { sessionStorage.setItem('blk-ann-closed', '1'); } catch (e) { /* التخزين مقفول */ }
    });
  }

  /* ===== 1) Sticky shape on scroll ===== */
  var bar = root.querySelector('.blk-bar');
  function updateBarShape() {
    if (window.scrollY <= 4) {
      bar.classList.remove('is-float');
    } else {
      bar.classList.add('is-float');
    }
  }
  var ticking = false;
  window.addEventListener('scroll', function () {
    if (!ticking) {
      requestAnimationFrame(function () {
        updateBarShape();
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });
  updateBarShape();

  /* ===== 1.5) الناف كبير على المساحة (اسم متجر طويل / عناصر كتير / 1024–1279):
     الشعار بيروح للبداية والناف بياخد النص بدل ما يركب على الشعار (RSP-05 / GEN-20) ===== */
  var row = root.querySelector('.blk-row');
  var startCol = root.querySelector('.blk-start');
  var navEl = root.querySelector('.blk-nav');
  function fitNav() {
    if (!row || !navEl || !startCol) return;
    row.classList.remove('is-compact', 'is-tight');
    if (window.innerWidth < 1024) return;
    if (navEl.scrollWidth > startCol.clientWidth + 1) row.classList.add('is-compact');
    if (row.classList.contains('is-compact') && navEl.scrollWidth > navEl.clientWidth + 1) row.classList.add('is-tight');
  }
  fitNav();
  window.addEventListener('resize', function () { clearTimeout(fitNav.t); fitNav.t = setTimeout(fitNav, 120); });
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(fitNav);

  /* ===== 2) Nav dropdown (click + hover على الكمبيوتر) ===== */
  var navItems = root.querySelectorAll('.blk-nav-item');

  function closeAllNav() {
    navItems.forEach(function (item) {
      var btn = item.querySelector('.blk-nav-link');
      var drop = item.querySelector('.blk-drop');
      if (btn) { btn.classList.remove('is-open'); if (btn.hasAttribute('aria-expanded')) btn.setAttribute('aria-expanded', 'false'); }
      if (drop) drop.classList.remove('is-open');
    });
  }

  // GEN-09: القائمة المنسدلة بتفضل جوه الشاشة (لو هتخرج من أي ناحية بتتزق لجوه)
  function keepInView(drop) {
    drop.style.removeProperty('--blk-drop-shift');
    var r = drop.getBoundingClientRect();
    var vw = document.documentElement.clientWidth;
    var shift = 0;
    if (r.right > vw - 8) shift = (vw - 8) - r.right;
    if (r.left + shift < 8) shift = 8 - r.left;
    if (shift) drop.style.setProperty('--blk-drop-shift', shift + 'px');
  }

  function openNav(item) {
    var btn = item.querySelector('.blk-nav-link');
    var drop = item.querySelector('.blk-drop');
    if (!drop) return;
    closeAllNav();
    btn.classList.add('is-open');
    btn.setAttribute('aria-expanded', 'true');
    drop.classList.add('is-open');
    keepInView(drop);
  }

  var canHover = window.matchMedia && window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  var leaveTimer;
  navItems.forEach(function (item) {
    var btn = item.querySelector('.blk-nav-link');
    var drop = item.querySelector('.blk-drop');
    if (!btn) return;

    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      if (!drop) return;
      if (btn.classList.contains('is-open')) closeAllNav(); else openNav(item);
    });
    if (drop && canHover) {
      item.addEventListener('mouseenter', function () { clearTimeout(leaveTimer); openNav(item); });
      item.addEventListener('mouseleave', function () { leaveTimer = setTimeout(closeAllNav, 180); });
    }
  });

  document.addEventListener('click', function (e) {
    if (!root.contains(e.target)) closeAllNav();
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeAllNav();
  });

  /* ===== 2.5) لينك القسم المفتوح حالياً بيتلوّن ===== */
  document.querySelectorAll('[data-nav-page]').forEach(function (link) {
    try {
      // نفس الصفحة ونفس القسم (كل الأقسام الافتراضية على /shop وبيفرق بينها ?category=)
      var url = new URL(link.href, window.location.origin);
      var here = new URLSearchParams(window.location.search);
      if (url.pathname === window.location.pathname && (url.searchParams.get('category') || '') === (here.get('category') || '')) {
        link.classList.add('is-active');
        link.setAttribute('aria-current', 'page');
      }
    } catch (err) { /* لينك مش صالح */ }
  });

  /* ===== 3) Search overlay ===== */
  var searchOverlay = document.querySelector('[data-blk="search-overlay"]');
  var searchInput = document.querySelector('[data-blk="search-input"]');
  var searchOpenBtn = root.querySelector('[data-blk="search-open"]');
  var searchCloseBtn = document.querySelector('[data-blk="search-close"]');

  function openSearch() {
    if (!searchOverlay) return;
    searchOverlay.classList.add('is-open');
    document.documentElement.classList.add('blk-no-scroll');
    setTimeout(function () {
      if (searchInput) searchInput.focus();
    }, 50);
  }
  function closeSearch() {
    if (!searchOverlay) return;
    var wasOpen = searchOverlay.classList.contains('is-open');
    searchOverlay.classList.remove('is-open');
    document.documentElement.classList.remove('blk-no-scroll');
    // التركيز يرجع للزرار اللي فتح البحث (لوحة المفاتيح وقارئ الشاشة)
    if (wasOpen && searchOpenBtn) searchOpenBtn.focus();
  }

  if (searchOpenBtn) searchOpenBtn.addEventListener('click', openSearch);
  if (searchCloseBtn) searchCloseBtn.addEventListener('click', closeSearch);

  if (searchOverlay) {
    searchOverlay.addEventListener('click', function (e) {
      if (e.target === searchOverlay) closeSearch();
    });
  }

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && searchOverlay && searchOverlay.classList.contains('is-open')) {
      closeSearch();
    }
  });

  /* ===== 4) Mobile sidebar (GEN-10: زرار، برّه، Esc — والخلفية مابتتحركش) ===== */
  var sidebar = document.querySelector('[data-blk="sidebar"]');
  var sidebarOverlay = document.querySelector('[data-blk="sidebar-overlay"]');
  var burgerBtn = root.querySelector('[data-blk="burger-open"]');
  var sidebarCloseBtn = document.querySelector('[data-blk="sidebar-close"]');

  function openSidebar() {
    if (!sidebar || !sidebarOverlay) return;
    sidebar.classList.add('is-open');
    sidebarOverlay.classList.add('is-open');
    document.documentElement.classList.add('blk-no-scroll');
    if (burgerBtn) burgerBtn.setAttribute('aria-expanded', 'true');
    // التركيز ينتقل جوه القائمة (زرار الإغلاق)
    if (sidebarCloseBtn) setTimeout(function () { sidebarCloseBtn.focus(); }, 50);
  }
  function closeSidebar() {
    if (!sidebar || !sidebarOverlay) return;
    var wasOpen = sidebar.classList.contains('is-open');
    sidebar.classList.remove('is-open');
    sidebarOverlay.classList.remove('is-open');
    document.documentElement.classList.remove('blk-no-scroll');
    if (burgerBtn) burgerBtn.setAttribute('aria-expanded', 'false');
    if (wasOpen && burgerBtn) burgerBtn.focus();
  }

  if (burgerBtn) burgerBtn.addEventListener('click', openSidebar);
  if (sidebarCloseBtn) sidebarCloseBtn.addEventListener('click', closeSidebar);
  if (sidebarOverlay) sidebarOverlay.addEventListener('click', closeSidebar);

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && sidebar && sidebar.classList.contains('is-open')) {
      closeSidebar();
    }
  });
  // الشاشة كبرت لحجم الكمبيوتر والقائمة مفتوحة: نقفلها عشان التمرير يرجع
  window.addEventListener('resize', function () {
    if (window.innerWidth >= 1024 && sidebar && sidebar.classList.contains('is-open')) closeSidebar();
  });
})();
</script>

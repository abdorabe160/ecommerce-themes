{#- Dark Blood — نموذج التواصل (CNT-06).
    قمرة مابتوفّرش endpoint لرسائل التواصل في المتجر، فالنموذج بيتبعت لرابط التاجر (Formspree / Getform…)
    أو بيفتح بريد العميل لإيميل المتجر لو مفيش رابط. من غير الاتنين بتظهر بيانات التواصل بس — مفيش نموذج بيروح لمكان مش موجود.
    التحقق (الاسم، الإيميل، الرسالة) في pages.js ([data-blk-contact]) برسالة تحت كل حقل -#}
{%- set wd = widget.data if (widget.data and (widget.data | length)) else (widget.settings or {}) -%}
{%- set L = '_en' if (localization and localization.language and localization.language != 'ar') else '' -%}
{%- set ht = 'h1' if wd.heading_tag == 'h1' else 'h2' -%}
{%- set title = (wd['title' + L] or wd.title) or t('contact.title') -%}
{%- set text = (wd['text' + L] or wd.text) or t('contact.text') -%}
{%- set action = (wd.form_action or '') | trim -%}
{%- set btn = (wd['button_text' + L] or wd.button_text) or t('contact.send') -%}
{%- set hasForm = action | length > 0 -%}
{%- set hasMail = not hasForm and settings.contactEmail -%}
{%- set address = settings['contactAddress' + L] or settings.contactAddress -%}
<section class="blk-section blk-contact" id="blkContact-{{ widget.id }}">
  <div class="blk-container">
    <div class="blk-contact-grid{% if not (hasForm or hasMail) %} is-solo{% endif %}">
      <div class="blk-contact-info">
        <{{ ht }} class="blk-section-title blk-contact-title">{{ title }}</{{ ht }}>
        {% if text %}<p class="blk-contact-text">{{ text }}</p>{% endif %}
        {% if settings.contactPhone or settings.contactEmail or address %}
          <ul class="blk-contact-details">
            {% if settings.contactPhone %}
              <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg><a href="tel:{{ settings.contactPhone | replace(' ', '') }}" dir="ltr">{{ settings.contactPhone }}</a></li>
            {% endif %}
            {% if settings.contactEmail %}
              <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg><a href="mailto:{{ settings.contactEmail }}">{{ settings.contactEmail }}</a></li>
            {% endif %}
            {% if address %}
              <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><span>{{ address }}</span></li>
            {% endif %}
          </ul>
        {% elif not (hasForm or hasMail) %}
          <p class="blk-contact-text">{{ t('contact.no_details') }}</p>
        {% endif %}
      </div>

      {% if hasForm or hasMail %}
        <form class="blk-contact-form" method="post" novalidate data-blk-contact
          {% if hasForm %} action="{{ action }}" target="_blank"{% else %} action="mailto:{{ settings.contactEmail }}" enctype="text/plain"{% endif %}>
          <div class="blk-contact-row">
            <div class="blk-field">
              <label for="blkContactName-{{ widget.id }}">{{ t('contact.name') }}</label>
              <input id="blkContactName-{{ widget.id }}" class="blk-input" type="text" name="name" autocomplete="name" required minlength="2" data-contact-field="name">
              <p class="blk-field-error" role="alert" hidden>{{ t('contact.name_error') }}</p>
            </div>
            <div class="blk-field">
              <label for="blkContactEmail-{{ widget.id }}">{{ t('contact.email') }}</label>
              <input id="blkContactEmail-{{ widget.id }}" class="blk-input" type="email" name="email" autocomplete="email" required inputmode="email" dir="ltr" data-contact-field="email">
              <p class="blk-field-error" role="alert" hidden>{{ t('contact.email_error') }}</p>
            </div>
          </div>
          <div class="blk-field">
            <label for="blkContactMsg-{{ widget.id }}">{{ t('contact.message') }}</label>
            <textarea id="blkContactMsg-{{ widget.id }}" class="blk-input blk-contact-textarea" name="message" rows="6" required minlength="10" data-contact-field="message"></textarea>
            <p class="blk-field-error" role="alert" hidden>{{ t('contact.message_error') }}</p>
          </div>
          <button type="submit" class="blk-btn blk-btn-primary">{{ btn }}</button>
          {#- مفيش رسالة «اتبعتت» من عندنا: مع البريد الإرسال بيحصل من برنامج العميل، ومع الرابط الخدمة نفسها بتأكد في التبويب الجديد -#}
          <p class="blk-contact-note">{{ t('contact.mail_note') if hasMail else t('contact.form_note') }}</p>
        </form>
      {% endif %}
    </div>
  </div>
</section>

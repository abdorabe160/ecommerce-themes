{
  "name": "سلايدر وصل حديثاً - New Arrivals",
  "description": "سلايدر لأحدث المنتجات اللي نزلت: شارة \"جديد\" على كل منتج، تابات فلترة، صورة تانية عند الـ Hover، وشريط المخزون",
  "settings": {
    "badge_text": {
      "type": "string",
      "label": "نص الشارة المضيئة فوق العنوان",
      "default": "لسه نازل"
    },
    "title": {
      "type": "string",
      "label": "عنوان القسم",
      "default": "وصل حديثاً"
    },
    "products": {
      "type": "products",
      "label": "اختر المنتجات الجديدة"
    },
    "use_store_products": {
      "type": "boolean",
      "label": "اعرض منتجات المتجر بدل المنتجات الافتراضية (لو مقفول بتظهر المنتجات الافتراضية)",
      "default": false
    },
    "store_sort": {
      "type": "select",
      "label": "ترتيب منتجات المتجر",
      "options": [
        {
          "label": "الافتراضي",
          "value": ""
        },
        {
          "label": "الأحدث أولاً",
          "value": "created-desc"
        },
        {
          "label": "الأعلى تقييماً",
          "value": "rating-desc"
        },
        {
          "label": "السعر: من الأقل للأعلى",
          "value": "price-asc"
        },
        {
          "label": "السعر: من الأعلى للأقل",
          "value": "price-desc"
        }
      ],
      "default": "created-desc"
    },
    "products_limit": {
      "type": "number",
      "label": "أقصى عدد منتجات في السلايدر",
      "default": 8,
      "min": 2,
      "max": 16,
      "step": 1
    },
    "enable_tabs": {
      "type": "boolean",
      "label": "تفعيل تابات الفلترة أعلى السلايدر",
      "default": true
    },
    "tabs_list": {
      "type": "string",
      "label": "أسماء التابات (افصل بينها بفاصلة، وأول تاب بيعرض الكل)",
      "default": "الكل, ملابس, أحذية"
    },
    "show_new_badge": {
      "type": "boolean",
      "label": "إظهار شارة \"جديد\" على المنتجات",
      "default": true
    },
    "new_badge_text": {
      "type": "string",
      "label": "نص شارة الجديد",
      "default": "جديد"
    },
    "show_secondary_image": {
      "type": "boolean",
      "label": "إظهار الصورة التانية عند الـ Hover",
      "default": true
    },
    "show_quick_view": {
      "type": "boolean",
      "label": "إظهار زر المعاينة السريعة",
      "default": true
    },
    "show_rating": {
      "type": "boolean",
      "label": "إظهار التقييم (النجوم) للمنتجات اللي عليها تقييمات",
      "default": true
    },
    "show_stock_urgency": {
      "type": "boolean",
      "label": "إظهار شريط \"أوشك على النفاد\" (3 قطع أو أقل)",
      "default": true
    }
  },
  "presets": [
    {
      "name": "سلايدر وصل حديثاً (Dark Blood)",
      "category": "homepage"
    }
  ]
}

{# =========================================================
   Dark Blood - الفوتر
   ========================================================= #}
{% set s = widget.data or widget.settings or {} %}
{% set storeName = s.store_name or store.name or 'BULCK' %}
{# الشبكات: إعداد الفوتر ← إعدادات الثيم العامة (التواصل والشبكات الاجتماعية) #}
{% set waRaw = (s.whatsapp_url or settings.socialWhatsapp or '') | string | trim %}
{% set waDigits = waRaw | replace('+', '') | replace(' ', '') | replace('-', '') %}
{% set waUrl = waRaw if ('://' in waRaw) else (('https://wa.me/' + waDigits) if waDigits else '') %}
{% set socials = [
  { key: 'facebook',  url: s.facebook_url or settings.socialFacebook,  label: t('common.facebook') },
  { key: 'instagram', url: s.instagram_url or settings.socialInstagram, label: t('common.instagram') },
  { key: 'tiktok',    url: s.tiktok_url or settings.socialTiktok,    label: t('common.tiktok') },
  { key: 'x',         url: settings.socialX,         label: t('common.x') },
  { key: 'youtube',   url: settings.socialYoutube,   label: t('common.youtube') },
  { key: 'snapchat',  url: settings.socialSnapchat,  label: t('common.snapchat') },
  { key: 'whatsapp',  url: waUrl,  label: t('common.whatsapp') }
] %}
{% set storeUrl = (store.url if (store and store.url) else '') | string %}
{% set isEn = localization and localization.language and localization.language != 'ar' %}
{% set fPhone = s.phone or settings.contactPhone %}
{% set fEmail = s.email or settings.contactEmail %}
{% set fAddress = s.address or ((settings.contactAddress_en or settings.contactAddress) if isEn else settings.contactAddress) %}

{# روابط الفوتر من غير تكرار: نفس الرابط مابيظهرش مرتين حتى لو القائمتين فيهم نفس العناصر
   (أو نفس القائمة اتختارت مرتين)، والعمود اللي مالوش روابط بيتخفي بعنوانه #}
{% set seenLinks = [] %}
{% set menu1Items = [] %}
{% for item in s.menu_1 or [] %}
  {% if item and item.title %}
    {% set linkKey = ((item.url or item.title) | string | trim | lower) %}
    {% if not (linkKey in seenLinks) %}{% if seenLinks.push(linkKey) %}{% endif %}{% if menu1Items.push(item) %}{% endif %}{% endif %}
  {% endif %}
{% endfor %}
{% set menu2Items = [] %}
{% for item in s.menu_2 or [] %}
  {% if item and item.title %}
    {% set linkKey = ((item.url or item.title) | string | trim | lower) %}
    {% if not (linkKey in seenLinks) %}{% if seenLinks.push(linkKey) %}{% endif %}{% if menu2Items.push(item) %}{% endif %}{% endif %}
  {% endif %}
{% endfor %}
{% set hasContact = fPhone or fEmail or fAddress %}
{# عدد الأعمدة الظاهرة عشان الشبكة ماتسيبش أماكن فاضية مكان العمود المخفي #}
{% set footerCols = (1 if (menu1Items | length) else 0) + (1 if (menu2Items | length) else 0) + (1 if hasContact else 0) %}

<footer class="blk-footer" id="blkFooter-{{ widget.id }}">
  <div class="blk-footer-glow" aria-hidden="true"></div>

  {% if s.show_features != false %}
    <div class="blk-container">
      <ul class="blk-footer-features">
        <li>
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 3h15v13H1zM16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <div><strong>{% ui "blk-t.njk", text=s.feature_1_title, key="defaults.footer_f1_title" %}</strong><span>{% ui "blk-t.njk", text=s.feature_1_text, key="defaults.footer_f1_text" %}</span></div>
        </li>
        <li>
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
          <div><strong>{% ui "blk-t.njk", text=s.feature_2_title, key="defaults.footer_f2_title" %}</strong><span>{% ui "blk-t.njk", text=s.feature_2_text, key="defaults.footer_f2_text" %}</span></div>
        </li>
        <li>
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <div><strong>{% ui "blk-t.njk", text=s.feature_3_title, key="defaults.footer_f3_title" %}</strong><span>{% ui "blk-t.njk", text=s.feature_3_text, key="defaults.footer_f3_text" %}</span></div>
        </li>
        <li>
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 13a8 8 0 0 1 16 0"/><rect x="3.5" y="13" width="4" height="6" rx="1.5"/><rect x="16.5" y="13" width="4" height="6" rx="1.5"/></svg>
          <div><strong>{% ui "blk-t.njk", text=s.feature_4_title, key="defaults.footer_f4_title" %}</strong><span>{% ui "blk-t.njk", text=s.feature_4_text, key="defaults.footer_f4_text" %}</span></div>
        </li>
      </ul>
    </div>
  {% endif %}

  <div class="blk-container blk-footer-main" style="--blk-footer-cols: {{ footerCols if footerCols > 0 else 1 }};">
    <div class="blk-footer-brand">
      <a href="/" class="blk-brand" aria-label="{{ storeName }}">
        {% if s.logo_image %}
          <img src="{{ s.logo_image.fileUrl | default(s.logo_image) }}" alt="{{ storeName }}" class="blk-logo-img" loading="lazy">
        {% else %}
          <span class="blk-wordmark">{{ storeName }}</span>
        {% endif %}
      </a>
      {% set aboutText = s.about_text or store.description %}
      <p>{% ui "blk-t.njk", text=aboutText, key="defaults.footer_about", html=true %}</p>

      <div class="blk-footer-social">
        {% for social in socials %}
          {% if social.url %}
            <a href="{{ social.url }}" class="blk-icon-btn" target="_blank" rel="noopener noreferrer" aria-label="{{ social.label }}">
              {% if social.key == 'facebook' %}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M14 9h3V5h-3c-2.8 0-4 1.7-4 4v2H8v4h2v8h4v-8h3l1-4h-4V9.5c0-.3.2-.5.5-.5z"/></svg>
              {% elif social.key == 'instagram' %}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
              {% elif social.key == 'x' %}
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.3L5.3 21H2.2l7.2-8.3L2 3h6.4l4.4 5.8L17.8 3zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5z"/></svg>
              {% elif social.key == 'youtube' %}
                <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8zM9.7 15.1V8.9l5.8 3.1-5.8 3.1z"/></svg>
              {% elif social.key == 'snapchat' %}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2c3 0 5.4 2.3 5.4 5.3v2.3c.5.2 1.1 0 1.6-.2.6-.2 1.2.4.8 1-.4.6-1.6.9-2.2 1.2.6 1.8 2 3.2 3.9 3.8.5.2.4.9-.1 1.1-.7.2-1.5.4-1.8.7-.2.4-.1 1-.6 1.2-.7.2-1.6-.3-2.7 0-1.1.3-1.9 1.6-4.3 1.6s-3.2-1.3-4.3-1.6c-1.1-.3-2 .2-2.7 0-.5-.2-.4-.8-.6-1.2-.3-.3-1.1-.5-1.8-.7-.5-.2-.6-.9-.1-1.1 1.9-.6 3.3-2 3.9-3.8-.6-.3-1.8-.6-2.2-1.2-.4-.6.2-1.2.8-1 .5.2 1.1.4 1.6.2V7.3C6.6 4.3 9 2 12 2z"/></svg>
              {% elif social.key == 'tiktok' %}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 3c.4 2.2 1.8 3.7 4 4v3.2c-1.5 0-2.9-.5-4-1.2v6.5a6 6 0 1 1-6-6h.5v3.3a2.8 2.8 0 1 0 2.3 2.7V3h3.2z"/></svg>
              {% else %}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.3 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.2.1.6-.1 1.2z"/></svg>
              {% endif %}
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {% if menu1Items | length %}
      <div class="blk-footer-col">
        <h4 class="blk-footer-title">{% ui "blk-t.njk", text=s.menu_1_title, key="defaults.footer_menu_1" %}</h4>
        <ul>
          {% for item in menu1Items %}
            <li><a href="{{ item.url }}"{% if ('://' in (item.url | string)) and not (storeUrl and (storeUrl in (item.url | string))) %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ item.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    {% if menu2Items | length %}
      <div class="blk-footer-col">
        <h4 class="blk-footer-title">{% ui "blk-t.njk", text=s.menu_2_title, key="defaults.footer_menu_2" %}</h4>
        <ul>
          {% for item in menu2Items %}
            <li><a href="{{ item.url }}"{% if ('://' in (item.url | string)) and not (storeUrl and (storeUrl in (item.url | string))) %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ item.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    {% if hasContact %}
    <div class="blk-footer-col">
      <h4 class="blk-footer-title">{% ui "blk-t.njk", text=s.contact_title, key="defaults.footer_contact" %}</h4>
      <ul class="blk-footer-contact">
        {% if fPhone %}
          <li><a href="tel:{{ fPhone | replace(' ', '') }}" dir="ltr">{{ fPhone }}</a></li>
        {% endif %}
        {% if fEmail %}
          <li><a href="mailto:{{ fEmail }}">{{ fEmail }}</a></li>
        {% endif %}
        {% if fAddress %}
          <li>{{ fAddress }}</li>
        {% endif %}
      </ul>
    </div>
    {% endif %}
  </div>

  <div class="blk-footer-bottom">
    <div class="blk-container blk-footer-bottom-inner">
      <span>© <span data-blk-year>{{ s.copyright_year }}</span> {{ storeName }}. {% ui "blk-t.njk", text=s.copyright_text, key="defaults.footer_copyright" %}</span>
      {#- طرق الدفع بيكتبها التاجر؛ النص التجريبي القديم (كاش • فيزا • ماستركارد) مابيظهرش -#}
      {% if s.payment_text and s.payment_text != 'كاش عند الاستلام • فيزا • ماستركارد' %}
        <span class="blk-footer-pay">{% ui "blk-t.njk", text=s.payment_text %}</span>
      {% endif %}
    </div>
  </div>
</footer>

<!-- =========================================================
     QMRA THEME (NUNJUCKS) - PROMO BANNER WIDGET
     بانر عرض لنص الصفحة: رقم ضخم بيتملي، كود خصم، عداد، وشريطين متحركين
     ========================================================= -->
{% set s = widget.data or widget.settings or {} %}
{% set bgImg = s.image.fileUrl | default(s.image) if s.image else 'https://images.pexels.com/photos/2261477/pexels-photo-2261477.jpeg?auto=compress&cs=tinysrgb&w=1600' %}
{% set bigText = s.big_text | default('NEW') %}
{% set showMarquee = s.show_marquee !== false %}
{#- مفيش كود خصم افتراضي: الكود بيظهر بس لو التاجر كتبه -#}
{% set couponCode = s.coupon_code or '' %}
{# النص الافتراضي بيتترجم، واللي التاجر كتبه بيفضل زي ما هو #}
{% set marqueeText = s.marquee_text if (s.marquee_text and s.marquee_text != 'شحن سريع لكل المحافظات • استبدال مجاني خلال 14 يوم • دفع عند الاستلام' and s.marquee_text != 'اتمرّن بقوة • البس بثقة • خليك على مستوى تاني') else t('defaults.promo_marquee') %}

{#- كل نص لازم يملا عرض الشاشة كله (حتى 2560px) وإلا بيبان فراغ في آخر اللفة: عدد التكرار حسب طول النص -#}
{% set mqLen = (marqueeText | length) or 1 %}
{% set mqReps = ((360 / mqLen) | round(0, 'ceil')) | int %}
{% set mqReps = 3 if mqReps < 3 else (16 if mqReps > 16 else mqReps) %}
{% macro marqueeRow(text, cls, reps) %}
  <div class="blk-pb-marquee {{ cls }}" aria-hidden="true">
    {#- نفس سرعة الحركة القديمة (حوالي 5 حروف في الثانية) مهما زاد التكرار -#}
    <div class="blk-pb-marquee-track" style="animation-duration: {{ (((text | length) * reps) / 5.25) | round(0) }}s;">
      {% for half in range(2) %}
        <div class="blk-pb-marquee-group">
          {% for rep in range(reps) %}
            {% for part in text.split('•') %}
              {% if part | trim %}
                <span class="blk-pb-marquee-item">{{ part | trim }}</span>
                <svg class="blk-pb-marquee-sep" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 1c1 7 4 10 11 11-7 1-10 4-11 11-1-7-4-10-11-11 7-1 10-4 11-11z"/></svg>
              {% endif %}
            {% endfor %}
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
{% endmacro %}

<section
  class="blk-section blk-pb"
  id="blkPb-{{ widget.id }}"
  {% if s.end_date %}data-end="{{ s.end_date }}"{% endif %}
  {% if s.hide_when_ended %}data-hide-ended{% endif %}
  data-msg-copied="{{t('promo.code_copied')}}" data-msg-copy="{{t('promo.copy_manually')}}">

  {# هدف زر "اكتشف العروض" في الهيرو (رابطه الافتراضي #offers) #}
  <span id="offers" class="blk-pb-anchor" aria-hidden="true"></span>

  {% if showMarquee %}{{ marqueeRow(marqueeText, 'blk-pb-marquee--top', mqReps) }}{% endif %}

  <div class="blk-container">
    <div class="blk-pb-card">
      <div class="blk-pb-bg">
        <img src="{{ bgImg }}" alt="" loading="lazy">
      </div>
      <div class="blk-pb-overlay"></div>
      <div class="blk-pb-stripes"></div>

      <div class="blk-pb-inner">
        <div class="blk-pb-copy">
          {% if s.badge_text | default('جديد الموسم') %}
            <span class="blk-badge-glow blk-pb-reveal" style="--d: 0;">
              <span class="blk-badge-dot"></span>
              {% ui "blk-t.njk", text=s.badge_text, key="defaults.promo_badge" %}
            </span>
          {% endif %}

          <h2 class="blk-pb-title blk-pb-reveal" style="--d: 1;">{% ui "blk-t.njk", text=s.title, key="defaults.promo_title" %}</h2>

          {% if s.subtitle %}
            <p class="blk-pb-sub blk-pb-reveal" style="--d: 2;">{% ui "blk-t.njk", text=s.subtitle, html=true %}</p>
          {% endif %}

          <div class="blk-pb-actions blk-pb-reveal" style="--d: 3;">
            {% if s.button_text | default('تسوق التشكيلة') %}
              <a href="{{ s.button_url | default('/collections') }}" class="blk-btn blk-btn-primary blk-btn-shine">
                {% ui "blk-t.njk", text=s.button_text, key="defaults.promo_button" %}
                <svg class="blk-btn-icon blk-pb-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              </a>
            {% endif %}

            {% if couponCode %}
              <button type="button" class="blk-pb-coupon" data-code="{{ couponCode }}" aria-label="{{t('promo.copy_code')}} {{ couponCode }}">
                <span class="blk-pb-coupon-label">{{t('promo.code')}}</span>
                <span class="blk-pb-coupon-code">{{ couponCode }}</span>
                <span class="blk-pb-coupon-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                </span>
              </button>
            {% endif %}
          </div>
        </div>

        <div class="blk-pb-side">
          <div class="blk-pb-big blk-pb-reveal" style="--d: 1;" data-text="{{ bigText }}">{{ bigText }}</div>

          {% if s.end_date %}
            <div class="blk-pb-countdown blk-pb-reveal" style="--d: 3;" hidden>
              {% for unit in [['d', t('promo.days')], ['h', t('promo.hours')], ['m', t('promo.minutes')], ['s', t('promo.seconds')]] %}
                <div class="blk-pb-unit">
                  <span class="blk-pb-num" data-unit="{{ unit[0] }}">00</span>
                  <span class="blk-pb-unit-label">{{ unit[1] }}</span>
                </div>
              {% endfor %}
            </div>
            <p class="blk-pb-ended" hidden>{{t('promo.ended')}}</p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  {% if showMarquee %}{{ marqueeRow(marqueeText, 'blk-pb-marquee--bottom', mqReps) }}{% endif %}
</section>

<style>
  .blk-pb {
    --pb-ease: cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
  }

  /* مسافة تحت الهيدر الثابت لما الصفحة تنزل للعرض */
  .blk-pb-anchor {
    position: absolute;
    top: 0;
    scroll-margin-top: 100px;
  }

  .blk-pb[hidden],
  .blk-pb [hidden] { display: none !important; }

  /* ---------- Marquee strips ---------- */
  .blk-pb-marquee {
    position: relative;
    z-index: 2;
    overflow: hidden;
    width: 104%;
    margin-inline-start: -2%;
    padding: 12px 0;
    font-family: var(--blk-font-ar);
    font-weight: 800;
    font-size: 15px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .blk-pb-marquee--top {
    background: var(--blk-accent);
    color: #fff;
    transform: rotate(-1.5deg);
    margin-bottom: 40px;
    box-shadow: 0 10px 30px color-mix(in srgb, var(--blk-accent) 35%, transparent);
  }

  .blk-pb-marquee--bottom {
    background: var(--blk-bg-alt);
    color: var(--blk-text-dim);
    border-block: 1px solid var(--blk-border-strong);
    transform: rotate(1.2deg);
    margin-top: 40px;
  }

  .blk-pb-marquee-track {
    display: flex;
    width: max-content;
    animation: blkPbMarquee 40s linear infinite;
  }

  .blk-pb-marquee--bottom .blk-pb-marquee-track { animation-direction: reverse; }
  .blk-pb-marquee:hover .blk-pb-marquee-track { animation-play-state: paused; }

  .blk-pb-marquee-group { display: flex; align-items: center; }
  .blk-pb-marquee-item { padding-inline: 22px; }
  .blk-pb-marquee-sep { flex: none; opacity: 0.6; }

  /* في RTL المحتوى بيكمل ناحية الشمال، فبنزق يمين بنص العرض */
  @keyframes blkPbMarquee {
    to { transform: translateX(calc(var(--pb-dir, 1) * 50%)); }
  }
  [dir="ltr"] .blk-pb { --pb-dir: -1; }

  /* ---------- Card ---------- */
  .blk-pb-card {
    position: relative;
    border-radius: var(--blk-radius-lg);
    overflow: hidden;
    isolation: isolate;
    border: 1px solid color-mix(in srgb, var(--blk-accent) 35%, transparent);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55), 0 0 60px color-mix(in srgb, var(--blk-accent) 12%, transparent);
  }

  .blk-pb-bg {
    position: absolute;
    inset: 0;
    z-index: -3;
  }

  .blk-pb-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.6) contrast(1.1);
    animation: blkSlowZoom 20s ease-in-out infinite alternate;
  }

  .blk-pb-overlay {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(100deg, rgba(10, 10, 10, 0.96) 0%, rgba(10, 10, 10, 0.8) 45%, color-mix(in srgb, var(--blk-accent-dark) 75%, transparent) 100%);
  }

  [dir="rtl"] .blk-pb-overlay {
    background: linear-gradient(260deg, rgba(10, 10, 10, 0.96) 0%, rgba(10, 10, 10, 0.8) 45%, color-mix(in srgb, var(--blk-accent-dark) 75%, transparent) 100%);
  }

  /* خطوط مايلة بتتحرك ببطء */
  .blk-pb-stripes {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: repeating-linear-gradient(-45deg, rgba(255, 255, 255, 0.035) 0 2px, transparent 2px 22px);
    background-size: 200% 200%;
    animation: blkPbStripes 18s linear infinite;
    pointer-events: none;
  }

  @keyframes blkPbStripes {
    to { background-position: 100% 100%; }
  }

  .blk-pb-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: 32px;
    padding: 64px 56px;
  }

  .blk-pb-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .blk-pb-title {
    margin: 0;
    font-size: clamp(28px, 3.6vw, 46px);
    line-height: 1.15;
    color: #fff;
  }

  .blk-pb-sub { margin: 0; max-width: 460px; color: rgba(255, 255, 255, 0.72); }

  .blk-pb-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 8px;
  }

  .blk-pb-actions .blk-btn:hover .blk-pb-arrow { transform: translateX(-4px); }
  [dir="ltr"] .blk-pb-arrow { transform: scaleX(-1); }
  [dir="ltr"] .blk-pb-actions .blk-btn:hover .blk-pb-arrow { transform: scaleX(-1) translateX(-4px); }

  /* ---------- Coupon ---------- */
  .blk-pb-coupon {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px 10px 16px;
    border: 1.5px dashed rgba(255, 255, 255, 0.35);
    border-radius: var(--blk-radius-full);
    background: rgba(255, 255, 255, 0.04);
    color: #fff;
    font-family: var(--blk-font-ar);
    cursor: pointer;
    transition: border-color 0.3s ease, background 0.3s ease, transform 0.3s var(--pb-ease);
  }

  .blk-pb-coupon:hover {
    border-color: var(--blk-accent-light);
    background: color-mix(in srgb, var(--blk-accent) 12%, transparent);
    transform: translateY(-2px);
  }

  .blk-pb-coupon-label { font-size: 12px; color: var(--blk-text-dim); }
  .blk-pb-coupon-code { font-family: var(--blk-font-display); font-size: 18px; letter-spacing: 2px; }

  .blk-pb-coupon-icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--blk-accent);
    transition: transform 0.4s var(--pb-ease);
  }

  .blk-pb-coupon.is-copied { border-color: var(--blk-success); border-style: solid; }
  .blk-pb-coupon.is-copied .blk-pb-coupon-icon { background: var(--blk-success); transform: rotate(360deg); }

  /* ---------- Big text ---------- */
  .blk-pb-side {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }

  .blk-pb-big {
    position: relative;
    font-family: var(--blk-font-display);
    font-size: clamp(96px, 15vw, 210px);
    line-height: 0.9;
    color: transparent;
    -webkit-text-stroke: 2px var(--blk-accent-light);
    direction: ltr;
    user-select: none;
  }

  /* نسخة مليانة فوق الـ outline بتتملي من تحت لفوق */
  .blk-pb-big::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    color: var(--blk-accent);
    -webkit-text-stroke: 0;
    text-shadow: 0 0 40px color-mix(in srgb, var(--blk-accent) 55%, transparent);
    clip-path: inset(0 0 0 0);
    animation: blkPbGlow 3s ease-in-out infinite alternate;
  }

  .blk-pb.is-armed .blk-pb-big::after { clip-path: inset(100% 0 0 0); }
  .blk-pb.is-visible .blk-pb-big::after {
    clip-path: inset(0 0 0 0);
    transition: clip-path 1.4s var(--pb-ease) 0.5s;
  }

  @keyframes blkPbGlow {
    to { text-shadow: 0 0 70px color-mix(in srgb, var(--blk-accent-light) 80%, transparent), 0 0 120px color-mix(in srgb, var(--blk-accent) 30%, transparent); }
  }

  /* ---------- Countdown ---------- */
  .blk-pb-countdown {
    display: flex;
    gap: 10px;
    direction: ltr;
  }

  [dir="rtl"] .blk-pb-countdown { flex-direction: row-reverse; }

  .blk-pb-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    min-width: 70px;
    padding: 12px 8px;
    background: rgba(10, 10, 10, 0.6);
    border: 1px solid var(--blk-border-strong);
    border-radius: var(--blk-radius-md);
    backdrop-filter: blur(6px);
  }

  .blk-pb-num {
    display: inline-block;
    font-family: var(--blk-font-display);
    font-size: 30px;
    line-height: 1;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }

  .blk-pb-num.is-tick { animation: blkPbTick 0.45s var(--pb-ease); }

  @keyframes blkPbTick {
    from { transform: translateY(-40%); opacity: 0; color: var(--blk-accent-light); }
  }

  .blk-pb-unit-label { font-size: 12px; color: var(--blk-text-dim); font-family: var(--blk-font-ar); }
  .blk-pb-ended { margin: 0; color: #fff; font-weight: 700; }

  /* ---------- Reveal ---------- */
  .blk-pb.is-armed .blk-pb-reveal { transform: translateY(24px); }
  .blk-pb.is-armed .blk-pb-card { transform: scale(0.97); }

  .blk-pb.is-visible .blk-pb-card,
  .blk-pb.is-visible .blk-pb-reveal {
    opacity: 1;
    transform: none;
    transition: opacity 0.9s var(--pb-ease), transform 0.9s var(--pb-ease);
  }

  .blk-pb.is-visible .blk-pb-reveal { transition-delay: calc(0.25s + var(--d, 0) * 0.12s); }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .blk-pb-inner { grid-template-columns: minmax(0, 1fr); padding: 44px 28px; }
    .blk-pb-side { order: -1; }
    .blk-pb-copy { align-items: center; text-align: center; }
    .blk-pb-actions { justify-content: center; }
  }

  @media (max-width: 480px) {
    .blk-pb-inner { padding: 36px 18px; }
    .blk-pb-unit { min-width: 0; flex: 1; padding: 10px 4px; }
    .blk-pb-num { font-size: 24px; }
    .blk-pb-countdown { width: 100%; }
    .blk-pb-marquee { font-size: 13px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .blk-pb.is-armed .blk-pb-reveal,
    .blk-pb.is-armed .blk-pb-card { opacity: 1; transform: none; }
    .blk-pb.is-armed .blk-pb-big::after { clip-path: none; }
    .blk-pb-marquee-track { animation: none; }
  }
</style>

<script>
(function () {
  var root = document.getElementById('blkPb-{{ widget.id }}');
  if (!root || root.hasAttribute('data-pb-ready')) return;
  root.setAttribute('data-pb-ready', '');

  function toast(msg) {
    if (typeof window.showQmraToast === 'function') window.showQmraToast(msg);
  }

  /* ===== 1) Countdown ===== */
  var endAttr = root.getAttribute('data-end');
  if (endAttr) {
    // "2026-12-31 23:59" → توقيت الجهاز المحلي
    var end = new Date(endAttr.trim().replace(' ', 'T'));
    var box = root.querySelector('.blk-pb-countdown');
    var endedMsg = root.querySelector('.blk-pb-ended');
    var nums = {};
    box.querySelectorAll('[data-unit]').forEach(function (el) { nums[el.getAttribute('data-unit')] = el; });

    var setNum = function (unit, value) {
      var text = String(value).padStart(2, '0');
      var el = nums[unit];
      if (el.textContent === text) return;
      el.textContent = text;
      el.classList.remove('is-tick');
      void el.offsetWidth;
      el.classList.add('is-tick');
    };

    var timer;
    var tick = function () {
      var diff = end.getTime() - Date.now();
      if (diff <= 0) {
        clearInterval(timer);
        box.hidden = true;
        if (root.hasAttribute('data-hide-ended')) root.hidden = true;
        else endedMsg.hidden = false;
        return;
      }
      var sec = Math.floor(diff / 1000);
      setNum('d', Math.floor(sec / 86400));
      setNum('h', Math.floor(sec % 86400 / 3600));
      setNum('m', Math.floor(sec % 3600 / 60));
      setNum('s', sec % 60);
    };

    if (isNaN(end.getTime())) {
      console.warn('[promo-banner] invalid end date:', endAttr);
    } else {
      box.hidden = false;
      tick();
      timer = setInterval(tick, 1000);
    }
  }

  /* ===== 2) Copy coupon ===== */
  var coupon = root.querySelector('.blk-pb-coupon');
  if (coupon) {
    coupon.addEventListener('click', function () {
      var code = coupon.getAttribute('data-code');
      var done = function () {
        coupon.classList.add('is-copied');
        toast((root.getAttribute('data-msg-copied') || 'Code copied:') + ' ' + code);
        setTimeout(function () { coupon.classList.remove('is-copied'); }, 2000);
      };
      var fallback = function () {
        var ta = document.createElement('textarea');
        ta.value = code;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); done(); } catch (err) { toast((root.getAttribute('data-msg-copy') || 'Copy the code:') + ' ' + code); }
        ta.remove();
      };
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(code).then(done, fallback);
      } else {
        fallback();
      }
    });
  }

  /* ===== 3) Scroll reveal ===== */
  if (!('IntersectionObserver' in window)) return;
  root.classList.add('is-armed');
  var io = new IntersectionObserver(function (entries) {
    if (!entries.some(function (e) { return e.isIntersecting; })) return;
    root.classList.add('is-visible');
    io.disconnect();
  }, { rootMargin: '0px 0px 15% 0px', threshold: 0 });
  io.observe(root);
})();
</script>

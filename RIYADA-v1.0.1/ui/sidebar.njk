{# ============================================================================
   RIYADA MOBILE SIDEBAR
   ----------------------------------------------------------------------------
   Mirrors the header's taxonomy, in the order a phone shopper needs it:
     goals (the store's primary browse axis) → mega sections → plain links → deals
   Goals lead because "أنا عايز أبني عضل" is a faster decision than "أنا عايز
   تيشيرت" — and a chip grid is scannable in one glance where a list is not.

   Locals (all supplied by the header widget):
     data.megas · data.simple_menu · data.goals_menu · data.goals_label
     data.deal_text · data.deal_url · data.currentLang · data.showLang

   Contract with assets/main.js — do not rename:
     $store.modal.current === 'sidebar'
   ========================================================================= #}

{% set megas = data.megas | default([]) %}
{% set simpleMenu = data.simple_menu %}
{% set goalsMenu = data.goals_menu %}
{% set goalsLabel = data.goals_label | default('') %}
{# One menu, one place: the goals grid, each mega column and the extra links
   are often bound to the same menu, which printed every link 3–17 times.
   A menu (compared by its dumped value) renders only where it first appears;
   a column whose menu is empty or already shown is dropped with its title. #}
{% set seenMenus = [] %}
{% if goalsMenu %}{% set _ = seenMenus.push(goalsMenu | dump) %}{% endif %}
{% set dealText = data.deal_text | default('') %}
{% set dealUrl = data.deal_url | default('/shop', true) %}
{% set sbLang = data.currentLang | default(localization.language) | default('ar', true) %}
{% set showLang = data.showLang | default(true) %}

{% macro sbLinks(menu) %}
  {% if menu %}
    {% for item in (menu.items if menu.items else menu) %}
      <a href="{{ item.url | default('#', true) }}" class="riyada-sb-sublink">{{ item.title }}</a>
      {# sub-items arrive under `item.menu` (measured), not `children` #}
      {% for s in (item.menu or item.children or []) %}
        <a href="{{ s.url | default('#', true) }}" class="riyada-sb-sublink" style="padding-inline-start: 1.75rem; opacity: .85;">{{ s.title }}</a>
      {% endfor %}
    {% endfor %}
  {% endif %}
{% endmacro %}

<style>
  /* accordion trigger and plain link share one look, so the drawer reads as
     one list even though half its rows open and half navigate */
  .riyada-sb-row {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 15px 2px;
    border: 0;
    background: transparent;
    font-family: var(--font-display-ar);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    text-align: start;
    text-transform: var(--display-case);
    cursor: pointer;
    transition: color var(--t-fast) var(--ease-out);
  }
  html[dir="ltr"] .riyada-sb-row { font-family: var(--font-display-en); font-weight: 400; letter-spacing: 0.04em; }
  .riyada-sb-row:hover { color: var(--color-flame); }
  .riyada-sb-item + .riyada-sb-item { border-top: 1px solid var(--color-border); }

  .riyada-sb-caret {
    width: 26px;
    height: 26px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-xs);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    transition: transform var(--t-base) var(--ease-out),
                background var(--t-fast) var(--ease-out),
                border-color var(--t-fast) var(--ease-out),
                color var(--t-fast) var(--ease-out);
  }
  .riyada-sb-item.is-open .riyada-sb-caret {
    transform: rotate(180deg);
    background: var(--color-flame-fill);
    border-color: var(--color-flame-fill);
    color: var(--color-text-on-flame);
  }

  .riyada-sb-panel { padding-bottom: 14px; }

  .riyada-sb-group-title {
    display: block;
    margin: 12px 0 6px;
    font-size: 0.6875rem;
    font-weight: 800;
    color: var(--color-flame);
    text-transform: var(--display-case);
  }
  html[dir="ltr"] .riyada-sb-group-title { letter-spacing: 0.12em; }

  .riyada-sb-sublink {
    display: block;
    padding: 9px 12px;
    margin-bottom: 2px;
    border-radius: var(--radius-xs);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    transition: background var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out);
  }
  .riyada-sb-sublink:hover { background: var(--color-surface-alt); color: var(--color-text-primary); }

  .riyada-sb-viewall {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-block-start: 8px;
    margin-inline-start: 12px;
    font-size: 0.8125rem;
    font-weight: 800;
    color: var(--color-flame);
  }

  /* goals — a chip grid, not a list. Two columns is the most a 380px drawer
     can hold without the labels wrapping to two lines. */
  .riyada-sb-goals {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
    margin-bottom: 20px;
  }
  .riyada-sb-goals a {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 13px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.3;
    transition: border-color var(--t-fast) var(--ease-out), background var(--t-fast) var(--ease-out);
  }
  .riyada-sb-goals a:hover { border-color: var(--color-flame); background: var(--color-flame-wash); }

  /* deals — the one flame row in the drawer */
  .riyada-sb-deal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 18px;
    padding: 14px 14px;
    border-radius: var(--radius-card);
    background: var(--color-flame-fill);
    color: var(--color-text-on-flame);
    font-size: 0.9375rem;
    font-weight: 800;
    text-transform: var(--display-case);
  }
  html[dir="ltr"] .riyada-sb-deal { letter-spacing: 0.06em; }

  /* language segmented control */
  .riyada-sb-seg {
    display: flex;
    gap: 3px;
    padding: 3px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-btn);
    background: var(--color-bg-tertiary);
  }
  .riyada-sb-seg button {
    flex: 1;
    padding: 9px 0;
    border: 0;
    border-radius: var(--radius-xs);
    background: transparent;
    color: var(--color-text-secondary);
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 700;
    cursor: pointer;
    transition: background var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out);
  }
  .riyada-sb-seg button.is-active {
    background: var(--color-flame-fill);
    color: var(--color-text-on-flame);
  }
</style>

<div x-data="{ open: null }" x-cloak>

  {# ---- Overlay ---- #}
  <div x-show="$store.modal.current === 'sidebar'"
       @click="$store.modal.close()"
       class="riyada-overlay"
       x-transition:enter="transition ease-out duration-200"
       x-transition:enter-start="opacity-0"
       x-transition:enter-end="opacity-100"
       x-transition:leave="transition ease-in duration-150"
       x-transition:leave-start="opacity-100"
       x-transition:leave-end="opacity-0"></div>

  {# ---- Drawer ---- #}
  <div class="riyada-drawer riyada-drawer--start"
       :class="{ 'is-open': $store.modal.current === 'sidebar' }"
       style="width: min(380px, 92vw);"
       role="dialog"
       aria-label="{{ t('common.menu') }}">

    {# head #}
    <div class="riyada-drawer-head">
      <a href="/" class="riyada-wordmark riyada-wordmark--sm" title="{{ store.name | default('RIYADA', true) }}">{% ui "store-name.njk" %}</a>
      <button type="button"
              @click="$store.modal.close()"
              class="riyada-btn-icon riyada-btn-icon--sm"
              aria-label="{{ t('common.close') }}">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    {# body #}
    <div class="riyada-drawer-body riyada-scroll-thin">

      {# ---- goals grid ---- #}
      {% if goalsMenu %}
        {# Same Nunjucks caveat as the hero's video source: goalsLabel is '' when
           unset, and `| default` only fires on `undefined`. #}
        <span class="riyada-sb-group-title" style="margin-top: 0;">
          {% if goalsLabel %}{{ goalsLabel }}{% else %}{{ t('common.categories') }}{% endif %}
        </span>
        <div class="riyada-sb-goals">
          {% for item in (goalsMenu.items if goalsMenu.items else goalsMenu) %}
            <a href="{{ item.url | default('#', true) }}">
              <span class="truncate">{{ item.title }}</span>
            </a>
          {% endfor %}
        </div>
      {% endif %}

      <nav aria-label="{{ t('common.menu') }}">

        {# ---- mega blocks as accordions ---- #}
        {% for block in megas %}
          {% set b = block.data %}
          {% if b.nav_label %}
            {% set key = 'sb' ~ loop.index %}
            <div class="riyada-sb-item" :class="open === '{{ key }}' && 'is-open'">
              {% set cols = [] %}
              {% for n in [1, 2, 3, 4] %}
                {% set cm = b['col' ~ n ~ '_menu'] %}
                {% set ck = (cm | dump) if cm else '' %}
                {% if b['col' ~ n ~ '_title'] and ck and not (ck in seenMenus) and (cm.items if cm.items else cm) | length %}
                  {% set _ = seenMenus.push(ck) %}
                  {% set _ = cols.push({ title: b['col' ~ n ~ '_title'], menu: cm }) %}
                {% endif %}
              {% endfor %}
              {% if cols | length %}
                <button type="button"
                        class="riyada-sb-row"
                        @click="open = open === '{{ key }}' ? null : '{{ key }}'"
                        :aria-expanded="open === '{{ key }}'">
                  <span>{{ b.nav_label }}</span>
                  <span class="riyada-sb-caret">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/>
                    </svg>
                  </span>
                </button>

                <div x-show="open === '{{ key }}'" x-collapse class="riyada-sb-panel">
                  {% for c in cols %}
                    <span class="riyada-sb-group-title">{{ c.title }}</span>
                    {{ sbLinks(c.menu) }}
                  {% endfor %}

                  <a href="{{ b.nav_url | default('#', true) }}" class="riyada-sb-viewall">
                    {{ t('common.view_all') }}
                    <svg class="riyada-flip" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/>
                    </svg>
                  </a>
                </div>
              {% else %}
                {# no columns configured — behave as a plain link #}
                <a href="{{ b.nav_url | default('#', true) }}" class="riyada-sb-row">
                  <span>{{ b.nav_label }}</span>
                  <svg class="riyada-flip" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity:.4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/>
                  </svg>
                </a>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}

        {# ---- plain links ---- #}
        {% if simpleMenu and ((simpleMenu | dump) in seenMenus) %}{% set simpleMenu = '' %}{% endif %}
        {% if simpleMenu %}
          {% for item in (simpleMenu.items if simpleMenu.items else simpleMenu) %}
            <div class="riyada-sb-item">
              <a href="{{ item.url | default('#', true) }}" class="riyada-sb-row">
                <span>{{ item.title }}</span>
                <svg class="riyada-flip" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity:.4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/>
                </svg>
              </a>
              {# sub-items arrive under `item.menu` (measured), not `children` #}
              {% for s in (item.menu or item.children or []) %}
                <a href="{{ s.url | default('#', true) }}" class="riyada-sb-sublink">{{ s.title }}</a>
              {% endfor %}
            </div>
          {% endfor %}
        {% endif %}
      </nav>

      {# ---- deals ---- #}
      {% if dealText %}
        <a href="{{ dealUrl }}" class="riyada-sb-deal">
          <span class="inline-flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M13.2 2.1a.6.6 0 0 1 1 .55l-.9 5.6h4.2a.6.6 0 0 1 .47.97l-8.1 12.7a.6.6 0 0 1-1.07-.5l1.06-6.2H5.6a.6.6 0 0 1-.47-.97L13.2 2.1Z"/>
            </svg>
            {{ dealText }}
          </span>
          <svg class="riyada-flip" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/>
          </svg>
        </a>
      {% endif %}
    </div>

    {# foot #}
    {% if showLang %}
      <div class="riyada-drawer-foot">
        <span class="riyada-caption block mb-2">{{ t('common.language') }}</span>
        {% form 'lang' %}
          <div class="riyada-sb-seg">
            <button type="submit" name="lang" value="ar" class="font-body {{ 'is-active' if sbLang == 'ar' }}">العربية</button>
            <button type="submit" name="lang" value="en" class="font-body-en {{ 'is-active' if sbLang == 'en' }}">English</button>
          </div>
        {% endform %}
      </div>
    {% endif %}

  </div>
</div>

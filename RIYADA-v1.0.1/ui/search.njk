{# ============================================================================
   RIYADA SEARCH — sheet dropping from the top
   ----------------------------------------------------------------------------
   Uses Qumra.search.suggest() (debounced in main.js).
   Hits are dense rows: image · title · price — the same reading order as the
   product card, so a shopper scans results the way they scan a grid.

   The thumbnail sits on the same true-black plate the product card uses. It is
   the one visual constant that tells you "this is the product", whatever the
   surface behind it.

   Contract with assets/main.js — do not rename:
     $store.modal.current === 'search'   ·   Qumra.search.suggest
   ========================================================================= #}

<style>
  .riyada-srch-sheet {
    position: fixed;
    top: 0;
    inset-inline: 0;
    z-index: var(--z-drawer);
    max-height: 88vh;
    overflow-y: auto;
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow-xl);
  }

  .riyada-srch-hit {
    display: flex;
    gap: 12px;
    padding: 10px;
    border-radius: var(--radius-card);
    transition: background var(--t-fast) var(--ease-out);
  }
  .riyada-srch-hit:hover { background: var(--color-surface-alt); }

  .riyada-srch-thumb {
    position: relative;
    width: 60px;
    height: 60px;
    flex: none;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    background: var(--color-media);
  }
  .riyada-srch-thumb img { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 639px) {
    .riyada-srch-thumb { width: 52px; height: 52px; }
  }
</style>

<div x-data x-cloak>

  {# ---- Overlay ---- #}
  <div x-show="$store.modal.current === 'search'"
       @click="$store.modal.close()"
       class="riyada-overlay"
       x-transition:enter="transition ease-out duration-200"
       x-transition:enter-start="opacity-0"
       x-transition:enter-end="opacity-100"
       x-transition:leave="transition ease-in duration-150"
       x-transition:leave-start="opacity-100"
       x-transition:leave-end="opacity-0"></div>

  {# ---- Sheet ---- #}
  <div x-show="$store.modal.current === 'search'"
       x-transition:enter="transition ease-out duration-200"
       x-transition:enter-start="opacity-0 -translate-y-5"
       x-transition:enter-end="opacity-100 translate-y-0"
       x-transition:leave="transition ease-in duration-150"
       x-transition:leave-start="opacity-100 translate-y-0"
       x-transition:leave-end="opacity-0 -translate-y-3"
       class="riyada-srch-sheet riyada-scroll-thin"
       x-data="{
         query: '',
         products: [],
         queries: [],
         searching: false,
         run() {
           if (this.query.length < 2) { this.products = []; this.queries = []; this.searching = false; return }
           this.searching = true;
           Qumra.search.suggest(this.query, (data) => {
             const r = data.resources || {};
             this.products = r.products || data.products || [];
             this.queries  = r.queries  || [];
             this.searching = false;
           }, 6);
         },
         money(v) { return Qumra.utils.formatMoney(v) },
         off(p) {
           const c = p.pricing && p.pricing.compareAtPrice, x = p.pricing && p.pricing.price;
           return (c && c > x) ? Math.floor(((c - x) / c) * 100) : 0;
         }
       }">

    <div class="riyada-container py-6 max-sm:py-4">

      {# head #}
      <div class="flex items-center justify-between gap-4 mb-4">
        <span class="riyada-eyebrow">{{ t('pages.search.title') }}</span>
        <button type="button"
                @click="$store.modal.close()"
                class="riyada-btn-icon riyada-btn-icon--sm"
                aria-label="{{ t('common.close') }}">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      {# field #}
      <form action="/shop" method="get" class="riyada-searchbar riyada-searchbar--lg" role="search">
        <span class="riyada-searchbar-icon" aria-hidden="true">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="7.25"/>
            <path stroke-linecap="round" d="m20.5 20.5-4.2-4.2"/>
          </svg>
        </span>
        <input type="search"
               name="q"
               x-model="query"
               @input.debounce.120ms="run()"
               class="riyada-searchbar-input"
               placeholder="{{ t('header.search_placeholder') }}"
               autocomplete="off"
               aria-label="{{ t('pages.search.title') }}"/>
        <button type="button"
                x-show="query.length > 0"
                @click="query = ''; run()"
                class="riyada-btn-icon riyada-btn-icon--sm shrink-0 me-1"
                aria-label="{{ t('common.cancel') }}">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
        <button type="submit" class="riyada-searchbar-submit">{{ t('common.search') }}</button>
      </form>

      {# ---- suggested queries ---- #}
      <div x-show="queries.length > 0" class="pt-5">
        <p class="riyada-micro mb-2.5 m-0">{{ t('pages.search.suggestions') }}</p>
        <div class="flex flex-wrap gap-2">
          <template x-for="q in queries" :key="q">
            <a :href="'/shop?q=' + encodeURIComponent(q)" class="riyada-chip riyada-chip--sm" x-text="q"></a>
          </template>
        </div>
      </div>

      {# ---- product hits ---- #}
      <div x-show="products.length > 0" class="pt-5">
        <div class="flex items-center justify-between gap-3 mb-2">
          <p class="riyada-micro m-0">{{ t('pages.search.products') }}</p>
          <a :href="'/shop?q=' + encodeURIComponent(query)" class="riyada-link">
            {{ t('pages.search.view_all') }}
            <svg class="riyada-flip" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/>
            </svg>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-5 gap-y-0.5">
          <template x-for="item in products" :key="item._id">
            <a :href="'/product/' + (item.slug || item.handle)"
               @click="$store.modal.close()"
               class="riyada-srch-hit">

              <div class="riyada-srch-thumb">
                <template x-if="item.images && item.images.length">
                  <img :src="item.images[0].fileUrl" :alt="item.title" loading="lazy"/>
                </template>
                <template x-if="!item.images || !item.images.length">
                  <div class="w-full h-full flex items-center justify-center" style="color: var(--color-border-strong);">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <rect x="3" y="3" width="18" height="18" rx="3"/>
                      <circle cx="8.75" cy="9" r="1.6"/>
                      <path stroke-linecap="round" stroke-linejoin="round" d="m4 17 5-4.5 4.5 4 3-2.5L21 18"/>
                    </svg>
                  </div>
                </template>
              </div>

              <div class="flex-1 min-w-0 flex flex-col justify-center gap-1">
                <p class="riyada-clamp-1 m-0 text-[0.875rem] font-semibold leading-snug"
                   style="color: var(--color-text-primary);" x-text="item.title"></p>

                <div class="flex items-center gap-2 flex-wrap">
                  <span class="riyada-price riyada-price--sm" x-text="money(item.pricing.price)"></span>
                  <template x-if="off(item) > 0">
                    <span class="riyada-price-was" x-text="money(item.pricing.compareAtPrice)"></span>
                  </template>
                  <template x-if="off(item) > 0">
                    <span class="riyada-badge riyada-badge--off" x-text="'−' + off(item) + '%'"></span>
                  </template>
                </div>
              </div>
            </a>
          </template>
        </div>
      </div>

      {# ---- loading ---- #}
      <div x-show="searching" x-cloak class="py-12 flex items-center justify-center">
        <span class="riyada-spinner" style="width: 24px; height: 24px;"></span>
      </div>

      {# ---- no results ---- #}
      <div x-show="!searching && query.length >= 2 && products.length === 0 && queries.length === 0"
           x-cloak
           class="riyada-empty" style="padding-block: var(--space-7);">
        <span class="riyada-empty-icon">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
            <circle cx="11" cy="11" r="7.25"/>
            <path stroke-linecap="round" d="m20.5 20.5-4.2-4.2"/>
          </svg>
        </span>
        <span class="riyada-empty-title">{{ t('pages.search.no_results') }}</span>
        <p class="riyada-text-sm m-0">{{ t('pages.search.try_different') }}</p>
      </div>

    </div>
  </div>
</div>

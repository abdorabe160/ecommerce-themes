      },
      "buttonStyle": {
        "type": "select",
        "label": {
          "ar": "شكل الأزرار",
          "en": "Button Shape"
        },
        "default": "square",
        "options": [
          { "value": "square", "label": { "ar": "مربّع (موصى به)", "en": "Square (recommended)" } },
          { "value": "tight", "label": { "ar": "ضيّق", "en": "Tight" } },
          { "value": "soft", "label": { "ar": "ناعم", "en": "Soft" } },
          { "value": "pill", "label": { "ar": "كبسولة", "en": "Pill" } }
        ]
      },
      "cardStyle": {
        "type": "select",
        "label": {
          "ar": "سلوك البطاقة عند المرور",
          "en": "Card Hover Behaviour"
        },
        "default": "outline",
        "options": [
          { "value": "outline", "label": { "ar": "الحدود تشتعل (موصى به)", "en": "Border ignites (recommended)" } },
          { "value": "raised", "label": { "ar": "ترتفع بظل", "en": "Lifts with a shadow" } },
          { "value": "glow", "label": { "ar": "توهّج ناري", "en": "Flame glow" } }
        ]
      },
      "cutDepth": {
        "type": "range",

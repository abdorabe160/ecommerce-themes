          { "value": "sharp", "label": { "ar": "حاد (موصى به)", "en": "Sharp (recommended)" } },
          { "value": "tight", "label": { "ar": "ضيّق", "en": "Tight" } },
          { "value": "soft", "label": { "ar": "ناعم", "en": "Soft" } },
          { "value": "rounded", "label": { "ar": "مدوّر", "en": "Rounded" } }

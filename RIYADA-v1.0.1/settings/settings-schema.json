          "en": "Primary Dark (pressed & on light blocks)"
        },
        "default": "#D93A1D"
      },
      "primaryColorWash": {
        "type": "color",
        "label": {
          "ar": "خلفية الوسوم النارية",
          "en": "Flame Chip Background"
        },
        "default": "#2A1310"
      },
      "primaryColorLine": {
        "type": "color",
        "label": {
          "ar": "حدود الوسوم النارية",
          "en": "Flame Border"
        },
        "default": "#6B2517"
      },
      "saleColor": {
        "type": "color",
        "label": {
          "ar": "لون الخصم (الشارة والسعر). فارغ = اللون الرئيسي",
          "en": "Sale colour (badge and price). Empty uses the primary colour"
        },
        "default": ""
      },
      "successColor": {
        "type": "color",
        "label": {
          "ar": "لون «متوفر». فارغ = الأخضر الحالي",
          "en": "In-stock colour. Empty keeps the current green"
        },
        "default": ""
      },
      "warningColor": {
        "type": "color",
        "label": {
          "ar": "لون «أوشك على النفاد». فارغ = الكهرماني الحالي",
          "en": "Low-stock colour. Empty keeps the current amber"
        },
        "default": ""
      }
    }
  },

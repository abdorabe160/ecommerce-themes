          "ar": "سرعة الحركة",
          "en": "Motion Speed"
        },
        "default": "snappy",
        "options": [
          { "value": "snappy", "label": { "ar": "سريعة (موصى به)", "en": "Snappy (recommended)" } },
          { "value": "relaxed", "label": { "ar": "هادئة", "en": "Relaxed" } }
        ]
      },

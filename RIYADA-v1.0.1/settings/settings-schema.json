          "en": "Enable motion (off stops the marquee, auto-sliding and hover movement)"
        },
        "default": true
      },
      "sectionSpacing": {
        "type": "select",
        "label": {
          "ar": "المسافات بين الأقسام",
          "en": "Section Spacing"
        },
        "default": "normal",
        "options": [
          { "value": "compact", "label": { "ar": "مضغوط", "en": "Compact" } },
          { "value": "normal", "label": { "ar": "عادي (موصى به)", "en": "Normal (recommended)" } },
          { "value": "roomy", "label": { "ar": "واسع", "en": "Roomy" } }
        ]
      },
      "containerWidth": {
        "type": "select",
        "label": {
          "ar": "أقصى عرض للمحتوى",

{
  "name": "الهيدر الرئيسي",
  "settings": {
    "header_logo": {
      "type": "media",
      "label": {
        "ar": "شعار المتجر (اتركه فارغاً لاستخدام شعار المتجر الأساسي)",
        "en": "Store Logo (leave empty to use the store's own logo)"
      }
    },
    "logo_height": {
      "type": "range",
      "label": {
        "ar": "ارتفاع الشعار",
        "en": "Logo Height"
      },
      "default": 34,
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px"
    },
    "sticky": {
      "type": "boolean",
      "label": {
        "ar": "تثبيت الهيدر عند التمرير",
        "en": "Sticky on Scroll"
      },
      "default": true
    },
    "search_style": {
      "type": "select",
      "label": {
        "ar": "شكل البحث",
        "en": "Search Style"
      },
      "default": "icon",
      "options": [
        {
          "value": "icon",
          "label": {
            "ar": "أيقونة تفتح نافذة بحث (موصى به)",
            "en": "Icon that opens a search sheet (recommended)"
          }
        },
        {
          "value": "inline",
          "label": {
            "ar": "حقل بحث ظاهر في الشريط",
            "en": "Inline field in the bar"
          }
        },
        {
          "value": "hidden",
          "label": {
            "ar": "بدون بحث",
            "en": "No search"
          }
        }
      ]
    },
    "search_placeholder": {
      "type": "string",
      "label": {
        "ar": "نص حقل البحث",

{# ============================================================================
   RIYADA HEADER — sports & gym
   ----------------------------------------------------------------------------
   Rows:
     1. marquee strip   (scrolling claims — the "شريط عروض متحرك" of the brief)
     2. main bar        (menu · logo · search · cart)
     3. goals rail      (تسوّق حسب الهدف — the only category strip on desktop)

   ── There is no desktop category nav, and that is deliberate ───────────────
   No inline nav, no mega dropdowns. Categories live in ONE place — the drawer —
   on every screen size. Which makes the menu button load-bearing rather than a
   mobile leftover, so it is visible at every width and carries a text label on
   desktop. A burger that only appears under 1024px would leave desktop with no
   route to the catalogue at all.

   The `mega` blocks are still the taxonomy source: the drawer renders each one
   as an accordion. They just no longer paint a dropdown panel.

   Contracts with assets/main.js — do not rename:
     toggleModal('sidebar' | 'search' | 'cart')   ·   $store.cart.totalQuantity
     $store.modal.current
   ========================================================================= #}

{% set id = widget.id %}
{% set d = widget.data %}
{% set megas = widget.blocks | default([]) %}

{% set isSticky = d.sticky | default(true) %}
{% set logoH = d.logo_height | default(34, true) %}
{% set storeName = (store.name or 'RIYADA') | trim %}{% set _sw = (storeName | replace('  ', ' ')).split(' ') %}{% set storeShort = (_sw.slice(0, 3).join(' ') ~ '…') if (_sw | length) > 3 else storeName %}
{% set logo = d.header_logo if d.header_logo and d.header_logo.fileUrl else store.logo %}

{% set searchStyle = d.search_style | default('icon', true) %}
{% set searchPlaceholder = d.search_placeholder | default(t('defaults.search_products'), true) %}
{% set hasSearch = searchStyle != 'hidden' %}
{% set inlineSearch = searchStyle == 'inline' %}

{% set showCart = d.show_cart | default(true) %}
{% set showLang = d.show_language_switcher | default(true) %}

{# ---- marquee claims: up to five strings, rendered as one scrolling track ----
   Bound to plain variables first rather than filtering inside the array
   literal — the two-step form is the one this theme already relies on and it
   keeps the `| default` out of a construct whose parsing varies. #}
{% set showAnnounce = d.show_announcement | default(true) %}
{% set claim1 = d.claim_1 | default('') %}
{% set claim2 = d.claim_2 | default('') %}
{% set claim3 = d.claim_3 | default('') %}
{% set claim4 = d.claim_4 | default('') %}
{% set claim5 = d.claim_5 | default('') %}
{% set claims = [claim1, claim2, claim3, claim4, claim5] %}
{% set hasClaims = claim1 or claim2 or claim3 or claim4 or claim5 %}

{# ---- menus (consumed by the drawer, not by this bar) ---- #}
{# '' (falsy, never undefined): Qalab's ui tag rejects undefined arguments #}
{% set simpleMenu = d.header_menu or '' %}
{% set dealText = d.deal_link_text or '' %}
{% set dealUrl = d.deal_link_url or '/shop' %}

{# ---- goals rail ---- #}
{% set showGoals = d.show_goals_row | default(true) %}
{% set goalsLabel = d.goals_label or '' %}
{% set goalsMenu = d.goals_menu or '' %}

{% set rawLang = localization.language | default('ar', true) %}
{% set currentLang = rawLang if rawLang == 'en' else 'ar' %}


{# ============================ MACROS ============================ #}

{# Brand: uploaded logo, or the wordmark fallback #}
{% macro brand(logo, h, name, cls) %}
  {% if logo and logo.fileUrl %}
    <img src="{{ logo.fileUrl }}" alt="{{ name }}"
         class="w-auto object-contain"
         style="height: {{ h }}px;"/>
  {% else %}
    <span class="riyada-wordmark {{ cls }}">{{ name }}</span>
  {% endif %}
{% endmacro %}

{# The inline search form — rendered twice (bar centre + mobile row) #}
{% macro searchForm(placeholder, label, cls) %}
  <form action="/shop" method="get" class="riyada-searchbar {{ cls }}" role="search">
    <span class="riyada-searchbar-icon" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7.25"/>
        <path stroke-linecap="round" d="m20.5 20.5-4.2-4.2"/>
      </svg>
    </span>
    <input type="search"
           name="q"
           class="riyada-searchbar-input"
           placeholder="{{ placeholder }}"
           aria-label="{{ label }}"
           autocomplete="off"/>
    <button type="submit" class="riyada-searchbar-submit">{{ label }}</button>
  </form>
{% endmacro %}

{# One pass of the marquee. Called twice — the track must contain the content
   exactly twice for the -50% keyframe to loop without a visible seam. #}
{% macro claimRun(list, hidden) %}
  <div class="flex items-center" style="gap: var(--marquee-gap, 40px);"
       {% if hidden %}aria-hidden="true"{% endif %}>
    {% for c in list %}
      {% if c %}
        <span class="riyada-marquee-item">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style="opacity:.65" aria-hidden="true">
            <path d="M13.2 2.1a.6.6 0 0 1 1 .55l-.9 5.6h4.2a.6.6 0 0 1 .47.97l-8.1 12.7a.6.6 0 0 1-1.07-.5l1.06-6.2H5.6a.6.6 0 0 1-.47-.97L13.2 2.1Z"/>
          </svg>
          {{ c }}
        </span>
      {% endif %}
    {% endfor %}
  </div>
{% endmacro %}


<style>
  /* ---- responsive visibility -----------------------------------------------
     These are NOT Tailwind's `lg:hidden` / `max-lg:hidden` utilities, and that
     is on purpose. Tailwind here comes from the Play CDN, which generates its
     CSS only AFTER its script has run and scanned the DOM — so for the first
     frames of every page load none of those classes exist, and every element
     meant to be hidden paints anyway. This block ships inline with the widget,
     so it is correct on frame one. Breakpoints mirror Tailwind's defaults. */
  @media (max-width: 1023px) { .riyada-hd-{{ id }}-desk { display: none !important; } }
  @media (min-width: 1024px) { .riyada-hd-{{ id }}-mob  { display: none !important; } }

  /* The merchant sets the logo height; width follows the aspect ratio. The cap
     is tied to the viewport as well as to a pixel value — on a phone a wide
     logo must never push the menu button or the cart out of the row. */
  .riyada-hd-{{ id }}-brand img { max-width: min(190px, 44vw); }

  /* ---- menu button ----
     The only route to the catalogue, so it is never hidden and it says what it
     is on desktop. An icon-only control at 1440px reads as a leftover. */
  .riyada-menubtn-{{ id }} {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 42px;
    padding-inline: 12px;
    border: 1px solid transparent;
    border-radius: var(--radius-btn);
    background: transparent;
    color: var(--color-header-text);
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 800;
    cursor: pointer;
    text-transform: var(--display-case);
    transition: border-color var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out);
  }
  html[dir="ltr"] .riyada-menubtn-{{ id }} { letter-spacing: 0.1em; }
  .riyada-menubtn-{{ id }}:hover { border-color: var(--color-flame); color: var(--color-flame); }
  .riyada-menubtn-{{ id }} .label { display: none; }
  @media (min-width: 1024px) {
    .riyada-menubtn-{{ id }} { border-color: var(--color-header-border); }
    .riyada-menubtn-{{ id }} .label { display: inline; }
  }
  @media (max-width: 1023px) {
    .riyada-menubtn-{{ id }} { padding-inline: 8px; margin-inline-start: -8px; }
  }

  /* ---- main bar grid: start | centre | end ---- */
  .riyada-bar-{{ id }} {
    display: grid;
    align-items: center;
    gap: 20px;
    min-height: 74px;
    grid-template-columns: auto minmax(0, 1fr) auto;
  }
  @media (max-width: 1023px) {
    .riyada-bar-{{ id }} { gap: 10px; min-height: 60px; }
  }

  /* ---- marquee tones ----
     NO `overflow: hidden` on this strip, ever. The language dropdown is a child
     of it and opens *below* it, so an overflow clip on the bar erases the panel
     entirely — the button toggles, Alpine renders, and nothing is visible. The
     clipping the marquee actually needs belongs to .riyada-marquee itself (see
     style.css §07), which wraps only the scrolling track. */
  .riyada-mq-{{ id }} {
    --marquee-dur: {{ d.marquee_speed | default(34, true) }}s;
    --marquee-gap: 44px;
    padding-block: 9px;
  }
  .riyada-mq-{{ id }}--flame { background: var(--color-announcement); color: var(--color-announcement-text); }
  .riyada-mq-{{ id }}--dark  { background: var(--color-media); color: var(--color-chalk); }
  .riyada-mq-{{ id }}--light { background: var(--color-chalk); color: var(--color-text-on-light); }

  .riyada-mqrow-{{ id }} { position: relative; display: flex; align-items: center; }
  /* min-width:0 is required: a flex child defaults to min-width:auto, so the
     track's intrinsic width would push the row wider than the container and
     the strip would scroll the page sideways instead of scrolling itself. */
  .riyada-mqrow-{{ id }} .riyada-marquee { flex: 1; min-width: 0; }
  .riyada-mqlang-{{ id }} {
    position: relative;
    z-index: 2;
    flex: none;
    display: flex;
    align-items: center;
    padding-inline-end: 14px;
    margin-inline-end: 4px;
    border-inline-end: 1px solid currentColor;
    opacity: 0.9;
  }

  /* ---- goals rail ---- */
  .riyada-goals-{{ id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    border-top: 1px solid var(--color-header-border);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .riyada-goals-{{ id }}::-webkit-scrollbar { display: none; }
  .riyada-goals-{{ id }} .label {
    flex: none;
    font-size: 0.6875rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-flame);
    text-transform: var(--display-case);
    white-space: nowrap;
  }
  html[dir="ltr"] .riyada-goals-{{ id }} .label { letter-spacing: 0.12em; }
  .riyada-goals-{{ id }} a {
    flex: none;
    padding: 7px 13px;
    border: 1px solid var(--color-header-border);
    border-radius: var(--radius-btn);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-header-text);
    white-space: nowrap;
    transition: border-color var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out);
  }
  .riyada-goals-{{ id }} a:hover { border-color: var(--color-flame); color: var(--color-flame); }
  /* the deals link is the one flame item, pushed to the far end */
  .riyada-goals-{{ id }} a.deal {
    margin-inline-start: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-color: var(--color-flame-line);
    background: var(--color-flame-wash);
    color: var(--color-flame);
  }
  .riyada-goals-{{ id }} a.deal:hover { border-color: var(--color-flame); }

  /* ---- language dropdown ---- */
  .riyada-lang-{{ id }} {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 800;
    cursor: pointer;
    transition: opacity var(--t-fast) var(--ease-out);
  }
  .riyada-lang-{{ id }}:hover { opacity: 0.7; }

  /* Positioned here rather than with Tailwind's `absolute top-full start-0`:
     those utilities do not exist until the Play CDN has scanned the DOM, and
     a dropdown that lands in the flow for even one frame shoves the strip open.
     Same reasoning as the visibility helpers at the top of this file. */
  .riyada-langdrop-{{ id }} {
    position: absolute;
    inset-block-start: calc(100% + 8px);
    inset-inline-start: 0;
    z-index: var(--z-mega);
    min-width: 160px;
    padding: 5px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-bg-secondary);
    box-shadow: var(--shadow-lg);
  }
  .riyada-langdrop-{{ id }} button {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 9px 12px;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text-primary);
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: background var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out);
  }
  .riyada-langdrop-{{ id }} button:hover:not(:disabled) { background: var(--color-surface-alt); }
  .riyada-langdrop-{{ id }} button:disabled { color: var(--color-flame); cursor: default; }

  @media (max-width: 767px) {
    .riyada-hd-{{ id }}-brand .riyada-wordmark { font-size: 1.2rem; }
  }
</style>

<header
  id="riyada-header-{{ id }}"
  class="riyada-header {{ 'riyada-header--sticky' if isSticky }}"
>

  {# ==================== Marquee strip ==================== #}
  {% if showAnnounce and (hasClaims or showLang) %}
  <div class="riyada-mq-{{ id }} riyada-mq-{{ id }}--{{ d.announcement_tone | default('flame', true) }}">
    <div class="riyada-container">
      <div class="riyada-mqrow-{{ id }}">

        {# language, pinned at the start edge #}
        {% if showLang %}
        <div x-data="{ open: false }" class="riyada-mqlang-{{ id }}">
          <button type="button"
                  @click="open = !open"
                  @click.outside="open = false"
                  class="riyada-lang-{{ id }}"
                  aria-label="{{ t('common.language') }}">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
              <circle cx="12" cy="12" r="9"/>
              <path stroke-linecap="round" d="M3.6 9h16.8M3.6 15h16.8"/>
              <path stroke-linecap="round" d="M12 3a14 14 0 0 0 0 18a14 14 0 0 0 0-18"/>
            </svg>
            <span>{{ 'EN' if currentLang == 'en' else 'ع' }}</span>
          </button>

          <div x-show="open" x-cloak
               x-transition:enter="transition ease-out duration-150"
               x-transition:enter-start="opacity-0 -translate-y-1"
               x-transition:enter-end="opacity-100 translate-y-0"
               x-transition:leave="transition ease-in duration-100"
               x-transition:leave-start="opacity-100"
               x-transition:leave-end="opacity-0"
               class="riyada-langdrop-{{ id }}">
            {% form 'lang' %}
              <button type="submit" name="lang" value="ar" {% if currentLang == 'ar' %}disabled{% endif %}>
                <span class="font-body">العربية</span>
                {% if currentLang == 'ar' %}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M4 12.5 9.5 18 20 6.5"/></svg>
                {% endif %}
              </button>
              <button type="submit" name="lang" value="en" {% if currentLang == 'en' %}disabled{% endif %}>
                <span class="font-body-en">English</span>
                {% if currentLang == 'en' %}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M4 12.5 9.5 18 20 6.5"/></svg>
                {% endif %}
              </button>
            {% endform %}
          </div>
        </div>
        {% endif %}

        {# the scrolling track — content twice, see the macro's note #}
        {% if hasClaims %}
          <div class="riyada-marquee">
            <div class="riyada-marquee-track">
              {{ claimRun(claims, false) }}
              {{ claimRun(claims, true) }}
            </div>
          </div>
        {% endif %}

      </div>
    </div>
  </div>
  {% endif %}

  {# ========================= Main bar ========================= #}
  <div class="riyada-header-bar">
    <div class="riyada-container">
      <div class="riyada-bar-{{ id }}">

        {# ---------- START · menu + logo ---------- #}
        <div class="flex items-center gap-3 min-w-0 justify-start">
          <button type="button"
                  onclick="toggleModal('sidebar')"
                  class="riyada-menubtn-{{ id }}"
                  aria-label="{{ t('common.menu') }}">
            <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" d="M3.5 7h17M3.5 12h17M3.5 17h11"/>
            </svg>
            <span class="label">{{ t('common.menu') }}</span>
          </button>

          <a href="/" class="riyada-hd-{{ id }}-brand flex items-center shrink-0 min-w-0" aria-label="{{ storeName }}" title="{{ storeName }}">
            {{ brand(logo, logoH, storeShort, '') }}
          </a>
        </div>

        {# ---------- CENTRE · search, when the merchant wants it inline ------ #}
        <div class="min-w-0 flex items-center justify-center">
          {% if inlineSearch %}
            {{ searchForm(searchPlaceholder, t('common.search'), 'riyada-hd-' ~ id ~ '-desk') }}
          {% endif %}
        </div>

        {# ---------- END · actions ---------- #}
        <div class="flex items-center justify-end gap-1 shrink-0">

          {% if hasSearch and not inlineSearch %}
            <button type="button" onclick="toggleModal('search')" class="riyada-btn-icon" aria-label="{{ t('header.search') }}">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="7.25"/>
                <path stroke-linecap="round" d="m20.5 20.5-4.2-4.2"/>
              </svg>
            </button>
          {% endif %}

          {# No wishlist button: `pages/` has no wishlist route, so the icon
             would be a dead link. main.js ships WishlistManager and an
             `$store.wishlist` (which exposes `ids`, not a `count`), so adding
             one later is a page + a badge bound to `$store.wishlist.ids.length`. #}

          {% if showCart %}
            <button type="button" onclick="toggleModal('cart')"
                    class="riyada-btn-icon riyada-btn-icon--count"
                    aria-label="{{ t('header.cart') }}" x-data>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 4h2.2l1.9 10.4a1.8 1.8 0 0 0 1.77 1.48h7.9a1.8 1.8 0 0 0 1.76-1.42L20.3 7.5H6.2"/>
                <circle cx="9.5" cy="19.5" r="1.4"/>
                <circle cx="17" cy="19.5" r="1.4"/>
              </svg>
              <span x-show="$store.cart.totalQuantity > 0"
                    x-text="$store.cart.totalQuantity"
                    x-cloak
                    class="riyada-btn-count"></span>
            </button>
          {% endif %}
        </div>

      </div>
    </div>

    {# ---------- Mobile search row (inline mode only) ---------- #}
    {% if inlineSearch %}
      <div class="riyada-hd-{{ id }}-mob" style="border-top: 1px solid var(--color-header-border);">
        <div class="riyada-container py-2.5">
          {{ searchForm(searchPlaceholder, t('common.search'), '') }}
        </div>
      </div>
    {% endif %}

    {# ==================== Goals rail ====================
       The only category strip on desktop. On mobile the drawer covers it. #}
    {% if showGoals and (goalsMenu or dealText) %}
    <div class="riyada-hd-{{ id }}-desk">
      <div class="riyada-container">
        <div class="riyada-goals-{{ id }}">
          {% if goalsLabel %}<span class="label">{{ goalsLabel }}</span>{% endif %}
          {% if goalsMenu %}
            {% for item in (goalsMenu.items if goalsMenu.items else goalsMenu) %}
              <a href="{{ item.url | default('#', true) }}">{{ item.title }}</a>
            {% endfor %}
          {% endif %}
          {% if dealText %}
            <a href="{{ dealUrl }}" class="deal">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                <path d="M13.2 2.1a.6.6 0 0 1 1 .55l-.9 5.6h4.2a.6.6 0 0 1 .47.97l-8.1 12.7a.6.6 0 0 1-1.07-.5l1.06-6.2H5.6a.6.6 0 0 1-.47-.97L13.2 2.1Z"/>
              </svg>
              {{ dealText }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
    {% endif %}
  </div>
</header>

{# Spacer — reserves the height the fixed header vacated. See the note on
   .riyada-header--sticky in style.css for why the header is fixed, not sticky. #}
{% if isSticky %}
  <div id="riyada-header-spacer-{{ id }}" aria-hidden="true"></div>
{% endif %}

<script>
  (function () {
    var header = document.getElementById('riyada-header-{{ id }}');
    var spacer = document.getElementById('riyada-header-spacer-{{ id }}');
    if (!header || !spacer) return;

    /* The header is position:fixed, so it no longer occupies flow space.
       The spacer mirrors its height — remeasured whenever the header can
       change size (font swap on load, viewport resize, rail wrapping).

       The same measurement is published as --header-h on the document root,
       because a full-height hero needs `calc(100svh - <header>)` and the
       header's height is not knowable at author time: it depends on the
       marquee being on, the goals rail existing, and on how the merchant's
       own logo scales the bar. */
    var sync = function () {
      var h = header.offsetHeight;
      spacer.style.height = h + 'px';
      document.documentElement.style.setProperty('--header-h', h + 'px');
    };
    sync();
    window.addEventListener('load', sync);
    window.addEventListener('resize', sync);
    if (window.ResizeObserver) new ResizeObserver(sync).observe(header);
  })();
</script>

{# ---- Global panels triggered from the header ----
   The drawer is where the taxonomy lives now, so `megas` matters more here
   than it used to: it is the ONLY place those sections are rendered. #}
{% ui "sidebar.njk", megas=megas, simple_menu=simpleMenu, goals_menu=goalsMenu, goals_label=goalsLabel, deal_text=dealText, deal_url=dealUrl, currentLang=currentLang, showLang=showLang %}
{% if hasSearch %}{% ui "search.njk" %}{% endif %}
{% ui "cart.njk" %}

{# Per-section palette. Emits nothing at all unless `colors_enabled` is on, so
   the switch IS the revert. Must stay after the widget's own <style> — see the
   partial's header for why. #}
{% ui "section-colors.njk", scope='#riyada-header-' ~ id, c=d %}

{# ============================================================================
   RIYADA HERO — "The Stage"
   ----------------------------------------------------------------------------
   A hero for a store that sells intent, not specs. Each slide is a training
   clip (or a still) behind one shouted line: جسمك مسؤوليتك.

   Layouts:
     full   full-bleed, edge to edge, sized against the live header height
     boxed  the same stage inside the container, with the theme's corner radius
     split  media beside the text — the calm variant, no scrim, no video

   ── Video: the four things that are not optional ───────────────────────────
   1. `muted` + `playsinline` — without BOTH, iOS refuses to autoplay and the
      shopper gets a black rectangle with a play button over the headline.
   2. A poster image, always. It is the first paint, the reduced-motion
      fallback, and the mobile fallback — so a slide with no poster and a slow
      connection is a slide with nothing in it.
   3. `prefers-reduced-motion` gets the poster and no playback. The CSS hides
      the video; the inline script also pauses it, because hidden video still
      decodes frames and still costs battery.
   4. Mobile can opt out entirely (`video_on_mobile`). A full-screen clip on a
      phone connection is the most expensive thing on the page.

   The stat strip is flat settings (stat1_* … stat3_*), NOT blocks. No widget
   in this theme mixes two block types, and the discriminating field is
   undocumented — so a fixed three-slot strip is the honest trade.

   Blocks:
     slide → the carousel (fade transition, one <h1> on the first slide)
   ========================================================================= #}

{% set id = widget.id %}
{% set d = widget.data %}
{% set slides = widget.blocks | default([]) %}
{% set count = slides | length %}

{% set layout = d.layout | default('full', true) %}
{% set isSplit = layout == 'split' %}
{% set isBoxed = layout == 'boxed' %}
{% set isFull = layout == 'full' %}

{% set height = d.height | default('full', true) %}
{% set heightM = d.height_mobile | default('large', true) %}
{% set align = d.text_align | default('start', true) %}
{% set isCentered = align == 'center' %}
{% set scrim = d.scrim | default('medium', true) %}
{% set showMotif = d.show_speed_motif | default(true) %}
{% set videoOnMobile = d.video_on_mobile | default(false) %}

{% set autoplay = d.autoplay | default(true) %}
{% set speed = d.autoplay_speed | default(7, true) %}
{% set showDots = d.show_dots | default(true) %}
{% set showArrows = d.show_arrows | default(true) %}

{# ---- stat strip, built from flat settings ---- #}
{% set showStats = d.show_stats | default(true) %}
{% set stat1n = d.stat1_number | default('') %}
{% set stat2n = d.stat2_number | default('') %}
{% set stat3n = d.stat3_number | default('') %}
{% set hasStats = showStats and (stat1n or stat2n or stat3n) %}

{% set sectionBg = d.section_background | default('void', true) %}
{% if sectionBg == 'canvas' %}{% set sectionBgVal = 'var(--color-bg-primary)' %}
{% elif sectionBg == 'none' %}{% set sectionBgVal = 'transparent' %}
{% else %}{% set sectionBgVal = 'var(--color-media)' %}{% endif %}

{# ---- heights ----
   Every value lands on `min-height`, never `height` — a floor, not a ceiling.
   That is what stops a long Arabic headline (which wraps taller than its
   English equivalent) from being clipped instead of pushing the stage taller.
   `full` subtracts the live header height, published by the header widget. #}
{% if height == 'medium' %}{% set hDesk = '520px' %}
{% elif height == 'large' %}{% set hDesk = '660px' %}
{% else %}{% set hDesk = 'calc(100svh - var(--header-h, 132px))' %}{% endif %}

{% if heightM == 'auto' %}{% set hMob = 'auto' %}
{% elif heightM == 'medium' %}{% set hMob = '440px' %}
{% elif heightM == 'full' %}{% set hMob = 'calc(100svh - var(--header-h, 132px))' %}
{% else %}{% set hMob = '560px' %}{% endif %}

{% if scrim == 'none' %}{% set scrimCls = '' %}
{% elif scrim == 'light' %}{% set scrimCls = 'riyada-scrim riyada-scrim--light' %}
{% elif scrim == 'heavy' %}{% set scrimCls = 'riyada-scrim riyada-scrim--heavy' %}
{% else %}{% set scrimCls = 'riyada-scrim riyada-scrim--medium' %}{% endif %}


<style>
  /* ===================== section shell ===================== */
  #riyada-hero-{{ id }} {
    background: {{ sectionBgVal }};
    {% if isBoxed %}padding-block: 20px;{% endif %}
  }

  /* ===================== the stage ===================== */
  .riyada-hero-{{ id }}-stage {
    position: relative;
    overflow: hidden;
    {% if isBoxed %}border-radius: var(--radius-card);{% endif %}
  }

  .riyada-hero-{{ id }}-slide {
    position: relative;
    display: flex;
    align-items: {{ 'center' if isSplit or isCentered else 'flex-end' }};
    min-height: {{ hDesk }};
    background: var(--color-media);
    overflow: hidden;
  }
  @media (max-width: 1023px) {
    .riyada-hero-{{ id }}-slide {
      min-height: {{ hMob }};
      {% if hMob == 'auto' %}padding-block: 40px;{% endif %}
      align-items: {{ 'center' if isSplit else 'flex-end' }};
    }
  }

  /* ---- media plate: poster underneath, video on top ---- */
  .riyada-hero-{{ id }}-media { position: absolute; inset: 0; z-index: 0; }
  .riyada-hero-{{ id }}-media img,
  .riyada-hero-{{ id }}-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .riyada-hero-{{ id }}-media video { position: absolute; inset: 0; }

  {% if not videoOnMobile %}
  /* A full-screen clip on a phone connection is the most expensive asset on
     the page — the poster carries the slide instead. */
  @media (max-width: 767px) {
    .riyada-hero-{{ id }}-media video { display: none; }
  }
  {% endif %}

  @media (prefers-reduced-motion: reduce) {
    .riyada-hero-{{ id }}-media video { display: none; }
  }

  {% if showMotif %}
  /* Speed lines — the brand motif, over the media and under the copy. */
  .riyada-hero-{{ id }}-slide::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-image: repeating-linear-gradient(
      115deg,
      rgba(255, 255, 255, 0.055) 0 2px,
      transparent 2px 15px
    );
  }
  html[dir="rtl"] .riyada-hero-{{ id }}-slide::after {
    background-image: repeating-linear-gradient(
      65deg,
      rgba(255, 255, 255, 0.055) 0 2px,
      transparent 2px 15px
    );
  }
  {% endif %}

  .riyada-hero-{{ id }}-inner {
    position: relative;
    z-index: 3;
    width: 100%;
    padding-block: clamp(36px, 6vw, 72px);
  }
  {% if hasStats %}
  /* leave room for the strip pinned to the stage floor */
  @media (min-width: 768px) {
    .riyada-hero-{{ id }}-inner { padding-block-end: 128px; }
  }
  {% endif %}

  /* ===================== split row ===================== */
  {% if isSplit %}
  .riyada-hero-{{ id }}-row {
    display: grid;
    align-items: center;
    gap: 48px;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }
  @media (max-width: 1023px) {
    .riyada-hero-{{ id }}-row { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .riyada-hero-{{ id }}-splitmedia { order: -1; }
  }
  .riyada-hero-{{ id }}-splitmedia {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: var(--color-media);
    aspect-ratio: 4 / 5;
  }
  .riyada-hero-{{ id }}-splitmedia img { width: 100%; height: 100%; object-fit: cover; }
  {% endif %}

  /* ===================== copy ===================== */
  .riyada-hero-{{ id }}-text {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: {{ '100%' if isSplit else '54rem' }};
    {% if isCentered %}
    align-items: center;
    text-align: center;
    margin-inline: auto;
    {% else %}
    align-items: flex-start;
    {% endif %}
  }

  .riyada-hero-{{ id }}-title {
    margin: 0;
    font-family: var(--font-display-ar);
    font-size: clamp(2.5rem, 7.5vw, 6rem);
    font-weight: 700;
    line-height: 0.96;
    letter-spacing: normal;
    text-transform: var(--display-case);
    color: {{ 'var(--color-text-primary)' if isSplit else '#FFFFFF' }};
  }
  html[dir="ltr"] .riyada-hero-{{ id }}-title {
    font-family: var(--font-display-en);
    font-weight: 400;
    letter-spacing: 0.005em;
  }
  /* Arabic display faces carry more vertical mass and the diacritics need the
     room, so the line-height that reads tight in Latin reads cramped here. */
  html[dir="rtl"] .riyada-hero-{{ id }}-title { line-height: 1.12; letter-spacing: -0.01em; }

  .riyada-hero-{{ id }}-title em,
  .riyada-hero-{{ id }}-title i { font-style: normal; color: var(--color-flame); }

  .riyada-hero-{{ id }}-sub {
    margin: 0;
    max-width: 42ch;
    font-size: clamp(0.9375rem, 1.6vw, 1.125rem);
    line-height: 1.65;
    color: {{ 'var(--color-text-secondary)' if isSplit else 'rgba(255,255,255,0.82)' }};
  }

  /* ===================== stat strip ===================== */
  {% if hasStats %}
  .riyada-hero-{{ id }}-stats {
    position: absolute;
    z-index: 4;
    inset-inline: 0;
    inset-block-end: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    background: linear-gradient(to top, rgba(0, 0, 0, 0.72), rgba(0, 0, 0, 0.18));
    backdrop-filter: blur(2px);
  }
  .riyada-hero-{{ id }}-stats > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 18px clamp(16px, 3vw, 32px);
  }
  .riyada-hero-{{ id }}-stats > div + div { border-inline-start: 1px solid rgba(255, 255, 255, 0.16); }
  .riyada-hero-{{ id }}-stats .num {
    font-family: var(--font-stat);
    font-size: clamp(1.5rem, 3.2vw, 2.5rem);
    font-weight: 400;
    line-height: 1;
    color: var(--color-flame);
  }
  .riyada-hero-{{ id }}-stats .lbl {
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.72);
  }
  /* On a phone the strip stops being an overlay and becomes a row under the
     stage — pinned, it would eat the headline it is meant to support. */
  @media (max-width: 767px) {
    .riyada-hero-{{ id }}-stats { position: static; background: var(--color-surface); border-top-color: var(--color-border); }
    .riyada-hero-{{ id }}-stats > div { padding: 14px 12px; }
    .riyada-hero-{{ id }}-stats > div + div { border-inline-start-color: var(--color-border); }
    .riyada-hero-{{ id }}-stats .lbl { color: var(--color-text-tertiary); }
  }
  {% endif %}

  /* ===================== controls ===================== */
  .riyada-hero-{{ id }}-arrow {
    position: absolute;
    top: 50%;
    z-index: 5;
    translate: 0 -50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--radius-btn);
    background: rgba(0, 0, 0, 0.35);
    color: #FFF;
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--t-base) var(--ease-out), background var(--t-fast) var(--ease-out);
  }
  .riyada-hero-{{ id }}-stage:hover .riyada-hero-{{ id }}-arrow { opacity: 1; }
  .riyada-hero-{{ id }}-arrow:hover { background: var(--color-flame); border-color: var(--color-flame); }
  .riyada-hero-{{ id }}-arrow--prev { inset-inline-start: 16px; }
  .riyada-hero-{{ id }}-arrow--next { inset-inline-end: 16px; }
  @media (hover: none) { .riyada-hero-{{ id }}-arrow { display: none; } }

  .riyada-hero-{{ id }}-dots {
    position: absolute;
    z-index: 5;
    inset-block-end: {{ '140px' if hasStats else '28px' }};
    inset-inline-start: 0;
    display: flex;
    gap: 5px;
  }
  @media (max-width: 767px) {
    .riyada-hero-{{ id }}-dots { inset-block-end: 20px; }
  }
  .riyada-hero-{{ id }}-dots .swiper-pagination-bullet {
    background: rgba(255, 255, 255, 0.4);
    opacity: 1;
    margin: 0 !important;
  }
  .riyada-hero-{{ id }}-dots .swiper-pagination-bullet-active { background: var(--color-flame); }
</style>


<section id="riyada-hero-{{ id }}"{% if count == 0 %} data-editor-only{% endif %}>
  <div class="{{ 'riyada-container' if isBoxed }}">
    <div class="riyada-hero-{{ id }}-stage" id="riyada-heroStage-{{ id }}">
      <div class="swiper riyada-swiper-clip" id="riyada-heroSw-{{ id }}">
        <div class="swiper-wrapper">

          {% for block in slides %}
            {% set s = block.data %}
            {# Out of the box: a bundled demo photo until the merchant picks one (docs/demo-images.md) #}
            {% set poster = s.slide_poster.fileUrl if s.slide_poster and s.slide_poster.fileUrl else (['demo-hero-1.jpg', 'demo-hero-2.jpg', 'demo-cta-split.jpg'][loop.index0 % 3] | assets) %}
            {% set vidFile = s.slide_video.fileUrl if s.slide_video and s.slide_video.fileUrl else '' %}
            {# Explicit if/else, NOT `vidFile | default(url)`: Nunjucks' default
               filter only substitutes for `undefined`, and vidFile is set to ''
               above — so the chained form would never fall through to the URL. #}
            {% if vidFile %}
              {% set vidSrc = vidFile %}
            {% else %}
              {% set vidSrc = s.slide_video_url | default('') %}
            {% endif %}
            {% set focal = s.slide_focal | default('center', true) %}

            <div class="swiper-slide">
              <div class="riyada-hero-{{ id }}-slide">

                {# ---- media ---- #}
                {% if not isSplit %}
                  <div class="riyada-hero-{{ id }}-media">
                    {% if poster %}
                      <img src="{{ poster }}" alt=""
                           style="object-position: {{ focal }};"
                           {% if loop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}/>
                    {% endif %}
                    {% if vidSrc %}
                      {# muted + playsinline are BOTH required or iOS blocks autoplay #}
                      <video
                        src="{{ vidSrc }}"
                        {% if poster %}poster="{{ poster }}"{% endif %}
                        style="object-position: {{ focal }};"
                        {# `autoplay` on the FIRST slide only. With effect:fade
                           every slide stays in the DOM, so autoplay on each one
                           would have all of them download and decode at once on
                           page load. The rest are started by syncVideos() when
                           they actually become the active slide. #}
                        {% if loop.first %}autoplay{% endif %}
                        muted
                        loop
                        playsinline
                        preload="{{ 'auto' if loop.first else 'none' }}"
                        aria-hidden="true"
                        tabindex="-1"></video>
                    {% endif %}
                  </div>
                  {% if scrimCls %}<span class="{{ scrimCls }}" style="z-index: 2;"></span>{% endif %}
                {% endif %}

                {# ---- copy ---- #}
                <div class="riyada-hero-{{ id }}-inner">
                  <div class="riyada-container">
                    <div class="{{ 'riyada-hero-' ~ id ~ '-row' if isSplit }}">

                      <div class="riyada-hero-{{ id }}-text">

                        {% if s.slide_eyebrow or s.slide_badge %}
                          <div class="flex items-center gap-2.5 flex-wrap">
                            {% if s.slide_eyebrow %}
                              <span class="riyada-eyebrow {{ 'riyada-eyebrow--light' if not isSplit }}">{{ s.slide_eyebrow }}</span>
                            {% endif %}
                            {% if s.slide_badge %}
                              <span class="riyada-badge riyada-badge--flame">{{ s.slide_badge }}</span>
                            {% endif %}
                          </div>
                        {% endif %}

                        {% if s.slide_title %}
                          {% if loop.first %}
                            <h1 class="riyada-hero-{{ id }}-title">{{ s.slide_title | safe }}</h1>
                          {% else %}
                            <p class="riyada-hero-{{ id }}-title">{{ s.slide_title | safe }}</p>
                          {% endif %}
                        {% endif %}

                        {% if s.slide_description %}
                          <p class="riyada-hero-{{ id }}-sub">{{ s.slide_description | safe }}</p>
                        {% endif %}

                        {% if s.slide_button_text or s.slide_button2_text %}
                          <div class="flex items-center gap-3 flex-wrap mt-1">
                            {% if s.slide_button_text %}
                              <a href="{{ s.slide_button_url | default('/shop', true) }}"
                                 class="riyada-btn riyada-btn--primary riyada-btn--lg">
                                {{ s.slide_button_text }}
                                <svg class="riyada-flip" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/>
                                </svg>
                              </a>
                            {% endif %}
                            {% if s.slide_button2_text %}
                              <a href="{{ s.slide_button2_url | default('/shop', true) }}"
                                 class="riyada-btn {{ 'riyada-btn--outline' if isSplit else 'riyada-btn--light' }} riyada-btn--lg">
                                {{ s.slide_button2_text }}
                              </a>
                            {% endif %}
                          </div>
                        {% endif %}
                      </div>

                      {% if isSplit %}
                        <div class="riyada-hero-{{ id }}-splitmedia">
                          {% if poster %}
                            <img src="{{ poster }}" alt="{{ s.slide_title | default('', true) | replace('<br>', ' ') | striptags }}"
                                 style="object-position: {{ focal }};"
                                 {% if loop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}/>
                          {% endif %}
                        </div>
                      {% endif %}

                    </div>
                  </div>
                </div>

              </div>
            </div>
          {% endfor %}

          {# ---- editor empty state ---- #}
          {% if count == 0 %}
            <div class="swiper-slide">
              <div class="riyada-hero-{{ id }}-slide">
                <div class="riyada-hero-{{ id }}-inner">
                  <div class="riyada-container">
                    <div class="riyada-empty">
                      <span class="riyada-empty-icon">
                        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5 21 7v10l-6-3.5M3.5 6.5h10a1.5 1.5 0 0 1 1.5 1.5v8a1.5 1.5 0 0 1-1.5 1.5h-10A1.5 1.5 0 0 1 2 16V8a1.5 1.5 0 0 1 1.5-1.5Z"/>
                        </svg>
                      </span>
                      <span class="riyada-empty-title">{{ t('hero.empty_title') }}</span>
                      <p class="riyada-text-sm m-0">{{ t('hero.empty_desc') }}</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          {% endif %}

        </div>
      </div>

      {# ---- dots, positioned inside the container gutter ---- #}
      {% if showDots and count > 1 %}
        <div class="riyada-container" style="position: absolute; inset-inline: 0; inset-block-end: 0; z-index: 5; pointer-events: none;">
          <div class="riyada-hero-{{ id }}-dots" id="riyada-heroDots-{{ id }}" style="pointer-events: auto;"></div>
        </div>
      {% endif %}

      {% if showArrows and count > 1 %}
        <button type="button" id="riyada-heroPrev-{{ id }}"
                class="riyada-hero-{{ id }}-arrow riyada-hero-{{ id }}-arrow--prev"
                aria-label="{{ t('common.prev') }}">
          <svg class="riyada-flip" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6"/>
          </svg>
        </button>
        <button type="button" id="riyada-heroNext-{{ id }}"
                class="riyada-hero-{{ id }}-arrow riyada-hero-{{ id }}-arrow--next"
                aria-label="{{ t('common.next') }}">
          <svg class="riyada-flip" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/>
          </svg>
        </button>
      {% endif %}

      {# ---- stat strip ---- #}
      {% if hasStats %}
        <div class="riyada-hero-{{ id }}-stats">
          {% if stat1n %}
            <div><span class="num">{{ stat1n }}</span><span class="lbl">{{ d.stat1_label | default('') }}</span></div>
          {% endif %}
          {% if stat2n %}
            <div><span class="num">{{ stat2n }}</span><span class="lbl">{{ d.stat2_label | default('') }}</span></div>
          {% endif %}
          {% if stat3n %}
            <div><span class="num">{{ stat3n }}</span><span class="lbl">{{ d.stat3_label | default('') }}</span></div>
          {% endif %}
        </div>
      {% endif %}

    </div>
  </div>
</section>

<script>
  (function () {
    var stage = document.getElementById('riyada-heroStage-{{ id }}');
    if (!stage) return;

    /* Reduced motion: the CSS already hides every video, but a hidden <video>
       still decodes frames and still drains a battery. Pause and unload it. */
    var calm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)');
    if (calm && calm.matches) {
      stage.querySelectorAll('video').forEach(function (v) {
        v.autoplay = false;
        v.pause();
        v.removeAttribute('src');
        v.load();
      });
    }

    /* Single slide (or none) needs no slider at all. */
    if ({{ count }} < 2) return;

    var el = document.getElementById('riyada-heroSw-{{ id }}');
    if (!el || typeof Swiper === 'undefined') return;

    new Swiper(el, {
      effect: 'fade',
      fadeEffect: { crossFade: true },
      speed: 600,
      loop: true,
      grabCursor: false,
      {% if autoplay and settings.enableAnimations != false %}
      autoplay: { delay: {{ (speed * 1000) | int }}, disableOnInteraction: false, pauseOnMouseEnter: true },
      {% endif %}
      {% if showDots %}
      pagination: { el: '#riyada-heroDots-{{ id }}', clickable: true },
      {% endif %}
      {% if showArrows %}
      navigation: { prevEl: '#riyada-heroPrev-{{ id }}', nextEl: '#riyada-heroNext-{{ id }}' },
      {% endif %}
      a11y: { enabled: true },
      on: {
        /* Runs on init as well as on every change: with loop:true the slide
           that is active at init is not necessarily slide 0 (Swiper prepends
           duplicates), so the markup's `autoplay` on the first slide is not
           enough on its own. A paused non-active clip is the whole point —
           fade keeps every slide mounted at full size. */
        init: syncVideos,
        slideChange: syncVideos
      }
    });

    function syncVideos() {
      var sw = this;
      sw.slides.forEach(function (slide, i) {
        var v = slide.querySelector('video');
        if (!v || !v.getAttribute('src')) return;
        if (i === sw.activeIndex) {
          var p = v.play();
          /* Autoplay can still be refused (data saver, low power mode). The
             poster is already behind the video, so a rejection is silent. */
          if (p && p.catch) p.catch(function () {});
        } else {
          v.pause();
        }
      });
    }
  })();
</script>

{# Per-section palette. Emits nothing at all unless `colors_enabled` is on, so
   the switch IS the revert. Must stay after the widget's own <style> — see the
   partial's header for why. #}
{% ui "section-colors.njk", scope='#riyada-hero-' ~ id, c=d %}

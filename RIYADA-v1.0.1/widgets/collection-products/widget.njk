{# ============================================================================
   RIYADA PRODUCTS SECTION
   ----------------------------------------------------------------------------
   Two layouts: grid · slider. Cards come from ui/product-card.njk (SSR) or
   RiyadaCard.build() (the AJAX fallback used when the merchant hasn't picked
   products yet, so the section is never empty on a fresh install).

   Column counts drive the shared `.riyada-grid` primitive through CSS vars —
   this widget ships no grid CSS of its own. The var names (--cols-desktop /
   --cols-tablet / --cols-mobile) are the same ones RiyadaCard's grid renderer
   writes in main.js, so a server-rendered grid and an AJAX one are identical.
   ========================================================================= #}

{% set id = widget.id %}
{% set d = widget.data %}

{% set products = d.featuredCollection | default([]) %}
{% set hasServer = (products | length) > 0 %}

{% set eyebrow = d.eyebrow | default(t('defaults.best_sellers'), true) %}
{% set title = d.title | default(t('products.title'), true) %}
{% set desc = d.description | default('') %}

{% set layout = d.layout | default('slider', true) %}
{% set isSlider = layout == 'slider' %}
{% set headerAlign = d.header_align | default('split', true) %}
{% set isCenter = headerAlign == 'center' %}

{% set bg = d.background | default('canvas', true) %}
{% set cardSurface = d.card_surface | default(true) %}
{% set limit = d.limit | default(10, true) %}
{% set ratio = d.card_image_ratio | default('1x1', true) %}

{% set viewAllUrl = d.view_all_url | default('') %}
{% set viewAllTextRaw = d.view_all_text | default('') %}
{% if viewAllTextRaw %}{% set viewAllText = viewAllTextRaw %}{% else %}{% set viewAllText = t('common.view_all') %}{% endif %}

{% set showArrows = d.show_arrows | default(true) %}
{% set showProgress = d.show_progress | default(true) %}

{# ---- columns ---- #}
{% set colsD = d.columns_desktop | default('4', true) %}
{% set colsM = d.columns_mobile | default('2', true) %}
{% if colsD == '3' %}{% set spv = 3 %}
{% elif colsD == '5' %}{% set spv = 5 %}
{% elif colsD == '6' %}{% set spv = 6 %}
{% else %}{% set spv = 4 %}{% endif %}
{# tablet sits one step below desktop, floored at 3 #}
{% set spvTablet = 3 if spv > 3 else spv %}

{# ---- background ---- #}
{% if bg == 'surface' %}{% set bgVal = 'var(--color-surface)' %}
{% elif bg == 'well' %}{% set bgVal = 'var(--color-bg-tertiary)' %}
{% elif bg == 'void' %}{% set bgVal = 'var(--color-media)' %}
{% elif bg == 'alt' %}{% set bgVal = 'var(--color-section-b)' %}
{% else %}{% set bgVal = 'var(--color-bg-primary)' %}{% endif %}


<style>
  #riyada-cp-{{ id }} { background: {{ bgVal }}; }

  /* ---------- slider ----------
     Swiper REQUIRES the container to clip horizontally — with `overflow:visible`
     every slide paints across the whole page and blows out the layout.
     `overflow-x: clip` clips sideways while still letting the flame glow and the
     hover lift bleed vertically; `hidden` is the fallback where clip is absent. */
  .riyada-cp-{{ id }}-sw { overflow: hidden; }
  @supports (overflow-x: clip) {
    .riyada-cp-{{ id }}-sw { overflow-x: clip; overflow-y: visible; }
  }
  .riyada-cp-{{ id }}-sw .swiper-wrapper { align-items: stretch; }
  .riyada-cp-{{ id }}-sw .swiper-slide { height: auto; display: flex; }
  .riyada-cp-{{ id }}-sw .swiper-slide > * { width: 100%; }

  /* thin progress line instead of a chunky scrollbar */
  .riyada-cp-{{ id }}-prog {
    position: relative !important;
    inset: auto !important;
    width: 100%;
    height: 2px;
    margin-top: 28px;
    background: var(--color-border) !important;
  }
  .riyada-cp-{{ id }}-prog .swiper-scrollbar-drag {
    height: 100%;
    border-radius: 0;
    background: var(--color-flame) !important;
    cursor: grab;
  }

  {% if not cardSurface %}
  /* borderless variant — the cards dissolve into the section until hovered.
     The media plate stays true black either way; that is the constant. */
  #riyada-cp-{{ id }} .riyada-pcard { border-color: transparent; background: transparent; }
  #riyada-cp-{{ id }} .riyada-pcard:hover { border-color: var(--card-hover-border); background: var(--color-surface); }
  {% endif %}

  @media (max-width: 767px) {
    .riyada-cp-{{ id }}-prog { margin-top: 20px; }
  }
</style>


<section id="riyada-cp-{{ id }}" class="riyada-section">
  <div class="riyada-container">

    {# ═══════════════ header ═══════════════ #}
    {% if eyebrow or title or desc %}
      {% if isCenter %}
        <div class="riyada-head riyada-head--center">
          <div class="riyada-head-inner">
            {% if eyebrow %}<span class="riyada-eyebrow">{{ eyebrow }}</span>{% endif %}
            {% if title %}<div class="riyada-h2">{{ title | safe }}</div>{% endif %}
            {% if desc %}<p class="riyada-lead">{{ desc | safe }}</p>{% endif %}
          </div>
        </div>
      {% else %}
        <div class="riyada-head riyada-head--split">
          <div class="riyada-head-inner">
            {% if eyebrow %}<span class="riyada-eyebrow">{{ eyebrow }}</span>{% endif %}
            {% if title %}<div class="riyada-h2">{{ title | safe }}</div>{% endif %}
            {% if desc %}<p class="riyada-lead">{{ desc | safe }}</p>{% endif %}
          </div>

          <div class="flex items-center gap-2 shrink-0">
            {% if isSlider and showArrows %}
              <div class="riyada-navs" id="cpNav-{{ id }}" {% if not hasServer %}style="display:none"{% endif %}>
                <button type="button" id="cpPrev-{{ id }}"
                        class="riyada-btn-icon riyada-btn-icon--outline riyada-btn-icon--sm"
                        aria-label="{{ t('common.prev') }}">
                  <svg class="riyada-flip" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6"/>
                  </svg>
                </button>
                <button type="button" id="cpNext-{{ id }}"
                        class="riyada-btn-icon riyada-btn-icon--outline riyada-btn-icon--sm"
                        aria-label="{{ t('common.next') }}">
                  <svg class="riyada-flip" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/>
                  </svg>
                </button>
              </div>
            {% endif %}

            {% if viewAllUrl %}
              <a href="{{ viewAllUrl }}" class="riyada-btn riyada-btn--outline riyada-btn--sm max-sm:hidden">
                {{ viewAllText }}
                <svg class="riyada-flip" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/>
                </svg>
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endif %}

    {# ═══════════════ products ═══════════════ #}
    {% if isSlider %}
      <div class="swiper riyada-cp-{{ id }}-sw" id="cpSwiper-{{ id }}">
        <div class="swiper-wrapper" id="cpWrapper-{{ id }}">
          {% for p in products %}
            {% if loop.index <= limit %}
              <div class="swiper-slide">
                {% ui "product-card.njk", product=p, image_ratio=ratio %}
              </div>
            {% endif %}
          {% endfor %}
        </div>

        {% if showProgress %}
          <div class="swiper-scrollbar riyada-cp-{{ id }}-prog" id="cpProg-{{ id }}"
               {% if not hasServer %}style="display:none"{% endif %}></div>
        {% endif %}
      </div>
    {% else %}
      <div class="riyada-grid" id="cpGrid-{{ id }}"
           style="--cols-desktop: {{ spv }}; --cols-tablet: {{ spvTablet }}; --cols-mobile: {{ colsM }};">
        {% for p in products %}
          {% if loop.index <= limit %}
            {% ui "product-card.njk", product=p, image_ratio=ratio %}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {# ═══════════════ empty ═══════════════ #}
    <div id="cpEmpty-{{ id }}" class="riyada-empty" style="display: none;">
      <span class="riyada-empty-icon">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
             stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 4h2.2l1.9 10.4a1.8 1.8 0 0 0 1.77 1.48h7.9a1.8 1.8 0 0 0 1.76-1.42L20.3 7.5H6.2"/>
          <circle cx="9.5" cy="19.5" r="1.4"/><circle cx="17" cy="19.5" r="1.4"/>
        </svg>
      </span>
      <p class="riyada-text-sm m-0">{{ t('products.no_products') }}</p>
    </div>

    {# ═══════════════ view all — centered header, or mobile ═══════════════ #}
    {% if viewAllUrl %}
      <div class="text-center mt-8 max-sm:mt-6 {{ '' if isCenter else 'sm:hidden' }}"
           id="cpViewAll-{{ id }}" {% if not hasServer %}style="display:none"{% endif %}>
        <a href="{{ viewAllUrl }}" class="riyada-btn riyada-btn--outline">
          {{ viewAllText }}
          <svg class="riyada-flip" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/>
          </svg>
        </a>
      </div>
    {% endif %}

  </div>
</section>

<script>
  (function () {
    var hasServer = {{ 'true' if hasServer else 'false' }};
    var isSlider = {{ 'true' if isSlider else 'false' }};
    var limit = {{ limit | int }};
    var cardOpts = { imageRatio: '{{ ratio }}' };

    function initSlider() {
      if (!isSlider || typeof Swiper === 'undefined') return;
      return new Swiper('#cpSwiper-{{ id }}', {
        slidesPerView: {{ 1.15 if colsM == '1' else 2.1 }},
        spaceBetween: 12,
        speed: 420,
        watchOverflow: true,
        breakpoints: {
          641:  { slidesPerView: {{ spvTablet | default(3, true) }}, spaceBetween: 16 },
          1024: { slidesPerView: {{ spv | default(4, true) }}, spaceBetween: 20 }
        },
        {% if showArrows %}
        navigation: { prevEl: '#cpPrev-{{ id }}', nextEl: '#cpNext-{{ id }}' },
        {% endif %}
        {% if showProgress %}
        scrollbar: { el: '#cpProg-{{ id }}', draggable: true, hide: false },
        {% endif %}
        a11y: { enabled: true }
      });
    }

    /* The merchant picked products → nothing to fetch. */
    if (hasServer) { initSlider(); return; }

    /* Otherwise show the latest products so the section is never empty. */
    function reveal(sel) {
      var el = document.getElementById(sel);
      if (el) el.style.display = '';
    }

    async function loadLatest() {
      var empty = document.getElementById('cpEmpty-{{ id }}');
      try {
        var res = await fetch('/ajax/search/products?q=&sort=created-desc');
        var data = await res.json();
        var items = (data.products || data.items || data.data || []).slice(0, limit);

        // Empty store: bundled demo products so the section isn't blank (cards link to /shop, no add-to-cart)
        if (!items.length && window.Qumra && Qumra.demo) items = Qumra.demo.products(limit);
        if (!items.length) { if (empty) empty.style.display = ''; return; }

        var box = document.getElementById(isSlider ? 'cpWrapper-{{ id }}' : 'cpGrid-{{ id }}');
        if (!box) return;

        if (isSlider) {
          box.innerHTML = items
            .map(function (p) { return '<div class="swiper-slide">' + RiyadaCard.build(p, cardOpts) + '</div>'; })
            .join('');
          if (window.Alpine) box.querySelectorAll('[x-data]').forEach(function (el) { Alpine.initTree(el); });
        } else {
          RiyadaCard.mount(box, items, cardOpts);
        }

        reveal('cpNav-{{ id }}');
        reveal('cpProg-{{ id }}');
        reveal('cpViewAll-{{ id }}');
        initSlider();
      } catch (e) {
        console.error('[collection-products] could not load latest products', e);
        if (empty) empty.style.display = '';
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadLatest);
    } else {
      loadLatest();
    }
  })();
</script>

{# Per-section palette. Emits nothing at all unless `colors_enabled` is on, so
   the switch IS the revert. Must stay after the widget's own <style> — see the
   partial's header for why. #}
{% ui "section-colors.njk", scope='#riyada-cp-' ~ id, c=d %}

{# ============================================================================
   RIYADA FEATURES BAR — the service strip
   ----------------------------------------------------------------------------
   Three styles:
     trust    icon box + title + description   (shipping / exchange / support…)
     compact  icon + short label on one line   (dense strip under the hero)
     marquee  infinite scrolling ticker

   The icon set is the store's service promise, not decoration: free shipping,
   free size exchange, authentic supplements, cash on delivery, size guide.

   ── The `light` background ────────────────────────────────────────────────
   Picking it adds `.riyada-invert`, which flips the whole token set to
   paper-on-white for this section only (style.css §01). Nothing inside needs a
   variant: the icons, text, borders and dividers all read from tokens, so they
   re-colour themselves. That is the one sanctioned way to put a light band in
   a dark-first theme — hand-painting white here would drift the moment the
   palette changes.
   ========================================================================= #}

{% set id = widget.id %}
{% set d = widget.data %}
{% set items = widget.blocks | default([]) %}
{% set count = items | length %}

{% set style = d.style | default('trust', true) %}
{% set isCompact = style == 'compact' %}
{% set isMarquee = style == 'marquee' %}

{% set bg = d.background | default('canvas', true) %}
{% set tone = d.icon_tone | default('flame', true) %}
{% set shape = d.icon_shape | default('square', true) %}
{% set cols = d.columns | default('4', true) %}
{% set align = d.align | default('start', true) %}
{% set isCenter = align == 'center' %}
{% set dividers = d.show_dividers | default(true) %}
{% set boxed = d.boxed | default(false) %}
{% set borderTop = d.border_top | default(false) %}
{% set borderBottom = d.border_bottom | default(true) %}
{% set tight = d.compact | default(false) %}
{% set mqSpeed = d.marquee_speed | default(26, true) %}

{# ---- background ----
   `light` and `flame` are the two that change what "readable" means inside the
   section, so each carries its own token overrides further down. #}
{% set isLight = bg == 'light' %}
{% set isFlame = bg == 'flame' %}
{% if bg == 'surface' %}{% set bgVal = 'var(--color-surface)' %}
{% elif bg == 'well' %}{% set bgVal = 'var(--color-bg-tertiary)' %}
{% elif bg == 'alt' %}{% set bgVal = 'var(--color-section-b)' %}
{% elif bg == 'void' %}{% set bgVal = 'var(--color-media)' %}
{% elif isFlame %}{% set bgVal = 'var(--color-flame-solid)' %}
{% elif isLight %}{% set bgVal = 'var(--color-light)' %}
{% elif bg == 'none' %}{% set bgVal = 'transparent' %}
{% else %}{% set bgVal = 'var(--color-bg-primary)' %}{% endif %}

{# ---- icon colours ---- #}
{% if tone == 'light' %}
  {% set iconFg = 'var(--color-text-primary)' %}{% set iconBg = 'var(--color-surface-alt)' %}
{% elif tone == 'success' %}
  {% set iconFg = 'var(--color-success)' %}{% set iconBg = 'var(--color-success-light)' %}
{% else %}
  {% set iconFg = 'var(--color-flame)' %}{% set iconBg = 'var(--color-flame-wash)' %}
{% endif %}

{# On the flame band every tinted chip disappears — swap to translucent white. #}
{% if isFlame %}
  {% set iconFg = '#FFFFFF' %}{% set iconBg = 'rgba(255,255,255,0.16)' %}
{% endif %}

{# ---- responsive column count for the mid breakpoint ---- #}
{% set colsInt = cols | int %}
{% set colsMid = 3 if colsInt > 3 else colsInt %}


{# ============================ ICON LIBRARY ============================
   Line icons on a 24×24 grid, 1.7 stroke — matches the rest of the theme.
   `refresh` is kept as an alias so older page JSON keeps working.
   ==================================================================== #}
{% macro icon(name, size) %}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none"
     stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true">
  {% if name == 'shipping' %}
    <path d="M2.5 6h11v9.5h-11z"/><path d="M13.5 9.5h3.3l3.2 3v3h-6.5z"/>
    <circle cx="6.5" cy="17.5" r="2"/><circle cx="17" cy="17.5" r="2"/>
  {% elif name == 'returns' or name == 'refresh' or name == 'exchange' %}
    <path d="M3 12a9 9 0 1 0 9-9 9.7 9.7 0 0 0-6.7 2.7L3 8"/><path d="M3 3v5h5"/>
  {% elif name == 'ruler' %}
    <rect x="2.2" y="8.5" width="19.6" height="7" rx="1.6"/>
    <path d="M6.4 8.5v3M10 8.5v4.4M13.6 8.5v3M17.2 8.5v4.4"/>
  {% elif name == 'dumbbell' %}
    <path d="M6.5 8v8M4 9.5v5M17.5 8v8M20 9.5v5M6.5 12h11"/>
  {% elif name == 'bottle' %}
    <path d="M10 2.8h4v2.4l1.6 2.2a4 4 0 0 1 .7 2.3v8.6a2.4 2.4 0 0 1-2.4 2.4h-3.8a2.4 2.4 0 0 1-2.4-2.4v-8.6a4 4 0 0 1 .7-2.3L10 5.2z"/>
    <path d="M7.7 12.5h8.6"/>
  {% elif name == 'medal' %}
    <circle cx="12" cy="14.8" r="5.2"/><path d="m10.6 13.6 1.4 1.4 2.6-2.7"/>
    <path d="M8.6 9.8 6.2 3.2h11.6l-2.4 6.6"/>
  {% elif name == 'shoe' %}
    <path d="M2.6 15.6h6l2.6-3.2 2.6 1.7h4.4a3.8 3.8 0 0 1 3.2 1.9v2.4H2.6z"/>
    <path d="M2.6 15.6V9.2h3l1.4 2.6"/>
  {% elif name == 'cash' %}
    <rect x="2.5" y="6" width="19" height="12" rx="2.2"/><circle cx="12" cy="12" r="2.6"/>
    <path d="M6 10v4M18 10v4"/>
  {% elif name == 'warranty' or name == 'authentic' %}
    <path d="M12 3l7.5 3v5.6c0 4.5-3.1 7.3-7.5 8.9-4.4-1.6-7.5-4.4-7.5-8.9V6z"/>
    <path d="M9 12.2l2.2 2.2 4.3-4.4"/>
  {% elif name == 'shield' %}
    <path d="M12 3l7.5 3v5.6c0 4.5-3.1 7.3-7.5 8.9-4.4-1.6-7.5-4.4-7.5-8.9V6z"/>
    <rect x="9.4" y="11.2" width="5.2" height="4.2" rx="1"/>
    <path d="M10.7 11.2V10a1.3 1.3 0 0 1 2.6 0v1.2"/>
  {% elif name == 'card' %}
    <rect x="2.5" y="5.5" width="19" height="13" rx="2.5"/><path d="M2.5 10h19"/>
    <path d="M6 14.5h3.5"/>
  {% elif name == 'installment' %}
    <rect x="3" y="4.5" width="18" height="15.5" rx="2.5"/><path d="M3 9.5h18"/>
    <path d="M7.5 3v3M16.5 3v3"/><path d="M7.5 13.5h2M14.5 13.5h2M7.5 16.8h2M14.5 16.8h2"/>
  {% elif name == 'support' %}
    <path d="M4 13.5v-1.5a8 8 0 0 1 16 0v1.5"/>
    <rect x="2.5" y="12.5" width="4" height="6" rx="1.8"/>
    <rect x="17.5" y="12.5" width="4" height="6" rx="1.8"/>
    <path d="M20 18.5v.6a2.4 2.4 0 0 1-2.4 2.4H13"/>
  {% elif name == 'clock' %}
    <circle cx="12" cy="12" r="8.75"/><path d="M12 7.2V12l3.4 2"/>
  {% elif name == 'badge' %}
    <path d="M12 2.8l2.2 1.6 2.7-.3 1 2.5 2.3 1.4-.7 2.6.7 2.6-2.3 1.4-1 2.5-2.7-.3L12 19.4l-2.2-1.6-2.7.3-1-2.5-2.3-1.4.7-2.6-.7-2.6 2.3-1.4 1-2.5 2.7.3z"/>
    <path d="M9.2 11.9l2 2 3.6-3.7"/>
  {% elif name == 'box' %}
    <path d="M3 7.6 12 3l9 4.6v8.8L12 21l-9-4.6z"/>
    <path d="M3 7.6 12 12l9-4.4"/><path d="M12 12v9"/>
  {% elif name == 'star' %}
    <path d="m12 3.1 2.7 5.5 6 .9-4.3 4.3 1 6-5.4-2.9-5.4 2.9 1-6L3.3 9.5l6-.9z"/>
  {% elif name == 'bolt' %}
    <path d="M13.2 2.6 5.3 14.4h5.1l-.6 7 7.9-11.8h-5.1z"/>
  {% else %}
    <circle cx="12" cy="12" r="8.75"/><path d="m8.2 12.3 2.6 2.6 5-5.2"/>
  {% endif %}
</svg>
{% endmacro %}

{# One pass of the ticker. Called twice — .riyada-marquee-track translates by
   exactly -50%, so the content must appear exactly twice or the loop jumps. #}
{% macro mqRun(list, hidden) %}
  <div class="flex items-center" style="gap: var(--marquee-gap, 32px);"
       {% if hidden %}aria-hidden="true"{% endif %}>
    {% for block in list %}
      {% set f = block.data %}
      {% if f.title %}
        <span class="riyada-fb-{{ id }}-mq-item">
          {{ icon(f.icon | default('check', true), 16) }}{{ f.title }}
        </span>
      {% endif %}
    {% endfor %}
  </div>
{% endmacro %}


<style>
  /* ================= shell ================= */
  #riyada-fb-{{ id }} {
    background: {{ bgVal }};
    {% if borderTop %}border-top: 1px solid var(--color-border);{% endif %}
    {% if borderBottom %}border-bottom: 1px solid var(--color-border);{% endif %}
    {% if isMarquee %}
    padding-block: {{ '12px' if tight else '18px' }};
    {% else %}
    padding-block: {{ '22px' if tight else '36px' }};
    {% endif %}
  }
  @media (max-width: 767px) {
    #riyada-fb-{{ id }} { padding-block: {{ '12px' if tight or isMarquee else '24px' }}; }
  }

  {% if isFlame %}
  /* On the flame band the neutral tokens would be unreadable, so they are
     redefined for the whole subtree rather than overridden per element. */
  #riyada-fb-{{ id }} {
    --color-text-primary: #FFFFFF;
    --color-text-secondary: rgba(255, 255, 255, 0.82);
    --color-text-tertiary: rgba(255, 255, 255, 0.68);
    --color-border: rgba(255, 255, 255, 0.24);
    --color-surface: transparent;
  }
  {% endif %}

  {% if boxed %}
  /* the whole strip becomes one bordered card floating on the section bg */
  .riyada-fb-{{ id }}-box {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: {{ 'transparent' if isFlame else 'var(--color-surface)' }};
    padding: {{ '16px' if tight else '22px' }};
  }
  {% endif %}

  /* ================= grid ================= */
  .riyada-fb-{{ id }}-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: {{ '16px 12px' if isCompact else '22px 16px' }};
  }
  @media (min-width: 768px) {
    .riyada-fb-{{ id }}-grid { grid-template-columns: repeat({{ colsMid }}, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .riyada-fb-{{ id }}-grid { grid-template-columns: repeat({{ colsInt }}, minmax(0, 1fr)); gap: 0; }
  }

  {% if dividers %}
  /* 1px rules between cells — this theme leans on lines, not shadows.
     Only from the breakpoint where every cell sits on ONE row; below that the
     rule lands mid-wrap and reads as a random stripe. */
  @media (min-width: 1024px) {
    .riyada-fb-{{ id }}-item + .riyada-fb-{{ id }}-item {
      border-inline-start: 1px solid var(--color-border);
    }
    .riyada-fb-{{ id }}-item { padding-inline: 22px; }
  }
  {% endif %}

  /* ================= item ================= */
  .riyada-fb-{{ id }}-item {
    display: flex;
    align-items: center;
    gap: {{ '9px' if isCompact else '13px' }};
    min-width: 0;
    {% if isCenter %}
    justify-content: center;
    text-align: center;
    {% if not isCompact %}flex-direction: column;{% endif %}
    {% endif %}
  }

  .riyada-fb-{{ id }}-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    color: {{ iconFg }};
    {% if shape != 'bare' %}
    background: {{ iconBg }};
    width: {{ '34px' if isCompact else '44px' }};
    height: {{ '34px' if isCompact else '44px' }};
    border-radius: {{ '50%' if shape == 'circle' else 'var(--radius-sm)' }};
    {% endif %}
  }

  .riyada-fb-{{ id }}-title {
    font-size: {{ '0.8125rem' if isCompact else '0.9375rem' }};
    font-weight: 800;
    line-height: 1.35;
    color: var(--color-text-primary);
  }
  .riyada-fb-{{ id }}-desc {
    margin-top: 3px;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-text-tertiary);
  }

  /* ================= marquee ================= */
  .riyada-fb-{{ id }}-mq {
    --marquee-dur: {{ mqSpeed }}s;
    --marquee-gap: 32px;
  }
  .riyada-fb-{{ id }}-mq-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: none;
    font-size: 0.8125rem;
    font-weight: 700;
    white-space: nowrap;
    color: var(--color-text-primary);
    text-transform: var(--display-case);
  }
  html[dir="ltr"] .riyada-fb-{{ id }}-mq-item { letter-spacing: 0.08em; }
  .riyada-fb-{{ id }}-mq-item svg { color: {{ iconFg }}; flex: none; }
</style>


<section id="riyada-fb-{{ id }}" class="{{ 'riyada-invert' if isLight }}"{% if count == 0 %} data-editor-only{% endif %}>
  {% if isMarquee %}

    {# ---------------- marquee ----------------
       The list is printed twice so the loop has no seam; the second copy is
       aria-hidden so a screen reader never announces the same promise twice. #}
    <div class="riyada-marquee riyada-fb-{{ id }}-mq">
      <div class="riyada-marquee-track">
        {{ mqRun(items, false) }}
        {{ mqRun(items, true) }}
      </div>
    </div>

  {% else %}

    {# ---------------- grid ---------------- #}
    <div class="riyada-container">
      <div class="{{ 'riyada-fb-' ~ id ~ '-box' if boxed }}">
        <div class="riyada-fb-{{ id }}-grid">
          {% for block in items %}
            {% set f = block.data %}
            {% if f.title %}
              <div class="riyada-fb-{{ id }}-item">
                <span class="riyada-fb-{{ id }}-icon">
                  {{ icon(f.icon | default('check', true), 20 if isCompact else 22) }}
                </span>
                <div class="min-w-0">
                  <div class="riyada-fb-{{ id }}-title">{{ f.title }}</div>
                  {% if f.description and not isCompact %}
                    <div class="riyada-fb-{{ id }}-desc">{{ f.description }}</div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}

          {# editor-only: a bar with no blocks would otherwise render as a bare strip #}
          {% if count == 0 %}
            <div class="riyada-fb-{{ id }}-item" style="grid-column: 1 / -1;">
              <span class="riyada-caption">{{ t('pages.features.empty') }}</span>
            </div>
          {% endif %}
        </div>
      </div>
    </div>

  {% endif %}
</section>

{# Per-section palette. Emits nothing at all unless `colors_enabled` is on, so
   the switch IS the revert. Must stay after the widget's own <style> — see the
   partial's header for why. #}
{% ui "section-colors.njk", scope='#riyada-fb-' ~ id, c=d %}

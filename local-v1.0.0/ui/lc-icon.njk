  <path d="M11.5 19.5c-4.2-.6-6.6-3.8-6-8.6 4.4.2 7 3.5 6 8.6Z"/>
  <path d="M12.5 19.5c-.6-5.2 1.9-8.8 6.5-9.3.4 5-2.1 8.7-6.5 9.3Z"/>
  <path d="M11.5 19.5 8 14M12.5 19.5l3.5-5.3M12 19.5v1.5"/>

{# ============================================================================
   LOCAL · ICON LIBRARY — line icons on a 24px grid, stroke = currentColor
   ----------------------------------------------------------------------------
   Usage:   ui "lc-icon.njk", name='leaf', size=36
   Locals:  name   one of the keys below (unknown → 'leaf')
            size   px, default 32
            stroke stroke width, default 1.3

   ⚠️  The keys are also the `options` of the `icon` select in
   widgets/icon-columns/schema.json — add an icon HERE and THERE, or the
   merchant cannot pick it (or picks one that draws the fallback).
   ========================================================================= #}
{% set n = data.name | default('leaf') %}
{% set s = data.size | default(32) %}
<svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="{{ data.stroke | default(1.3) }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">

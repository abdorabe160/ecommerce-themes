{
  "name": "أعمدة نصية مع أيقونات",
  "settings": {
    "title": {
      "type": "string",
      "label": {
        "ar": "عنوان القسم (اختياري)",
        "en": "Section heading (optional)"
      },
      "default": "تسوّق حسب احتياجك"
    },
    "columns": {
      "type": "range",
      "label": {
        "ar": "عدد الأعمدة — كمبيوتر",
        "en": "Columns — desktop"
      },
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5
    },
    "circle_size": {
      "type": "range",
      "label": {
        "ar": "حجم الدائرة",
        "en": "Circle size"
      },
      "min": 56,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 92
    },
    "icon_scale": {
      "type": "range",
      "label": {
        "ar": "حجم الأيقونة داخل الدائرة",
        "en": "Icon size inside the circle"
      },
      "min": 30,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 58
    },
    "shape": {
      "type": "select",
      "label": {
        "ar": "الشكل",
        "en": "Shape"
      },
      "default": "circle",
      "options": [
        {
          "value": "circle",
          "label": {
            "ar": "دائرة",
            "en": "Circle"
          }
        },
        {
          "value": "rounded",
          "label": {
            "ar": "مربع بزوايا مدوّرة",
            "en": "Rounded square"
          }
        },
        {
          "value": "none",
          "label": {
            "ar": "بدون خلفية",
            "en": "No background"
          }
        }
      ]
    },
    "mobile_layout": {
      "type": "select",
      "label": {
        "ar": "على الجوال",
        "en": "On mobile"
      },
      "default": "slider",
      "options": [
        {
          "value": "slider",
          "label": {
            "ar": "شريط قابل للسحب",
            "en": "Swipeable row"
          }
        },
        {
          "value": "grid",
          "label": {
            "ar": "عمودان",
            "en": "Two columns"
          }
        }
      ]
    },
    "padding_top": {
      "type": "range",
      "label": {
        "ar": "المسافة أعلى القسم",
        "en": "Space above the section"
      },
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    "padding_bottom": {
      "type": "range",
      "label": {
        "ar": "المسافة أسفل القسم",
        "en": "Space below the section"
      },
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    "colors_enabled": {
      "type": "boolean",
      "label": {
        "ar": "ألوان مخصّصة لهذا القسم — أطفئه للرجوع لألوان الثيم",
        "en": "Custom colours for this section — switch off to restore theme colours"
      },
      "default": false
    },
    "color_bg": {
      "type": "color",
      "label": {
        "ar": "خلفية القسم",
        "en": "Section background"
      },
      "default": ""
    },
    "color_title": {
      "type": "color",
      "label": {
        "ar": "لون العناوين",
        "en": "Headings colour"
      },
      "default": ""
    },
    "color_text": {
      "type": "color",
      "label": {
        "ar": "لون النص الصغير",
        "en": "Small text colour"
      },
      "default": ""
    }
  },

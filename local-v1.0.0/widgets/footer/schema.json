{
  "name": "الفوتر الرئيسي",
  "settings": {
    "show_newsletter": {
      "type": "boolean",
      "label": {
        "ar": "▸ بطاقة النشرة البريدية أعلى الفوتر",
        "en": "▸ Newsletter card at the top of the footer"
      },
      "default": true
    },
    "newsletter_title": {
      "type": "string",
      "label": {
        "ar": "النشرة — العنوان",
        "en": "Newsletter — title"
      },
      "default": "اشترك في نشرتنا"
    },
    "newsletter_text": {
      "type": "string",
      "label": {
        "ar": "النشرة — سطر الوصف",
        "en": "Newsletter — supporting line"
      },
      "default": "وصفات موسمية ومنتجات جديدة."
    },
    "newsletter_action": {
      "type": "string",
      "label": {
        "ar": "النشرة — رابط استقبال البريد من مزوّد القوائم (Mailchimp / Klaviyo). بدونه لن يظهر النموذج",
        "en": "Newsletter — form action URL from your list provider (Mailchimp / Klaviyo). Without it the form is not rendered"
      },
      "default": ""
    },
    "newsletter_field": {
      "type": "string",
      "label": {
        "ar": "النشرة — اسم حقل البريد عند المزوّد",
        "en": "Newsletter — provider's email field name"
      },
      "default": "EMAIL"
    },
    "newsletter_placeholder": {
      "type": "string",
      "label": {
        "ar": "النشرة — نص داخل الحقل",
        "en": "Newsletter — input placeholder"
      },
      "default": "أدخل بريدك الإلكتروني"
    },
    "newsletter_button": {
      "type": "string",
      "label": {
        "ar": "النشرة — نص الزر (اتركه فارغاً لزر السهم الدائري)",
        "en": "Newsletter — button label (leave empty for the round arrow button)"
      },
      "default": "اشترك"
    },
    "newsletter_note": {
      "type": "text",
      "label": {
        "ar": "النشرة — السطر الصغير تحت النموذج (يقبل روابط)",
        "en": "Newsletter — fine print under the form (accepts links)"
      },
      "default": ""
    },
    "show_logo": {
      "type": "boolean",
      "label": {
        "ar": "▸ عمود العلامة — الشعار ونبذة وروابط التواصل",
        "en": "▸ Brand column — logo, blurb and social links"
      },
      "default": true
    },
    "footer_logo": {
      "type": "media",
      "label": {
        "ar": "شعار الفوتر — فارغ = شعار المتجر",
        "en": "Footer logo — empty uses the store logo"
      }
    },

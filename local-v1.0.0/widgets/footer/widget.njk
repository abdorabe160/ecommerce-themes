{# ============================================================================
   LOCAL · FOOTER
   ----------------------------------------------------------------------------
     ┌─────────────────────── warm ground (--color-footer) ────────────────────┐
     │  ╭────────────────────────── white card ──────────────────────────────╮ │
     │  │ Subscribe to our newsletter          ( email…              [Join] ) │ │
     │  │ seasonal recipes, new arrivals…                                     │ │
     │  ╰─────────────────────────────────────────────────────────────────────╯ │
     │                                                                          │
     │  LOGO              Shop          Help          Contact us               │
     │  a short blurb     links…        links…        (◌) title / text × 4     │
     │  (f) (x) (ig)                                                            │
     │  ──────────────────────────────────────────────────────────────────────  │
     │  © 2026 Local · Privacy · Terms        [mada][visa]…        (🌐 English) │
     └──────────────────────────────────────────────────────────────────────────┘

   Setting keys are the previous footer's (newsletter_* · contact1..4_* ·
   social_* · pay_* · copyright · bottom_menu · show_language_switcher), so
   anything a merchant already filled in carries over.

   ── Newsletter ──
   A NATIVE form POST to the merchant's list provider (`newsletter_action`),
   not fetch(): providers send no CORS headers, so fetch() fails silently and
   says "subscribed" when nothing was stored. No action URL → no field, only a
   setup hint (an input that posts nowhere collects nothing while looking like
   it works). `novalidate` + checkValidity() keeps the browser's rules but
   shows the messages in the STORE's language. The honeypot is hidden INLINE
   on purpose — it must not depend on the stylesheet loading.

   ── Language, not market ──
   Qumra resolves the market server-side; the language is the one thing a
   shopper can switch from here (`{% form 'lang' %}`), so that is the pill.

   ── Contact text is dir="auto" ──
   "+966 55 000 0000" starts with no strong character and would render
   reversed in RTL; `dir="auto"` lets each value pick its own direction.

   Styling: assets/style.css → "15.20 FOOTER · LOCAL" (+ 15.20.1 badges).
   ========================================================================= #}

{% macro extAttrs(url) %}{% if url and url.indexOf('://') > -1 and not (store.url and url.indexOf(store.url) == 0) %} target="_blank" rel="noopener noreferrer"{% endif %}{% endmacro %}
{% macro mediaUrl(m) %}{% if m %}{% if m is string %}{{ m }}{% elif m.fileUrl %}{{ m.fileUrl }}{% elif m.url %}{{ m.url }}{% endif %}{% endif %}{% endmacro %}

{% set id = widget.id %}
{% set d = widget.data %}
{% set columns = widget.blocks | default([], true) %}

{% set showNl = d.show_newsletter | default(true) %}
{% set nlAction = d.newsletter_action | default('', true) %}
{% set nlField = d.newsletter_field | default('EMAIL', true) %}
{% set nlPlaceholder = d.newsletter_placeholder | default(t('newsletter.placeholder'), true) %}
{% set nlButton = d.newsletter_button | default(t('newsletter.button'), true) %}
{% set nlNote = d.newsletter_note | default('', true) %}

{% set showLogo = d.show_logo | default(true) %}
{% set logoSrc = mediaUrl(d.footer_logo) | trim %}
{% set logoSrc = logoSrc if (logoSrc | length) > 0 else (store.logo.fileUrl if store.logo and store.logo.fileUrl else '') %}
{% set storeName = store.name | default('Local') %}

{% set showContact = d.show_contact | default(true) %}
{% set hasContact = d.contact1_title or d.contact1_text or d.contact2_title or d.contact2_text or d.contact3_title or d.contact3_text or d.contact4_title or d.contact4_text %}

{% set hasPayIcon = d.pay_mada or d.pay_visa or d.pay_mastercard or d.pay_amex or d.pay_applepay or d.pay_stcpay or d.pay_tabby or d.pay_tamara or d.pay_paypal or d.pay_cod %}
{% set showPay = d.show_payments | default(true) %}
{% set showLang = d.show_language_switcher | default(true) %}
{% set copyright = d.copyright | default(storeName, true) %}
{% set bottomMenu = d.bottom_menu %}
{% set rawLang = localization.language | default('ar') %}
{% set currentLang = rawLang if rawLang == 'en' else 'ar' %}

{% set payImg1 = mediaUrl(d.payment_image_1) | trim %}
{% set payImg2 = mediaUrl(d.payment_image_2) | trim %}
{% set payImg3 = mediaUrl(d.payment_image_3) | trim %}
{% set hasPayImg = (payImg1 | length) > 0 or (payImg2 | length) > 0 or (payImg3 | length) > 0 %}
{% set showPay = showPay and (hasPayImg or hasPayIcon) %}
{% set hasSocial = d.social_facebook or d.social_x or d.social_instagram or d.social_tiktok or d.social_youtube or d.social_snapchat or d.social_whatsapp or d.social_pinterest %}

{# ═══════════════════ icons ═══════════════════ #}
{% macro contactIcon(kind) %}
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
       stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {% if kind == 'chat' %}
      <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9.3 9.3 0 0 1-2.8-.4L3 21l1.6-4.6A8.2 8.2 0 0 1 3 11.5 8.4 8.4 0 0 1 12 3a8.4 8.4 0 0 1 9 8.5Z"/><path d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01"/>
    {% elif kind == 'phone' %}
      <path d="M22 16.9v2.6a1.8 1.8 0 0 1-2 1.8 17.6 17.6 0 0 1-7.7-2.7 17.4 17.4 0 0 1-5.3-5.3A17.6 17.6 0 0 1 4.3 5.6 1.8 1.8 0 0 1 6.1 3.6h2.6a1.8 1.8 0 0 1 1.8 1.6c.1.9.3 1.7.6 2.5a1.8 1.8 0 0 1-.4 1.9l-1.1 1.1a14 14 0 0 0 5.3 5.3l1.1-1.1a1.8 1.8 0 0 1 1.9-.4c.8.3 1.6.5 2.5.6a1.8 1.8 0 0 1 1.6 1.8Z"/>
    {% elif kind == 'mail' %}
      <rect x="2.5" y="4.5" width="19" height="15" rx="2"/><path d="m3 6.5 9 6 9-6"/>
    {% elif kind == 'pin' %}
      <path d="M20 10.5c0 5.5-8 12-8 12s-8-6.5-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10.3" r="2.9"/>
    {% elif kind == 'send' %}
      <path d="M21.5 2.5 2.5 9.8l7.6 2.9 3 8L21.5 2.5Z"/><path d="m10.1 12.7 4.6-4.6"/>
    {% elif kind == 'clock' %}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v5.3l3.4 2"/>
    {% elif kind == 'truck' %}
      <path d="M2.5 6.5h10v9h-10zM12.5 10h4l3 3v2.5h-7z"/><circle cx="6.5" cy="17.6" r="1.7"/><circle cx="16.6" cy="17.6" r="1.7"/>
    {% elif kind == 'shield' %}
      <path d="M12 3 5 6v5.5c0 4.3 3 8.2 7 9.5 4-1.3 7-5.2 7-9.5V6l-7-3Z"/><path d="m9.2 12 2 2 3.6-3.8"/>
    {% elif kind == 'whatsapp' %}
      <path d="M20.5 11.7a8.4 8.4 0 0 1-12.4 7.4L3.5 20.5l1.5-4.4a8.4 8.4 0 1 1 15.5-4.4Z"/><path d="M9.3 8.6c.4 1 .8 1.6.8 1.6s-.5.7-.3 1.1a6 6 0 0 0 2.9 2.9c.4.2 1.1-.3 1.1-.3s.6.4 1.6.8"/>
    {% endif %}
  </svg>
{% endmacro %}


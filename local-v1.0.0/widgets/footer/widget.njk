    {% elif kind == 'pinterest' %}
      <path d="M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.2-2 0-2.9l1.2-5.1s-.3-.6-.3-1.5c0-1.4.8-2.5 1.8-2.5.9 0 1.3.6 1.3 1.4 0 .9-.5 2.2-.8 3.4-.3 1 .5 1.9 1.5 1.9 1.8 0 3.2-1.9 3.2-4.7 0-2.4-1.8-4.2-4.3-4.2a4.5 4.5 0 0 0-4.7 4.5c0 .9.3 1.8.8 2.3.1.1.1.2.1.3l-.3 1c0 .2-.1.2-.3.1-1.2-.6-2-2.4-2-3.8 0-3.1 2.3-6 6.5-6 3.4 0 6.1 2.4 6.1 5.7 0 3.4-2.1 6.2-5.1 6.2-1 0-2-.5-2.3-1.1l-.6 2.4c-.2.9-.8 2-1.2 2.6A10 10 0 1 0 12 2Z"/>
    {% endif %}
  </svg>
{% endmacro %}
{% macro socialLink(url, kind, label) %}{% if url %}<a href="{{ url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ label }}">{{ social(kind) }}</a>{% endif %}{% endmacro %}

{% macro contactRow(icon, title, text, url) %}
  {% if title or text %}
    <li class="lc-foot-contact">
      {% if icon and icon != 'none' %}<span class="lc-foot-contact-icon">{{ contactIcon(icon) }}</span>{% endif %}
      <span class="lc-foot-contact-body">
        {% if title %}<span class="lc-foot-contact-title" dir="auto">{{ title }}</span>{% endif %}
        {% if text %}
          {% if url %}<a href="{{ url }}" dir="auto">{{ text }}</a>{% else %}<span dir="auto">{{ text }}</span>{% endif %}
        {% endif %}
      </span>
    </li>
  {% endif %}
{% endmacro %}


<footer id="lc-footer-{{ id }}" class="lc-foot" style="--lc-logo-h: {{ d.logo_height | default(40) }}px;">
  <div class="lc-hwrap">

    {# ═══════════ newsletter card ═══════════ #}
    {% if showNl %}
      {# No provider URL yet → the card is the merchant's to-do, not the shopper's:
         it renders only inside the theme editor (html.is-builder, set in the layout). #}
      <div class="lc-foot-nl{{ '' if nlAction else ' lc-builder-only' }}" x-data="{ sent: false }">
        <div class="lc-foot-nl-copy">
          {% if d.newsletter_title %}<h2 class="lc-foot-nl-title">{{ d.newsletter_title }}</h2>{% endif %}
          {% if d.newsletter_text %}<p class="lc-foot-nl-text">{{ d.newsletter_text }}</p>{% endif %}
        </div>

        <div class="lc-foot-nl-form">
          {% if nlAction %}
            <p class="lc-foot-nl-ok" x-show="sent" x-cloak role="status">{{ t('newsletter.success') }}</p>
            {# The messages ride on data- attributes, NOT `| dump` inside @submit:
               dump emits double quotes, which closed this attribute early and left
               Alpine a broken expression — validation silently never ran. #}
            <form action="{{ nlAction }}" method="post" target="_blank" rel="noopener"
                  novalidate x-data="{ err: '' }" x-show="!sent"
                  data-err-empty="{{ t('newsletter.error_empty') }}"
                  data-err-format="{{ t('newsletter.error_format') }}"
                  @submit="
                    const f = $el.querySelector('input[type=email]');
                    if (f.checkValidity()) { err = ''; sent = true; return; }
                    $event.preventDefault();
                    err = f.value.trim() === '' ? $el.dataset.errEmpty : $el.dataset.errFormat;
                    f.focus();
                  ">
              <div class="lc-foot-field">
                <input type="email" name="{{ nlField }}" required autocomplete="email" inputmode="email"
                       :aria-invalid="err ? 'true' : 'false'" @input="err = ''"
                       placeholder="{{ nlPlaceholder }}" aria-label="{{ t('common.email') }}"/>
                <button type="submit">{{ nlButton }}</button>
              </div>
              {# honeypot — hidden inline so a missing stylesheet cannot expose it #}
              <div aria-hidden="true" style="position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0;">
                <label><span>Leave this field empty</span><input type="text" name="hy_hp" tabindex="-1" autocomplete="off"/></label>
              </div>
              <p class="lc-foot-err" x-show="err" x-text="err" x-cloak role="alert" aria-live="assertive"></p>
            </form>
            {% if nlNote %}<div class="lc-foot-nl-note">{{ nlNote | safe }}</div>{% endif %}
          {% else %}
            {# no provider URL yet: the field's shape, disabled, and why #}
            <div class="lc-foot-field is-off" aria-hidden="true">
              <input type="email" placeholder="{{ nlPlaceholder }}" disabled/>
              <button type="button" disabled>{{ nlButton }}</button>
            </div>
            <p class="lc-foot-nl-note">{{ t('newsletter.setup_hint') }}</p>
          {% endif %}
        </div>
      </div>
    {% endif %}

    {# ═══════════ columns ═══════════ #}
    <div class="lc-foot-grid">
      {% if showLogo %}
        <div class="lc-foot-brand">
          <a href="/" class="lc-foot-logo" aria-label="{{ storeName }}">
            {% if logoSrc %}<img src="{{ logoSrc }}" alt="{{ storeName }}"/>{% else %}<span>{{ storeName }}</span>{% endif %}
          </a>
          {% if d.brand_text %}<div class="lc-foot-blurb">{{ d.brand_text | safe }}</div>{% endif %}
          {% if hasSocial %}
            <div class="lc-foot-social">
              {{ socialLink(d.social_facebook, 'facebook', 'Facebook') }}
              {{ socialLink(d.social_x, 'x', 'X') }}
              {{ socialLink(d.social_instagram, 'instagram', 'Instagram') }}
              {{ socialLink(d.social_tiktok, 'tiktok', 'TikTok') }}
              {{ socialLink(d.social_youtube, 'youtube', 'YouTube') }}
              {{ socialLink(d.social_snapchat, 'snapchat', 'Snapchat') }}
              {{ socialLink(d.social_whatsapp, 'whatsapp', 'WhatsApp') }}
              {{ socialLink(d.social_pinterest, 'pinterest', 'Pinterest') }}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% for block in columns %}
        {% set b = block.data %}
        {% set items = b.menu.items if b.menu and b.menu.items else b.menu %}
        {% if items is string %}{% set items = [] %}{% endif %}
        {% if items and (items | length) > 0 %}
          <div class="lc-foot-col">
            {% if b.title %}<h2 class="lc-foot-heading">{{ b.title }}</h2>{% endif %}
            {% if items %}
              <ul class="lc-foot-links">
                {% for item in items %}
                  <li><a href="{{ item.url | default('#') }}"{{ extAttrs(item.url) }}>{{ item.title }}</a></li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}

      {% if showContact and hasContact %}
        <div class="lc-foot-col">
          {% if d.contact_title %}<h2 class="lc-foot-heading">{{ d.contact_title }}</h2>{% endif %}
          <ul class="lc-foot-contacts">
            {{ contactRow(d.contact1_icon, d.contact1_title, d.contact1_text, d.contact1_url) }}
            {{ contactRow(d.contact2_icon, d.contact2_title, d.contact2_text, d.contact2_url) }}
            {{ contactRow(d.contact3_icon, d.contact3_title, d.contact3_text, d.contact3_url) }}
            {{ contactRow(d.contact4_icon, d.contact4_title, d.contact4_text, d.contact4_url) }}
          </ul>
        </div>
      {% endif %}
    </div>

    {# ═══════════ bottom bar ═══════════ #}
    <div class="lc-foot-bar">
      <div class="lc-foot-legal">
        {# the year is written by script — a typed "© 2026" is wrong every January #}
        <span>© <span data-lc-year>2026</span> {{ copyright }}</span>
        {% if bottomMenu %}
          {% for item in (bottomMenu.items if bottomMenu.items else bottomMenu) %}
            <a href="{{ item.url | default('#') }}"{{ extAttrs(item.url) }}>{{ item.title }}</a>
          {% endfor %}
        {% endif %}
      </div>

      {% if showPay %}
        <div class="lc-foot-pay lc-footer-pay" role="list" aria-label="{{ t('footer.payments') }}">
          {% if hasPayImg %}
            {% if (payImg1 | length) > 0 %}<img src="{{ payImg1 }}" alt="" loading="lazy"/>{% endif %}
            {% if (payImg2 | length) > 0 %}<img src="{{ payImg2 }}" alt="" loading="lazy"/>{% endif %}
            {% if (payImg3 | length) > 0 %}<img src="{{ payImg3 }}" alt="" loading="lazy"/>{% endif %}
          {% else %}
            {% if d.pay_mada %}{% ui "payment-icons.njk", key='mada', label='mada' %}{% endif %}
            {% if d.pay_visa %}{% ui "payment-icons.njk", key='visa', label='Visa' %}{% endif %}
            {% if d.pay_mastercard %}{% ui "payment-icons.njk", key='mastercard', label='Mastercard' %}{% endif %}
            {% if d.pay_amex %}{% ui "payment-icons.njk", key='amex', label='American Express' %}{% endif %}
            {% if d.pay_applepay %}{% ui "payment-icons.njk", key='applepay', label='Apple Pay' %}{% endif %}
            {% if d.pay_stcpay %}{% ui "payment-icons.njk", key='stcpay', label='STC Pay' %}{% endif %}
            {% if d.pay_tabby %}{% ui "payment-icons.njk", key='tabby', label='Tabby' %}{% endif %}
            {% if d.pay_tamara %}{% ui "payment-icons.njk", key='tamara', label='Tamara' %}{% endif %}
            {% if d.pay_paypal %}{% ui "payment-icons.njk", key='paypal', label='PayPal' %}{% endif %}
            {% if d.pay_cod %}{% ui "payment-icons.njk", key='cod', label=t('footer.cod') %}{% endif %}
          {% endif %}
        </div>
      {% endif %}

      {% if showLang %}
        {% form 'lang' %}
          <button type="submit" name="lang" value="{{ 'ar' if currentLang == 'en' else 'en' }}" class="lc-foot-lang" aria-label="{{ t('common.language') }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17"/><path d="M12 3.5c2.3 2.3 3.4 5.2 3.4 8.5s-1.1 6.2-3.4 8.5c-2.3-2.3-3.4-5.2-3.4-8.5S9.7 5.8 12 3.5Z"/></svg>
            <span class="{{ 'font-body' if currentLang == 'en' else 'font-body-en' }}">{{ 'العربية' if currentLang == 'en' else 'English' }}</span>
          </button>
        {% endform %}
      {% endif %}
    </div>
  </div>
</footer>

<script>
  (function () {
    var el = document.querySelector('#lc-footer-{{ id }} [data-lc-year]');
    if (el) el.textContent = new Date().getFullYear();
  })();
</script>

{% ui "section-colors.njk", scope='#lc-footer-' ~ id, c=d %}

    {% elif kind == 'youtube' %}
      <path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.5 2.5 0 0 0-1.8 1.8A26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8ZM10 15.1V8.9l5.3 3.1-5.3 3.1Z"/>
    {% elif kind == 'snapchat' %}
      <path d="M12 2c2.7 0 4.6 2 4.7 4.7 0 .8 0 1.6-.1 2.3.4.2.9.1 1.4-.1.5-.2 1 .1 1.1.6.1.5-.2.9-.7 1.1-.5.2-1.3.5-1.5.9-.2.4.5 1.9 2.4 3 .4.2.5.6.4 1-.3.7-1.4 1-2.3 1.2-.2.3-.2.7-.4 1-.2.3-.6.3-1 .2-.6-.1-1.2-.2-1.9 0-.6.2-1.2 1.1-2.1 1.1s-1.5-.9-2.1-1.1c-.7-.2-1.3-.1-1.9 0-.4.1-.8.1-1-.2-.2-.3-.2-.7-.4-1-.9-.2-2-.5-2.3-1.2-.1-.4 0-.8.4-1 1.9-1.1 2.6-2.6 2.4-3-.2-.4-1-.7-1.5-.9-.5-.2-.8-.6-.7-1.1.1-.5.6-.8 1.1-.6.5.2 1 .3 1.4.1-.1-.7-.1-1.5-.1-2.3C7.4 4 9.3 2 12 2Z"/>

{
  "name": "شهادات العملاء",
  "settings": {
    "eyebrow": {
      "type": "string",
      "label": {
        "ar": "سطر صغير فوق العنوان (اختياري)",
        "en": "Small line above the heading (optional)"
      },
      "default": ""
    },
    "title": {
      "type": "string",
      "label": {
        "ar": "العنوان (اختياري)",
        "en": "Heading (optional)"
      },
      "default": ""
    },
    "quote_style": {
      "type": "select",
      "label": {
        "ar": "خط الاقتباس",
        "en": "Quote typeface"
      },
      "default": "serif",
      "options": [
        {
          "value": "serif",
          "label": {
            "ar": "خط كلاسيكي مائل (Crimson / أميري)",
            "en": "Classic serif italic (Crimson / Amiri)"
          }
        },
        {
          "value": "sans",
          "label": {
            "ar": "خط الثيم",
            "en": "The theme font"
          }
        }
      ]
    },
    "show_rating": {
      "type": "boolean",
      "label": {
        "ar": "إظهار نجوم التقييم",
        "en": "Show the star rating"
      },
      "default": false
    },
    "star_color": {
      "type": "color",
      "label": {
        "ar": "لون النجوم",
        "en": "Star colour"
      },
      "default": ""
    },
    "autoplay": {
      "type": "range",
      "label": {
        "ar": "التبديل التلقائي كل (ثانية) — ٠ = يدوي",
        "en": "Auto-advance every (seconds) — 0 = manual"
      },
      "min": 0,
      "max": 14,
      "step": 1,
      "unit": "s",
      "default": 7
    },
    "card_style": {
      "type": "select",
      "label": {
        "ar": "شكل البطاقة",
        "en": "Card style"
      },
      "default": "bordered",
      "options": [
        {
          "value": "bordered",
          "label": {
            "ar": "بإطار رفيع",
            "en": "Hairline border"
          }
        },
        {
          "value": "filled",
          "label": {
            "ar": "خلفية ملوّنة",
            "en": "Tinted fill"
          }
        },
        {
          "value": "plain",
          "label": {
            "ar": "بدون بطاقة",
            "en": "No card"
          }
        }
      ]
    },
    "padding_top": {
      "type": "range",
      "label": {
        "ar": "المسافة أعلى القسم",
        "en": "Space above the section"
      },
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    "padding_bottom": {
      "type": "range",
      "label": {
        "ar": "المسافة أسفل القسم",
        "en": "Space below the section"
      },
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    "colors_enabled": {
      "type": "boolean",
      "label": {
        "ar": "ألوان مخصّصة لهذا القسم — أطفئه للرجوع لألوان الثيم",
        "en": "Custom colours for this section — switch off to fall back to the theme palette"
      },
      "default": false
    },
    "color_bg": {
      "type": "color",
      "label": {
        "ar": "خلفية القسم",
        "en": "Section background"
      },
      "default": ""
    },
    "color_card": {
      "type": "color",
      "label": {
        "ar": "خلفية البطاقة",
        "en": "Card background"
      },
      "default": ""
    },
    "color_title": {
      "type": "color",
      "label": {
        "ar": "لون العناوين",
        "en": "Heading colour"
      },
      "default": ""
    },
    "color_text": {
      "type": "color",
      "label": {
        "ar": "لون نص الرأي",
        "en": "Quote colour"
      },
      "default": ""
    },
    "color_border": {
      "type": "color",
      "label": {
        "ar": "لون حدود البطاقة",
        "en": "Card border colour"
      },
      "default": ""
    }
  },
  "blocks": {
    "quote": {
      "name": "رأي",
      "settings": {
        "quote": {
          "type": "text",
          "label": {
            "ar": "نص الرأي",
            "en": "The quote"
          },
          "default": ""
        },
        "author": {
          "type": "string",
          "label": {
            "ar": "اسم العميل",
            "en": "Customer name"
          },
          "default": ""
        },
        "note": {
          "type": "string",
          "label": {
            "ar": "الصفة تحت الاسم — مثال: عميل، عميلة منذ ٢٠٢٣",
            "en": "Role under the name — e.g. Customer, Customer since 2023"
          },
          "default": ""
        },
        "rating": {
          "type": "range",
          "label": {
            "ar": "التقييم بالنجوم · ٠ لإخفائها",
            "en": "Star rating · 0 hides them"
          },
          "default": 5,
          "min": 0,
          "max": 5,
          "step": 1
        },
        "avatar": {
          "type": "media",
          "label": {
            "ar": "صورة العميل (اختيارية) — بدونها تظهر أول حرف من الاسم",
            "en": "Customer photo (optional) — without it, the name's initial shows"
          }
        }
      }
    }
  },
  "presets": [
    {
      "category": "المحتوى",
      "name": "شهادات العملاء"
    }
  ]
}

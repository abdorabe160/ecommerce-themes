  "blocks": {
    "nav_item": {
      "name": "عنصر تنقّل",
      "settings": {
        "nav_label": {
          "type": "string",
          "label": {
            "ar": "النص",
            "en": "Label"
          },
          "default": ""
        },
        "nav_url": {
          "type": "string",
          "label": {
            "ar": "الرابط — / · /shop · /collections · /blogs · /cart",
            "en": "Link — / · /shop · /collections · /blogs · /cart"
          },
          "default": "/shop"
        },
        "nav_menu": {
          "type": "menu",
          "label": {
            "ar": "قائمة منسدلة (اختيارية)",
            "en": "Dropdown menu (optional)"
          },
          "default": "header-menu"
        },
        "nav_columns": {
          "type": "select",
          "label": {
            "ar": "أعمدة القائمة المنسدلة",
            "en": "Dropdown columns"
          },
          "default": "1",
          "options": [
            {
              "value": "1",
              "label": {
                "ar": "عمود واحد",
                "en": "One column"
              }
            },
            {
              "value": "2",
              "label": {
                "ar": "عمودان",
                "en": "Two columns"
              }
            },
            {
              "value": "3",
              "label": {
                "ar": "ثلاثة أعمدة",
                "en": "Three columns"
              }
            },
            {
              "value": "4",
              "label": {
                "ar": "أربعة أعمدة",
                "en": "Four columns"
              }
            }
          ]
        },
        "nav_image": {
          "type": "media",
          "label": {
            "ar": "صورة ترويجية داخل القائمة (تظهر مع عمودين فأكثر)",
            "en": "Promo image inside the dropdown (two columns or more)"
          }
        },
        "nav_image_url": {
          "type": "string",
          "label": {
            "ar": "رابط الصورة الترويجية",
            "en": "Promo image link"
          },
          "default": ""

{
  "name": "الهيدر الرئيسي",
  "settings": {
    "sticky": {
      "type": "boolean",
      "label": {
        "ar": "▸ تثبيت الهيدر أعلى الصفحة أثناء التمرير",
        "en": "▸ Keep the header pinned while scrolling"
      },
      "default": true
    },
    "header_logo": {
      "type": "media",
      "label": {
        "ar": "▸ الشعار — اتركه فارغًا ليُستخدم شعار المتجر",
        "en": "▸ Logo — leave empty to use the store logo"
      }
    },
    "logo_height": {
      "type": "range",
      "label": {
        "ar": "ارتفاع الشعار",
        "en": "Logo height"
      },
      "min": 24,
      "max": 90,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    "show_search": {
      "type": "boolean",
      "label": {
        "ar": "▸ إظهار حقل البحث",
        "en": "▸ Show the search field"
      },
      "default": true
    },
    "search_placeholder": {
      "type": "string",
      "label": {
        "ar": "نص الحقل — اتركه فارغًا للنص المترجم",
        "en": "Field prompt — leave empty for the translated text"
      },
      "default": ""
    },
    "search_show_suggestions": {
      "type": "boolean",
      "label": {
        "ar": "إظهار كلمات البحث المقترحة",
        "en": "Show suggested search terms"
      },
      "default": true
    },
    "action_link_url": {
      "type": "string",
      "label": {
        "ar": "▸ زر مخصّص بجانب السلة — قمرة ليس بها صفحة حساب، فضع هنا أي رابط (واتساب، تتبّع الطلب، صفحة تواصل…) · فارغ = مخفي",
        "en": "▸ Custom button beside the cart — Qumra has no account page, so link anything here (WhatsApp, order tracking, contact page…) · empty hides it"
      },
      "default": ""
    },
    "action_link_label": {
      "type": "string",
      "label": {
        "ar": "نص الزر المخصّص",
        "en": "Custom button label"
      },
      "default": ""
    },
    "action_link_icon": {
      "type": "select",
      "label": {
        "ar": "أيقونة الزر المخصّص",
        "en": "Custom button icon"
      },
      "default": "whatsapp",
      "options": [
        {
          "value": "user",
          "label": {
            "ar": "شخص",
            "en": "Person"
          }
        },
        {
          "value": "whatsapp",
          "label": {
            "ar": "واتساب",
            "en": "WhatsApp"
          }
        },
        {
          "value": "phone",
          "label": {
            "ar": "هاتف",
            "en": "Phone"
          }
        },
        {
          "value": "truck",
          "label": {
            "ar": "شاحنة",
            "en": "Truck"
          }
        },
        {
          "value": "heart",
          "label": {
            "ar": "قلب",
            "en": "Heart"
          }
        }
      ]
    },
    "show_cart": {
      "type": "boolean",
      "label": {
        "ar": "إظهار السلة",
        "en": "Show the cart"
      },
      "default": true
    },
    "cart_show_total": {
      "type": "boolean",
      "label": {
        "ar": "إظهار إجمالي السلة داخل الزر",
        "en": "Show the cart total inside the button"
      },
      "default": true
    },
    "cart_free_shipping": {
      "type": "number",
      "label": {
        "ar": "▸ حد الشحن المجاني — بعملة المتجر · ٠ = إخفاء شريط التقدّم",
        "en": "▸ Free-shipping threshold — in store currency · 0 hides the progress bar"
      },
      "default": 0,
      "min": 0,
      "step": 1
    },
    "cart_upsell_title": {
      "type": "string",
      "label": {
        "ar": "عنوان «أكمل طلبك» — اتركه فارغًا لإخفاء الشريط",
        "en": "Cross-sell heading — leave empty to hide the strip"
      },
      "default": ""
    },
    "cart_upsell_products": {
      "type": "products",
      "label": {
        "ar": "منتجات «أكمل طلبك» — قمرة ليس بها اقتراحات تلقائية للسلة، فالاختيار يدوي",
        "en": "Cross-sell products — Qumra has no cart-recommendation API, so these are picked by hand"
      }
    },
    "cart_empty_collections": {
      "type": "collections",
      "label": {
        "ar": "تصنيفات تظهر عندما تكون السلة فارغة",
        "en": "Collections shown when the cart is empty"
      }
    },
    "cart_footer_dark": {
      "type": "boolean",
      "label": {
        "ar": "خلفية داكنة لتذييل السلة",
        "en": "Dark ground under the cart total"
      },
      "default": true
    },
    "cart_note": {
      "type": "string",
      "label": {
        "ar": "سطر أسفل الإجمالي",
        "en": "Line under the total"
      },
      "default": ""
    },
    "nav_enabled": {
      "type": "boolean",
      "label": {
        "ar": "▸ الصف الثاني — روابط التنقّل",
        "en": "▸ Second row — navigation links"
      },
      "default": true
    },
    "nav_extra_menu": {
      "type": "menu",
      "label": {
        "ar": "روابط إضافية بعد العناصر أعلاه",
        "en": "Extra links after the items above"
      },
      "default": "header-menu"
    },
    "show_locale": {
      "type": "boolean",
      "label": {
        "ar": "إظهار زر تبديل اللغة في الصف الثاني",

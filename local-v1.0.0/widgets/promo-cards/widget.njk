{# ============================================================================
   LOCAL · PROMO CARDS — بطاقات ترويجية
   ----------------------------------------------------------------------------
     ┌────────────┐ ┌────────────┐ ┌────────────┐
     │   picture  │ │   picture  │ │   picture  │   the picture fills the card;
     │            │ │            │ │            │   the card's colour shows
     │ Fresh…     │ │ Just in!   │ │ Collection │   before it loads / without it
     │ Finest     │ │ Superfoods │ │ Pure       │
     │ (Show more)│ │ (Show more)│ │ (Show more)│
     └────────────┘ └────────────┘ └────────────┘

   The whole card is ONE link (the button is a styled span inside it), so the
   tap target is the card and there are no nested links.

   `mobile_layout: slider` → LocalSlider (desktop shows `columns`, locked when
   they all fit; phone swipes with a peek). `stack` → a plain grid everywhere.

   Styling: assets/style.css → "15.5.4 PROMO CARDS · LOCAL".
   ========================================================================= #}

{% set id = widget.id %}
{% set d = widget.data %}
{% set cards = widget.blocks | default([], true) %}
{% set count = cards | length %}

{% set perView = d.columns | default(3, true) %}
{% set r = d.card_ratio | default('3x4') %}
{% set ratioVal = '3 / 4' if r == '3x4' else ('4 / 5' if r == '4x5' else ('1 / 1' if r == '1x1' else '2 / 3')) %}
{% set align = d.text_align | default('center') %}
{% set isSlider = (d.mobile_layout | default('slider')) == 'slider' %}

{% macro mediaUrl(m) %}{% if m %}{% if m is string %}{{ m }}{% elif m.fileUrl %}{{ m.fileUrl }}{% elif m.url %}{{ m.url }}{% endif %}{% endif %}{% endmacro %}

{% macro card(b, wrapCls) %}
  {% set src = mediaUrl(b.image) | trim %}
  <a href="{{ b.url | default('#', true) }}"
     class="lc-promo {{ wrapCls }} {{ 'has-fade' if (b.fade is not defined or b.fade) and (src | length) > 0 }}"
     style="--lc-promo-bg: {{ b.bg_color | default('color-mix(in srgb, var(--color-bg-tertiary) 94%, var(--color-text-primary))', true) }};
            --lc-promo-fg: {{ b.text_color | default('var(--color-text-primary)', true) }};
            --lc-promo-btn: {{ b.button_bg | default('var(--color-accent)', true) }};
            --lc-promo-btn-fg: {{ b.button_text_color | default('var(--color-text-on-accent)', true) }};">
    {% if (src | length) > 0 %}
      <img src="{{ src }}" alt="{{ b.title | default('', true) }}" class="lc-promo-img" loading="lazy"/>
    {% endif %}
    <span class="lc-promo-copy">
      {% if b.eyebrow %}<span class="lc-promo-eyebrow">{{ b.eyebrow }}</span>{% endif %}
      {% if b.title %}<span class="lc-promo-title">{{ b.title }}</span>{% endif %}
      {% if b.button_text %}<span class="lc-promo-btn">{{ b.button_text }}</span>{% endif %}
    </span>
  </a>
{% endmacro %}

<section id="lc-promo-{{ id }}"
         class="lc-promos lc-promos--{{ align }}"
         style="--lc-promo-ratio: {{ ratioVal }}; --lc-promo-n: {{ perView }}; padding-block: {{ d.padding_top | default(32) }}px {{ d.padding_bottom | default(56) }}px;">
  <div class="lc-hwrap">
    {% if d.title %}<h2 class="lc-sec-title">{{ d.title }}</h2>{% endif %}

    {% if count == 0 %}
      <p class="lc-icols-empty">{{ t('common.placeholder_add') }}</p>

    {% elif isSlider %}
      <div class="swiper" id="lc-promoSw-{{ id }}">
        <div class="swiper-wrapper">
          {% for block in cards %}{{ card(block.data, 'swiper-slide') }}{% endfor %}
        </div>
      </div>
      <div class="lc-pager lc-promos-pager">
        <button type="button" class="lc-pager-arrow" id="lc-promoPrev-{{ id }}" aria-label="{{ t('common.prev') }}">
          <svg class="lc-flip" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m15 5-7 7 7 7"/>
          </svg>
        </button>
        <div class="lc-pager-dots" id="lc-promoDots-{{ id }}"></div>
        <button type="button" class="lc-pager-arrow" id="lc-promoNext-{{ id }}" aria-label="{{ t('common.next') }}">
          <svg class="lc-flip" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7"/>
          </svg>
        </button>
      </div>

    {% else %}
      <div class="lc-promos-grid">
        {% for block in cards %}{{ card(block.data, '') }}{% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% if isSlider and count > 0 %}
<script>
  LocalReady(function () {
    LocalSlider({
      root: 'lc-promo-{{ id }}',
      el: 'lc-promoSw-{{ id }}',
      prev: '#lc-promoPrev-{{ id }}',
      next: '#lc-promoNext-{{ id }}',
      dots: '#lc-promoDots-{{ id }}',
      desk: {{ perView | default(3, true) }},
      mob: 1.15,
      gap: 22
    });
  });
</script>
{% endif %}

{% ui "section-colors.njk", scope='#lc-promo-' ~ id, c=d %}

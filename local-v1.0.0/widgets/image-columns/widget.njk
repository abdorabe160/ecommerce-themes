{# ============================================================================
   LOCAL · IMAGE COLUMNS — أعمدة نصية مع صور
   ----------------------------------------------------------------------------
     Shop by Category
     ┌────────┐ ┌────────┐ ┌────────┐ ┌────────┐ ┌────────┐ ┌────────┐
     │  ◖◗    │ │   ▯    │ │  ◒     │ │   ◯    │ │   ▮    │ │   ◆    │
     │ Bread  │ │ Flour  │ │ Fruits │ │ Meals  │ │ Drinks │ │  Meat  │
     └────────┘ └────────┘ └────────┘ └────────┘ └────────┘ └────────┘
                              ‹   ▬▬  •   ›

   Each block is an image, a title, an optional small line and a link — the
   merchant builds it by hand, so it can point at collections, /shop, or
   anywhere else. The whole card is the link.

   `layout: slider` pages the row with Swiper (one page = the visible count),
   `grid` wraps it. When every card already fits, the slider locks and the
   pager hides itself (`.is-locked`).

   Pager: the shared `.lc-pager` (see "15.5 HERO · LOCAL → PAGER").
   Styling: assets/style.css → "15.5.1 IMAGE COLUMNS · LOCAL".
   ========================================================================= #}

{% set id = widget.id %}
{% set d = widget.data %}
{% set cols = widget.blocks | default([], true) %}
{% set count = cols | length %}

{% set title = d.title | default('', true) %}
{% set perView = d.columns | default(6, true) %}
{% set perViewM = d.columns_mobile | default('2.3', true) %}
{% set isSlider = (d.layout | default('slider')) == 'slider' %}
{% set cardStyle = d.card_style | default('bordered') %}
{% set imgH = d.image_size | default(120) %}
{% set fit = d.image_fit | default('contain') %}
{% set showArrows = d.show_arrows | default(true) %}
{% set showDots = d.show_dots | default(true) %}

{% macro mediaUrl(m) %}{% if m %}{% if m is string %}{{ m }}{% elif m.fileUrl %}{{ m.fileUrl }}{% elif m.url %}{{ m.url }}{% endif %}{% endif %}{% endmacro %}

{% macro card(b, wrapCls) %}
  {% set src = mediaUrl(b.image) | trim %}
  <a href="{{ b.url | default('#', true) }}" class="lc-icol {{ wrapCls }}">
    <span class="lc-icol-media">
      {% if (src | length) > 0 %}
        <img src="{{ src }}" alt="{{ b.title | default('', true) }}" loading="lazy"/>
      {% else %}
        <span class="lc-icol-ph" aria-hidden="true"><svg class="lc-ph-art" viewBox="0 0 200 170" fill="none" aria-hidden="true" focusable="false"><path class="lc-ph-fill" d="M100 48c-14-10-44-12-58 8-16 22-8 64 12 86 12 13 28 20 46 12 18 8 34 1 46-12 20-22 28-64 12-86-14-20-44-18-58-8Z"/><rect class="lc-ph-tint" x="94" y="20" width="12" height="34" rx="6"/><ellipse class="lc-ph-tint" cx="128" cy="30" rx="22" ry="11" transform="rotate(-24 128 30)"/></svg></span>
      {% endif %}
    </span>
    {% if b.title %}<span class="lc-icol-title">{{ b.title }}</span>{% endif %}
    {% if b.subtitle %}<span class="lc-icol-sub">{{ b.subtitle }}</span>{% endif %}
  </a>
{% endmacro %}

<section id="lc-icols-{{ id }}"
         class="lc-icols lc-icols--{{ cardStyle }} lc-icols--{{ fit }}"
         style="--lc-icol-img: {{ imgH }}px; --lc-icol-n: {{ perView }}; padding-block: {{ d.padding_top | default(64) }}px {{ d.padding_bottom | default(48) }}px;">
  <div class="lc-hwrap">

    {% if title %}
      <h2 class="lc-sec-title">{{ title }}</h2>
    {% endif %}

    {% if count == 0 %}
      <p class="lc-icols-empty">{{ t('common.placeholder_add') }}</p>

    {% elif isSlider %}
      <div class="swiper lc-icols-track" id="lc-icolsSw-{{ id }}">
        <div class="swiper-wrapper">
          {% for block in cols %}{{ card(block.data, 'swiper-slide') }}{% endfor %}
        </div>
      </div>

      {% if showArrows or showDots %}
        <div class="lc-pager lc-icols-pager">
          {% if showArrows %}
            <button type="button" class="lc-pager-arrow" id="lc-icolsPrev-{{ id }}" aria-label="{{ t('common.prev') }}">
              <svg class="lc-flip" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m15 5-7 7 7 7"/>
              </svg>
            </button>
          {% endif %}
          {% if showDots %}<div class="lc-pager-dots" id="lc-icolsDots-{{ id }}"></div>{% endif %}
          {% if showArrows %}
            <button type="button" class="lc-pager-arrow" id="lc-icolsNext-{{ id }}" aria-label="{{ t('common.next') }}">
              <svg class="lc-flip" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7"/>
              </svg>
            </button>
          {% endif %}
        </div>
      {% endif %}

    {% else %}
      <div class="lc-icols-grid">
        {% for block in cols %}{{ card(block.data, '') }}{% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% if isSlider and count > 0 %}
<script>
  (function () {
    var root = document.getElementById('lc-icols-{{ id }}');
    var el = document.getElementById('lc-icolsSw-{{ id }}');
    if (!root || !el || typeof Swiper === 'undefined') return;

    var DESK = {{ perView | default(6, true) }};
    var MOB = {{ perViewM | default('2.3', true) }};
    /* One page = what is visible, rounded down — so a 2.3 row on a phone moves
       two cards per swipe and still leaves the third peeking. */
    var bp = function (n) { return { slidesPerView: n, slidesPerGroup: Math.max(1, Math.floor(n)) }; };

    /* Hides the pager when there is nothing to page through. */
    var lock = function (sw) { root.classList.toggle('is-locked', !!sw.isLocked); };

    new Swiper(el, Object.assign({
      spaceBetween: 12,
      speed: 600,
      watchOverflow: true,
      {% if showArrows %}
      navigation: { prevEl: '#lc-icolsPrev-{{ id }}', nextEl: '#lc-icolsNext-{{ id }}', disabledClass: 'is-disabled' },
      {% endif %}
      {% if showDots %}
      pagination: {
        el: '#lc-icolsDots-{{ id }}',
        clickable: true,
        bulletClass: 'lc-pager-dot',
        bulletActiveClass: 'is-active',
        renderBullet: function (i, cls) {
          return '<button type="button" class="' + cls + '" aria-label="' + (i + 1) + '"><span></span></button>';
        }
      },
      {% endif %}
      a11y: { enabled: true },
      breakpoints: {
        640:  Object.assign({ spaceBetween: 16 }, bp(Math.min(3, DESK))),
        900:  Object.assign({ spaceBetween: 20 }, bp(Math.min(4, DESK))),
        1200: Object.assign({ spaceBetween: 22 }, bp(DESK))
      },
      on: { init: lock, resize: lock, breakpoint: lock }
    }, bp(MOB)));
  })();
</script>
{% endif %}

{% ui "section-colors.njk", scope='#lc-icols-' ~ id, c=d %}

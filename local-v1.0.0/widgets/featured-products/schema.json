{
  "name": "تشكيلة مميزة",
  "settings": {
    "title": {
      "type": "string",
      "label": {
        "ar": "▸ العنوان",
        "en": "▸ Heading"
      },
      "default": "أحدث المنتجات"
    },
    "view_all_text": {
      "type": "string",
      "label": {
        "ar": "نص رابط «عرض الكل» — فارغ = مخفي",
        "en": "“View all” link label — empty hides it"
      },
      "default": "عرض كل المنتجات"
    },
    "view_all_url": {
      "type": "string",
      "label": {
        "ar": "رابط «عرض الكل» · /shop · /collections",
        "en": "“View all” link · /shop · /collections"
      },
      "default": "/shop"
    },
    "products": {
      "type": "products",
      "label": {
        "ar": "▸ المنتجات — اتركها فارغة لعرض منتجات تلقائية حسب الترتيب أدناه",
        "en": "▸ Products — leave empty to show products automatically, ordered as below"
      }
    },
    "auto_sort": {
      "type": "select",
      "label": {
        "ar": "الترتيب التلقائي (عند ترك المنتجات فارغة)",
        "en": "Automatic order (when no products are picked)"
      },
      "default": "created-desc",
      "options": [
        {
          "value": "created-desc",
          "label": {
            "ar": "الأحدث",
            "en": "Newest"
          }
        },
        {
          "value": "rating-desc",
          "label": {
            "ar": "الأعلى تقييماً",
            "en": "Highest rated"
          }
        },
        {
          "value": "price-asc",
          "label": {
            "ar": "الأقل سعراً",
            "en": "Lowest price"
          }
        }
      ]
    },
    "auto_limit": {
      "type": "range",
      "label": {
        "ar": "عدد المنتجات التلقائية",
        "en": "Number of automatic products"
      },
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    "columns": {
      "type": "range",
      "label": {
        "ar": "المنتجات الظاهرة — كمبيوتر",
        "en": "Visible products — desktop"
      },
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    "columns_mobile": {
      "type": "select",
      "label": {
        "ar": "المنتجات الظاهرة — جوال",
        "en": "Visible products — mobile"
      },
      "default": "1.5",
      "options": [
        {
          "value": "1.2",
          "label": {
            "ar": "واحد وجزء صغير",
            "en": "One and a sliver"
          }
        },
        {
          "value": "1.5",
          "label": {
            "ar": "واحد ونصف",
            "en": "One and a half"
          }
        },
        {
          "value": "2",
          "label": {
            "ar": "اثنان",
            "en": "Two"
          }
        }
      ]
    },
    "image_ratio": {
      "type": "select",
      "label": {
        "ar": "نسبة الصورة",
        "en": "Image ratio"
      },
      "default": "1x1",
      "options": [
        {
          "value": "1x1",
          "label": {
            "ar": "مربعة",
            "en": "Square"
          }
        },
        {
          "value": "4x5",
          "label": {
            "ar": "طولية ٤:٥",
            "en": "Portrait 4:5"
          }
        },
        {
          "value": "3x4",
          "label": {
            "ar": "طولية ٣:٤",
            "en": "Portrait 3:4"
          }
        }
      ]
    },
    "button_action": {
      "type": "select",
      "label": {
        "ar": "زر البطاقة",
        "en": "Card button"
      },
      "default": "add",
      "options": [
        {
          "value": "add",
          "label": {
            "ar": "أضف للسلة",
            "en": "Add to cart"
          }
        },
        {
          "value": "buy",
          "label": {
            "ar": "اشتري الآن — يذهب للدفع مباشرة",
            "en": "Buy now — straight to checkout"
          }
        }
      ]
    },
    "show_rating": {
      "type": "boolean",
      "label": {
        "ar": "إظهار التقييم (للمنتجات التي لها مراجعات فقط)",
        "en": "Show the rating (only for products that have reviews)"
      },
      "default": true
    },
    "show_badges": {
      "type": "boolean",
      "label": {
        "ar": "إظهار شارات «تخفيض» و«جديد» — «جديد» يظهر للمنتجات الموسومة بـ new",
        "en": "Show “Sale” and “New” badges — “New” shows on products tagged new"
      },
      "default": true
    },
    "show_quick_view": {
      "type": "boolean",
      "label": {
        "ar": "إظهار زر العرض السريع (العين) على صورة المنتج",
        "en": "Show the quick-view (eye) button on the product image"
      },
      "default": true
    },
    "show_arrows": {
      "type": "boolean",
      "label": {
        "ar": "إظهار الأسهم",
        "en": "Show arrows"
      },
      "default": true
    },
    "show_dots": {
      "type": "boolean",
      "label": {
        "ar": "إظهار مؤشر الصفحات",
        "en": "Show the page indicator"
      },
      "default": true
    },
    "padding_top": {
      "type": "range",
      "label": {
        "ar": "المسافة أعلى القسم",
        "en": "Space above the section"
      },
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    "padding_bottom": {
      "type": "range",
      "label": {
        "ar": "المسافة أسفل القسم",
        "en": "Space below the section"
      },
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    "colors_enabled": {
      "type": "boolean",
      "label": {
        "ar": "ألوان مخصّصة لهذا القسم — أطفئه للرجوع لألوان الثيم",
        "en": "Custom colours for this section — switch off to restore theme colours"
      },
      "default": false
    },
    "color_bg": {
      "type": "color",
      "label": {
        "ar": "خلفية القسم",
        "en": "Section background"
      },
      "default": ""
    },
    "color_card": {
      "type": "color",
      "label": {
        "ar": "خلفية البطاقة",
        "en": "Card background"
      },
      "default": ""
    },
    "color_title": {
      "type": "color",
      "label": {
        "ar": "لون العنوان وأسماء المنتجات",
        "en": "Heading and product names"
      },
      "default": ""
    },
    "color_text": {
      "type": "color",
      "label": {
        "ar": "لون النص الثانوي",
        "en": "Secondary text"
      },
      "default": ""
    },
    "color_accent": {
      "type": "color",
      "label": {
        "ar": "لون الزر",
        "en": "Button colour"
      },
      "default": ""
    },
    "color_border": {
      "type": "color",
      "label": {
        "ar": "لون الإطار",
        "en": "Border colour"
      },
      "default": ""
    }
  },
  "presets": [
    {
      "category": "المنتجات",
      "name": "تشكيلة مميزة"
    }
  ]
}

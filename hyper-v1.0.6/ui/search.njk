{# ============================================================================
   HYPER SEARCH — a sheet that takes over the top of the page
   ----------------------------------------------------------------------------
   Opened from the header's search icon via toggleModal('search'). Results come
   from Qumra.search.suggest(), which is ALREADY debounced at 300ms internally
   and whose third argument is a RESULT LIMIT, not a delay — so there is no
   @input.debounce here. Adding one would stack 120ms on top of 300ms and make
   the sheet feel slower for no gain.

   The `query.length < 2` guard before the call is load-bearing: suggest()
   returns early below two characters WITHOUT invoking the callback, so calling
   it anyway would leave `searching` stuck true the moment someone backspaces
   down to one letter, and the spinner would never clear.

   Contracts with assets/main.js — do not rename:
     $store.modal.current  ·  Qumra.search.suggest  ·  Qumra.utils.formatMoney
   All styling lives in assets/style.css → "15.3 SEARCH SHEET".
   ========================================================================= #}

{# The bare `x-data` is required, not decorative: Alpine only processes
   directives inside a tree rooted at an x-data, so without it the overlay's
   x-show below is never initialised and the dimmer never appears. #}
<div x-data x-cloak>

  {# ---- Overlay ---- #}
  <div x-show="$store.modal.current === 'search'"
       @click="$store.modal.close()"
       class="taqa-overlay"
       x-transition:enter="transition ease-out duration-300"
       x-transition:enter-start="opacity-0"
       x-transition:enter-end="opacity-100"
       x-transition:leave="transition ease-in duration-200"
       x-transition:leave-start="opacity-100"
       x-transition:leave-end="opacity-0"></div>

  {# ---- Sheet ---- #}
  <div x-show="$store.modal.current === 'search'"
       x-transition:enter="transition ease-out duration-300"
       x-transition:enter-start="opacity-0 -translate-y-4"
       x-transition:enter-end="opacity-100 translate-y-0"
       x-transition:leave="transition ease-in duration-200"
       x-transition:leave-start="opacity-100 translate-y-0"
       x-transition:leave-end="opacity-0 -translate-y-2"
       class="hy-search-sheet taqa-scroll-thin"
       x-data="{
         query: '',
         products: [],
         queries: [],
         searching: false,
         run() {
           if (this.query.length < 2) { this.products = []; this.queries = []; this.searching = false; return }
           this.searching = true;
           Qumra.search.suggest(this.query, (data) => {
             const r = data.resources || {};
             this.products = r.products || data.products || [];
             this.queries  = r.queries  || [];
             this.searching = false;
           }, 8);
         },
         money(v) { return Qumra.utils.formatMoney(v) },
         onSale(p) {
           const c = p.pricing && p.pricing.compareAtPrice, x = p.pricing && p.pricing.price;
           return !!(c && c > x);
         }
       }"
       {# Focus the field once the sheet is actually on screen. Focusing while
          it is still display:none silently does nothing in every browser. #}
       x-effect="if ($store.modal.current === 'search') $nextTick(() => $refs.field && $refs.field.focus())">

    <div class="hy-container">

      {# ---- head ---- #}
      <div class="hy-search-head">
        <span class="hy-label">{{ t('pages.search.title') }}</span>
        <button type="button"
                @click="$store.modal.close()"
                class="hy-icon-btn"
                aria-label="{{ t('common.close') }}">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
            <path stroke-linecap="round" d="M6 18 18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      {# ---- field ---- #}
      <form action="/shop" method="get" class="hy-search-field" role="search">
        <input type="search"
               name="q"
               x-ref="field"
               x-model="query"
               @input="run()"
               class="hy-search-input"
               placeholder="{{ t('pages.search.placeholder') }}"
               autocomplete="off"
               aria-label="{{ t('pages.search.title') }}"/>

        <button type="button"
                x-show="query.length > 0"
                @click="query = ''; run(); $refs.field.focus()"
                class="hy-search-clear">{{ t('common.cancel') }}</button>
      </form>

      {# ---- suggested queries ---- #}
      <div x-show="queries.length > 0" class="pt-7">
        <span class="hy-label mb-4">{{ t('pages.search.suggestions') }}</span>
        <div class="hy-sugg">
          <template x-for="q in queries" :key="q">
            <a :href="'/shop?q=' + encodeURIComponent(q)" class="hy-sugg-link" x-text="q"></a>
          </template>
        </div>
      </div>

      {# ---- product hits ---- #}
      <div x-show="products.length > 0" class="pt-7 pb-10">
        <div class="flex items-center justify-between gap-4 mb-5">
          <span class="hy-label">{{ t('pages.search.products') }}</span>
          <a :href="'/shop?q=' + encodeURIComponent(query)" class="hy-link">
            {{ t('pages.search.view_all') }}
          </a>
        </div>

        <div class="hy-hits">
          <template x-for="item in products" :key="item._id">
            <a :href="'/product/' + (item.slug || item.handle)"
               @click="$store.modal.close()"
               class="hy-hit">

              <div class="hy-hit-media">
                <template x-if="item.images && item.images.length">
                  <img :src="item.images[0].fileUrl" :alt="item.title" loading="lazy"/>
                </template>
                <template x-if="!item.images || !item.images.length">
                  <div class="hy-hit-empty">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18"/>
                      <circle cx="8.75" cy="9" r="1.5"/>
                      <path stroke-linecap="round" stroke-linejoin="round" d="m4 17 5-4.5 4.5 4 3-2.5L21 18"/>
                    </svg>
                  </div>
                </template>
              </div>

              <p class="hy-hit-title hy-clamp-2" x-text="item.title"></p>

              <div class="hy-hit-prices">
                <span class="hy-price" :class="onSale(item) && 'hy-price--sale'"
                      x-text="money(item.pricing.price)"></span>
                <template x-if="onSale(item)">
                  <span class="hy-price-was" x-text="money(item.pricing.compareAtPrice)"></span>
                </template>
              </div>
            </a>
          </template>
        </div>
      </div>

      {# ---- loading ---- #}
      <div x-show="searching" x-cloak class="py-16 flex items-center justify-center">
        <span class="hy-spinner"></span>
      </div>

      {# ---- no results ---- #}
      <div x-show="!searching && query.length >= 2 && products.length === 0 && queries.length === 0"
           x-cloak
           class="hy-empty">
        <span class="hy-empty-title">{{ t('pages.search.no_results') }}</span>
        <p class="m-0 text-sm">{{ t('pages.search.try_different') }}</p>
      </div>

    </div>
  </div>
</div>

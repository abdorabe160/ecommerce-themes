{#- Store name, shortened to its first 3 words (full name goes in the caller's title=).
    One rule for header, footer and sidebar. -#}
{%- set storeName = (store.name or 'HYPER') | trim -%}
{%- set nameWords = [] -%}{%- for w in storeName.split(' ') -%}{%- if w -%}{%- set _x = nameWords.push(w) -%}{%- endif -%}{%- endfor -%}
{%- if nameWords | length > 3 -%}{{ nameWords.slice(0, 3).join(' ') }}…{%- else -%}{{ storeName }}{%- endif -%}

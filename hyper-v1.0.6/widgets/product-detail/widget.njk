{# ============================================================================
   HYPER PRODUCT PAGE (PDP)
   ----------------------------------------------------------------------------
   ⚠️  DATA REALITY: Qumra products expose only _id, title, handle, description
   (HTML), sku, quantity, pricing, images[], options[], variants[], tags[],
   averageRating, reviewsCount — there are NO metafields. So per-product copy
   lives in `description` (a panel with source="description" renders it) and
   store-wide copy (shipping, returns, care) in a panel with source="text".
   Nothing here invents a data source that does not exist.

   ⚠️  JS CONTRACT — carried over verbatim from the previous version. The whole
   <script> at the bottom is unchanged; only the markup around it was rebuilt:
     · reads `context.product` (NOT the bare `product` global)
     · exposes window['productPage_<widget.id>'], which x-data calls directly
     · matches variants client-side against the dumped `variants` array,
       comparing `variant.options` (an array of option-VALUE ids)
     · adds to cart via Qumra.cart.add(id, qty, optionIds)
   Restyle freely; do not change those four things.

   Styling lives in assets/style.css → "15.23 PRODUCT PAGE".
   ========================================================================= #}

{% set id = widget.id %}
{% set d = widget.data %}
{% set p = context.product %}
{% set panels = widget.blocks | default([]) %}

{% set ratio = d.image_ratio | default('3x4') %}
{% if ratio == '1x1' %}{% set ratioVal = '1 / 1' %}
{% elif ratio == '4x5' %}{% set ratioVal = '4 / 5' %}
{% elif ratio == '2x3' %}{% set ratioVal = '2 / 3' %}
{% else %}{% set ratioVal = '3 / 4' %}{% endif %}

{% set showCrumbs = d.show_breadcrumb | default(true) %}

{# The h1 text belongs to the product, so what the merchant gets is its SIZE.
   It ships as one multiplier rather than a font-size, because the title carries
   two different clamps — Arabic runs smaller than the Latin display face at the
   same nominal size — and a raw px value would flatten that distinction. The
   scale multiplies whichever clamp is in force, so both stay in proportion.
   Weight is deliberately NOT offered: layout.njk loads a SINGLE weight per
   font family, so a weight picker would only ever trigger synthetic bolding. #}
{% set tSize = d.title_size | default('md') %}
{% if tSize == 'sm' %}{% set titleScale = '0.85' %}
{% elif tSize == 'lg' %}{% set titleScale = '1.15' %}
{% elif tSize == 'xl' %}{% set titleScale = '1.32' %}
{% else %}{% set titleScale = '1' %}{% endif %}
{% set showSavings = d.show_savings | default(true) %}
{% set showStock = d.show_stock_status | default(true) %}
{# Fixed: the low-stock bar fills from 0 to this number and the "in stock"
   pill takes over above it. Was a picker; the number is a display detail, not
   a merchandising decision. #}
{% set lowStock = d.low_stock_threshold | default(settings.lowStockThreshold, true) | default(5, true) %}
{% set baseSku = p.sku or (p.identification and p.identification.sku) or '' %}
{% set relatedTitle = t('pages.product.related') %}
{% set relatedLimit = 4 %}
{% set related = context.related | default([]) %}
{% set showZoom = d.show_zoom | default(true) %}
{# widgets do not inherit the layout's `set` locals — resolve it here #}
{% set isAr = (localization.language | default('ar')) != 'en' %}

{% set images = p.images | default([]) %}
{% set imgCount = images | length %}
{% set untracked = p.allowBackorder or (not p.trackQuantity) %}
{% set canPurchase = untracked or (p.quantity | default(0)) > 0 %}
{% set hasDiscount = p.pricing.compareAtPrice and p.pricing.compareAtPrice > p.pricing.price %}


{% if p %}
<section id="hy-pdp-{{ id }}" class="hy-pdp" x-data="productPage_{{ id }}()"
         style="--hy-pdp-title-scale: {{ titleScale }};">
  <div class="hy-container">

    {% if showCrumbs %}
      <nav class="hy-crumbs" style="padding-top: var(--space-5);" aria-label="{{t('common.home')}}">
        <a href="/">{{t('common.home')}}</a>
        <svg class="rtl-flip" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/>
        </svg>
        <a href="/shop">{{t('pages.shop.all_products')}}</a>
        <svg class="rtl-flip" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/>
        </svg>

        {# ---- The product's collection, when the payload carries one ----
           The DATA REALITY note at the top of this file lists what a Qumra
           product exposes, and `collections` is not in it — the LIST payload
           has it (ui/product-card.njk builds its eyebrow from it) but the
           product page's own payload has not been seen to. So this is written
           to cost nothing when the field is absent and to work the moment it
           appears, rather than being left out on the assumption it never will.

           Two guards, both taken from the card's own note:
             · the list may be missing or empty — hence the length test before
               any index is taken;
             · `collections[0]` may be an id STRING rather than an object, and
               `.title` on a string is undefined, so that case renders nothing
               instead of printing a raw hash.

           Falls back to `/shop` when there is a title but no usable slug: a
           crumb that reads right and navigates somewhere sane beats one that
           links to /shop/undefined. #}
        {% set pCols = p.collections | default([]) %}
        {% set pCol = pCols[0] if (pCols | length) > 0 else null %}
        {% set pColTitle = (pCol.title | default('')) if pCol else '' %}
        {% if pColTitle %}
          {% set pColSlug = pCol.handle | default(pCol.slug) | default('') %}
          <a href="{{ ('/shop/' ~ pColSlug) if pColSlug else '/shop' }}">{{ pColTitle }}</a>
          <svg class="rtl-flip" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/>
          </svg>
        {% endif %}

        <span aria-current="page">{{ p.title }}</span>
      </nav>
    {% endif %}

    <div class="hy-pdp-grid">

      {# ═══════════════ gallery ═══════════════
         One large stage with a thumb strip down its end edge. Clothing is
         judged on drape, so the main shot gets the room; the strip is there to
         switch, not to be looked at.

         The `#pdZoom-<id>-<index>` ids are a CONTRACT — openZoom() in the
         script clicks the one matching activeImageIndex to open GLightbox. #}
      <div class="hy-pdp-stage">
        {# `.passive` on touchstart — this listener only reads coordinates and
           never calls preventDefault, and saying so lets the browser keep
           scrolling on the main thread instead of waiting to find out. #}
        <div class="hy-pdp-main" style="--pdp-ratio: {{ ratioVal }};"
             @touchstart.passive="swipeStart($event)"
             @touchend.passive="swipeEnd($event)">
          {% if imgCount > 0 %}
            {% for img in images %}
              <a id="pdZoom-{{ id }}-{{ loop.index0 }}"
                 class="hy-pdp-shot {{ 'glightbox' if showZoom }}"
                 {% if showZoom %}href="{{ img.fileUrl }}" data-gallery="pd-{{ id }}"{% else %}href="#" @click.prevent{% endif %}
                 x-show="!variantImageUrl && activeImageIndex === {{ loop.index0 }}"
                 {% if not loop.first %}x-cloak{% endif %}
                 aria-label="{{ p.title }}">
                <img src="{{ img.fileUrl }}" alt="{{ p.title }}"
                     {% if loop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}/>
              </a>
            {% endfor %}
          {% else %}
            <div class="hy-pdp-shot" style="cursor: default;" x-show="!variantImageUrl">
              <span class="hy-pdp-noimg">
                <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18"/><circle cx="8.75" cy="9" r="1.5"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="m4 17 5-4.5 4.5 4 3-2.5L21 18"/>
                </svg>
              </span>
            </div>
          {% endif %}
          {# The chosen variant's own photo when it isn't one of the product images
             (the server render only has its ID — the URL comes from /ajax/product) #}
          <div class="hy-pdp-shot" x-show="variantImageUrl" x-cloak style="cursor: default;">
            <img :src="variantImageUrl" alt="{{ p.title }}"/>
          </div>
        </div>

        {% if imgCount > 1 %}
          <div class="hy-pdp-thumbs" role="group" aria-label="{{ p.title }}">
            {% for img in images %}
              <button type="button" class="hy-pdp-thumb"
                      :class="!variantImageUrl && activeImageIndex === {{ loop.index0 }} && 'is-active'"
                      @click="setImage({{ loop.index0 }})"
                      aria-label="{{ loop.index }}">
                <img src="{{ img.fileUrl }}" alt="" loading="lazy"/>
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      {# ═══════════════ buy column ═══════════════ #}
      <div class="hy-pdp-buy">
        <h1 class="hy-pdp-title">{{ p.title }}</h1>

        {# ═══════════════ rating ═══════════════
           `averageRating` and `reviewsCount` are the only two review fields a
           Qumra product carries — there is no list of reviews and no endpoint
           to post one (docs/store-ajax/ has cart, product, search and wishlist,
           and nothing else). So this is the summary, and it is all the summary
           can honestly be. Nothing here invents the rest.

           ⚠️  Rendered ONLY when there is something to report. A product with
           no reviews shows nothing — not five hollow stars, which read as a
           score of zero rather than as an absence and make a new product look
           rejected.

           The stars are drawn from ONE gradient-clipped element rather than
           five glyphs, so a 4.2 shows four stars and a fifth filled to 20% —
           a half-star set could only ever round to 4 or 4.5. `--pct` carries
           the fraction; the CSS does the clipping. #}
        {% set rvCount = p.reviewsCount | default(0) %}
        {% set rvAvg = p.averageRating | default(0) %}
        {% if rvCount > 0 and rvAvg > 0 %}
          <div class="hy-pdp-rating"
               aria-label="{{ rvAvg }} / 5">
            <span class="hy-stars" style="--pct: {{ (rvAvg / 5 * 100) | round }}%;" aria-hidden="true">★★★★★</span>
            <span class="hy-pdp-rating-num">{{ rvAvg }}</span>
            <span class="hy-pdp-rating-count">{{ t('pages.product.reviews_count') | replace('{count}', rvCount) }}</span>
          </div>
        {% endif %}

        {# The headline figure is the LINE TOTAL (unit × qty). The was-price and
           the savings were already multiplied by qty, so leaving the main price
           at the unit rate made the stepper look broken: press + and every
           number on the block moved except the one being read. #}
        <div class="hy-pdp-prices">
          <span class="hy-pdp-price" :class="hasDiscount() && 'hy-pdp-price--sale'" x-text="displayPrice()">{% if (p.pricing.price | default(0)) == 0 %}{{t('common.free')}}{% else %}{{ p.pricing.price | default(0) | money }}{% endif %}</span>
          <span class="hy-pdp-was" x-show="hasDiscount()" x-cloak x-text="displayComparePrice()"></span>
          {% if showSavings %}
            <span class="hy-pdp-save" x-show="hasDiscount()" x-cloak>
              {# `<bdi>` around the SIGN AND the amount, not just the amount. `-` is a
                 neutral character: on its own in an Arabic line it drifts to the
                 logical end and "−50,000" renders as "50,000−". Isolated with the
                 digits it stays a single LTR run in the right place. Same reason the
                 unit price and the article counts are already wrapped. #}
              <span class="hy-neg">−<span x-text="discountPercent"></span>%</span>
            </span>
          {% endif %}
        </div>

        {# so "2,000ج.م" on a 1,000ج.م product is never a mystery #}
        <p class="hy-pdp-unit" x-show="qty > 1" x-cloak>
          <bdi x-text="displayUnitPrice()"></bdi>
          <span aria-hidden="true">×</span>
          <bdi x-text="qty"></bdi>
        </p>

        {# ═══════════ options ═══════════ #}
        {% for option in p.options %}
          {% if (option.values | length) > 0 %}
            <div class="hy-pdp-opt">
              {# Inline, not stacked: "Colour: Gray blue" reads as one fact.
                 Naming the picked value also saves the shopper working out
                 which swatch is the outlined one. #}
              <div class="hy-pdp-opt-head">
                <span class="hy-pdp-opt-name">{{ option.name }}:</span>
                {# Nothing is pre-selected, so the head doubles as the prompt.
                   "المقاس: اختر المقاس" states the outstanding task instead of
                   showing a value the shopper never picked. #}
                <span class="hy-pdp-opt-value" data-opt="{{ option.name }}"
                      data-prompt="{{ t('pages.product.select_option') | replace('{{option}}', option.name) }}"
                      :class="!selectedOptions[$el.dataset.opt] && 'is-empty'"
                      x-text="selectedLabels[$el.dataset.opt] || $el.dataset.prompt"></span>
              </div>
              <div class="hy-pdp-swatches" role="group" aria-label="{{ option.name }}">
                {% for v in option.values %}
                  {# data- attributes, not interpolation: `| dump` emits double
                     quotes and the first one would close the attribute. #}
                  {% set vImg = v.image.fileUrl if v.image and v.image.fileUrl else '' %}
                  <button type="button" class="hy-pdp-swatch {{ 'hy-pdp-swatch--img' if vImg }}"
                          data-opt="{{ option.name }}"
                          data-val="{{ v._id }}"
                          data-label="{{ v.label }}"
                          :class="{
                            'is-active': selectedOptions[$el.dataset.opt] === $el.dataset.val,
                            'is-unavailable': valueDisabled($el.dataset.opt, $el.dataset.val)
                          }"
                          :disabled="valueDisabled($el.dataset.opt, $el.dataset.val)"
                          :title="valueDisabled($el.dataset.opt, $el.dataset.val)
                            ? _strings.variantSoldOut : $el.dataset.label"
                          @click="selectOption($el.dataset.opt, $el.dataset.val, $el.dataset.label)"
                          {% if vImg %}title="{{ v.label }}" aria-label="{{ v.label }}"{% endif %}>
                    {% if vImg %}<img src="{{ vImg }}" alt="" loading="lazy"/>{% else %}{{ v.label }}{% endif %}
                  </button>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        {% endfor %}

        {# ═══════════ stock ═══════════
           The bar is a rough gauge, not a report: Qumra gives the remaining
           quantity but no starting total, so the fill is measured against a
           merchant-set ceiling. It only appears while the number is genuinely
           low — a full bar on every product says nothing and a bar drawn from
           an invented total would be a lie. #}
        {# One line, four explicit states from HayatVariants.stockState():
           soldout · incart (you already hold all of it) · low (1…threshold) · instock.
           The gauge is measured against the merchant's low-stock threshold — the
           same number that decides "low" — never an invented total. #}
        <div class="hy-pdp-stockwrap">
          {% if showStock %}
            <span class="hy-pdp-stock" :class="{ 'hy-pdp-stock--out': stockState() === 'soldout' || stockState() === 'incart', 'hy-pdp-stock--low': stockState() === 'low', 'hy-pdp-stock--in': stockState() === 'instock' }"
                  x-text="stockLine()"></span>
            <div class="hy-pdp-bar-track" aria-hidden="true" x-show="stockState() === 'low'" x-cloak>
              <span class="hy-pdp-bar-fill" :style="'width:' + stockBarPct() + '%'"></span>
            </div>
          {% else %}
            <span class="hy-pdp-stock hy-pdp-stock--out" x-show="stockState() === 'soldout' || stockState() === 'incart'" x-cloak x-text="stockLine()"></span>
          {% endif %}
        </div>

        {# ═══════════ actions ═══════════ #}
        <div class="hy-pdp-actions" id="pdInfo-{{ id }}">
            <div class="hy-qty">
              <button type="button" @click="decQty()" :disabled="qty <= 1" aria-label="−">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" d="M5 12h14"/></svg>
              </button>
              <span x-text="qty">1</span>
              <button type="button" @click="incQty()"
                      :disabled="maxQty() !== null && qty >= maxQty()" aria-label="+">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" d="M12 5v14M5 12h14"/></svg>
              </button>
            </div>

          {# NOT disabled while the selection is incomplete: a dead button
             explains nothing. Clicking it prints which option is still missing.
             It only hard-disables once the answer is "you cannot buy this". #}
          <button type="button" class="hy-btn hy-btn--solid"
                  @click="addToCart()" :disabled="addDisabled()">
            <span x-show="addingToCart" class="hy-spinner" style="width:15px;height:15px;"></span>
            <span x-show="addedSuccess && !addingToCart" x-cloak>{{t('pages.product.added')}}</span>
            <span x-show="!addingToCart && !addedSuccess">
              <span x-show="stockState() !== 'soldout' && stockState() !== 'incart'">{{t('pages.product.add_to_cart')}}</span>
              <span x-show="stockState() === 'soldout' || stockState() === 'incart'" x-cloak x-text="stockLine()"></span>
            </span>
          </button>

          {# Always rendered — it is the second half of the buy decision, not an
             option. `buyNow()` adds and then sends the shopper to /cart. #}
          <button type="button" class="hy-btn hy-btn--outline"
                  @click="buyNow()" :disabled="addDisabled()">{{t('pages.product.buy_now')}}</button>
        </div>

        {# Why the add did not happen, next to the button that refused. The
           toast says the same thing but slides away; this stays until fixed. #}
        <p class="hy-form-error" x-show="formError" x-cloak x-text="formError" role="alert"></p>

          <div class="hy-pdp-meta">
            {# The SELECTED variant's code, not the parent's. `currentSku` starts
               as the product's own and is replaced the moment a combination
               resolves — so the server-rendered value is correct before Alpine
               boots and stays correct after. x-show rather than a bare {% if %}
               because a product with no parent SKU can still have one per
               variant, and the line has to be able to appear. #}
            <span x-show="currentSku" {% if not baseSku %}x-cloak{% endif %}>
              {{t('pages.product.sku')}}: <span x-text="currentSku">{{ baseSku }}</span>
            </span>
              {# The label is server-rendered and x-text REPLACES it. It used to
                 live only in the x-text, so until Alpine booted — and for good
                 if its script failed — this was an empty, unnamed button. #}
              <button type="button" class="hy-shop-clear" @click="share()"
                      x-text="shared ? copiedText : shareText">{{ t('common.share') }}</button>
          </div>

        {# ═══════════ panels ═══════════ #}
        {% if (panels | length) > 0 %}
          <div class="hy-pdp-panels">
            {# `descUsed` stops several panels rendering the SAME description.
               The block default used to be source="description", so a merchant
               who added four panels and only filled the text of three got the
               product description four times over. The first panel that asks
               for it wins; the rest fall back to their own text. #}
            {# An array is the only thing that carries state across `for`
               iterations in Nunjucks — `set` inside the loop is scoped to it,
               and there is no `namespace()` (that is Jinja2). Pushing into a
               list declared outside works because it is the same object. #}
            {% set descTaken = [] %}
            {% for block in panels %}
              {% set b = block.data %}
              {% set wantsDesc = b.source == 'description' and (descTaken | length) == 0 %}
              {% if wantsDesc %}{% set _ = descTaken.push(1) %}{% endif %}
              {% set body = p.description if wantsDesc else (b.text | default('', true)) %}
              {% if b.title and body %}
                <div class="hy-pdp-panel" x-data="{ open: {{ 'true' if b.open_by_default else 'false' }} }">
                  <button type="button" class="hy-pdp-panel-head"
                          @click="open = !open" :aria-expanded="open ? 'true' : 'false'">
                    <span>{{ b.title }}</span>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/>
                    </svg>
                  </button>
                  <div class="hy-pdp-panel-body" x-show="open" x-collapse
                       {% if not b.open_by_default %}x-cloak{% endif %}>{{ body | safe }}</div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  {# ═══════════════ recommended ═══════════════
     Rendered from `context.related`, which Qumra populates on a product page.
     No fallback fetch: unlike the home page there is no endpoint that returns
     "products like this one", and a row of unrelated newest products under a
     heading that says "recommended" is worse than no row. #}
  {% if (related | length) > 0 %}
    <div class="hy-container">
      <div class="hy-prow-head" style="margin-top: var(--space-7);">
        <h2 class="hy-prow-title">{{ relatedTitle }}</h2>
      </div>
      <div class="hy-shop-grid" style="--shop-cols: 4; --shop-cols-lg: 4; --shop-cols-md: 3; --shop-cols-sm: 2; padding-bottom: var(--space-8);">
        {# The current product is filtered out rather than trusted absent.
           `context.related` is built server-side and this page has no say in
           it; a row headed "you may also like" that opens with the thing being
           looked at is the one result nobody wants, and it costs one comparison
           to be sure. Counted with `related_shown` rather than loop.index0 so
           the limit still yields four CARDS when the current product is among
           the candidates — indexing would have silently shown three. #}
        {# ⚠️  A pushed ARRAY, not a counter and not `namespace()` — Nunjucks
           scopes `{% set %}` to the loop body and has no namespace() (that is
           Jinja2). The note beside the panels loop above says the same thing;
           this is the same trick for the same reason.

           Counting SHOWN cards rather than using loop.index0: the current
           product is filtered out of `context.related`, which the server builds
           without knowing this page, and a row headed "you may also like" that
           opens with the thing being looked at is the one result nobody wants.
           Indexing would then have yielded three cards instead of four whenever
           the product was among its own candidates. #}
        {% set shownRel = [] %}
        {% for rp in related %}
          {% if rp._id != p._id and (shownRel | length) < relatedLimit %}
            {% set _ = shownRel.push(1) %}
            {% ui "product-card.njk", product=rp %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {# ═══════════════ sticky buy bar ═══════════════ #}
    <div class="hy-pdp-bar" x-show="showBar" x-cloak
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0 translate-y-2"
         x-transition:enter-end="opacity-100 translate-y-0">
      <div class="hy-pdp-bar-info">
        <span class="hy-pdp-bar-title">{{ p.title }}</span>
        <span class="hy-price" x-text="displayPrice()"></span>
      </div>
      <button type="button" class="hy-btn hy-btn--solid hy-btn--sm"
              @click="addToCart()" :disabled="addDisabled()">
        <span x-show="addingToCart" class="hy-spinner" style="width:14px;height:14px;"></span>
        <span x-show="!addingToCart">
          <span x-show="stockState() !== 'soldout' && stockState() !== 'incart'">{{t('pages.product.add_to_cart')}}</span>
          <span x-show="stockState() === 'soldout' || stockState() === 'incart'" x-cloak x-text="stockLine()"></span>
        </span>
      </button>
    </div>
</section>
{% endif %}


{# ═══════════════════ JSON-LD ═══════════════════
   Structured data for the Product. The seo tag writes the title, the
   description and the Open Graph tags; it does not write this, and a search
   result carrying a price and an in-stock line is the difference between a
   listing and a rich one.

   ⚠️  `| dump` on every string. This is JSON inside a <script>, so one quote or
   newline in a merchant's title breaks the document — silently, because a
   malformed ld+json is ignored rather than reported. `dump` is also what
   escapes a stray closing script tag out of a description.

   ⚠️  The price goes out as-is: Qumra already sends MAJOR units (measured live —
   `123456 | money` prints «123,456»), and schema.org wants a bare decimal with
   no symbol and no grouping. Dividing by 100 told crawlers a price 100× too low.

   Availability mirrors the SAME three fields the buy button reads, so a page
   that tells a shopper "in stock" cannot tell a crawler otherwise. #}
{% if p %}
{% set ldStock = p.allowBackorder or (not p.trackQuantity) or (p.quantity | default(0)) > 0 %}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ p.title | default('', true) | dump | safe }},
  {% if imgCount > 0 %}"image": [{% for img in images %}{{ img.fileUrl | dump | safe }}{% if not loop.last %},{% endif %}{% endfor %}],{% endif %}
  "description": {{ (p.description | default('', true) | replace('</p>', ' ') | replace('</h2>', ' ') | replace('</li>', ' ') | replace('<br>', ' ') | striptags | truncate(300)) | dump | safe }},
  {% if p.sku %}"sku": {{ p.sku | dump | safe }},{% endif %}
  "offers": {
    "@type": "Offer",
    "url": {{ ((store.url | default('', true)) ~ '/products/' ~ (p.slug or p.handle or p._id)) | dump | safe }},
    "priceCurrency": {{ (localization.currency.currencyCode | default('EGP')) | dump | safe }},
    "price": "{{ p.pricing.price | default(0, true) }}",
    "availability": "https://schema.org/{{ 'InStock' if ldStock else 'OutOfStock' }}"
  }
}
</script>

<script>
  /* ==========================================================================
     Factory hung on `window` (NOT Alpine.data) — the x-data above calls
     productPage_<id>() directly. Same contract as the previous version.
     ======================================================================= */
  (function () {
    var wid = '{{ id }}';

    window['productPage_' + wid] = function () {
      /* Buy-side state and logic come from the shared engine in main.js so the
         product page and the quick view can never disagree about what is
         addable. Everything below it is page-only: gallery, share, sticky bar,
         and the two sentences that need a placeholder swapped. */
      return Object.assign(window.HayatVariants({
        productId: '{{ p._id }}',
        slug: {{ (p.slug or p.handle or '') | dump | safe }},
        sku: {{ baseSku | dump | safe }},
        lowAt: {{ lowStock | int }},
        price: {{ p.pricing.price | default(0, true) }},
        compareAtPrice: {{ p.pricing.compareAtPrice | default(0, true) }},
        quantity: {{ p.quantity | default(0, true) }},
        trackQuantity: {{ 'true' if p.trackQuantity else 'false' }},
        allowBackorder: {{ 'true' if p.allowBackorder else 'false' }},

        groups: [
          {% for option in p.options %}{% if (option.values | length) > 0 %}
          { name: {{ option.name | dump | safe }},
            values: [{% for v in option.values %}{ id: '{{ v._id }}', label: {{ v.label | dump | safe }} }{% if not loop.last %},{% endif %}{% endfor %}] }{% if not loop.last %},{% endif %}
          {% endif %}{% endfor %}
        ],

        {# `pricing` may be an empty object on a variant that inherits the
           product's price — `default` turns the missing number into the
           product's own rather than into zero. #}
        variants: [
          {% for variant in p.variants %}
          {
            id: '{{ variant._id }}',
            price: {{ variant.pricing.price | default(p.pricing.price, true) | default(0, true) }},
            compareAtPrice: {{ variant.pricing.compareAtPrice | default(p.pricing.compareAtPrice, true) | default(0, true) }},
            sku: {{ (variant.sku or '') | dump | safe }},
            quantity: {{ variant.quantity | default(0, true) }},
            {# what the server actually counts — see the note in HayatVariants #}
            {% set vAvail = variant.inventoryLevel.available if variant.inventoryLevel else null %}
            available: {{ (vAvail if (vAvail or vAvail == 0) else (variant.quantity or 0)) | int }},
            trackQuantity: {{ 'true' if variant.trackQuantity else 'false' }},
            allowBackorder: {{ 'true' if variant.allowBackorder else 'false' }},
            sku: {{ (variant.sku or (variant.identification and variant.identification.sku) or '') | dump | safe }},
            {# server render gives variant.images as raw IDs (ObjectId-like): compare as strings #}
            {% set vImg = variant.images[0] if (variant.images and variant.images | length) else null %}
            {% set vid = ((vImg._id if vImg._id else vImg) | string) if vImg else '' %}
            {% set idx = [] %}
            {% if vid %}{% for g in images %}{% if (g._id | string) == vid %}{% set _ = idx.push(loop.index0) %}{% endif %}{% endfor %}{% endif %}
            imageIndex: {{ idx[0] if idx | length else -1 }},
            options: {{ (variant.options or []) | dump | safe }}
          }{% if not loop.last %},{% endif %}
          {% endfor %}
        ],

        strings: {
          selectOptionsFirst: {{ t('pages.product.select_options_first') | dump | safe }},
          comboUnavailable:   {{ t('pages.product.combo_unavailable') | dump | safe }},
          maxQty:             {{ t('pages.product.max_qty') | dump | safe }},
          outOfStock:         {{ t('pages.product.out_of_stock') | dump | safe }},
          allInCart:          {{ t('pages.product.max_in_cart') | dump | safe }},
          lowStock:           {{ t('pages.product.low_stock') | dump | safe }},
          inStock:            {{ t('pages.product.in_stock') | dump | safe }},
          inStockCount:       {{ t('pages.product.in_stock_count') | dump | safe }},
          variantSoldOut:     {{ t('pages.product.variant_sold_out') | dump | safe }},
          addError:           {{ t('common.error') | dump | safe }},
          listSeparator:      {{ ('، ' if isAr else ', ') | dump | safe }}
        }
      }), {

        /* ---------------- page-only state ---------------- */
        activeImageIndex: 0,
        imageCount: {{ imgCount | int }},
        shared: false,
        showBar: false,
        shareText: {{ t('pages.product.share') | dump | safe }},
        copiedText: {{ t('pages.blog.copied') | dump | safe }},

        init() {
          var self = this;

          this.initVariants();

          /* What is already in the cart is read inside HayatVariants.initVariants()
             (cartSnapshot) — for the CAP, never to pre-fill the stepper:
             /ajax/cart/add ADDS a quantity, so pre-filling 8 then adding turns 8 into 16. */

          /* the sticky bar appears only once the real buy button is off-screen */
          var anchor = document.getElementById('pdInfo-' + wid);
          if (anchor && 'IntersectionObserver' in window) {
            new IntersectionObserver(function (entries) {
              self.showBar = !entries[0].isIntersecting;
            }, { rootMargin: '-140px 0px 0px 0px' }).observe(anchor);
          }
        },

        setImage(idx) { this.activeImageIndex = idx; this.variantImageUrl = null; },

        /* ---- Touch swipe on the main shot ----
           The gallery switched on thumbnail taps only, so on a phone — where
           the strip is small and the photograph fills the screen — the obvious
           gesture did nothing.

           Written by hand rather than by turning the stage into a Swiper: the
           `#pdZoom-<id>-<index>` ids are a contract with openZoom(), the
           `x-show` stack is what GLightbox's `.glightbox` anchors hang off, and
           a carousel would have to reproduce both. Twenty lines against a
           rewrite of two contracts.

           Guards, each for a real gesture:
             · single touch only — two fingers is a pinch-zoom, not a swipe;
             · |dx| must beat |dy|, or a vertical page scroll that drifts
               sideways would flip the image out from under the reader;
             · 40px floor, so a tap with a shake in it stays a tap. */
        _swipeX: 0,
        _swipeY: 0,
        _swipeOK: false,

        swipeStart(e) {
          this._swipeOK = e.touches && e.touches.length === 1;
          if (!this._swipeOK) return;
          this._swipeX = e.touches[0].clientX;
          this._swipeY = e.touches[0].clientY;
        },

        swipeEnd(e) {
          if (!this._swipeOK || this.imageCount < 2) return;
          this._swipeOK = false;
          var t = e.changedTouches && e.changedTouches[0];
          if (!t) return;
          var dx = t.clientX - this._swipeX;
          var dy = t.clientY - this._swipeY;
          if (Math.abs(dx) < 40 || Math.abs(dx) <= Math.abs(dy)) return;

          /* Direction follows the reading order, the same way Swiper resolves
             it from `dir`: dragging the picture toward the start of the line
             brings the NEXT one in. In Arabic that is a drag to the right. */
          var forward = {{ 'dx > 0' if isAr else 'dx < 0' }};
          var n = this.imageCount;
          this.activeImageIndex = forward
            ? (this.activeImageIndex + 1) % n
            : (this.activeImageIndex - 1 + n) % n;
        },


        openZoom() {
          {% if showZoom and imgCount > 0 %}
          var link = document.getElementById('pdZoom-' + wid + '-' + this.activeImageIndex);
          if (link) link.click();
          {% endif %}
        },


        async share() {
          var url = window.location.href;
          /* native share sheet on mobile, clipboard on desktop */
          if (navigator.share) {
            try {
              await navigator.share({ title: {{ p.title | dump | safe }}, url: url });
              return;
            } catch (e) { /* dismissed — fall through to copy */ }
          }
          try { await navigator.clipboard.writeText(url); } catch (e) { return; }
          this.shared = true;
          var self = this;
          setTimeout(function () { self.shared = false; }, 2000);
        }
      });
    };
  })();

  {% if showZoom and imgCount > 0 %}
  /* On DOMContentLoaded, not inline.
     GLightbox is loaded with `defer` (see layouts/layout.njk), so at the moment
     this script is parsed the library does not exist yet and the guard below
     would return early — the zoom would silently never bind. Deferred scripts
     all finish executing BEFORE DOMContentLoaded fires, so by here it is there.
     This is what buys the head 18KB of blocking transfer on every page in the
     shop that is not a product page. */
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof GLightbox === 'undefined') return;
    GLightbox({ selector: '.glightbox[data-gallery="pd-{{ id }}"]', touchNavigation: true, loop: true });
  });
  {% endif %}
</script>
{% endif %}{# /if p — no product, no JSON-LD and no page script #}

{# Per-section palette. Emits nothing at all unless `colors_enabled` is on, so
   the switch IS the revert. Must stay after the widget's own <style> — see the
   partial's header for why. #}
{% ui "section-colors.njk", scope='#hy-pdp-' ~ id, c=d %}

{# Floating WhatsApp button. Renders nothing without a number. This theme has no
   global social settings to fall back to, so the number lives here. #}
{% set d = widget.data %}
{% set L = '_en' if localization.language != 'ar' else '' %}
{% set raw = (d.phone_number or '') | string | trim %}
{% set num = raw | replace('+', '') | replace(' ', '') | replace('-', '') | replace('(', '') | replace(')', '') %}
{% set msg = (d['message' + L] or d.message or '') | trim %}
{% set label = d['label' + L] or d.label %}
{% if (num | length) >= 6 and d.enabled != false %}
  <a href="https://wa.me/{{ num }}{% if msg %}?text={{ msg | urlencode }}{% endif %}" target="_blank" rel="noopener noreferrer"
     class="hy-fab hy-fab--wa {{ 'hy-fab--end' if d.position == 'end' }} {{ 'hy-fab--desktop-only' if d.mobile == false }}"
     style="{% if d.color %}--fab-bg: {{ d.color }};{% endif %}{% if d.icon_color %}--fab-fg: {{ d.icon_color }};{% endif %}"
     aria-label="{{ t('common.chat_whatsapp') }}">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.69.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35ZM12.05 21.5h-.01a9.45 9.45 0 0 1-4.82-1.32l-.34-.2-3.58.94.96-3.49-.23-.36a9.43 9.43 0 0 1-1.45-5.03c0-5.22 4.25-9.47 9.48-9.47 2.53 0 4.9.99 6.7 2.78a9.41 9.41 0 0 1 2.77 6.7c0 5.23-4.25 9.45-9.48 9.45Zm8.07-17.52A11.33 11.33 0 0 0 12.05.64C5.76.64.65 5.75.64 12.04c0 2 .53 3.96 1.52 5.69L.55 23.64l6.05-1.59a11.4 11.4 0 0 0 5.44 1.39h.01c6.29 0 11.4-5.11 11.41-11.4 0-3.05-1.19-5.91-3.34-8.06Z"/>
    </svg>
    {% if label %}<span class="hy-fab-label">{{ label }}</span>{% endif %}
  </a>
{% endif %}

{
  "name": "شريط تمرير متعدد الأعمدة",
  "settings": {
    "media_position": {
      "type": "select",
      "label": {
        "ar": "جهة الشريط المتحرك",
        "en": "Carousel side"
      },
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": {
            "ar": "البداية (يمين في العربية)",
            "en": "Start (left in English)"
          }
        },
        {
          "value": "end",
          "label": {
            "ar": "النهاية (يسار في العربية)",
            "en": "End (right in English)"
          }
        }
      ]
    },
    "slider_height": {
      "type": "range",
      "label": {
        "ar": "أقل ارتفاع للشريط",
        "en": "Carousel minimum height"
      },
      "default": 420,
      "min": 300,
      "max": 680,
      "step": 20,
      "unit": "px"
    },
    "gap": {
      "type": "range",
      "label": {
        "ar": "المسافة بين العناصر",
        "en": "Gap between the pieces"
      },
      "default": 16,
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px"
    },
    "background": {
      "type": "select",
      "label": {
        "ar": "خلفية القسم",
        "en": "Section background"
      },
      "default": "white",
      "options": [
        {
          "value": "white",
          "label": {
            "ar": "أبيض",
            "en": "White"
          }
        },
        {
          "value": "well",
          "label": {
            "ar": "رمادي فاتح",
            "en": "Soft grey"
          }
        }
      ]
    },
    "show_arrows": {
      "type": "boolean",
      "label": {
        "ar": "إظهار أسهم التنقل",
        "en": "Show arrows"
      },
      "default": true
    },
    "show_dots": {
      "type": "boolean",
      "label": {
        "ar": "إظهار مؤشر الشرائح",
        "en": "Show the slide indicator"
      },
      "default": true
    },
    "autoplay": {
      "type": "boolean",
      "label": {
        "ar": "التنقل التلقائي",
        "en": "Autoplay"
      },
      "default": true
    },
    "autoplay_speed": {
      "type": "range",
      "label": {
        "ar": "مدة عرض الشريحة",
        "en": "Seconds per slide"
      },
      "default": 6,
      "min": 3,
      "max": 15,
      "step": 1,
      "unit": "s"
    },
    "tile1_image": {
      "type": "media",
      "label": {
        "ar": "▸ الخانة 1 — الصورة (مقصوصة بخلفية شفافة تعطي أفضل نتيجة)",
        "en": "▸ Tile 1 — image (a cut-out on a transparent background works best)"
      }

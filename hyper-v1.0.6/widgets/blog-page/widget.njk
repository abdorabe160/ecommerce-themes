{# ============================================================================
   HYPER BLOG PAGE — /blogs/<handle>
   ----------------------------------------------------------------------------
   The article list for one blog.

   Cards come from ui/article-card.njk, which is the same `.hy-post-*` object
   the homepage post grid uses. The optional lead article is that card at a
   larger size — not a second design, just the first cell spanning the grid.

   Styling: style.css → "15.18 POST GRID" for the card, "15.27 BLOG" for the
   page around it.
   ========================================================================= #}

{% set id = widget.id %}
{% set d = widget.data %}
{% set blog = context.blog | default({}) %}
{% set articles = context.articles or blog.articles or [] %}
{% set count = articles | length %}
{# Seen as {totalItems,totalPages,currentPage} and as {total,page,limit,pages}. #}
{% set _pg = context.pagination or {} %}
{% set pgTotalItems = _pg.totalItems or _pg.total or 0 %}
{% set pgPages = (_pg.totalPages or _pg.pages or 1) | int %}
{% set pgCurrent = (_pg.currentPage or _pg.page or 1) | int %}

{% set showHero = d.show_hero | default(true) %}
{# strings, not booleans: see the note in ui/product-card.njk — `{% ui %}` does
   not carry boolean literals, so every on/off local in this theme travels as
   'on' / 'off'. #}
{% set showDate = 'on' if (d.show_date | default(true)) else 'off' %}
{% set showExcerpt = 'on' if (d.show_excerpt | default(true)) else 'off' %}
{% set featureFirst = d.feature_first | default(true) %}
{% set cols = d.columns | default('3', true) %}
{# Columns follow what the lead card leaves, so no lone card ends the grid. The
   lead only spans the row from 1024px, so the tablet count uses the full list. #}
{% macro fit(n, c) %}{% set m = c | int %}{% if n <= m %}{{ n if n > 0 else m }}{% elif n % m != 1 %}{{ m }}{% elif n % (m + 1) != 1 %}{{ m + 1 }}{% else %}{{ m }}{% endif %}{% endmacro %}
{% set rest = (count - 1) if (d.feature_first | default(true) and count > 1) else count %}
{% set bg = d.background | default('white') %}

{% set heroImg = blog.image.fileUrl if blog.image and blog.image.fileUrl and not blog.image.notFound else '' %}
{% set blogTitle = blog.title | default(t('pages.blog.title'), true) %}

<section id="hy-blog-{{ id }}"
         class="hy-blogpage {{ 'hy-blogpage--well' if bg == 'well' }}"
         data-pages="{{ pgPages }}"
         style="--blog-cols: {{ fit(rest, cols) | trim }}; --blog-cols-md: {{ fit(count, 2) | trim }};">
  <div class="hy-container">

    <nav class="hy-crumbs" aria-label="{{ t('common.home') }}">
      <a href="/">{{ t('common.home') }}</a>
      <svg class="rtl-flip" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/>
      </svg>
      <a href="/blogs">{{ t('pages.blog.title') }}</a>
      <svg class="rtl-flip" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/>
      </svg>
      <span aria-current="page">{{ blogTitle }}</span>
    </nav>

    {% if showHero and heroImg %}
      <div class="hy-blog-hero">
        <img src="{{ heroImg }}" alt="{{ blogTitle }}" fetchpriority="high"/>
      </div>
    {% endif %}

    <div class="hy-blog-head">
      <span class="hy-blog-eyebrow">{{ t('pages.blog.title') }}</span>
      <h1 class="hy-blog-title">{{ blogTitle }}</h1>
      {# ⚠️  A <div>, NOT a <p>. A `text` field comes back from Qumra as block
           HTML (`<p>…</p>`), and a <p> cannot contain a <p> — the browser closes
           the outer one and the content becomes a SIBLING, so every style on
           this class stops reaching the text. Inner margins are reset in the CSS. #}
      {% if blog.description %}<div class="hy-blog-desc">{{ blog.description | safe }}</div>{% endif %}
      {% if pgTotalItems %}
        <span class="hy-blog-count">{% ui "count.njk", n=pgTotalItems, kind='article' %}</span>
      {% endif %}
    </div>

    {# ═════════════ articles ═════════════ #}
    {% if count > 0 %}
      <div class="hy-blog-grid {{ 'hy-blog-grid--lead' if featureFirst and count > 1 }}">
        {% for article in articles %}
          {% ui "article-card.njk", article=article, show_date=showDate, show_excerpt=showExcerpt %}
        {% endfor %}
      </div>

      {# plain links: this page is server-paginated, so a link is the whole
         feature. Same .hy-pager as the shop and collections pages. #}
      {% if pgPages > 1 %}
        <nav class="hy-pager" aria-label="{{ t('common.next') }}">
          {% if pgCurrent > 1 %}
            <a href="?page={{ pgCurrent - 1 }}" class="hy-pager-btn" aria-label="{{ t('common.prev') }}">
              <svg class="rtl-flip" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6"/>
              </svg>
            </a>
          {% endif %}
          {% for n in range(1, pgPages + 1) %}
            {% if n == pgCurrent %}
              <span class="hy-pager-btn is-active" aria-current="page">{{ n }}</span>
            {% elif n == 1 or n == pgPages or (n >= pgCurrent - 1 and n <= pgCurrent + 1) %}
              <a href="?page={{ n }}" class="hy-pager-btn">{{ n }}</a>
            {% elif n == pgCurrent - 2 or n == pgCurrent + 2 %}
              <span class="hy-pager-gap">…</span>
            {% endif %}
          {% endfor %}
          {% if pgCurrent < pgPages %}
            <a href="?page={{ pgCurrent + 1 }}" class="hy-pager-btn" aria-label="{{ t('common.next') }}">
              <svg class="rtl-flip" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/>
              </svg>
            </a>
          {% endif %}
        </nav>
      {% endif %}

    {% else %}
      <div class="hy-blog-grid">
        {% ui "placeholder.njk", kind='article', count=cols %}
      </div>
      <p class="hy-ph-note">{{ t('pages.blog.no_articles_desc') }}</p>
      
    {% endif %}

  </div>
</section>

{# Per-section palette. Emits nothing at all unless `colors_enabled` is on. #}
{% ui "section-colors.njk", scope='#hy-blog-' ~ id, c=d %}

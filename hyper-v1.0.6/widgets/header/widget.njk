{# Spacer — a fixed header no longer occupies flow space, so this reserves it.
   With `sticky_mode = compact` only part of the header stays fixed, but the
   spacer still reserves the FULL height: the rows above simply scroll away
   under it, and reserving less would pull the page up by that amount on load. #}
{% if isSticky %}
  <div id="hy-header-spacer-{{ id }}" aria-hidden="true"></div>
{% endif %}

<script>
  (function () {
    var header = document.getElementById('hy-header-{{ id }}');
    if (!header) return;

    {% if isSticky %}
    var spacer = document.getElementById('hy-header-spacer-{{ id }}');
    /* Remeasured on every event that can change the header's height: a web font
       swapping in, a viewport resize, the nav wrapping. Setting it once on parse
       would leave a gap or an overlap the moment any of those fire. */
    var sync = function () {
      if (spacer) spacer.style.height = header.offsetHeight + 'px';
      /* Same measurement, second consumer: html { scroll-padding-top } needs it
         so an #anchor clears the fixed header instead of landing behind it.
         Written on <html> rather than on the header because that is the element
         the property applies to. */
      document.documentElement.style.setProperty('--hy-header-h', header.offsetHeight + 'px');
      /* The compact mode slides the rows above the main bar out of view rather
         than hiding them, so the sticky offset has to be their real height. */
      var top = header.querySelector('.hy-topbar');
      header.style.setProperty('--hy-topbar-h', (top ? top.offsetHeight : 0) + 'px');
    };
    sync();
    window.addEventListener('load', sync);
    window.addEventListener('resize', sync);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(sync);
    if (window.ResizeObserver) new ResizeObserver(sync).observe(header);

    {% endif %}

    /* ---- Announcement bar · dismiss ----
       sessionStorage, not localStorage: an announcement is a campaign, and a
       shopper who closes it should see the NEXT one. localStorage would keep it
       shut across visits and the merchant would never know why their banner
       stopped working. The theme's two localStorage users are both genuine
       long-lived preferences (a column count, a countdown's first-seen time) —
       this is not one of those.

       The key carries a hash of the message, so changing the text brings the
       bar back for everyone who dismissed the previous one. Without that, a
       merchant editing the announcement would be shouting at a closed room.

       Read and applied HERE, inline, while the body is still parsing: the
       topbar is a few nodes above this script, so it is hidden before the
       browser has painted it and there is no flash of a bar that then vanishes.

       Removing the element (not just hiding it) is what keeps the rest honest:
       `sync()` measures `.hy-topbar` for --hy-topbar-h and the header for the
       spacer, and the ResizeObserver above re-runs it the moment the height
       changes. Nothing else needs to know the bar is gone.

       try/catch on every access — Safari private mode throws on the first read
       of sessionStorage, and an uncaught throw here would take the whole header
       script down with it. */
    (function () {
      var bar = document.getElementById('hy-topbar-{{ id }}');
      if (!bar) return;

      /* djb2 over the rendered message — short, stable, and enough to tell one
         announcement from the next. */
      var msg = {{ (topMsg or '') | dump | safe }};
      var h = 5381;
      for (var i = 0; i < msg.length; i++) h = ((h << 5) + h + msg.charCodeAt(i)) | 0;
      var KEY = 'hy-topbar-closed:' + (h >>> 0).toString(36);

      var closed = false;
      try { closed = sessionStorage.getItem(KEY) === '1'; } catch (e) {}
      if (closed) { bar.remove(); return; }

      var btn = document.getElementById('hy-topbarX-{{ id }}');
      if (btn) {
        btn.addEventListener('click', function () {
          try { sessionStorage.setItem(KEY, '1'); } catch (e) {}

          /* Collapse, then remove. A bare remove() dropped 38px out of the
             document in one frame and the whole page snapped upward — correct,
             and unpleasant enough to read as a glitch.

             The height has to be pinned to its measured pixel value first:
             `auto` is not an animatable value, so going straight to 0 from it
             transitions nothing. One forced reflow between the two writes is
             what makes the browser treat them as two states rather than
             collapsing them into the final one.

             `prefers-reduced-motion` skips straight to the end — this is a
             layout collapse, which is exactly the kind of motion that setting
             is asking us not to make. */
          var reduce = document.documentElement.classList.contains('hy-no-motion')
            || (window.matchMedia
            && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
          if (reduce) { bar.remove(); return; }

          bar.style.height = bar.offsetHeight + 'px';
          bar.style.overflow = 'hidden';
          void bar.offsetHeight;                      /* forced reflow */
          bar.style.transition = 'height 240ms var(--ease-out), opacity 160ms linear';
          bar.style.height = '0px';
          bar.style.opacity = '0';

          /* transitionend can fail to arrive — a background tab throttles it,
             and a display change mid-flight swallows it — so the removal is on
             a timer that the event can only bring forward. */
          var done = false;
          var finish = function () { if (done) return; done = true; bar.remove(); };
          bar.addEventListener('transitionend', finish);
          setTimeout(finish, 320);
        });
      }
    })();

    {% if isSticky %}
    {% if stickyMode == 'compact' %}
    /* `is-scrolled` is what slides the topbar away. It is toggled off a scroll
       listener rather than a CSS `position: sticky` on the inner row, because
       the rows have to move as one unit — sticky children of a fixed parent do
       not scroll relative to it at all.

       The threshold is the topbar's OWN height, not a token 8px: the spacer
       below reserves the header's full height, so collapsing earlier than that
       would lift the header's bottom edge above the still-visible spacer and
       expose a blank strip between the header and the page. */
    var onScroll = function () {
      var topH = parseFloat(getComputedStyle(header).getPropertyValue('--hy-topbar-h'));
      if (isNaN(topH)) topH = 38;
      header.classList.toggle('is-scrolled', window.scrollY > topH);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    {% endif %}
    {% endif %}
  })();

  {% if showSearch and searchLive %}
  /* Registered on `alpine:init` like every other component in this theme —
     defining it at parse time would race Alpine's boot at the end of <body>. */
  document.addEventListener('alpine:init', function () {
    if (window.__hyHeaderSearchReady) return;   /* one header per page, but the
                                                   Theme Editor can re-inject it */
    window.__hyHeaderSearchReady = true;

    Alpine.data('hyHeaderSearch', function (live) {
      return {
        query: '',
        scope: '',            /* collection HANDLE — drives the form action  */
        scopeId: '',          /* collection _id    — drives the AJAX filter  */
        scopeLabel: {{ t('header.all_categories') | dump | safe }},
        scopeOpen: false,
        open: false,
        loading: false,
        searched: false,
        results: [],
        /* -1 = nothing highlighted, which is also "Enter submits the form and
           goes to the full results page". Any other value is an index into
           `results`, and Enter opens that product instead. */
        active: -1,

        productUrl: function (p) {
          return '/products/' + (p.slug || p.handle || p._id);
        },

        /* Wraps at both ends: Down from the last lands back on the field
           (active = -1) rather than sticking, which is how a shopper gets back
           to editing what they typed without reaching for the mouse. */
        move: function (step) {
          if (!this.open || !this.results.length) return;
          var n = this.results.length;
          this.active = this.active + step;
          if (this.active >= n) this.active = -1;
          if (this.active < -1) this.active = n - 1;
          this.$nextTick(function () {
            var el = document.querySelector('.hy-search-hit.is-active');
            if (el && el.scrollIntoView) el.scrollIntoView({ block: 'nearest' });
          });
        },

        /* Returns TRUE when it handled the key, so the caller knows whether to
           let the form submit. Enter on a highlighted row must not do both. */
        enter: function () {
          if (!this.open || this.active < 0 || !this.results[this.active]) return false;
          window.location.href = this.productUrl(this.results[this.active]);
          return true;
        },

        pickScope: function (handle, id, label) {
          this.scope = handle;
          this.scopeId = id;
          this.scopeLabel = label;
          this.scopeOpen = false;
          if (this.query.length >= 2) this.fetch();
        },

        allUrl: function () {
          var base = this.scope ? '/shop/' + this.scope : '/shop';
          return base + '?q=' + encodeURIComponent(this.query);
        },

        money: function (v) { return Qumra.utils.formatMoney(v || 0); },

        fetch: function () {
          if (!live) return;
          var self = this;
          var q = (this.query || '').trim();
          /* A new query invalidates the highlight — index 2 of the old list is
             a different product in the new one. */
          this.active = -1;
          if (q.length < 2) { this.results = []; this.open = false; this.searched = false; return; }

          this.loading = true;
          this.open = true;

          /* search(), not suggest() — suggest() ignores collectionId, which
             would make a field scoped to "Chairs" return everything. */
          var filters = {};
          if (this.scopeId) filters.collectionId = this.scopeId;

          Qumra.search.search(q, filters).then(function (data) {
            var list = (data && (data.products || data.data || data.results)) || [];
            self.results = list.slice(0, 6);
            self.active = -1;
            self.searched = true;
            self.loading = false;
          }).catch(function () {
            self.results = [];
            self.searched = true;
            self.loading = false;
          });
        }
      };
    });
  });
  {% endif %}
</script>

{# ---- Global panels triggered from the header ---- #}
{% ui "sidebar.njk", nav_items=navItems, extra_menu=navExtra, topbar_menu=topMenu, socials=socials, has_socials=hasSocial, currentLang=currentLang, showLang=showLocale %}
{% ui "cart.njk" %}

{# Topbar colours are their own two settings rather than part of the palette
   block below, because the bar is a deliberately contrasting strip — folding it
   into `color_bg` would repaint the whole header the same colour. #}
<style>
  #hy-header-{{ id }} {
    --hy-topbar-bg: {{ d.topbar_bg | default('var(--color-topbar)', true) }};
    --hy-topbar-fg: {{ d.topbar_text | default('var(--color-topbar-text)', true) }};
  }
</style>

{# Per-section palette. Emits nothing unless `colors_enabled` is on, so the
   switch IS the revert. Must stay last — see the partial's header for why. #}
{% ui "section-colors.njk", scope='#hy-header-' ~ id, c=d %}

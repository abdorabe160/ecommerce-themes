{# ============================================================================
   HYPER BLOGS PAGE — /blogs
   ----------------------------------------------------------------------------
   Lists the ARTICLES, not the categories. The platform sends this page only the
   categories (`context.blogs`), so the articles are gathered in the browser from
   each category's own page and arrive as that page's server-rendered cards
   (ui/article-card.njk, no second card in JS). The categories become a filter
   above them, hidden when there is only one.

   Styling: style.css → "15.18 POST GRID" for the card, "15.27 BLOG" for the page
   around it.
   ========================================================================= #}

{% set id = widget.id %}
{% set d = widget.data %}
{% set blogs = context.blogs | default([], true) %}
{% set blogHandles = [] %}
{% for b in blogs %}{% if b.handle or b.slug %}{% set _ = blogHandles.push(b.handle or b.slug) %}{% endif %}{% endfor %}
{% set count = blogHandles | length %}

{% set showHead = d.show_title | default(true) %}
{% set eyebrow = d.eyebrow | default('') %}
{% set title = d.title if (d.title | default('') | trim | length) > 0 else t('pages.blog.title') %}
{% set subtitle = d.subtitle | default('') %}
{% set cols = d.columns | default('3', true) %}

{# No `background` select here on purpose — the page rides the theme's paper.
   A per-section surface is still reachable through the 🎨 custom-colours
   switch below (`color_bg`), which is the one place a merchant changes it. #}
<section id="hy-blogs-{{ id }}"
         class="hy-blogpage"
         data-blog-cols="{{ cols }}"
         style="--blog-cols: {{ cols }};">
  <div class="hy-container">

    <nav class="hy-crumbs" aria-label="{{ t('common.home') }}">
      <a href="/">{{ t('common.home') }}</a>
      <svg class="rtl-flip" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6"/>
      </svg>
      <span aria-current="page">{{ title }}</span>
    </nav>

    {% if showHead %}
      <div class="hy-blog-head">
        {% if eyebrow %}<span class="hy-blog-eyebrow">{{ eyebrow }}</span>{% endif %}
        <h1 class="hy-blog-title">{{ title }}</h1>
        {# ⚠️  A <div>, NOT a <p>. A `text` field comes back from Qumra as block
             HTML (`<p>…</p>`), and a <p> cannot contain a <p> — the browser closes
             the outer one and the content becomes a SIBLING, so every style on
             this class stops reaching the text. Inner margins are reset in the CSS. #}
        {% if subtitle %}<div class="hy-blog-desc">{{ subtitle | safe }}</div>{% endif %}
      </div>
    {% endif %}

    {# A shopper who reaches an empty blog gets a sentence and a way on, on the
       live store too. The skeleton cards below it are for the merchant in the
       builder only (.hy-editor-only is removed on the live store). #}
    <div class="hy-empty" data-blogs-empty {% if count > 0 %}hidden{% endif %}>
      <span class="hy-empty-title">{{ t('pages.blog.no_articles_desc') }}</span>
      <a href="/shop" class="hy-btn hy-btn--outline hy-btn--sm" style="margin-block-start: var(--space-4);">{{ t('pages.cart.continue_shopping') }}</a>
    </div>

    {% if count > 0 %}
      {% if count > 1 %}
        <div class="hy-shop-rail hy-blog-filters" role="group" aria-label="{{ t('pages.blog.title') }}" data-blog-filters>
          <a href="/blogs" class="hy-chip is-active" data-blog-filter="">{{ t('common.view_all') }}</a>
          {% for blog in blogs %}
            {% set bh = blog.handle or blog.slug %}
            {% if bh and blog.title %}<a href="/blogs/{{ bh }}" class="hy-chip" data-blog-filter="{{ bh }}">{{ blog.title }}</a>{% endif %}
          {% endfor %}
        </div>
      {% endif %}

      <div class="hy-blog-grid" data-blogs-grid aria-busy="true">
        {% ui "placeholder.njk", kind='article', count=cols %}
      </div>

      <script>
        (function () {
          var root = document.getElementById('hy-blogs-{{ id }}');
          var grid = root.querySelector('[data-blogs-grid]');
          var empty = root.querySelector('[data-blogs-empty]');
          var bar = root.querySelector('[data-blog-filters]');
          var handles = {{ blogHandles | dump | safe }};
          var MAX_PAGES = 5;

          function page(handle, n) {
            return fetch('/blogs/' + encodeURIComponent(handle) + (n > 1 ? '?page=' + n : ''), { credentials: 'same-origin' })
              .then(function (r) { return r.ok ? r.text() : ''; })
              .then(function (html) { return new DOMParser().parseFromString(html, 'text/html'); })
              .catch(function () { return null; });
          }
          function cards(doc, handle) {
            if (!doc) return [];
            return [].map.call(doc.querySelectorAll('.hy-blog-grid .hy-post:not([data-hy-placeholder])'), function (el) {
              var card = document.importNode(el, true);
              card.setAttribute('data-blog', handle);
              return card;
            });
          }
          function load(handle) {
            return page(handle, 1).then(function (doc) {
              var first = cards(doc, handle);
              var holder = doc && doc.querySelector('[data-pages]');
              var pages = Math.min(Number(holder && holder.getAttribute('data-pages')) || 1, MAX_PAGES);
              var rest = [];
              for (var i = 2; i <= pages; i++) rest.push(page(handle, i));
              return Promise.all(rest).then(function (docs) {
                return docs.reduce(function (all, d) { return all.concat(cards(d, handle)); }, first);
              });
            });
          }
          /* Columns follow the count, so one, two or four articles never leave
             a lone card under a part-empty row. */
          function show(list, filter) {
            var shown = list.filter(function (c) { return !filter || c.getAttribute('data-blog') === filter; });
            var n = shown.length;
            var blogCols = n === 1 ? 1 : (n === 2 || n === 4 ? 2 : {{ cols | int }});
            root.style.setProperty('--blog-cols', blogCols);
            root.setAttribute('data-blog-cols', blogCols);
            grid.classList.toggle('hy-blog-grid--one', n === 1);
            grid.innerHTML = '';
            shown.forEach(function (c) { grid.appendChild(c); });
            if (window.HayatLocaliseDates) window.HayatLocaliseDates(grid);
          }

          Promise.all(handles.map(load)).then(function (lists) {
            var seen = {};
            var all = lists.reduce(function (x, y) { return x.concat(y); }, []).filter(function (c) {
              var href = c.getAttribute('href');
              if (seen[href]) return false;
              seen[href] = true;
              return true;
            }).sort(function (x, y) {
              return String(y.getAttribute('data-date')).localeCompare(String(x.getAttribute('data-date')));
            });
            grid.removeAttribute('aria-busy');
            if (!all.length) {
              grid.hidden = true;
              if (bar) bar.hidden = true;
              empty.hidden = false;
              return;
            }
            show(all, '');
            if (!bar) return;
            bar.addEventListener('click', function (e) {
              var chip = e.target.closest('[data-blog-filter]');
              if (!chip) return;
              e.preventDefault();
              bar.querySelectorAll('[data-blog-filter]').forEach(function (c) { c.classList.remove('is-active'); });
              chip.classList.add('is-active');
              show(all, chip.getAttribute('data-blog-filter'));
            });
          });
        })();
      </script>
    {% else %}
      <div class="hy-blog-grid hy-editor-only">
        {% ui "placeholder.njk", kind='article', count=cols %}
      </div>
    {% endif %}

  </div>
</section>

{# Per-section palette. Emits nothing at all unless `colors_enabled` is on. #}
{% ui "section-colors.njk", scope='#hy-blogs-' ~ id, c=d %}

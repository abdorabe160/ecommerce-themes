{# ============================================================================
   MORVA FILTER PANEL — one group per filter the platform hands the shop.
   Runs INSIDE the collectionFilter() scope (shop-page), so every control
   calls its methods: toggleFilter · applyPrice · setTextFilter · isActive.

   Qumra filters arrive in more than one shape (items / values / options;
   label as a string or as {ar, en}), so every read below has fallbacks.
   Locals: filters, lang, visible (chips shown before "+N")
   ========================================================================= #}
{% set filters = data.filters | default([]) %}
{% set lang = data.lang | default(localization.language) | default('ar') %}
{% set visible = data.visible | default(10) %}

{% macro pick(o, lang) %}
  {%- set v = o.label | default(o.name) | default(o.title) | default(o.displayName) | default(o.text) | default('') -%}
  {%- if v is string -%}{{ v }}
  {%- elif v -%}{{ v[lang] | default(v.ar) | default(v.en) | default('') }}
  {%- endif -%}
{% endmacro %}

{% macro groupName(o, lang) %}
  {%- set named = pick(o, lang) | trim -%}
  {%- if (named | length) > 0 -%}{{ named }}
  {%- else -%}
    {%- set h = (o.handle | default(o.id) | default('')) | string -%}
    {%- if h and (h | int | string) != h -%}{{ h }}{%- endif -%}
  {%- endif -%}
{% endmacro %}

{% macro optionLabel(o, lang) %}
  {%- set named = pick(o, lang) | trim -%}
  {%- if (named | length) > 0 -%}{{ named }}
  {%- else -%}{{ (o.value | default(o.handle) | default(o.id) | default('')) | string }}
  {%- endif -%}
{% endmacro %}

{% for f in filters %}
  {% set gLabel = groupName(f, lang) | trim %}
  {% set items = f.items | default(f.values) | default(f.options) | default(f.choices) | default(f.list) | default([]) %}
  {% set kind = f.inputType | default(f.type) | default('select') %}
  {% set isRange = kind == 'range' %}
  {% set isText = kind == 'search_text' %}
  {% set fh = f.handle | default(f.id) | default('') %}

  {% if isRange or isText or (items | length) > 0 %}
    <div class="mv-fgroup" x-data="{ open: true, more: false }">
      <button type="button" class="mv-fgroup-head" @click="open = !open" :aria-expanded="open ? 'true' : 'false'">
        <span>{{ gLabel if gLabel else t('pages.search.filter') }}</span>
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M6 0v12M0 6h12" stroke="currentColor" stroke-width="1.4"/></svg>
      </button>
      <div class="mv-fgroup-body" x-show="open" x-collapse>
        {% if isRange %}
          {% set rMin = f.range.min if f.range and f.range.min is defined else 0 %}
          {% set rMax = f.range.max if f.range and f.range.max is defined else '' %}
          <div class="mv-fprice">
            <input type="number" inputmode="numeric" class="mv-input" min="{{ rMin }}" {% if rMax %}max="{{ rMax }}"{% endif %}
                   x-model="priceMin" @input.debounce.500ms="applyPrice()"
                   placeholder="{{ rMin }}" aria-label="{{ t('pages.search.min_price') }}"/>
            <span>—</span>
            <input type="number" inputmode="numeric" class="mv-input" min="{{ rMin }}" {% if rMax %}max="{{ rMax }}"{% endif %}
                   x-model="priceMax" @input.debounce.500ms="applyPrice()"
                   placeholder="{{ rMax if rMax else t('pages.search.max_price') }}" aria-label="{{ t('pages.search.max_price') }}"/>
          </div>
          <p class="mv-fnote" x-show="priceNote" x-text="priceNote" x-cloak role="status" aria-live="polite"></p>
        {% elif isText %}
          <input type="search" class="mv-input" data-h="{{ fh }}"
                 :value="textFilter($el.dataset.h)"
                 @input.debounce.500ms="setTextFilter($el.dataset.h, $el.value)"
                 placeholder="{{ gLabel if gLabel else t('common.search') }}"
                 aria-label="{{ gLabel if gLabel else t('common.search') }}"/>
        {% else %}
          <div class="mv-fopts">
            {% for it in items %}
              {% set itLabel = optionLabel(it, lang) | trim %}
              {% if (itLabel | length) > 0 %}
                <label class="mv-fopt"
                       data-h="{{ fh }}"
                       data-v="{{ it.value | default(it.handle) | default(it.id) | default('') }}"
                       :class="isActive($el.dataset.h, $el.dataset.v) && 'is-on'"
                       {% if loop.index0 >= visible %}x-show="more" x-cloak{% endif %}>
                  <input type="checkbox"
                         :checked="isActive($el.parentElement.dataset.h, $el.parentElement.dataset.v)"
                         @change="toggleFilter($el.parentElement.dataset.h, $el.parentElement.dataset.v)"/>
                  <span>{{ itLabel }}</span>
                  {% if it.count %}<span class="mv-fopt-count">{{ it.count }}</span>{% endif %}
                </label>
              {% endif %}
            {% endfor %}
          </div>
          {% if (items | length) > visible %}
            <button type="button" class="mv-fmore" @click="more = !more">
              <span x-show="!more">+{{ (items | length) - visible }}</span>
              <span x-show="more" x-cloak>{{ t('common.back') }}</span>
            </button>
          {% endif %}
        {% endif %}
      </div>
    </div>
  {% endif %}
{% endfor %}

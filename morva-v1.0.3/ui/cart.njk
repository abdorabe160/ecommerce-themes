{# ============================================================================
   MORVA CART — the bag drawer and the cart-page line list
   ----------------------------------------------------------------------------
   variant='drawer' (default)  side drawer, rendered once by the header
   variant='list'              just the lines, inside cart-page's own scope

   NOTE: The `row` macro has a TWIN: HayatCartItem.build() in assets/main.js
   appends rows to an already-rendered drawer. Same markup, same data-* hooks
   (data-cart-item · data-item-total · data-item-compare) and the same Alpine
   bindings cartInteraction provides. Change one, change the other.

   The drawer's data-* hooks are what CartManager._refreshDrawer() updates in
   place after every add / change / remove — keep every one of them:
     data-cart-container · data-cart-list · data-cart-footer · data-cart-empty
     data-cart-count-bar · data-cart-count · data-cart-total
     data-cart-savings-row · data-cart-savings · data-cart-ship (+ fill/msg)
   ========================================================================= #}

{% set variant = data.variant | default('drawer') %}
{% set freeShip = data.free_shipping | default(0) %}
{% set cartNote = data.note | default('') %}
{% set itemCount = cart.items | length %}

{# Server paint of the free-shipping bar. main.js recomputes it on load with
   the DETECTED minor-unit scale, so the ×100 here only survives one frame. #}
{% set shipTarget = freeShip * 100 %}
{% set shipNow = cart.totalPrice | default(0) %}
{% set shipLeft = (shipTarget - shipNow) if shipTarget > shipNow else 0 %}
{% set shipPct = 100 if shipTarget <= 0 or shipLeft <= 0 else ((shipNow / shipTarget) * 100) | round %}

<script>
  window.__hyCartStrings = window.__hyCartStrings || {
    maxStock:     {{ t('pages.cart.max_stock') | dump | safe }},
    needsVariant: {{ t('pages.cart.needs_variant') | dump | safe }},
    lineSoldOut:  {{ t('pages.cart.line_sold_out') | dump | safe }}
  };
</script>

{% macro row(item, onClick) %}
  {% set pd = item.productData %}
  {% set url = '/products/' ~ (pd.slug | default(pd.handle) | default('')) %}
  {% set img = pd.image.fileUrl if pd.image and pd.image.fileUrl else '' %}
  {% set hasCompare = item.compareAtPrice and item.compareAtPrice > item.price %}
  <div class="mv-line" data-cart-item="{{ item._id }}"
       x-show="activeItems.includes('{{ item._id }}')"
       :class="removingId === '{{ item._id }}' && 'is-removing'">
    <a href="{{ url }}" class="mv-line-img"{% if onClick %} @click="{{ onClick }}"{% endif %}>
      {% if img %}
        <img class="mv-fill" src="{{ img }}" alt="{{ pd.title }}" loading="lazy"/>
      {% else %}
        <span class="mv-noimg"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><rect x="3" y="3" width="18" height="18"/><circle cx="8.75" cy="9" r="1.5"/><path d="m4 17 5-4.5 4.5 4 3-2.5L21 18"/></svg></span>
      {% endif %}
    </a>
    <div class="mv-line-body">
      <div class="mv-line-top">
        <a href="{{ url }}" class="mv-line-name"{% if onClick %} @click="{{ onClick }}"{% endif %}>{{ pd.title }}</a>
        <button type="button" class="mv-line-remove" @click="removeItem('{{ item._id }}')"
                aria-label="{{ t('pages.cart.remove_item') }}">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.4"/></svg>
        </button>
      </div>

      {% if item.variantData and item.variantData.options and (item.variantData.options | length) > 0 %}
        <div class="mv-line-opts">
          {% for opt in item.variantData.options %}
            <span class="mv-line-opt">
              {{ opt.option.name }}:
              {% if opt.option.type == 'color' %}{% set dotHex = opt.value if opt.value and (opt.value | string).indexOf('#') == 0 else '' %}<i class="mv-line-dot" data-swatch="{{ opt.label }}"{% if dotHex %} style="background: {{ dotHex }};"{% endif %}></i>{% endif %}
              <b>{{ opt.label }}</b>
            </span>
          {% endfor %}
        </div>
      {% endif %}

      <p class="mv-line-note" x-show="lineNote['{{ item._id }}']" x-cloak x-text="lineNote['{{ item._id }}']"></p>

      <div class="mv-line-foot">
        <div class="mv-qty">
          <button type="button" @click="decrement('{{ item._id }}')" aria-label="{{ t('morva.decrease') }}">−</button>
          <span class="mv-qty-val">
            <span x-show="updating !== '{{ item._id }}'" x-text="quantities['{{ item._id }}']">{{ item.quantity }}</span>
            <span x-show="updating === '{{ item._id }}'" x-cloak class="mv-spinner" style="width:12px;height:12px;"></span>
          </span>
          <button type="button" @click="increment('{{ item._id }}')" :disabled="atCap('{{ item._id }}')"
                  aria-label="{{ t('morva.increase') }}">+</button>
        </div>
        <div class="mv-line-money{{ ' is-sale' if hasCompare }}">
          <span class="mv-line-unit" title="{{ t('pages.cart.unit_price') }}">
            <bdi>{{ item.price | default(0) | money }}</bdi><span aria-hidden="true">×</span><bdi x-text="quantities['{{ item._id }}']">{{ item.quantity }}</bdi>
          </span>
          <span class="mv-line-total" data-item-total="{{ item._id }}"
                :class="updating === '{{ item._id }}' && 'is-pending'">{{ item.totalPrice | default(0) | money }}</span>
          <span class="mv-line-was" data-item-compare="{{ item._id }}"
                {% if not hasCompare %}style="display: none;"{% endif %}>{{ item.totalCompareAtPrice | default(0) | money }}</span>
        </div>
      </div>

      <div class="mv-line-confirm" x-show="confirmRemoveId === '{{ item._id }}'" x-cloak>
        <span>{{ t('pages.cart.remove_confirm') }}</span>
        <div class="mv-line-confirm-acts">
          <button type="button" class="mv-btn mv-btn--sm" @click="removeItem('{{ item._id }}')">{{ t('common.delete') }}</button>
          <button type="button" class="mv-btn mv-btn--sm mv-btn--ghost" @click="confirmRemoveId = null">{{ t('common.cancel') }}</button>
        </div>
      </div>
    </div>
  </div>
{% endmacro %}

{% if variant == 'list' %}

  <div class="mv-lines" data-cart-list>
    {% for item in cart.items %}{{ row(item, '') }}{% endfor %}
  </div>

{% else %}

  <div x-data="cartInteraction({
         items: [{% for item in cart.items %}{ id: '{{ item._id }}', qty: {{ item.quantity | default(1, true) }}, slug: '{{ item.productData.slug | default(item.productData.handle) | default('') }}', variantId: {{ ("'" ~ item.variantId ~ "'") if item.variantId else 'null' }} }{% if not loop.last %},{% endif %}{% endfor %}],
         strings: window.__hyCartStrings
       })">
    <div class="mv-backdrop" :class="$store.modal.current === 'cart' && 'is-open'"
         @click="$store.modal.close()" aria-hidden="true"></div>

    <aside class="mv-drawer" :class="$store.modal.current === 'cart' && 'is-open'"
           role="dialog" aria-modal="true" aria-label="{{ t('morva.bag_title') }}"
           :aria-hidden="$store.modal.current === 'cart' ? 'false' : 'true'">
      <header class="mv-drawer-head">
        <h2 class="mv-drawer-title">
          {{ t('morva.bag_title') }}
          <span class="mv-drawer-count" data-cart-count-bar {% if itemCount == 0 %}style="display: none;"{% endif %}><span data-cart-count>{{ cart.totalQuantity | default(0) }}</span></span>
        </h2>
        <button type="button" class="mv-close" @click="$store.modal.close()" aria-label="{{ t('common.close') }}">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5"/></svg>
        </button>
      </header>

      {% if freeShip > 0 %}
        <div class="mv-ship" data-cart-ship data-ship-target="{{ freeShip }}" {% if itemCount == 0 %}style="display: none;"{% endif %}>
          <p class="mv-ship-msg {{ 'is-done' if shipLeft <= 0 }}" data-ship-msg>
            {% if shipLeft > 0 %}{{ t('pages.cart.free_shipping_left') | replace('{amount}', shipLeft | money) }}{% else %}{{ t('pages.cart.free_shipping_done') }}{% endif %}
          </p>
          <div class="mv-ship-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ shipPct }}">
            <span class="mv-ship-fill" data-ship-fill style="width: {{ shipPct }}%;"></span>
          </div>
        </div>
      {% endif %}

      <div class="mv-drawer-body" data-cart-container data-lenis-prevent {% if itemCount == 0 %}style="display: none;"{% endif %}>
        <div class="mv-lines" data-cart-list>
          {% for item in cart.items %}{{ row(item, '$store.modal.close()') }}{% endfor %}
        </div>
      </div>

      <footer class="mv-drawer-foot" data-cart-footer {% if itemCount == 0 %}style="display: none;"{% endif %}>
        <div class="mv-sum">
          <div class="mv-sum-row" data-cart-savings-row {% if not cart.totalSavings or cart.totalSavings <= 0 %}style="display: none;"{% endif %}>
            <span>{{ t('pages.cart.savings') }}</span>
            <span class="mv-neg" data-cart-savings>-{{ cart.totalSavings | default(0) | money }}</span>
          </div>
          {% if cart.couponApplied %}
            <div class="mv-sum-row">
              <span>{{ t('pages.cart.discount_applied') }}</span>
              <span class="mv-neg">-{{ cart.couponDiscount | default(0) | money }}</span>
            </div>
          {% endif %}
        </div>
        <div class="mv-subtotal">
          <span>{{ t('morva.subtotal') }}</span>
          <span class="mv-subtotal-val" data-cart-total>{{ cart.totalPrice | default(0) | money }}</span>
        </div>
        <p class="mv-shipnote">{{ cartNote | default(t('morva.shipping_note'), true) }}</p>
        <a href="/checkout" class="mv-btn mv-btn--block mv-checkout"
           :class="hasSoldOut() && 'is-blocked'"
           :aria-disabled="hasSoldOut() ? 'true' : 'false'"
           @click="if (hasSoldOut()) $event.preventDefault()">{{ t('morva.checkout') }}</a>
        <a href="/cart" class="mv-continue" @click="$store.modal.close()">{{ t('pages.cart.view_cart') }}</a>
        <p class="mv-blocked" x-show="hasSoldOut()" x-cloak role="alert">{{ t('pages.cart.blocked_sold_out') }}</p>
      </footer>

      <div class="mv-cart-empty" data-cart-empty {% if itemCount > 0 %}style="display: none;"{% endif %}>
        <p class="mv-empty-title">{{ t('morva.bag_empty') }}</p>
        <p class="mv-empty-text">{{ t('morva.bag_empty_hint') }}</p>
        <a href="/shop" class="mv-btn" @click="$store.modal.close()">{{ t('morva.continue_shopping') }}</a>
      </div>
    </aside>
  </div>

{% endif %}

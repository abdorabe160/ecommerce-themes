{
  "name": "سلايدر الواجهة (Hero Slider)",
  "settings": {
    "height": {
      "type": "select",
      "label": { "ar": "ارتفاع السلايدر", "en": "Slider height" },
      "default": "full",
      "options": [
        { "value": "full", "label": { "ar": "ملء الشاشة", "en": "Full screen" } },
        { "value": "large", "label": { "ar": "كبير", "en": "Large" } },
        { "value": "medium", "label": { "ar": "متوسط", "en": "Medium" } }
      ]
    },
    "autoplay": {
      "type": "boolean",
      "label": { "ar": "تشغيل تلقائي", "en": "Autoplay" },
      "default": true
    },
    "interval": {
      "type": "range",
      "label": { "ar": "مدة كل شريحة (ثوانٍ)", "en": "Time per slide (seconds)" },
      "default": 6,
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s"
    },
    "show_index": {
      "type": "boolean",
      "label": { "ar": "إظهار رقم الشريحة الكبير", "en": "Show the large slide number" },
      "default": true
    },
    "strip_text": {
      "type": "string",
      "label": { "ar": "نص الشريط المتحرك أسفل السلايدر (فارغ لإخفائه)", "en": "Kinetic strip under the slider (empty hides it)" },
      "default": "تحرّك بسرعة"
    },
    "strip_speed": {
      "type": "range",
      "label": { "ar": "سرعة الشريط (ثوانٍ لكل دورة — أقل = أسرع)", "en": "Strip speed (seconds per loop — lower is faster)" },
      "default": 28,
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "s"
    }
  },
  "blocks": {
    "slide": {
      "name": "شريحة",
      "settings": {
        "image": {
          "type": "media",
          "label": { "ar": "الصورة (كمبيوتر) — يفضّل ١٩٢٠×١٠٨٠", "en": "Image (desktop) — 1920×1080 recommended" }
        },
        "image_mobile": {
          "type": "media",
          "label": { "ar": "صورة الموبايل (اختيارية) — يفضّل ١٠٨٠×١٣٥٠", "en": "Mobile image (optional) — 1080×1350 recommended" }
        },
        "image_position": {
          "type": "select",
          "label": { "ar": "تركيز الصورة", "en": "Image focus" },
          "default": "center",
          "options": [
            { "value": "center", "label": { "ar": "المنتصف", "en": "Center" } },
            { "value": "left", "label": { "ar": "اليسار", "en": "Left" } },
            { "value": "right", "label": { "ar": "اليمين", "en": "Right" } },
            { "value": "top", "label": { "ar": "الأعلى", "en": "Top" } },
            { "value": "bottom", "label": { "ar": "الأسفل", "en": "Bottom" } }
          ]
        },
        "overlay": {
          "type": "range",
          "label": { "ar": "تعتيم الصورة خلف النص (٪)", "en": "Image darkening behind text (%)" },
          "default": 55,
          "min": 0,
          "max": 90,
          "step": 5,
          "unit": "%"
        },
        "kicker": {
          "type": "string",
          "label": { "ar": "العنوان الصغير", "en": "Kicker" },
          "default": "الإصدار الجديد"
        },
        "title": {
          "type": "string",
          "label": { "ar": "العنوان", "en": "Title" },
          "default": "ارتدِ الضجيج"
        },
        "text": {
          "type": "string",
          "label": { "ar": "النص", "en": "Text" },
          "default": ""
        },
        "button_text": {
          "type": "string",
          "label": { "ar": "نص الزر الأساسي", "en": "Primary button label" },
          "default": "تسوّق الآن"
        },
        "button_url": {
          "type": "string",
          "label": { "ar": "رابط الزر الأساسي", "en": "Primary button link" },
          "default": "/shop"
        },
        "button2_text": {
          "type": "string",
          "label": { "ar": "نص الزر الثاني (اختياري)", "en": "Secondary button label (optional)" },
          "default": ""
        },
        "button2_url": {
          "type": "string",
          "label": { "ar": "رابط الزر الثاني", "en": "Secondary button link" },
          "default": ""
        },
        "align": {
          "type": "select",
          "label": { "ar": "مكان النص", "en": "Text position" },
          "default": "start",
          "options": [
            { "value": "start", "label": { "ar": "في البداية", "en": "Start" } },
            { "value": "center", "label": { "ar": "في المنتصف", "en": "Center" } },
            { "value": "end", "label": { "ar": "في النهاية", "en": "End" } }
          ]
        }
      }
    }
  },
  "presets": [
    { "category": "الواجهة", "name": "سلايدر الواجهة (Hero Slider)" }
  ]
}

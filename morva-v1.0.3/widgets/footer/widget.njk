{% endmacro %}

<footer class="mv-footer">
  {% if (slogans | length) > 0 %}
    <div class="mv-ftags" style="--tags: {{ slogans | length }};">
      {% for s in slogans %}<div class="mv-ftag reveal" style="--i: {{ loop.index0 }}; --ry: 24px;">{{ s }}</div>{% endfor %}
    </div>
  {% endif %}

  <div class="mv-flinks">
    <div class="mv-fcol mv-fbrand reveal" style="--i: 0; --ry: 24px;">
      <a href="/" class="mv-flogo{{ ' is-mono' if d.logo_mono }}" aria-label="{{ storeName }}" data-no-transition>
        {% if logoUrl %}<img src="{{ logoUrl }}" alt="{{ storeName }}" width="80" height="32" loading="lazy"/>{% else %}<span class="mv-wordmark">{{ storeName }}</span>{% endif %}
      </a>
      {% if brandText %}<div class="mv-fdesc">{{ brandText | safe }}</div>{% endif %}
    </div>

    {% if (helpItems | length) > 0 %}
      <div class="mv-fcol reveal" style="--i: 1; --ry: 24px;">
        <div class="mv-fh">{{ d.help_title | default(t('morva.help'), true) }}</div>
        {% for item in helpItems %}<a href="{{ item.url | default('#') }}" class="mv-flink">{{ item.title }}</a>{% endfor %}
      </div>
    {% endif %}

    {% if (brandItems | length) > 0 %}
      <div class="mv-fcol reveal" style="--i: 2; --ry: 24px;">
        <div class="mv-fh">{{ d.brand_title | default(storeName, true) }}</div>
        {% for item in brandItems %}<a href="{{ item.url | default('#') }}" class="mv-flink">{{ item.title }}</a>{% endfor %}
      </div>
    {% endif %}

    {% if (activeSocials | length) > 0 %}
      <div class="mv-fcol reveal" style="--i: 3; --ry: 24px;">
        <div class="mv-fh">{{ d.follow_title | default(t('morva.follow'), true) }}</div>
        {% for s in activeSocials %}<a href="{{ s.url }}" target="_blank" rel="noopener noreferrer" class="mv-flink">{{ s.label }}</a>{% endfor %}
      </div>
    {% endif %}
  </div>

  {% if d.domain_text or (activeSocials | length) > 0 %}
    <div class="mv-fstrip">
      {% if d.domain_text %}
        <a href="{{ d.domain_url | default('/') }}" class="mv-fdomain">{{ d.domain_text }}</a>
      {% else %}
        <span></span>
      {% endif %}
      <div class="mv-social">
        {% for s in activeSocials %}
          <a href="{{ s.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ s.label }}">{{ socialIcon(s.key) }}</a>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <div class="mv-legal">
    {% if d.copyright %}{{ d.copyright }}{% else %}© {{ storeName }}. {{ t('morva.rights') }}{% endif %}
  </div>
</footer>

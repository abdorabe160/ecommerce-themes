{#
  ============================================================================
  MORVA · FOOTER
  ----------------------------------------------------------------------------
  slogan tags (4) · brand column + two link menus + FOLLOW · domain + social
  icons · legal line. Every column hides itself when it has nothing to show.
  ============================================================================
#}
{% set d = widget.data %}
{% set storeName = store.name | default('MORVA') %}

{% set slogans = [] %}
{% for k in ['slogan_1', 'slogan_2', 'slogan_3', 'slogan_4'] %}
  {% if d[k] %}{% set _ = slogans.push(d[k]) %}{% endif %}
{% endfor %}

{% set logo = d.logo if d.logo and d.logo.fileUrl else store.logo %}
{#- No store logo: the store's own name, never the bundled MORVA mark (it
    put another brand's logo on every store that had not uploaded one). -#}
{% set logoUrl = logo.fileUrl if logo and logo.fileUrl else '' %}
{% set brandText = d.brand_text | default(store.description) | default('') %}

{% set helpMenu = d.help_menu %}
{% set helpItems = (helpMenu.items if helpMenu and helpMenu.items else helpMenu) | default([], true) %}
{% set brandMenu = d.brand_menu %}
{% set brandAll = (brandMenu.items if brandMenu and brandMenu.items else brandMenu) | default([], true) %}
{#- Both columns often point at the same menu: a link is shown once. -#}
{% set helpUrls = [] %}
{% for item in helpItems %}{% set _ = helpUrls.push(item.url) %}{% endfor %}
{% set brandItems = [] %}
{% for item in brandAll %}{% if not (item.url in helpUrls) %}{% set _ = brandItems.push(item) %}{% endif %}{% endfor %}

{% set socials = [
  { key: 'instagram', url: d.social_instagram, label: 'Instagram' },
  { key: 'tiktok',    url: d.social_tiktok,    label: 'TikTok' },
  { key: 'youtube',   url: d.social_youtube,   label: 'YouTube' },
  { key: 'snapchat',  url: d.social_snapchat,  label: 'Snapchat' },
  { key: 'facebook',  url: d.social_facebook,  label: 'Facebook' },
  { key: 'x',         url: d.social_x,         label: 'X' },
  { key: 'whatsapp',  url: d.social_whatsapp,  label: 'WhatsApp' }
] %}
{% set activeSocials = [] %}
{% for s in socials %}{% if s.url %}{% set _ = activeSocials.push(s) %}{% endif %}{% endfor %}


{#
  ============================================================================
  MORVA · HEADER
  ----------------------------------------------------------------------------
  Desktop (> 880px) — a three-column grid on a blurred dark bar:
    [ SEARCH · (02) BAG ] | logo | [ nav links · EN/ع ]
  Mobile — physically left-to-right in BOTH languages:
    [ menu | search | bag ] ·············· [ logo ]

  Also renders the overlays the header owns: mobile menu, search sheet and
  the bag drawer (ui/cart.njk), so they exist on every page exactly once.
  The bar turns more opaque once the page scrolls (main.js · mvHeader).
  ============================================================================
#}
{% set id = widget.id %}
{% set d = widget.data %}

{% set storeName = store.name | default('MORVA') %}
{% set logo = d.logo if d.logo and d.logo.fileUrl else store.logo %}
{% set logoUrl = logo.fileUrl if logo and logo.fileUrl else ('logo.png' | assets if d.use_theme_logo | default(false) else '') %}
{% set logoH = d.logo_height | default(26) %}
{% set menu = d.menu %}
{% set menuItems = (menu.items if menu and menu.items else menu) or [] %}
{% set showLang = d.show_language | default(true) %}
{% set lang = localization.language | default('ar') %}
{% set curPath = (page.url | default('/')).split('?')[0] %}
{% set qty = cart.totalQuantity | default(0) %}

<header id="mv-header-{{ id }}" class="mv-header" x-data="mvHeader()" :class="scrolled && 'is-scrolled'">

  {# ══ Desktop ══ #}
  <div class="mv-hgrid">
    <div class="mv-hstart">
      <button type="button" class="mv-util" @click="$store.modal.open('search')">{{ t('morva.search') }}</button>
      <button type="button" class="mv-util" @click="$store.modal.open('cart')">
        (<span class="mv-util-num" x-text="String($store.cart.totalQuantity).padStart(2, '0')">{{ ('0' ~ qty) if qty < 10 else qty }}</span>) {{ t('morva.bag') }}
      </button>
    </div>

    <div class="mv-hcenter">
      <a href="/" class="mv-logo" aria-label="{{ storeName }}" data-no-transition style="--logo-h: {{ logoH }}px;">
        {% if logoUrl %}<img src="{{ logoUrl }}" alt="{{ storeName }}" width="72" height="28"/>{% else %}<span class="mv-wordmark">{{ storeName }}</span>{% endif %}
      </a>
    </div>

    <div class="mv-hend">
      <nav class="mv-nav" aria-label="{{ t('common.menu') }}">
        {% for item in menuItems %}
          {% set itemPath = (item.url | default('#')).split('?')[0] %}
          {#- Sub-items arrive under `menu` on stores (measured on ATTAR's) and `children` in the docs: read both. -#}
          {% set kids = item.menu if (item.menu and (item.menu | length) > 0) else (item.children or []) %}
          {% if (kids | length) > 0 %}
            <div class="mv-navitem" x-data="mvNavItem()" @pointerenter="enter($event)" @pointerleave="leave($event)"
                 @focusin="focusIn($event)" @focusout="focusOut($event)" @keydown.escape="open = false">
              <a href="{{ item.url | default('#') }}"
                 class="mv-navlink {{ 'is-active' if itemPath == curPath and itemPath != '/' }}">{{ item.title }}</a>
              <button type="button" class="mv-navcaret" @click="toggle()" aria-expanded="false" :aria-expanded="open ? 'true' : 'false'"
                      aria-label="{{ t('morva.submenu') }}: {{ item.title }}">
                <svg width="9" height="6" viewBox="0 0 9 6" fill="none" aria-hidden="true"><path d="M1 1l3.5 3.5L8 1" stroke="currentColor" stroke-width="1.5"/></svg>
              </button>
              <div class="mv-drop" x-ref="drop" x-show="open" x-cloak data-lenis-prevent>
                {% for child in kids %}
                  <a href="{{ child.url | default('#') }}" class="mv-droplink">{{ child.title }}</a>
                  {% set subs = child.menu if (child.menu and (child.menu | length) > 0) else (child.children or []) %}
                  {% for sub in subs %}
                    <a href="{{ sub.url | default('#') }}" class="mv-droplink mv-droplink--sub">{{ sub.title }}</a>
                  {% endfor %}
                {% endfor %}
              </div>
            </div>
          {% else %}
          <a href="{{ item.url | default('#') }}"
             class="mv-navlink {{ 'is-active' if itemPath == curPath and itemPath != '/' }}">{{ item.title }}</a>
          {% endif %}
        {% endfor %}
      </nav>
      {% if showLang %}
        {% form 'lang' %}
          {% if lang == 'en' %}
            <button type="submit" name="lang" value="ar" class="mv-langbtn" aria-label="{{ t('morva.switch_lang') }}">ع</button>
          {% else %}
            <button type="submit" name="lang" value="en" class="mv-langbtn" aria-label="{{ t('morva.switch_lang') }}">EN</button>
          {% endif %}
        {% endform %}
      {% endif %}
    </div>
  </div>

  {# ══ Mobile ══ #}
  <div class="mv-hmobile">
    <button type="button" class="mv-burger" @click="$store.modal.open('menu')" aria-label="{{ t('common.menu') }}">
      <svg width="22" height="14" viewBox="0 0 22 14" fill="none" aria-hidden="true"><path d="M0 1h22M0 7h22M0 13h22" stroke="currentColor" stroke-width="1.5"/></svg>
    </button>
    <button type="button" class="mv-iconbtn" @click="$store.modal.open('search')" aria-label="{{ t('morva.search') }}">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
    </button>
    <button type="button" class="mv-iconbtn" @click="$store.modal.open('cart')" aria-label="{{ t('morva.bag') }}">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      <span class="mv-badge" x-show="$store.cart.totalQuantity > 0" x-text="$store.cart.totalQuantity" {% if qty == 0 %}x-cloak{% endif %}>{{ qty }}</span>
    </button>
    <a href="/" class="mv-mlogo" aria-label="{{ storeName }}" data-no-transition style="--logo-h-m: {{ (logoH * 0.85) | round }}px;">
      {% if logoUrl %}<img src="{{ logoUrl }}" alt="{{ storeName }}" width="72" height="28"/>{% else %}<span class="mv-wordmark">{{ storeName }}</span>{% endif %}
    </a>
  </div>
</header>

{#- Qalab's `ui` tag rejects an undefined argument and prints an error box in
    its place — a merchant who never picked menu products (or cleared a menu)
    got that box on EVERY page. Each argument gets a defined fallback. -#}
{% ui "mobile-menu.njk", menu=(menu or false), quick=(d.quick_menu or false), products=(d.menu_products or []), shop_label=(d.shop_label or ''), show_lang=showLang %}
{% ui "search-panel.njk", popular=(d.search_popular or '') %}
{% ui "cart.njk", free_shipping=(d.cart_free_shipping or 0), note=(d.cart_note or '') %}

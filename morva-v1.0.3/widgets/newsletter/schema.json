    "button": {
      "type": "string",
      "label": {
        "ar": "نص الزر",
        "en": "Button label"
      },
      "default": "اشترك"
    },
    "form_action": {
      "type": "string",
      "label": {
        "ar": "رابط استقبال الاشتراكات (Mailchimp / Brevo / Klaviyo…) — مطلوب لتفعيل النموذج",

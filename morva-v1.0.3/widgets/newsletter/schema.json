          }
        },
        {
          "value": "email",
          "label": {
            "ar": "بريد إلكتروني",
            "en": "Email"
          }
        },
        {
          "value": "phone",
          "label": {
            "ar": "رقم موبايل",
            "en": "Phone number"
          }
        },
        {
          "value": "both",
          "label": {
            "ar": "الاثنين (بريد وموبايل)",
            "en": "Both (email and phone)"
          }
        }
      ]
